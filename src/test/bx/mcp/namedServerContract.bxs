// Run against the loaded module. Separate lookups must retain the registered closure.
function registerRecorder( required string serverName ) {
	var history = []
	mcpServer( arguments.serverName ).registerTool( aiTool(
		name: "record",
		description: "Append a label and return the labels recorded so far",
		callable: ( label ) => {
			history.append( label )
			return history.toList( "," )
		},
		autoRegister: false
	) )
}

probeName = "named-server-contract"
registerRecorder( probeName )
for ( label in [ "first", "second" ] ) {
	reply = mcpServer( probeName ).handleRequest( {
		jsonrpc: "2.0", id: label, method: "tools/call",
		params: { name: "record", arguments: { label: label } }
	} )
	expected = label == "first" ? "first" : "first,second"
	if ( reply.id != label || reply.result.content[ 1 ].text != expected ) {
		throw( message: "Named MCP server did not retain the recorder for #label#" )
	}
}
