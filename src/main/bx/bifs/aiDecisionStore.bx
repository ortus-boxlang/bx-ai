 * Create an IDecisionStore instance for durable human-in-the-loop "approve always" grants
 */
@BoxBIF
class {

	/**
	 * Create an IDecisionStore instance. When called with no arguments, resolves the
	 * application-wide default from settings.hitl.decisionStore — the same fallback
	 * HumanInTheLoopMiddleware uses when it isn't given a decisionStore explicitly.
	 *
	 * @store  The store type to create: cache | jdbc | file, or a full class path.
	 *         Defaults to settings.hitl.decisionStore.provider.
	 * @config Configuration struct for the store (e.g. { cacheName }, { datasource, table },
	 *         { directoryPath }). Defaults to settings.hitl.decisionStore.config.
	 *
	 * @return IDecisionStore instance
	 */
	function invoke(
		string store,
		struct config
	) {
		var storeType   = arguments.store ?: moduleRecord.settings.hitl.decisionStore.provider;
		var storeConfig = arguments.config ?: moduleRecord.settings.hitl.decisionStore.config;
		var storeClass  = "";

		switch ( storeType.lcase() ) {
			case "cache":
			case "CacheDecisionStore":
				storeClass = "bxModules.bxai.models.hitl.decisions.CacheDecisionStore";
				break;
			case "jdbc":
			case "JdbcDecisionStore":
			case "database":
			case "db":
				storeClass = "bxModules.bxai.models.hitl.decisions.JdbcDecisionStore";
				break;
			case "file":
			case "FileDecisionStore":
				storeClass = "bxModules.bxai.models.hitl.decisions.FileDecisionStore";
				break;
			default:
				if ( storeType.findNoCase( "." ) ) {
					storeClass = storeType;
				} else {
					throw(
						type   : "InvalidDecisionStoreType",
						message: "Unknown decision store type: #storeType#. Available types: cache, jdbc, file"
					);
				}
		}

		BoxAnnounce( "onAiDecisionStoreCreate", {
			storeType  : storeType,
			storeClass : storeClass,
			storeConfig: storeConfig
		} );

		return new "#storeClass#"( argumentCollection: storeConfig );
	}

}
