 * Returns the singleton GatewayRegistry instance.
 *
 * Usage:
 *   aiGatewayRegistry().register( gatewayInstance )
 *   aiGatewayRegistry().register( gatewayInstance, "my-module" )
 *   aiGatewayRegistry().get( "slack@bx-ai-gateway-slack" )
 *   aiGatewayRegistry().has( "cli" )
 *   aiGatewayRegistry().listGateways()
 */
import bxModules.bxai.models.gateway.registry.GatewayRegistry;

@BoxBIF
class {

	// Create the singleton registry instance on class load
	variables.registry = new GatewayRegistry()

	function invoke() {
		return variables.registry
	}

}
