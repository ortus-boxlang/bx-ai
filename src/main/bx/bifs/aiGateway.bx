 * ----------------------------------------------------------------------------------
 * Creates a reference to a Gateway implementation by name.
 *
 * A small switch resolves the gateway names bx-ai ships in core. For any other name,
 * external gateway modules (e.g. bx-ai-gateway-slack) integrate via gatewayRegistry():
 * a module registers an instance under its gateway name when it loads
 * (`gatewayRegistry().register( new SlackGateway() )`), and this BIF looks it up and
 * (re)configures it with the given options. If nothing is registered under that name,
 * the name is tried as a directly-instantiable class path as a last resort.
 */
@BoxBIF
class {

	static {
		/**
		 * Inject the following references into the class
		 * - moduleRecord : The ModuleRecord instance
		 * - boxRuntime : The BoxRuntime instance
		 * - interceptorService : The BoxLang InterceptorService
		 * - log : A logger for the module config itself
		 */
		final CORE_GATEWAYS = [ "mock", "cli", "http" ];
	}

	/**
	 * Creates a reference to a Gateway implementation this module (or an external module)
	 * supports.
	 *
	 * @name    The gateway name to resolve — a core name ("mock", "cli", "http") or an
	 *          externally-registered name provided by a gateway module (e.g. "slack")
	 * @options A struct of options to configure the gateway instance
	 *
	 * @throws GatewayNotSupported if the gateway name is not supported
	 *
	 * @return The configured IGateway instance
	 */
	function invoke( required string name, struct options = {} ) {
		var targetClass = ""

		switch ( arguments.name ) {
			case "mock":
				targetClass = "bxModules.bxai.models.gateway.MockGateway"
				break
			case "cli":
				targetClass = "bxModules.bxai.models.gateway.cli.CliGateway"
				break
			case "http":
				targetClass = "bxModules.bxai.models.gateway.http.HttpGateway"
				break
			default:
				// A module that provides this gateway registers an instance under its name
				// when it loads — prefer that over anything else.
				if ( gatewayRegistry().has( arguments.name ) ) {
					var registeredGateway = gatewayRegistry().get( arguments.name )
					registeredGateway.configure( arguments.options )
					BoxAnnounce( "onGatewayCreate", { gateway: registeredGateway } )
					return registeredGateway
				}

				// Fallback: try the name as a directly-instantiable class path
				try {
					var oTargetGateway = new "#arguments.name#"().configure( arguments.options )
				} catch ( any e ) {
					throw(
						type   : "GatewayNotSupported",
						message: "Gateway [#arguments.name#] is not supported. Core gateways are: [#static.CORE_GATEWAYS.toList()#]. Register it in gatewayRegistry() or install a module that provides it (e.g. bx-ai-gateway-#arguments.name#)."
					)
				}
				BoxAnnounce( "onGatewayCreate", { gateway: oTargetGateway } )
				return oTargetGateway
		}

		// Create the gateway instance
		var oTargetGateway = new "#targetClass#"().configure( arguments.options )

		// Announce
		BoxAnnounce( "onGatewayCreate", { gateway: oTargetGateway } )

		return oTargetGateway
	}

}
