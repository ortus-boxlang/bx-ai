 * ----------------------------------------------------------------------------------
 * Fence (spotlight) untrusted content for safe inclusion in an AI prompt.
 *
 * Wraps the content in unique boundary markers so the model treats it as DATA, not
 * instructions — the core defense against indirect prompt injection from RAG documents,
 * tool/MCP output, web pages, and other external sources.
 *
 * Usage:
 *   context = aiFence( retrievedDoc, "knowledge-base" )
 *   answer  = aiChat( "Answer using this context: #context#", ... )
 *
 *   // Include the security preamble inline (for one-off prompts without a system message)
 *   fenced = aiFence( untrustedText, "web-page", withPreamble = true )
 */
@BoxBIF
class {

	/**
	 * Fence untrusted content in boundary markers.
	 *
	 * @content      The untrusted content to fence (string or complex value)
	 * @label        A short source label (e.g. "knowledge-base", "web-page"); default "external"
	 * @withPreamble When true, prepend the security preamble instruction to the fenced block
	 *
	 * @return The fenced string
	 */
	function invoke(
		required any content,
		string label = "external",
		boolean withPreamble = false
	){
		var fenced = bxModules.bxai.models.security.PromptSecurity::fence( arguments.content, arguments.label );

		if( arguments.withPreamble ){
			return bxModules.bxai.models.security.PromptSecurity::fencePreamble() & char( 10 ) & char( 10 ) & fenced;
		}

		return fenced;
	}

}
