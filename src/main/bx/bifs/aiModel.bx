 * Creates an AI Model runnable for use in pipelines
 */
import bxModules.bxai.models.util.ProfileResolver;

@BoxBIF
class {

	/**
	 * Inject the following references into the class
	 * - moduleRecord : The ModuleRecord instance
	 * - boxRuntime : The BoxRuntime instance
	 * - interceptorService : The BoxLang InterceptorService
	 * - log : A logger for the module config itself
	 */

	/**
	 * Creates an AI Model runnable that wraps a service provider
	 * This is the pipeline-friendly version of aiService()
	 * <p>
	 * Use this when you want to integrate AI calls into runnable pipelines.
	 * Use aiService() when you need direct service invocation control.
	 *
	 * Example:
	 * ```
	 * // In a pipeline
	 * chain = aiMessage("Hello ${name}")
	 *     .to( aiModel("openai") )
	 *     .to( aiTransform( r => r.content ) )
	 *
	 * result = chain.run({ name: "World" })
	 * ```
	 *
	 * @provider The provider to use (openai, claude, etc.). If not provided, uses default from module settings.
	 * @apiKey Optional API key override. If not provided, uses default from module settings.
	 * @tools Optional ITool or an array of Tool instances to attach to the model for tool-augmented generation.
	 * @param params Additional parameters to bind the model with
	 * @param options Additional options for model creation (e.g., timeout, logResponse, logResponseToConsole, logRequest, logRequestToConsole)
	 * @middleware IAiMiddleware instance, struct-of-closures, or array of either to attach to this model
	 * @skills Always-on skills: full content injected as a system message on every model call
	 * @profile The name of a configured profile. It supplies the provider, API key, params and options. Explicit arguments win.
	 * @mcpServers Array of MCP server URLs to seed into the model for internal tool calls to sub-agents and tools. This allows the model to make calls to sub-agents and tools registered on those MCP servers, enabling distributed agent architectures and tool usage across multiple servers.
	 *
	 * @return An AiModel runnable
	 */
	function invoke(
		string provider,
		any apiKey,
		any tools=[],
		struct params={},
		struct options={},
		any middleware=[],
		array skills=[],
		array mcpServers=[],
		string profile
	) {
		// Resolve the profile: the argument, else options.profile, else the default profile when no provider was requested.
		// aiService() applies the provider, key and options of the profile, the params are layered here.
		var profileOptions = { profile: arguments.profile ?: ( arguments.options.profile ?: "" ) }
		if ( !isNull( arguments.provider ) ) {
			profileOptions.provider = arguments.provider
		}
		var profileName = ProfileResolver::profileFor( profileOptions )
		var profileParams = {}
		var profileOptions2 = {}
		if ( len( profileName ) ) {
			arguments.profile = profileName
			var resolvedProfile = ProfileResolver::resolve( profileName )
			// Profile params are for the profile's own provider
			if ( isNull( arguments.provider ) || arguments.provider == resolvedProfile.provider ) {
				profileParams = resolvedProfile.params
				profileOptions2 = resolvedProfile.options
			}
		}

		// Get the underlying service (pass only service-relevant args)
		var service = aiService( argumentCollection: arguments )

		// Wrap it as a model entity for use in pipelines
		var model = new bxModules.bxai.models.runnables.AiModel( service )
			.withTools( arguments.tools )
			.withParams( profileParams.append( arguments.params, true ) )
			.withOptions( profileOptions2.append( arguments.options, true ) )
			.withMiddleware( arguments.middleware )
			.withSkills( arguments.skills )
			.withMCPServers( arguments.mcpServers )

		model.setProfile( profileName )

		// Notify of model creation
		BoxAnnounce( "onAIModelCreate", { model: model, service: service } )

		return model
	}

}
