 * ----------------------------------------------------------------------------------
 * Capability interface for gateways that support rich interactive actions
 * (buttons, select menus, modals) rather than plain text — e.g. Slack, Discord, Teams.
 *
 * The coordinator (Phase 2) should check `supports("interactiveActions")` before
 * relying on this and degrade to plain-text instructions otherwise (see
 * IHumanInteractionGateway for the text-only fallback path every gateway supports).
 *
 * @since 4.0.0
 */
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayDeliveryResult;

interface extends="IGateway" {

	/**
	 * Deliver a GatewayEvent using rich interactive actions native to the platform
	 * (e.g. approve/reject buttons) instead of plain text instructions.
	 *
	 * @event   The normalized event to deliver
	 * @context The GatewayContext identifying who/where to deliver it to
	 * @actions Interactive action definitions — gateway-specific shape (label, value, style, etc.)
	 *
	 * @return A GatewayDeliveryResult describing the outcome
	 */
	GatewayDeliveryResult function deliverInteractive(
		required GatewayEvent event,
		required GatewayContext context,
		required array actions
	);

}
