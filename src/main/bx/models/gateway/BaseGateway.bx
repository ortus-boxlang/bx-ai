 * ----------------------------------------------------------------------------------
 * Abstract base for gateway implementations.
 *
 * Provides a sensible configure() default and capability discovery driven by
 * getDeclaredCapabilities() — mirrors BaseService's getCapabilities()/hasCapability()
 * pattern used by AI providers, so gateways follow the same "declare what you support"
 * convention.
 *
 * Concrete gateways: `class extends="BaseGateway"`, overriding only the IGateway
 * capability methods (parseInbound/verifyInbound, deliver, deliverChunk,
 * deliverInteractive, requestHumanInteraction/parseHumanDecision) they actually
 * support, and overriding getDeclaredCapabilities() to advertise those same
 * capabilities (e.g. "inboundMessages", "outboundMessages", "streaming",
 * "interactiveActions", "humanApproval", plus any platform-specific ones like
 * "threads", "attachments", "messageEditing", "argumentEditing", "authentication").
 */
abstract class implements="IGateway" {

	/**
	 * The gateway's name, used for logging, debugging, and registry lookups
	 */
	property name="name" type="string" default="";

	/**
	 * The gateway's description, used for logging and debugging
	 */
	property name="description" type="string" default="";

	/**
	 * Configuration options this gateway was configured with
	 */
	property name="options" type="struct" default={};

	/**
	 * Configure the gateway with configuration options.
	 * Override for gateway-specific setup (credentials, endpoints, etc.) — call
	 * super.configure() to retain the base storage behavior.
	 *
	 * @options A struct containing configuration options — shape is gateway-specific
	 *
	 * @return The configured gateway instance
	 */
	IGateway function configure( required any options ) {
		variables.options = isStruct( arguments.options ) ? arguments.options : { "value": arguments.options }
		return this;
	}

	/**
	 * Returns all capabilities this gateway supports — whatever getDeclaredCapabilities()
	 * reports.
	 *
	 * @return Array of capability strings
	 */
	public array function getCapabilities() {
		return getDeclaredCapabilities()
	}

	/**
	 * Override in concrete gateways to declare which capabilities they support
	 * (e.g. "inboundMessages", "outboundMessages", "streaming", "interactiveActions",
	 * "humanApproval", "threads", "attachments", "messageEditing", "argumentEditing",
	 * "authentication"). Only declare a capability if the corresponding IGateway
	 * method is actually overridden.
	 *
	 * @return Array of capability strings
	 */
	public array function getDeclaredCapabilities() {
		return []
	}

}
