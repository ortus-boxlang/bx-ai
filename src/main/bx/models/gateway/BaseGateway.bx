 * ----------------------------------------------------------------------------------
 * Abstract base for gateway implementations.
 *
 * Provides a sensible configure() default and capability discovery inferred from the
 * optional capability interfaces (IInboundGateway/IOutboundGateway/IStreamingGateway/
 * IInteractiveGateway/IHumanInteractionGateway) a concrete gateway implements — mirrors
 * BaseService's getCapabilities()/hasCapability()/getDeclaredCapabilities() pattern used
 * by AI providers, so gateways follow the same "implement what you support, capabilities
 * stay in sync automatically" convention.
 *
 * Concrete gateways: `class extends="BaseGateway" implements="IInboundGateway,IOutboundGateway"`.
 * Fine-grained platform features that can't be inferred structurally (threads,
 * attachments, messageEditing, argumentEditing, authentication) should be declared
 * explicitly by overriding getDeclaredCapabilities().
 */
abstract class implements="IGateway" {

	/**
	 * The gateway's name, used for logging, debugging, and registry lookups
	 */
	property name="name" type="string" default="";

	/**
	 * The gateway's description, used for logging and debugging
	 */
	property name="description" type="string" default="";

	/**
	 * Configuration options this gateway was configured with
	 */
	property name="options" type="struct" default={};

	/**
	 * Configure the gateway with configuration options.
	 * Override for gateway-specific setup (credentials, endpoints, etc.) — call
	 * super.configure() to retain the base storage behavior.
	 *
	 * @options A struct containing configuration options — shape is gateway-specific
	 *
	 * @return The configured gateway instance
	 */
	IGateway function configure( required any options ) {
		variables.options = isStruct( arguments.options ) ? arguments.options : { "value": arguments.options }
		return this;
	}

	/**
	 * Returns all capabilities this gateway supports.
	 * If the concrete class overrides getDeclaredCapabilities(), that result is used.
	 * Otherwise capabilities are inferred from implemented interfaces.
	 *
	 * @return Array of capability strings
	 */
	public array function getCapabilities() {
		var declared = getDeclaredCapabilities()
		if ( !declared.isEmpty() ) {
			return declared
		}
		// Fallback: infer from interfaces
		var caps = []
		if ( isInstanceOf( this, "IInboundGateway" ) ) {
			caps.append( "inboundMessages" )
		}
		if ( isInstanceOf( this, "IOutboundGateway" ) ) {
			caps.append( "outboundMessages" )
		}
		if ( isInstanceOf( this, "IStreamingGateway" ) ) {
			caps.append( "streaming" )
		}
		if ( isInstanceOf( this, "IInteractiveGateway" ) ) {
			caps.append( "interactiveActions" )
		}
		if ( isInstanceOf( this, "IHumanInteractionGateway" ) ) {
			caps.append( "humanApproval" )
		}
		return caps
	}

	/**
	 * Override in concrete gateways to declare explicit capabilities via static.CAPABILITIES
	 * (needed for capabilities that can't be inferred from an implemented interface, e.g.
	 * "threads", "attachments", "messageEditing", "argumentEditing", "authentication").
	 * Returning a non-empty array bypasses interface-based detection entirely, so include
	 * the structural ones too if you override this.
	 *
	 * @return Array of capability strings, or [] to use interface detection
	 */
	public array function getDeclaredCapabilities() {
		return []
	}

}
