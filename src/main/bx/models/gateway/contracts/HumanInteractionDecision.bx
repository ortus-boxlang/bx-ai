 * ----------------------------------------------------------------------------------
 * A human's decision on a HumanInteractionRequest.
 *
 * For tool_approval requests, `decision` maps directly onto the existing
 * AiMiddlewareResult vocabulary: approve | reject | edit | cancel — plus two durable-grant
 * variants, approve_always | approve_session, which resolve to the same APPROVED outcome as
 * "approve" but also tell HumanInteractionCoordinator to record a grant so future requests for
 * the same identity/tool/scope can skip presenting entirely. See DECISIONS for the full set.
 */
class {

	/**
	 * The HumanInteractionRequest.id this decision resolves
	 */
	property name="requestID" type="string" default="";

	/**
	 * The decision: approve | reject | edit | cancel (for tool_approval requests),
	 * or a gateway/interactionType-specific value for other interaction types
	 */
	property name="decision" type="string" default="";

	/**
	 * Corrected data when decision is "edit" (e.g. { correctedArgs: {...} })
	 */
	property name="editedData" type="struct" default={};

	/**
	 * Freeform/selection input the human submitted, for non-approval interaction types
	 */
	property name="submittedData" type="struct" default={};

	/**
	 * Human-readable reason for the decision
	 */
	property name="reason" type="string" default="";

	/**
	 * Identifier of who made the decision (platform-native user id, email, etc.)
	 */
	property name="decidedBy" type="string" default="";

	/**
	 * When the decision was made
	 */
	property name="decidedAt" type="date";

	/**
	 * Free-form metadata for gateway-specific extensions
	 */
	property name="metadata" type="struct" default={};

	/**
	 * Well-known decision string constants
	 */
	static {
		DECISIONS = {
			APPROVE        : "approve",
			APPROVE_ALWAYS : "approve_always",
			APPROVE_SESSION: "approve_session",
			REJECT         : "reject",
			EDIT           : "edit",
			CANCEL         : "cancel"
		}
	}

	/**
	 * Constructor
	 *
	 * @requestID      The HumanInteractionRequest.id this decision resolves
	 * @decision       The decision: approve | reject | edit | cancel, or interactionType-specific
	 * @editedData     Corrected data when decision is "edit"
	 * @submittedData  Freeform/selection input the human submitted
	 * @reason         Human-readable reason for the decision
	 * @decidedBy      Identifier of who made the decision
	 * @decidedAt      When the decision was made (defaults to now)
	 * @metadata       Free-form metadata for gateway-specific extensions
	 */
	function init(
		string requestID     = "",
		string decision      = "",
		struct editedData    = {},
		struct submittedData = {},
		string reason        = "",
		string decidedBy     = "",
		date   decidedAt     = now(),
		struct metadata      = {}
	) {
		variables.requestID     = arguments.requestID
		variables.decision      = arguments.decision
		variables.editedData    = arguments.editedData
		variables.submittedData = arguments.submittedData
		variables.reason        = arguments.reason
		variables.decidedBy     = arguments.decidedBy
		variables.decidedAt     = arguments.decidedAt
		variables.metadata      = arguments.metadata
		return this;
	}

	/**
	 * Whether this decision resolves to an approved outcome — true for a plain "approve" as
	 * well as either durable-grant variant ("approve_always"/"approve_session")
	 */
	boolean function isApproved() {
		return variables.decision == static.DECISIONS.APPROVE
			|| variables.decision == static.DECISIONS.APPROVE_ALWAYS
			|| variables.decision == static.DECISIONS.APPROVE_SESSION
	}

	/**
	 * Whether this decision is specifically an "approve_always" durable grant
	 */
	boolean function isApprovedAlways() {
		return variables.decision == static.DECISIONS.APPROVE_ALWAYS
	}

	/**
	 * Whether this decision is specifically an "approve_session" grant
	 */
	boolean function isApprovedForSession() {
		return variables.decision == static.DECISIONS.APPROVE_SESSION
	}

	boolean function isRejected() {
		return variables.decision == static.DECISIONS.REJECT
	}

	boolean function isEdit() {
		return variables.decision == static.DECISIONS.EDIT
	}

	boolean function isCancelled() {
		return variables.decision == static.DECISIONS.CANCEL
	}

}
