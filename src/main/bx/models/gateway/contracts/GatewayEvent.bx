 * A normalized event emitted by the agent layer and delivered by a gateway.
 *
 * This is the vocabulary the agent speaks to any gateway — it never calls a
 * platform-specific method directly. Gateways translate these into whatever
 * platform-native presentation makes sense (a Slack message update, a CLI print,
 * an SSE chunk, etc.).
 *
 * Use the TYPES constants for the well-known event type strings rather than
 * hardcoding them, e.g. `GatewayEvent.TYPES.EXECUTION_SUSPENDED`.
 */
class {

	/**
	 * Unique identifier for this event
	 */
	property name="id" type="string" default="";

	/**
	 * The normalized event type — prefer GatewayEvent.TYPES.* constants
	 */
	property name="type" type="string" default="";

	/**
	 * The agent execution/run this event correlates to — matches AiAgent's runId
	 */
	property name="executionID" type="string" default="";

	/**
	 * Event-specific payload. Shape depends on `type` (e.g. suspendData for
	 * execution.suspended, a text delta for response.delta)
	 */
	property name="data" type="struct" default={};

	/**
	 * The GatewayContext identifying who/where this event belongs to
	 */
	property name="context" type="GatewayContext";

	/**
	 * When this event was created
	 */
	property name="createdAt" type="date";

	/**
	 * Well-known normalized event type constants
	 */
	static {
		TYPES = {
			MESSAGE_REQUESTED    : "message.requested",
			APPROVAL_REQUESTED   : "approval.requested",
			INPUT_REQUESTED      : "input.requested",
			EXECUTION_SUSPENDED  : "execution.suspended",
			EXECUTION_RESUMED    : "execution.resumed",
			RESPONSE_STARTED     : "response.started",
			RESPONSE_DELTA       : "response.delta",
			RESPONSE_COMPLETED   : "response.completed",
			EXECUTION_FAILED     : "execution.failed"
		}
	}

	/**
	 * Constructor
	 *
	 * @id          Unique identifier for this event (auto-generated if omitted)
	 * @type        The normalized event type — prefer GatewayEvent.TYPES.* constants
	 * @executionID The agent execution/run this event correlates to
	 * @data        Event-specific payload
	 * @context     The GatewayContext identifying who/where this event belongs to
	 * @createdAt   When this event was created (defaults to now)
	 */
	function init(
		string id          = createUUID(),
		string type        = "",
		string executionID = "",
		struct data         = {},
		any    context,
		date   createdAt    = now()
	) {
		variables.id          = arguments.id
		variables.type        = arguments.type
		variables.executionID = arguments.executionID
		variables.data        = arguments.data
		variables.context     = arguments.context ?: new GatewayContext()
		variables.createdAt   = arguments.createdAt
		return this;
	}

}
