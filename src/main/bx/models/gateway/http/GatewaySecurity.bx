 * Request signing and verification for HttpGateway — the first gateway with real
 * network exposure, so unlike the in-process MockGateway/CliGateway, anything that
 * mutates state (an inbound event, a human's decision) must prove it was signed by a
 * holder of the shared secret, arrived recently, and hasn't already been consumed.
 *
 * Signature scheme: HMAC-SHA256 over `timestamp & "." & nonce & "." & rawBody`, hex-encoded.
 * The signer and verifier both canonicalize on the exact raw request body string (not a
 * re-serialization of parsed JSON) so whitespace/key-order differences can't desync them.
 *
 * This is a pure/stateless helper — nonce replay tracking (which needs shared, mutable
 * state) lives on HttpGateway itself, not here.
 */
class {

	/**
	 * Compute the HMAC-SHA256 signature for a request.
	 *
	 * @secret    The shared secret
	 * @timestamp Unix timestamp (seconds) the request was signed at
	 * @nonce     A unique-per-request random token
	 * @rawBody   The exact raw request body string that was/will be sent
	 *
	 * @return Hex-encoded HMAC-SHA256 signature
	 */
	static string function sign(
		required string secret,
		required string timestamp,
		required string nonce,
		required string rawBody
	) {
		var payload      = arguments.timestamp & "." & arguments.nonce & "." & arguments.rawBody
		var keySpec      = createObject( "java", "javax.crypto.spec.SecretKeySpec" ).init(
			charsetDecode( arguments.secret, "UTF-8" ),
			"HmacSHA256"
		)
		var mac = createObject( "java", "javax.crypto.Mac" ).getInstance( "HmacSHA256" )
		mac.init( keySpec )
		var digest = mac.doFinal( charsetDecode( payload, "UTF-8" ) )
		return binaryEncode( digest, "hex" ).lCase()
	}

	/**
	 * Verify a request's signature, timestamp freshness, in one call.
	 *
	 * @secret           The shared secret
	 * @timestamp        The X-Timestamp header value the request claims
	 * @nonce             The X-Nonce header value the request claims
	 * @rawBody           The exact raw request body string received
	 * @signature         The X-Signature header value to verify
	 * @toleranceSeconds  Maximum allowed clock skew / request age, in seconds
	 *
	 * @return struct { valid: boolean, reason: string } — reason is "" when valid
	 */
	static struct function verify(
		required string secret,
		required string timestamp,
		required string nonce,
		required string rawBody,
		required string signature,
		numeric toleranceSeconds = 300
	) {
		if ( !isNumeric( arguments.timestamp ) ) {
			return { valid: false, reason: "Missing or non-numeric timestamp." }
		}

		var age = abs( now().getTime() / 1000 - val( arguments.timestamp ) )
		if ( age > arguments.toleranceSeconds ) {
			return { valid: false, reason: "Request timestamp outside the allowed tolerance (#arguments.toleranceSeconds#s)." }
		}

		var expected = sign( arguments.secret, arguments.timestamp, arguments.nonce, arguments.rawBody )
		if ( !constantTimeEquals( expected, arguments.signature.lCase() ) ) {
			return { valid: false, reason: "Signature mismatch." }
		}

		return { valid: true, reason: "" }
	}

	/**
	 * Compare two strings without short-circuiting on the first mismatch, so verification
	 * time doesn't leak how many leading characters of a guessed signature were correct.
	 * Delegates to java.security.MessageDigest.isEqual(), the JDK's own constant-time
	 * byte-array comparison.
	 *
	 * @a First string
	 * @b Second string
	 */
	static boolean function constantTimeEquals( required string a, required string b ) {
		return createObject( "java", "java.security.MessageDigest" ).isEqual(
			charsetDecode( arguments.a, "UTF-8" ),
			charsetDecode( arguments.b, "UTF-8" )
		)
	}

}
