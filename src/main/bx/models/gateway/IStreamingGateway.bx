 * ----------------------------------------------------------------------------------
 * Capability interface for gateways that can deliver incremental updates for a single
 * logical response (SSE for a web UI, progressive message edits in Slack, etc.).
 *
 * This is a translation-only layer: it does not change how providers stream —
 * a GatewayStreamAdapter (Phase 4) wraps the existing per-chunk callback and
 * calls deliverChunk() for each piece when a streaming gateway is attached.
 *
 * @since 4.0.0
 */
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayDeliveryResult;

interface extends="IGateway" {

	/**
	 * Deliver a single response.started / response.delta / response.completed event as
	 * part of an ongoing streamed response.
	 *
	 * @event   The normalized event to deliver (type is one of GatewayEvent.TYPES.RESPONSE_*)
	 * @context The GatewayContext identifying who/where to deliver it to
	 *
	 * @return A GatewayDeliveryResult describing the outcome
	 */
	GatewayDeliveryResult function deliverChunk( required GatewayEvent event, required GatewayContext context );

}
