 * Capability interface for gateways that receive inbound platform traffic
 * (webhooks, socket events, CLI stdin, etc.) and normalize it into GatewayMessage(s).
 *
 * @since 4.0.0
 */
import bxModules.bxai.models.gateway.IGateway;

interface extends="IGateway" {

	/**
	 * Verify that an inbound payload is authentic (e.g. signature/HMAC validation).
	 * Call this before parseInbound() for any externally-reachable gateway.
	 *
	 * @payload        The raw inbound payload (shape is gateway-specific)
	 * @requestContext Transport-level context (headers, IP, etc.), shape is gateway-specific
	 *
	 * @return true if the payload is verified authentic
	 */
	boolean function verifyInbound( required any payload, struct requestContext = {} );

	/**
	 * Parse a raw inbound platform payload into one or more normalized GatewayMessage(s).
	 *
	 * @payload        The raw inbound payload (shape is gateway-specific)
	 * @requestContext Transport-level context (headers, IP, etc.), shape is gateway-specific
	 *
	 * @return Array of GatewayMessage instances
	 */
	array function parseInbound( required any payload, struct requestContext = {} );

}
