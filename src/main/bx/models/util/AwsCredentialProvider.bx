 * ----------------------------------------------------------------------------------
 * AWS Credential Provider
 *
 * Implements the standard AWS credential chain for loading credentials from multiple sources.
 * This follows the same precedence as the AWS SDK:
 *
 * 1. Explicit credentials passed via getCredentials()
 * 2. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
 * 3. AWS credentials file (~/.aws/credentials) using AWS_PROFILE or "default"
 * 4. ECS container credentials (AWS_CONTAINER_CREDENTIALS_RELATIVE_URI)
 * 5. EC2 instance metadata (IMDSv2)
 *
 * Usage:
 * ```boxlang
 * var credProvider = new AwsCredentialProvider();
 * var creds = credProvider.getCredentials();
 * // creds = { awsAccessKeyId: "...", awsSecretAccessKey: "...", awsSessionToken: "..." }
 * ```
 *
 * @see https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-envvars.html
 * @see https://docs.aws.amazon.com/sdkref/latest/guide/file-format.html
 */
class {

	static {
		// Auto-resolved (container/IMDS) credentials, cached across INSTANCES. Callers construct a
		// fresh provider per request — OpenSearchVectorMemory.getAwsSignedHeaders() does exactly
		// that — so an instance-scoped cache would never be read a second time and every request
		// would re-hit the metadata endpoint. Keyed by credentialCacheKey(); each entry is
		// { credentials: {}, lastFailure: null|datetime }.
		CREDENTIAL_CACHE = {};
		// Re-resolve once inside this many minutes of the reported expiry.
		REFRESH_BUFFER_MINUTES = 5;
		// After a resolution attempt that found nothing, skip the network round-trips for this long
		// rather than paying the timeout again — but only while there are still usable credentials
		// to serve. With nothing to serve, every request would be signed with empty keys and fail,
		// so the window is short enough to recover quickly (see NEGATIVE_CACHE_SECONDS_EMPTY).
		NEGATIVE_CACHE_SECONDS = 60;
		NEGATIVE_CACHE_SECONDS_EMPTY = 5;
	}

	/**
	 * Get AWS credentials from the credential chain
	 *
	 * @explicitCredentials Optional struct with awsAccessKeyId, awsSecretAccessKey, awsSessionToken to use directly
	 *
	 * @return Struct with awsAccessKeyId, awsSecretAccessKey, awsSessionToken (empty strings if not found)
	 */
	public struct function getCredentials( struct explicitCredentials = {} ){
		var result = {
			"awsAccessKeyId": "",
			"awsSecretAccessKey": "",
			"awsSessionToken": ""
		};

		// 1. Use explicit credentials if provided
		if ( arguments.explicitCredentials.keyExists( "awsAccessKeyId" ) && len( arguments.explicitCredentials.awsAccessKeyId ) ) {
			result.awsAccessKeyId = arguments.explicitCredentials.awsAccessKeyId;
			result.awsSecretAccessKey = arguments.explicitCredentials.awsSecretAccessKey ?: "";
			result.awsSessionToken = arguments.explicitCredentials.awsSessionToken ?: "";
			if ( len( result.awsAccessKeyId ) && len( result.awsSecretAccessKey ) ) {
				return result;
			}
		}

		// 2. Try environment variables
		result = loadFromEnvironment();
		if ( len( result.awsAccessKeyId ) && len( result.awsSecretAccessKey ) ) {
			return result;
		}

		// 3. Try AWS credentials file
		result = loadFromCredentialsFile();
		if ( len( result.awsAccessKeyId ) && len( result.awsSecretAccessKey ) ) {
			return result;
		}

		// 4 + 5. Container / EC2 metadata, behind a cache shared across instances. Callers build a
		// fresh provider per request, so without this every request re-pays the metadata round-trip
		// (or, off AWS, the full timeout).
		return resolveAutoCredentials();
	}

	/**
	 * Resolve container/IMDS credentials through the shared cache.
	 *
	 * Cache reads take a READONLY lock and the metadata calls happen OUTSIDE any lock, with only the
	 * write-back exclusive: BoxLang's lock registry is JVM-static, so holding an exclusive lock
	 * across seconds of HTTP would serialize every caller in the runtime. Two threads racing a cold
	 * cache may each pay one round-trip, which is deliberately preferred to that.
	 *
	 * @return Struct with awsAccessKeyId, awsSecretAccessKey, awsSessionToken (empty if not found)
	 */
	private struct function resolveAutoCredentials(){
		// Every failure below degrades to an empty struct so the caller sees "no credentials" and AWS
		// answers with its own auth error. The named locks use throwontimeout="true" (required by
		// convention), so a contended lock would otherwise be the one failure here that escapes out
		// of getCredentials() as an exception from a credential LOOKUP.
		try {
			return resolveAutoCredentialsLocked();
		} catch ( any e ) {
			writeLog(
				text: "AwsCredentialProvider: auto credential resolution failed (#e.type#): #e.message#",
				type: "error",
				log : "ai"
			);
			return { "awsAccessKeyId" : "", "awsSecretAccessKey" : "", "awsSessionToken" : "" };
		}
	}

	/**
	 * The cached container/IMDS resolution itself. Separated so resolveAutoCredentials() can
	 * guarantee this never throws.
	 *
	 * Cache reads take a READONLY lock and the metadata calls happen OUTSIDE any lock, with only the
	 * write-back exclusive: BoxLang's lock registry is JVM-static, so holding an exclusive lock
	 * across seconds of HTTP would serialize every caller in the runtime. Two threads racing a cold
	 * cache may each pay one round-trip, which is deliberately preferred to that.
	 *
	 * @return Struct with awsAccessKeyId, awsSecretAccessKey, awsSessionToken (empty if not found)
	 */
	private struct function resolveAutoCredentialsLocked(){
		var cacheKey = credentialCacheKey();
		var lockName = "aws-credential-provider-#cacheKey#";
		var cached   = "";

		lock name="#lockName#" type="readonly" timeout="10" throwontimeout="true" {
			// duplicate() INSIDE the lock. `?:` yields the LIVE entry, and every field read below
			// happens after the lock releases — aliasing it let a writer mutate the entry
			// mid-decision: validate one credentials struct and return another, or null lastFailure
			// between the isNull() check and the dateDiff() below, which throws "Can't cast null to a
			// DateTime" straight out of getCredentials().
			cached = duplicate( static.CREDENTIAL_CACHE[ cacheKey ] ?: { "credentials" : {}, "lastFailure" : null } );
		}

		if ( isCredentialCacheValid( cached.credentials ) ) {
			return duplicate( cached.credentials );
		}

		// Negative cache: skip the metadata round-trips for a window after a failed attempt. The
		// window is short when there is nothing usable to serve, because suppressing requests that
		// will all fail buys nothing and one unlucky attempt (a pod that started before its
		// credential endpoint was reachable) would otherwise hard-fail every request for a minute.
		if ( !isNull( cached.lastFailure ) ) {
			var stillUsable    = isCredentialUsableNow( cached.credentials );
			var negativeWindow = stillUsable ? static.NEGATIVE_CACHE_SECONDS : static.NEGATIVE_CACHE_SECONDS_EMPTY;

			if ( dateDiff( "s", cached.lastFailure, now() ) < negativeWindow ) {
				// Only credentials that have not ACTUALLY expired are served. Gating on a non-empty
				// secret alone meant an endpoint that stayed down had long-expired keys handed out
				// indefinitely, 60 seconds at a time — every signed request 403ing, where returning
				// nothing surfaces a clear credentials error instead.
				return stillUsable
					? duplicate( cached.credentials )
					: { "awsAccessKeyId" : "", "awsSecretAccessKey" : "", "awsSessionToken" : "" };
			}
		}

		var resolved = loadFromECS();
		if ( !len( resolved.awsAccessKeyId ?: "" ) || !len( resolved.awsSecretAccessKey ?: "" ) ) {
			resolved = loadFromEC2Metadata();
		}

		var usable = len( resolved.awsAccessKeyId ?: "" ) && len( resolved.awsSecretAccessKey ?: "" );

		lock name="#lockName#" type="exclusive" timeout="10" throwontimeout="true" {
			var entry = static.CREDENTIAL_CACHE[ cacheKey ] ?: { "credentials" : {}, "lastFailure" : null };

			if ( usable ) {
				entry.credentials = resolved;
				entry.lastFailure = null;
			} else {
				// Only arm the window when nothing valid is already cached: a concurrent thread may
				// have just stored good credentials, and stamping a failure over those is what makes
				// the negative branch withhold perfectly usable keys.
				if ( !isCredentialCacheValid( entry.credentials ) ) {
					entry.lastFailure = now();
				}
			}

			static.CREDENTIAL_CACHE[ cacheKey ] = entry;
		}

		// A failed refresh must not discard credentials that are still genuinely valid — that would
		// sign every request with empty keys during a transient endpoint hiccup.
		if ( !usable && isCredentialUsableNow( cached.credentials ) ) {
			return duplicate( cached.credentials );
		}

		return duplicate( resolved );
	}

	/**
	 * Whether cached credentials can still be used RIGHT NOW: key material present and the reported
	 * expiry not yet passed.
	 *
	 * Deliberately laxer than isCredentialCacheValid(), which additionally refuses anything inside
	 * the refresh buffer. The buffer says "start refreshing"; this says "these still work" — the
	 * distinction is what lets a transient refresh failure reuse credentials rather than discard
	 * them, without ever serving an expired set.
	 *
	 * @cached A cached credentials struct (may be empty)
	 *
	 * @return True if the credentials are present and unexpired
	 */
	private boolean function isCredentialUsableNow( required struct cached ){
		if ( !len( arguments.cached.awsAccessKeyId ?: "" ) || !len( arguments.cached.awsSecretAccessKey ?: "" ) ) {
			return false;
		}
		if ( !arguments.cached.keyExists( "expiration" ) ) {
			return false;
		}
		return dateCompare( now(), arguments.cached.expiration ) < 0;
	}

	/**
	 * Key under which auto-resolved credentials are shared across instances.
	 *
	 * Built only from what determines the credential values — the container endpoint in use, or EC2
	 * IMDS otherwise. Region is deliberately excluded: the metadata service returns the same
	 * credentials regardless of which region they are later used to sign for, so including it would
	 * bound nothing while multiplying cold probes and negative-cache windows.
	 *
	 * @return The cache key
	 */
	private string function credentialCacheKey(){
		var relativeUri = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "" );
		var fullUri     = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_FULL_URI", "" );

		// The key must name the source that will actually be used. An untrusted FULL_URI is never
		// contacted, so IMDS supplies the credentials — filing those under the container-full key
		// described a source that produced nothing.
		var source = "ec2-imds";
		if ( len( relativeUri ) && isValidRelativeCredentialUri( relativeUri ) ) {
			source = "container-relative:" & relativeUri;
		} else if ( !len( relativeUri ) && len( fullUri ) && isTrustedContainerCredentialUri( fullUri ) ) {
			source = "container-full:" & trim( fullUri );
		}

		// Hashed so an endpoint URI cannot inject characters into a lock name or struct key.
		return hash( lCase( source ), "MD5" );
	}

	/**
	 * Whether a cached, auto-resolved credentials struct is still usable: it carries actual key
	 * material and has more than the refresh buffer left before its reported expiry.
	 *
	 * An expiry alone is not evidence of credentials — a container endpoint answering `200 {}` would
	 * otherwise read as valid until it "expired". Credentials with no reported expiry are treated as
	 * non-cacheable rather than eternal.
	 *
	 * @cached A struct as returned by loadFromECS()/loadFromEC2Metadata() (or {})
	 *
	 * @return True if the cached credentials can still be used as-is
	 */
	public boolean function isCredentialCacheValid( required struct cached ){
		if ( arguments.cached.isEmpty() || !arguments.cached.keyExists( "expiration" ) ) {
			return false;
		}
		if ( !len( arguments.cached.awsAccessKeyId ?: "" ) || !len( arguments.cached.awsSecretAccessKey ?: "" ) ) {
			return false;
		}
		return dateDiff( "n", now(), arguments.cached.expiration ) > static.REFRESH_BUFFER_MINUTES;
	}

	/**
	 * Get AWS region from environment or default
	 *
	 * @defaultRegion Default region to use if not found in environment
	 *
	 * @return The AWS region
	 */
	public string function getRegion( string defaultRegion = "us-east-1" ){
		var region = getSystemSetting( "AWS_REGION", getSystemSetting( "AWS_DEFAULT_REGION", "" ) );
		return len( region ) ? region : arguments.defaultRegion;
	}

	/**
	 * Get the AWS profile name from environment
	 *
	 * @return The profile name (defaults to "default")
	 */
	public string function getProfileName(){
		return getSystemSetting( "AWS_PROFILE", "default" );
	}

	/**
	 * Check if running in an AWS environment (ECS/EC2)
	 *
	 * @return Boolean
	 */
	public boolean function isRunningOnAWS(){
		return len( getSystemSetting( "AWS_EXECUTION_ENV", "" ) ) > 0
			|| len( getSystemSetting( "AWS_REGION", "" ) ) > 0
			|| len( getSystemSetting( "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "" ) ) > 0;
	}

	/**
	 * Load credentials from environment variables
	 */
	private struct function loadFromEnvironment(){
		return {
			"awsAccessKeyId": getSystemSetting( "AWS_ACCESS_KEY_ID", "" ),
			"awsSecretAccessKey": getSystemSetting( "AWS_SECRET_ACCESS_KEY", "" ),
			"awsSessionToken": getSystemSetting( "AWS_SESSION_TOKEN", "" )
		};
	}

	/**
	 * Load credentials from AWS credentials file (~/.aws/credentials)
	 */
	private struct function loadFromCredentialsFile(){
		var result = { "awsAccessKeyId": "", "awsSecretAccessKey": "", "awsSessionToken": "" };

		try {
			var profileName = getProfileName();
			var credentialsFilePath = getSystemSetting( "AWS_SHARED_CREDENTIALS_FILE", "" );

			// Build list of possible credential file locations
			var possiblePaths = [];
			if ( len( credentialsFilePath ) ) {
				possiblePaths.append( credentialsFilePath );
			}

			var homeDir = getSystemSetting( "HOME", getSystemSetting( "USERPROFILE", "" ) );
			if ( len( homeDir ) ) {
				possiblePaths.append( homeDir & "/.aws/credentials" );
			}
			possiblePaths.append( "/root/.aws/credentials" );

			// Try each path
			for ( var credPath in possiblePaths ) {
				if ( fileExists( credPath ) ) {
					var parsed = parseCredentialsFile( fileRead( credPath ), profileName );
					if ( len( parsed.awsAccessKeyId ) && len( parsed.awsSecretAccessKey ) ) {
						return parsed;
					}
				}
			}
		} catch ( any e ) {
			// Credentials file not available or not readable - continue to next source
		}

		return result;
	}

	/**
	 * Parse AWS credentials file format (INI-style)
	 */
	public struct function parseCredentialsFile( required string fileContent, required string profileName ){
		var result = { "awsAccessKeyId": "", "awsSecretAccessKey": "", "awsSessionToken": "" };
		var lines = listToArray( arguments.fileContent, char( 10 ) );
		var inProfile = false;
		var profileMatch = "[#arguments.profileName#]";

		for ( var line in lines ) {
			line = trim( line );

			// Skip empty lines and comments (lines starting with # or ;)
			if ( !len( line ) || left( line, 1 ) == char( 35 ) || left( line, 1 ) == char( 59 ) ) {
				continue;
			}

			// Check if entering the desired profile section
			if ( line == profileMatch ) {
				inProfile = true;
				continue;
			}

			// Check if hit a new profile section
			if ( left( line, 1 ) == "[" && right( line, 1 ) == "]" ) {
				if ( inProfile ) {
					break; // Found all credentials for our profile
				}
				inProfile = false;
				continue;
			}

			// Parse credential lines within the correct profile
			if ( inProfile && find( "=", line ) ) {
				var eqPos = find( "=", line );
				var key = trim( left( line, eqPos - 1 ) );
				var value = trim( mid( line, eqPos + 1, len( line ) ) );

				switch( key ) {
					case "aws_access_key_id":
						result.awsAccessKeyId = value;
						break;
					case "aws_secret_access_key":
						result.awsSecretAccessKey = value;
						break;
					case "aws_session_token":
						result.awsSessionToken = value;
						break;
				}
			}
		}

		return result;
	}

	/**
	 * Load credentials from ECS container credentials endpoint
	 */
	private struct function loadFromECS(){
		var result = { "awsAccessKeyId": "", "awsSecretAccessKey": "", "awsSessionToken": "" };

		try {
			// RELATIVE_URI wins when both are set, per the AWS container credential provider spec.
			var ecsRelativeUri = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "" );
			if ( len( ecsRelativeUri ) ) {
				if ( !isValidRelativeCredentialUri( ecsRelativeUri ) ) {
					writeLog(
						text: "AwsCredentialProvider: ignoring AWS_CONTAINER_CREDENTIALS_RELATIVE_URI [#ecsRelativeUri#] — "
							& "it must be a path beginning with / and may not contain userinfo",
						type: "warning",
						log : "ai"
					);
					return result;
				}
				return fetchCredentialsFromUrl( "http://169.254.170.2" & trim( ecsRelativeUri ) );
			}

			// Check for full URI (ECS with custom endpoint, and EKS Pod Identity)
			var ecsFullUri = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_FULL_URI", "" );
			if ( len( ecsFullUri ) && isTrustedContainerCredentialUri( ecsFullUri ) ) {
				// The TRIMMED value, because that is what was validated. Fetching the raw environment
				// string meant a trailing newline passed validation, failed the HTTP call, was
				// swallowed, and silently fell through to IMDS — signing with the EC2 instance role
				// instead of the ECS task role. A privilege swap, not an error.
				return fetchCredentialsFromUrl( trim( ecsFullUri ) );
			}
		} catch ( any e ) {
			// ECS credentials not available
		}

		return result;
	}

	/**
	 * Clear the shared auto-resolved credential cache.
	 *
	 * The cache is JVM-static and deliberately outlives any instance, which makes the caching
	 * behaviour untestable without a reset seam — and untested caching is how the chr() bug in this
	 * same file survived. Also useful operationally: there is otherwise no way to force a
	 * re-resolution after a role change without restarting the runtime.
	 *
	 * @return This provider, chainable
	 */
	public function clearCredentialCache(){
		var cacheKey = credentialCacheKey();
		lock name="aws-credential-provider-#cacheKey#" type="exclusive" timeout="10" throwontimeout="true" {
			static.CREDENTIAL_CACHE.clear();
		}
		return this;
	}

	/**
	 * The cached state for the current credential source, for tests and diagnostics: whether
	 * credentials are cached, whether they are currently usable, and whether a failure is recorded.
	 * Never returns the secret itself.
	 *
	 * @return Struct { cached, usable, negativeCached }
	 */
	public struct function credentialCacheState(){
		var cacheKey = credentialCacheKey();
		var snapshot = "";
		lock name="aws-credential-provider-#cacheKey#" type="readonly" timeout="10" throwontimeout="true" {
			snapshot = duplicate( static.CREDENTIAL_CACHE[ cacheKey ] ?: { "credentials" : {}, "lastFailure" : null } );
		}
		return {
			"cached"         : len( snapshot.credentials.awsAccessKeyId ?: "" ) > 0,
			"usable"         : isCredentialUsableNow( snapshot.credentials ),
			"negativeCached" : !isNull( snapshot.lastFailure )
		};
	}

	/**
	 * Whether AWS_CONTAINER_CREDENTIALS_RELATIVE_URI is safe to concatenate onto the fixed ECS
	 * address.
	 *
	 * It must actually be a path. A value like "@evil.example/creds" would assemble into
	 * "http://169.254.170.2@evil.example/creds", whose real host is evil.example — the userinfo trick
	 * arriving through the one input that never reaches isTrustedContainerCredentialUri().
	 *
	 * @uri The configured relative URI
	 *
	 * @return True if it may be used
	 */
	public boolean function isValidRelativeCredentialUri( required string uri ){
		var normalized = trim( arguments.uri );
		return normalized.startsWith( "/" ) && !normalized.find( "@" ) && !normalized.find( "\" );
	}

	/**
	 * Extract the real host from an absolute URI, so a trust decision cannot be fooled by the
	 * authority's own syntax.
	 *
	 * A URI may carry `userinfo@` before the host, so `http://127.0.0.1:80@evil.example/creds` has a
	 * real host of `evil.example` while a naive "everything before the first colon" read returns
	 * `127.0.0.1`. And an IPv6 literal is bracketed and full of colons, so that same read turns
	 * `http://[::1]/` into `[`.
	 *
	 * @uri An absolute URI
	 *
	 * @return The lowercased host, with any userinfo, port and IPv6 brackets removed
	 */
	private string function extractUriHost( required string uri ){
		var authority = arguments.uri.reReplaceNoCase( "^[a-z][a-z0-9+.-]*://", "" );
		authority     = authority.listFirst( "/?##" );

		// Userinfo may itself contain @, so the host follows the LAST one
		if ( authority.find( "@" ) ) {
			authority = authority.listLast( "@" );
		}

		// Bracketed IPv6 literal: the host is inside the brackets, any port follows them
		if ( authority.startsWith( "[" ) ) {
			var closing = authority.find( "]" );
			return closing > 1 ? lCase( authority.mid( 2, closing - 2 ) ) : "";
		}

		return lCase( authority.listFirst( ":" ) );
	}

	/**
	 * Whether a container credential endpoint may be contacted, per the AWS SDKs' rule for
	 * AWS_CONTAINER_CREDENTIALS_FULL_URI.
	 *
	 * The request carries a bearer authorization token, so the destination cannot be arbitrary: over
	 * plain HTTP only loopback and the documented ECS/EKS link-local addresses are permitted, and any
	 * other host must use HTTPS. Without this an environment variable pointing at an attacker-chosen
	 * plain-HTTP host would be handed the token verbatim.
	 *
	 * @see https://docs.aws.amazon.com/sdkref/latest/guide/feature-container-credentials.html
	 *
	 * @uri The configured full URI
	 *
	 * @return True if the endpoint is allowed
	 */
	public boolean function isTrustedContainerCredentialUri( required string uri ){
		var normalized = trim( arguments.uri );

		// HTTPS to any host is acceptable — the token is protected in transit.
		if ( normalized.reFindNoCase( "^https://" ) ) {
			return true;
		}

		if ( normalized.reFindNoCase( "^http://" ) ) {
			var host = extractUriHost( normalized );

			// Loopback, plus the fixed ECS (169.254.170.2) and EKS Pod Identity (169.254.170.23)
			// link-local addresses, and their IPv6 equivalents.
			var trustedHosts = [ "localhost", "127.0.0.1", "::1", "169.254.170.2", "169.254.170.23", "fd00:ec2::23" ];
			if ( trustedHosts.findNoCase( host ) ) {
				return true;
			}
			// Any 127.x.x.x loopback address
			if ( host.reFind( "^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" ) ) {
				return true;
			}
		}

		writeLog(
			text: "AwsCredentialProvider: refusing to send a container credential token to untrusted endpoint "
				& "[#normalized#] — plain HTTP is allowed only for loopback and the ECS/EKS link-local "
				& "addresses; use HTTPS for any other host",
			type: "warning",
			log : "ai"
		);
		return false;
	}

	/**
	 * Resolve the container credential provider's authorization token.
	 *
	 * EKS Pod Identity supplies AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE and rotates the file's
	 * contents, so the file is re-read on every call rather than cached; ECS supplies the token
	 * inline via AWS_CONTAINER_AUTHORIZATION_TOKEN. The file variant takes precedence, matching the
	 * AWS container credential provider specification. An unreadable file falls back to the inline
	 * value instead of failing the whole chain.
	 *
	 * @see https://docs.aws.amazon.com/sdkref/latest/guide/feature-container-credentials.html
	 *
	 * @return The authorization token, or an empty string when neither variable is set
	 */
	private string function containerAuthorizationToken(){
		var tokenFile = getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE", "" );

		if ( len( tokenFile ) ) {
			// The file's contents become an Authorization header, so the path is validated before it
			// is read, per this project's path-traversal rule. AWS supplies an absolute path here.
			if ( tokenFile.find( ".." ) ) {
				writeLog(
					text: "AwsCredentialProvider: refusing AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE [#tokenFile#] — "
						& "path traversal is not accepted",
					type: "warning",
					log : "ai"
				);
				return getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN", "" );
			}
			try {
				return trim( fileRead( tokenFile ) );
			} catch ( any e ) {
				writeLog(
					text: "AwsCredentialProvider: could not read AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE [#tokenFile#]: #e.message#",
					type: "warning",
					log : "ai"
				);
			}
		}

		return getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN", "" );
	}

	/**
	 * Load credentials from EC2 instance metadata (IMDSv2)
	 */
	private struct function loadFromEC2Metadata(){
		var result = { "awsAccessKeyId": "", "awsSecretAccessKey": "", "awsSessionToken": "" };
		var metadataBase = "http://169.254.169.254";

		try {
			// Get IMDSv2 token (required for IMDSv2)
			var tokenResult = "";
			bx:http url="#metadataBase#/latest/api/token" method="PUT" timeout="2" redirect="false" result="tokenResult" {
				bx:httpparam type="header" name="X-aws-ec2-metadata-token-ttl-seconds" value="21600";
			}

			if ( val( listFirst( tokenResult.statusCode ?: "0", " " ) ) != 200 ) {
				return result;
			}

			var token = tokenResult.fileContent;

			// Get IAM role name
			var roleResult = "";
			bx:http url="#metadataBase#/latest/meta-data/iam/security-credentials/" method="GET" timeout="2" redirect="false" result="roleResult" {
				bx:httpparam type="header" name="X-aws-ec2-metadata-token" value="#token#";
			}

			if ( val( listFirst( roleResult.statusCode ?: "0", " " ) ) != 200 || !len( trim( roleResult.fileContent ?: "" ) ) ) {
				return result;
			}

			var roleName = trim( roleResult.fileContent );

			// Get credentials for the role
			var credResult = "";
			bx:http url="#metadataBase#/latest/meta-data/iam/security-credentials/#roleName#" method="GET" timeout="2" redirect="false" result="credResult" {
				bx:httpparam type="header" name="X-aws-ec2-metadata-token" value="#token#";
			}

			if ( val( listFirst( credResult.statusCode ?: "0", " " ) ) == 200 ) {
				var credData = deserializeJSON( credResult.fileContent );

				// A 200 with no key material is a failed resolution, not an empty-but-valid set.
				if ( !len( credData.AccessKeyId ?: "" ) || !len( credData.SecretAccessKey ?: "" ) ) {
					return result;
				}

				result.awsAccessKeyId     = credData.AccessKeyId;
				result.awsSecretAccessKey = credData.SecretAccessKey;
				result.awsSessionToken    = credData.Token ?: "";

				// The expiration MUST be captured or isCredentialCacheValid() can never return true
				// for an IMDS-sourced set, which made the whole cross-instance cache a no-op on EC2 —
				// every request re-paid all three IMDS round-trips. IMDS returns Expiration in this
				// same body; the synthesized fallback mirrors the container path.
				result[ "expiration" ] = len( credData.Expiration ?: "" )
					? parseDateTime( credData.Expiration )
					: dateAdd( "n", 60, now() );
			}
		} catch ( any e ) {
			// EC2 metadata not available (not running on EC2)
		}

		return result;
	}

	/**
	 * Fetch credentials from a URL endpoint (used by ECS)
	 */
	private struct function fetchCredentialsFromUrl( required string url ){
		var result = { "awsAccessKeyId": "", "awsSecretAccessKey": "", "awsSessionToken": "" };

		try {
			// The Authorization header is REQUIRED by EKS Pod Identity and by any ECS setup using
			// AWS_CONTAINER_CREDENTIALS_FULL_URI with a token. Omitting it entirely meant the
			// credential request was rejected and this step of the chain always came back empty, so
			// Pod Identity could never work here.
			var authToken  = containerAuthorizationToken();
			var httpResult = "";

			// redirect="false" matters here specifically: without it the client follows a 302 from a
			// trusted address to an arbitrary host and returns that host's body as a 200, which we
			// would accept and cache as credentials — defeating isTrustedContainerCredentialUri()
			// entirely. Verified against local listeners. AWS SDKs do not follow redirects here.
			if ( len( authToken ) ) {
				bx:http url="#arguments.url#" method="GET" timeout="5" redirect="false" result="httpResult" {
					bx:httpparam type="header" name="Authorization" value="#authToken#";
				}
			} else {
				bx:http url="#arguments.url#" method="GET" timeout="5" redirect="false" result="httpResult" {
				}
			}

			if ( val( listFirst( httpResult.statusCode ?: "0", " " ) ) == 200 ) {
				var credData = deserializeJSON( httpResult.fileContent );

				// A 200 carrying no key material is a failed resolution, not an empty-but-valid
				// credential set — leave the result empty so the chain falls through to IMDS.
				if ( !len( credData.AccessKeyId ?: "" ) || !len( credData.SecretAccessKey ?: "" ) ) {
					writeLog(
						text: "AwsCredentialProvider: container credential endpoint returned no key material; falling through",
						type: "warning",
						log : "ai"
					);
					return result;
				}

				result.awsAccessKeyId     = credData.AccessKeyId;
				result.awsSecretAccessKey = credData.SecretAccessKey;
				result.awsSessionToken    = credData.Token ?: "";

				// Parsed in its own try: a malformed Expiration would otherwise reach the outer catch
				// AFTER the keys above were set, handing back working-but-uncacheable credentials
				// with no diagnostic. Falls back to the same synthesized window as IMDS.
				try {
					result[ "expiration" ] = len( credData.Expiration ?: "" )
						? parseDateTime( credData.Expiration )
						: dateAdd( "n", 60, now() );
				} catch ( any parseError ) {
					writeLog(
						text: "AwsCredentialProvider: unparseable Expiration [#credData.Expiration ?: ''#] from the container "
							& "endpoint; using a 60-minute window instead: #parseError.message#",
						type: "warning",
						log : "ai"
					);
					result[ "expiration" ] = dateAdd( "n", 60, now() );
				}
			}
		} catch ( any e ) {
			// URL not accessible
		}

		return result;
	}

}
