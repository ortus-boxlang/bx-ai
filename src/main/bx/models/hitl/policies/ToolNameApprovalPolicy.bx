 * ----------------------------------------------------------------------------------
 * Requires approval for tool calls whose name matches a configured list.
 *
 * The original — and simplest — approval policy: `HumanInTheLoopMiddleware`'s
 * `toolsRequiringApproval` constructor argument builds one of these internally
 * when no explicit `policy` is supplied.
 */
import bxModules.bxai.models.hitl.IApprovalPolicy;

class implements="IApprovalPolicy" {

	/**
	 * Tool names that require human approval (case-insensitive)
	 */
	property name="toolNames" type="array" default=[];

	/**
	 * Constructor
	 *
	 * @toolNames Array of tool names (case-insensitive) that require approval
	 */
	function init( array toolNames = [] ) {
		variables.toolNames = arguments.toolNames
		return this;
	}

	boolean function needsApproval( required struct context ) {
		var toolName = arguments.context.toolName ?: ( arguments.context.tool?.getName() ?: "" )
		return variables.toolNames.findNoCase( toolName ) > 0
	}

}
