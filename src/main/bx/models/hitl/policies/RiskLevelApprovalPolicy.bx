 * ----------------------------------------------------------------------------------
 * Requires approval for tool calls whose declared risk level meets or exceeds a
 * configured threshold. Risk level is declared the same way `AnnotationApprovalPolicy`
 * reads its marker — a standalone annotation line directly above the tool's
 * doInvoke() method (not inside its javadoc-style comment block):
 *
 * ```
 * class extends="BaseTool" {
 *     @riskLevel( "high" )
 *     any function doInvoke( required struct args, AiChatRequest chatRequest ) {
 *         ...
 *     }
 * }
 * ```
 *
 * Tools with no `@riskLevel` annotation are treated as `defaultLevel` (default "low").
 */
import bxModules.bxai.models.hitl.IApprovalPolicy;

class implements="IApprovalPolicy" {

	/**
	 * The minimum risk level (inclusive) that requires approval
	 */
	property name="minLevel" type="string" default="high";

	/**
	 * The risk level assumed for tools with no @riskLevel annotation
	 */
	property name="defaultLevel" type="string" default="low";

	/**
	 * Ordered risk scale, lowest to highest
	 */
	static {
		LEVELS = [ "low", "medium", "high", "critical" ]
	}

	/**
	 * Constructor
	 *
	 * @minLevel      The minimum risk level (inclusive) that requires approval — one of
	 *                "low"/"medium"/"high"/"critical" (default "high")
	 * @defaultLevel  The risk level assumed for tools with no @riskLevel annotation (default "low")
	 */
	function init( string minLevel = "high", string defaultLevel = "low" ) {
		validateLevel( arguments.minLevel, "minLevel" )
		validateLevel( arguments.defaultLevel, "defaultLevel" )
		variables.minLevel     = arguments.minLevel
		variables.defaultLevel = arguments.defaultLevel
		return this;
	}

	boolean function needsApproval( required struct context ) {
		var tool = arguments.context.tool ?: javacast( "null", "" )
		if ( isNull( tool ) ) {
			return false
		}
		var declaredLevel = readRiskLevel( tool )
		return levelIndex( declaredLevel ) >= levelIndex( variables.minLevel )
	}

	/**
	 * Read the @riskLevel annotation off a tool's doInvoke() method, falling back to defaultLevel.
	 *
	 * @tool The tool instance to inspect
	 */
	private string function readRiskLevel( required any tool ) {
		var meta      = getMetadata( arguments.tool )
		var functions = meta.functions ?: []
		for ( var thisFunction in functions ) {
			if ( thisFunction.name == "doInvoke" ) {
				var annotations = thisFunction.annotations ?: {}
				if ( annotations.keyExists( "riskLevel" ) && isSimpleValue( annotations.riskLevel ) && len( trim( annotations.riskLevel ) ) ) {
					return annotations.riskLevel
				}
			}
		}
		return variables.defaultLevel
	}

	/**
	 * Resolve a risk level string to its position on the ordered scale — an unrecognized
	 * @riskLevel annotation value (author-controlled, not validated at construction time)
	 * sorts below "low" so it never accidentally requires approval by comparison against
	 * a valid minLevel.
	 *
	 * @level The risk level string to resolve
	 */
	private numeric function levelIndex( required string level ) {
		var idx = static.LEVELS.findNoCase( arguments.level )
		return idx > 0 ? idx : 0
	}

	/**
	 * Validate a constructor-supplied risk level against the known scale — throws rather
	 * than silently misbehaving (an invalid minLevel would otherwise require approval for
	 * every tool; an invalid defaultLevel could silently disable approval for unannotated
	 * ones).
	 *
	 * @level     The level string to validate
	 * @paramName The constructor argument name, for the error message
	 */
	private void function validateLevel( required string level, required string paramName ) {
		if ( static.LEVELS.findNoCase( arguments.level ) == 0 ) {
			throw(
				type   : "InvalidArgument",
				message: "RiskLevelApprovalPolicy #arguments.paramName# [#arguments.level#] is not a valid risk level. Valid levels are: [#static.LEVELS.toList()#]."
			)
		}
	}

}
