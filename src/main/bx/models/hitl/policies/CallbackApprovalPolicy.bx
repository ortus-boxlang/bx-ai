 * ----------------------------------------------------------------------------------
 * Requires approval based on a custom closure: `function( context ) => boolean`.
 *
 * The escape hatch for approval logic that doesn't fit tool name, annotation, or
 * risk level — e.g. approve only above a dollar amount found in the tool arguments,
 * or only outside business hours.
 */
import bxModules.bxai.models.hitl.IApprovalPolicy;

class implements="IApprovalPolicy" {

	/**
	 * The decision closure: function( context ) => boolean
	 */
	property name="callback";

	/**
	 * Constructor
	 *
	 * @callback function( context ) => boolean — return true if the tool call needs approval
	 */
	function init( required function callback ) {
		variables.callback = arguments.callback
		return this;
	}

	boolean function needsApproval( required struct context ) {
		return !!variables.callback( arguments.context )
	}

}
