 * ----------------------------------------------------------------------------------
 * Decides whether a pending tool call needs human approval before it executes.
 *
 * Implementations receive the same `context` struct middleware hooks already see
 * (`toolName`, `tool`, `toolCall`, `toolArgs`, `chatRequest`, ...) — see
 * `models/hitl/policies/` for the built-in policies (by tool name, by tool
 * annotation, by declared risk level, by custom callback) and
 * `CompositeApprovalPolicy` for combining several with AND/OR semantics.
 *
 * @since 4.0.0
 */
interface {

	/**
	 * Whether the pending tool call described by `context` requires human approval.
	 *
	 * @context The tool-call context (toolName, tool, toolCall, toolArgs, chatRequest, ...)
	 *
	 * @return true if a human must approve before the tool call proceeds
	 */
	boolean function needsApproval( required struct context );

}
