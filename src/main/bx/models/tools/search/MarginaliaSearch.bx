 * ----------------------------------------------------------------------------------
 * Marginalia Search provider, keyless by default.
 *
 * Uses the Marginalia Search API (https://api.marginalia.nu/<key>/search/<query>), an independent search engine of
 * the small, non-commercial web. The shared key "public" works without signing up but is rate limited for everyone
 * who uses it; a key of your own (MARGINALIA_API_KEY, or marginaliaApiKey in the settings) gets its own limit.
 * The base URL can be changed with `marginaliaBaseUrl`.
 */
class extends="BaseSearch" {

	/**
	 * The API key: "public" (shared) unless you have your own.
	 */
	property name="apiKey" type="string" default="public";

	/**
	 * The API base URL.
	 */
	property name="baseUrl" type="string" default="https://api.marginalia.nu";

	/**
	 * Configure the provider.
	 *
	 * @config Struct with marginaliaApiKey, marginaliaBaseUrl, maxResults, timeout, etc.
	 * @return This instance for fluent chaining
	 */
	function configure( required struct config ) {
		super.configure( arguments.config )
		var key = resolveApiKey( "MARGINALIA_API_KEY", "marginaliaApiKey" )
		variables.apiKey = key.isEmpty() ? "public" : key
		if ( structKeyExists( arguments.config, "marginaliaBaseUrl" ) && reFind( "^https?://", arguments.config.marginaliaBaseUrl ) ) {
			variables.baseUrl = reReplace( arguments.config.marginaliaBaseUrl, "/+$", "" )
		}
		return this
	}

	/**
	 * Search Marginalia.
	 *
	 * @query   The search query string
	 * @options Optional struct with maxResults, timeout, etc.
	 *
	 * @return  Array of result structs: [{title, url, snippet, ...}]
	 */
	function doSearch( required string query, struct options = {} ) {
		if ( !isNull( arguments.options ) ) {
			configure( arguments.options )
		}

		var searchUrl = "#variables.baseUrl#/#urlEncodedFormat( variables.apiKey )#/search/" & encodeSearchQuery( arguments.query ) & "?count=#variables.maxResults#"
		var response = executeRequest(
			url    : searchUrl,
			headers: {
				"Accept"    : "application/json",
				"User-Agent": "bx-ai web search (BoxLang; https://github.com/ortus-boxlang/bx-ai)"
			}
		)

		var statusCode = val( listFirst( response.statusCode, " " ) )
		if ( statusCode == 503 || statusCode == 429 ) {
			return [ {
				title  : "Marginalia Search Busy",
				url    : "",
				snippet: "HTTP #statusCode#: the shared Marginalia key is rate limited. Try again later, or set MARGINALIA_API_KEY to a key of your own."
			} ]
		}
		if ( statusCode >= 400 ) {
			return [ {
				title  : "Marginalia Search Error",
				url    : "",
				snippet: "HTTP #statusCode# from the Marginalia API. Response: #left( response.fileContent, 300 )#"
			} ]
		}

		return parseResults( response.fileContent, arguments.query )
	}

	/**
	 * Read the results out of a Marginalia answer: { query, results : [ { url, title, description } ] }.
	 *
	 * @json  The answer
	 * @query The query, for the messages
	 *
	 * @return Array of formatted result structs, or one result that explains why there are none
	 */
	array function parseResults( required string json, string query = "" ) {
		try {
			var data = jsonDeserialize( arguments.json )
		} catch ( any e ) {
			return [ {
				title  : "Marginalia Search Error",
				url    : "",
				snippet: "Failed to parse the Marginalia answer: #e.message#"
			} ]
		}

		var hits = isStruct( data ) ? ( data.results ?: [] ) : []
		if ( !isArray( hits ) || !hits.len() ) {
			return [ {
				title  : "No Results",
				url    : "",
				snippet: "Marginalia returned no results for: #arguments.query#"
			} ]
		}

		return formatResults(
			hits.slice( 1, min( hits.len(), variables.maxResults ) ).map( hit => {
				return { title: hit.title ?: "", url: hit.url ?: "", description: hit.description ?: "" }
			} )
		)
	}

}
