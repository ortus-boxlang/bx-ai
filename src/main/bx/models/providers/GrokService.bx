import bxModules.bxai.models.providers.capabilities.IAiChatService;
import bxModules.bxai.models.providers.capabilities.IAiImageService;
import bxModules.bxai.models.providers.capabilities.IAiSpeechService;
import bxModules.bxai.models.responses.AiImageResponse;
import bxModules.bxai.models.responses.AiSpeechResponse;

class extends="OpenAIService" implements="IAiChatService, IAiImageService, IAiSpeechService" {

	/**
	 * Static defaults
	 */
	static {
		CAPABILITIES = [ "chat", "stream", "image", "speech" ]
		DEFAULT_CHAT_PARAMS = {
			// according to the docs, this is the default model
			// https://docs.x.ai/docs/models
			"model" : "grok-4-1-fast-reasoning"
		}
		DEFAULT_IMAGE_PARAMS = {
			// https://docs.x.ai/docs/image-generation
			"model"           : "grok-2-image",
			"response_format" : "url"
		}
		DEFAULT_SPEECH_PARAMS = {
			// https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
			// Available voices: eve (default), ara, rex
			"voice_id" : "eve"
		}
	}

	/**
	 * Constructor
	 */
	function init(){
		variables.chatURL   = "https://api.x.ai/v1/chat/completions"
		variables.imageURL  = "https://api.x.ai/v1/images/generations"
		variables.speechURL = "https://api.x.ai/v1/tts"
		variables.name      = "Grok"
	}

	@override
	public array function getDeclaredCapabilities() {
		return static.CAPABILITIES
	}

	@override
	public function chat( required AiChatRequest chatRequest, numeric interactionCount = 0 ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.chat( arguments.chatRequest )
	}

	@override
	public function chatStream( required AiChatRequest chatRequest, required function callback, numeric interactionCount = 0 ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.chatStream( arguments.chatRequest, arguments.callback )
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * IAiSpeechService Implementation — xAI custom TTS endpoint
	 * https://docs.x.ai/docs/tts
	 * ---------------------------------------------------------------------------------------------------------
	 */

	/**
	 * Convert text to speech using the xAI /v1/tts endpoint.
	 * Body: { text, voice_id, language, output_format: { codec, sample_rate, bit_rate? }, speed? }
	 * Supported formats: mp3, wav, pcm, mulaw, alaw. flac and opus throw InvalidArgument.
	 * Override `language` (default "auto"), `sample_rate` and `bit_rate` through params.
	 */
	@override
	public AiSpeechResponse function speak( required AiSpeechRequest speechRequest ){
		// Capture the caller's voice BEFORE merging defaults, otherwise the default voice_id shadows it
		var explicitVoice = arguments.speechRequest.getParams().voice_id ?: ""

		arguments.speechRequest
			.mergeServiceParams( static.DEFAULT_SPEECH_PARAMS )
			.setApiKeyIfEmpty( getAPIKey() )
			.mergeServiceHeaders( variables.headers )

		var params  = arguments.speechRequest.getParams()
		var voiceId = len( explicitVoice ) ? explicitVoice : ( arguments.speechRequest.hasVoice() ? arguments.speechRequest.getVoice() : static.DEFAULT_SPEECH_PARAMS.voice_id )
		var format  = resolveOutputFormat( arguments.speechRequest.getOutputFormat(), params )

		var dataPacket = {
			"text"          : arguments.speechRequest.getText(),
			"voice_id"      : voiceId,
			// xAI requires a language. "auto" lets the service detect it.
			"language"      : params.language ?: "auto",
			"output_format" : format.output_format
		}
		if ( arguments.speechRequest.getSpeed() != 1.0 ) {
			dataPacket[ "speed" ] = arguments.speechRequest.getSpeed()
		}

		var speechURL = len( arguments.speechRequest.getBaseURL() ) ? reReplace( arguments.speechRequest.getBaseURL(), "/+$", "" ) & "/tts" : variables.speechURL

		// Logging
		if ( arguments.speechRequest.getLogRequest() ) {
			writeLog( text: "Grok aiSpeak request to #speechURL#: #jsonSerialize( dataPacket )#", type: "info", log: "ai" )
		}
		if ( arguments.speechRequest.getLogRequestToConsole() ) {
			println( "Grok aiSpeak request to #speechURL#: #jsonSerialize( dataPacket )#" )
		}

		bx: http
			url     = speechURL
			method  = "post"
			result  = "speechResult"
			charset = "utf-8"
			timeout = arguments.speechRequest.getTimeout()
		{
			bx:httpParam type="header" name="content-type" value="application/json";
			bx:httpParam type="header" name="Authorization" value="Bearer #arguments.speechRequest.getApiKey()#";

			for ( var thisHeader in arguments.speechRequest.getHeaders() ) {
				bx:httpParam type="header" name="#thisHeader#" value="#arguments.speechRequest.getHeaders()[ thisHeader ]#";
			}

			bx:httpParam type="body" value=jsonSerialize( dataPacket );
		}

		if ( speechResult.statusCode != "200" ) {
			var errorMessage = speechResult.fileContent;
			try {
				var errorData = jsonDeserialize( speechResult.fileContent );
				errorMessage  = errorData.error?.message ?: errorData.error ?: errorData.message ?: errorData.toString();
			} catch ( any parseEx ) {}

			BoxAnnounce( "onAIError", {
				error       : errorMessage,
				errorMessage: errorMessage,
				provider    : this,
				operation   : "speech",
				aiRequest   : arguments.speechRequest,
				canRetry    : false
			} );

			throw( type: "ProviderError", message: "Grok TTS error: #errorMessage#" )
		}

		return new AiSpeechResponse(
			audioData   : speechResult.fileContent,
			audioFormat : format.label,
			model       : "",
			provider    : variables.name
		);
	}

	/**
	 * xAI only streams speech over a WebSocket (wss://api.x.ai/v1/tts), which is not implemented yet.
	 * The REST endpoint returns the complete file.
	 */
	@override
	public struct function speakStream( required AiSpeechRequest speechRequest, required function callback ){
		throw(
			type   : "UnsupportedCapability",
			message: "Unsupported capability: provider [Grok] does not support streaming text-to-speech over HTTP. xAI streams speech over a WebSocket, which is not implemented. Use aiSpeak() for the complete file."
		)
	}

	/**
	 * Map the module's outputFormat keyword onto xAI's output_format object.
	 * Sample rate and bit rate can be overridden with params.sample_rate and params.bit_rate.
	 */
	private struct function resolveOutputFormat( required string outputFormat, required struct params ){
		var requested  = lCase( arguments.outputFormat.len() ? arguments.outputFormat : "mp3" )
		var sampleRate = val( arguments.params.sample_rate ?: 0 )

		if ( !listFindNoCase( "mp3,wav,pcm,mulaw,alaw", requested ) ) {
			throw(
				type   : "InvalidArgument",
				message: "Grok does not support the [#requested#] output format. Supported formats: mp3, wav, pcm, mulaw, alaw."
			)
		}

		var output = {
			"codec"       : requested,
			"sample_rate" : sampleRate > 0 ? sampleRate : ( listFindNoCase( "mulaw,alaw", requested ) ? 8000 : 24000 )
		}
		if ( requested == "mp3" ) {
			output[ "bit_rate" ] = arguments.params.bit_rate ?: 128000
		}
		return { label : requested, output_format : output }
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * IAiImageService Implementation — xAI image generation (OpenAI-compatible)
	 * https://docs.x.ai/docs/image-generation
	 * ---------------------------------------------------------------------------------------------------------
	 */

	@override
	public AiImageResponse function generateImage( required AiImageRequest imageRequest ){
		arguments.imageRequest.mergeServiceParams( static.DEFAULT_IMAGE_PARAMS )
		return sendImageRequest( arguments.imageRequest, variables.imageURL )
	}

}
