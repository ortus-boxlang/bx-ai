import bxModules.bxai.models.providers.capabilities.IAiChatService;
import bxModules.bxai.models.providers.capabilities.IAiEmbeddingsService;
import bxModules.bxai.models.providers.capabilities.IAiSpeechService;
import bxModules.bxai.models.providers.capabilities.IAiSpeechStreamService;
import bxModules.bxai.models.providers.capabilities.IAiTranscriptionService;
import bxModules.bxai.models.responses.AiSpeechResponse;
import bxModules.bxai.models.responses.AiTranscriptionResponse;
import bxModules.bxai.models.util.SpeechStreamHelper;

class extends="OpenAIService" implements="IAiChatService, IAiEmbeddingsService, IAiSpeechService, IAiSpeechStreamService, IAiTranscriptionService" {

	/**
	 * Static defaults
	 */
	static {
		CAPABILITIES = [ "chat", "stream", "embeddings", "speech", "speechStream", "transcription" ]
		DEFAULT_CHAT_PARAMS = {
			// https://docs.mistral.ai/getting-started/models/models_overview/
			// mistral-small-latest is the default model for cost-effective tasks
			"model" : "mistral-small-latest"
		}
		DEFAULT_EMBED_PARAMS = {
			// https://docs.mistral.ai/capabilities/embeddings/
			"model" : "mistral-embed"
		}
		DEFAULT_SPEECH_PARAMS = {
			// https://docs.mistral.ai/capabilities/audio/text_to_speech/speech/
			// No default voice: "Charlotte" is not a valid Mistral voice (404 invalid_voice). When the caller
			// does not choose one, the first preset voice is looked up from GET /v1/audio/voices.
			"model" : "voxtral-mini-tts-2603"
		}
		// Preset voice id per endpoint, so the lookup happens once per process
		PRESET_VOICE_CACHE = {}
		DEFAULT_TRANSCRIPTION_PARAMS = {
			// https://docs.mistral.ai/capabilities/audio/offline_transcription/
			"model" : "voxtral-mini-latest"
		}
	}

	/**
	 * Constructor
	 * https://docs.mistral.ai/api/
	 */
	function init(){
		variables.chatURL       = "https://api.mistral.ai/v1/chat/completions"
		variables.embeddingsURL = "https://api.mistral.ai/v1/embeddings"
		variables.speechURL     = "https://api.mistral.ai/v1/audio/speech"
		variables.transcribeURL = "https://api.mistral.ai/v1/audio/transcriptions"
		variables.translateURL  = "https://api.mistral.ai/v1/audio/transcriptions"
		variables.name          = "Mistral"
	}

	@override
	public array function getDeclaredCapabilities() {
		return static.CAPABILITIES
	}

	@override
	public function chat( required AiChatRequest chatRequest, numeric interactionCount = 0 ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.chat( arguments.chatRequest )
	}

	@override
	public function chatStream( required AiChatRequest chatRequest, required function callback, numeric interactionCount = 0 ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.chatStream( arguments.chatRequest, arguments.callback, arguments.interactionCount )
	}

	@override
	public function embeddings( required AiEmbeddingRequest embeddingRequest ){
		// Set default embedding model if not specified
		arguments.embeddingRequest.mergeServiceParams( static.DEFAULT_EMBED_PARAMS )
		return super.embeddings( embeddingRequest )
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * IAiSpeechService Implementation
	 * ---------------------------------------------------------------------------------------------------------
	 */

	@override
	public AiSpeechResponse function speak( required AiSpeechRequest speechRequest ){
		arguments.speechRequest.mergeServiceParams( static.DEFAULT_SPEECH_PARAMS )
		return super.speak( arguments.speechRequest )
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * IAiSpeechStreamService Implementation
	 * ---------------------------------------------------------------------------------------------------------
	 */

	/**
	 * Stream synthesized speech to a callback. Mistral streams base64 audio inside Server-Sent Events
	 * when the request carries `stream: true`.
	 *
	 * @see https://docs.mistral.ai/api/endpoint/audio/speech
	 */
	@override
	public struct function speakStream( required AiSpeechRequest speechRequest, required function callback ){
		arguments.speechRequest.mergeServiceParams( static.DEFAULT_SPEECH_PARAMS )

		var dataPacket = buildSpeechPacket( arguments.speechRequest )
		dataPacket.stream = true
		// Make the audio format explicit so the chunk label always matches the bytes
		dataPacket.response_format = dataPacket.response_format ?: "mp3"

		var url = resolveSpeechURL( arguments.speechRequest )

		BoxAnnounce( "onAISpeakRequest", {
			provider   : this,
			operation  : "speech",
			aiRequest  : arguments.speechRequest,
			dataPacket : dataPacket
		} )
		if ( arguments.speechRequest.getLogRequest() ) {
			writeLog( text: "aiSpeak stream request to #url#: #jsonSerialize( dataPacket )#", type: "info", log: "ai" )
		}

		var headers = {
			"content-type" : "application/json",
			"Authorization": "Bearer #arguments.speechRequest.getApiKey()#"
		}
		headers.append( arguments.speechRequest.getHeaders(), true )

		return SpeechStreamHelper::streamSSE(
			providerName: variables.name,
			url         : url,
			headers     : headers,
			body        : jsonSerialize( dataPacket ),
			format      : dataPacket.response_format,
			sampleRate  : 0,
			timeout     : arguments.speechRequest.getTimeout(),
			callback    : arguments.callback,
			parser      : ( event ) => parseSpeechEvent( event ),
			model       : dataPacket.model ?: ""
		)
	}

	/**
	 * Normalize one Mistral speech SSE event into stream events.
	 * Audio arrives as base64 in `audio_data`. Events whose type mentions "done" end the stream.
	 * Events with no audio payload (usage, metadata) are ignored.
	 */
	private array function parseSpeechEvent( required struct event ){
		var payload = jsonDeserialize( arguments.event.data )
		var type    = lCase( payload.type ?: arguments.event.event ?: "" )

		if ( type.contains( "error" ) ) {
			return [ { type: "error", message: payload.message ?: payload.error?.message ?: arguments.event.data } ]
		}
		if ( type.contains( "done" ) || type.contains( "completed" ) ) {
			return [ { type: "done" } ]
		}
		for ( var field in [ "audio_data", "audio", "data", "delta" ] ) {
			var value = payload[ field ] ?: ""
			if ( isSimpleValue( value ) && len( value ) ) {
				return [ { type: "audio", data: binaryDecode( value, "base64" ) } ]
			}
		}
		return []
	}

	/**
	 * Mistral's own speech defaults, so OpenAI's default voice never reaches a Mistral request.
	 */
	@override
	private struct function speechDefaults(){
		return static.DEFAULT_SPEECH_PARAMS
	}

	/**
	 * Mistral references voices by `voice_id`.
	 * - A UUID passed as the generic `voice` is mapped onto `voice_id`. Any other value is left untouched.
	 * - When no voice (and no reference audio) was requested, the first preset voice is used, looked up from
	 *   GET /v1/audio/voices. If that lookup fails the request is sent without a voice and Mistral's own
	 *   error explains what it needs.
	 */
	@override
	private struct function preRequest(
		required AiBaseRequest aiRequest,
		required struct dataPacket,
		required string operation
	){
		if (
			arguments.operation == "speech" &&
			isSimpleValue( arguments.dataPacket.voice ?: "" ) &&
			reFindNoCase( "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", arguments.dataPacket.voice ?: "" )
		) {
			arguments.dataPacket.voice_id = arguments.dataPacket.voice
			structDelete( arguments.dataPacket, "voice" )
		}

		if (
			arguments.operation == "speech" &&
			!len( arguments.dataPacket.voice_id ?: "" ) &&
			!len( arguments.dataPacket.voice ?: "" ) &&
			!len( arguments.dataPacket.ref_audio ?: "" )
		) {
			var presetId = resolveDefaultVoiceId( arguments.aiRequest )
			if ( len( presetId ) ) {
				arguments.dataPacket.voice_id = presetId
			}
		}
		return arguments.dataPacket
	}

	/**
	 * Look up the first preset voice id from Mistral and cache it per endpoint.
	 * Returns an empty string when the lookup fails, so speech is still attempted.
	 *
	 * @see https://docs.mistral.ai/api/endpoint/audio/voices
	 */
	private string function resolveDefaultVoiceId( required aiRequest ){
		var voicesURL = resolveSpeechURL( arguments.aiRequest ).replace( "/audio/speech", "/audio/voices" )
		if ( static.PRESET_VOICE_CACHE.keyExists( voicesURL ) ) {
			return static.PRESET_VOICE_CACHE[ voicesURL ]
		}
		try {
			var voiceResult = ""
			bx:http url="#voicesURL#?type=preset&limit=1" method="get" result="voiceResult" timeout=arguments.aiRequest.getTimeout(){
				bx:httpParam type="header" name="Authorization" value="Bearer #arguments.aiRequest.getApiKey()#";
			}
			if ( voiceResult.statusCode == "200" ) {
				var items = jsonDeserialize( voiceResult.fileContent ).items ?: []
				if ( items.len() && len( items[ 1 ].id ?: "" ) ) {
					static.PRESET_VOICE_CACHE[ voicesURL ] = items[ 1 ].id
					return items[ 1 ].id
				}
			}
		} catch ( any e ) {
			writeLog( text: "Mistral preset voice lookup failed: #e.message#", type: "warning", log: "ai" )
		}
		return ""
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * IAiTranscriptionService Implementation
	 * ---------------------------------------------------------------------------------------------------------
	 */

	@override
	public AiTranscriptionResponse function transcribe( required AiTranscriptionRequest transcriptionRequest ){
		arguments.transcriptionRequest.mergeServiceParams( static.DEFAULT_TRANSCRIPTION_PARAMS )
		return super.transcribe( arguments.transcriptionRequest )
	}

	/**
	 * Mistral does not have a separate translations endpoint — forward to transcribe.
	 */
	@override
	public AiTranscriptionResponse function translate( required AiTranscriptionRequest transcriptionRequest ){
		arguments.transcriptionRequest.mergeServiceParams( static.DEFAULT_TRANSCRIPTION_PARAMS )
		return super.transcribe( arguments.transcriptionRequest )
	}

}
