 * ----------------------------------------------------------------------------------
 * Capability interface for AI providers that can stream synthesized speech back as it is generated.
 * Use it to restream audio to a client (voice agents, telephony, browsers) without waiting for the full file.
 *
 * The callback receives a struct per event, discriminated by `type`:
 *
 * - `{ type: "audio", data: binary, format: string, sampleRate: numeric, sequence: numeric }`
 * - `{ type: "timestamps", words: array, start: array, end: array }` (providers that support it)
 * - `{ type: "done", chunks: numeric, bytes: numeric }` (always the last event)
 *
 * Returning an explicit `false` from the callback stops the stream early (e.g. caller barge-in).
 */
import bxModules.bxai.models.providers.IAiService;

interface extends="IAiService" {

	/**
	 * Convert text to speech and stream the audio to a callback as it is generated.
	 *
	 * @speechRequest The speech request containing the input text and audio parameters
	 * @callback      Function invoked with each stream event struct
	 *
	 * @return Summary struct: { provider, model, audioFormat, sampleRate, chunks, bytes, completed }
	 */
	struct function speakStream( required AiSpeechRequest speechRequest, required function callback )

}
