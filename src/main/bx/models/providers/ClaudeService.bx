import bxModules.bxai.models.providers.capabilities.IAiChatService;
import bxModules.bxai.models.util.SchemaBuilder;
import bxModules.bxai.models.middleware.AiMiddlewareResult;

class extends="BaseService" implements="IAiChatService" {

	/**
	 * Static defaults
	 */
	static {
		CAPABILITIES = [ "chat", "stream" ]
		DEFAULT_CHAT_PARAMS = {
			// according to the docs, this is the default model and tokens
			// https://docs.anthropic.com/en/docs/about-claude/models/overview#model-aliases
			"model" : "claude-sonnet-4-5",
			"max_tokens": 1024
		};
		DEFAULT_HEADERS = {
			// https://docs.anthropic.com/en/api/versioning
			"anthropic-version" : "2023-06-01"
		};
		// Synthetic tool name used to force Claude into structured-output mode
		STRUCTURED_OUTPUT_TOOL = "structured_output";
	}

	/**
	 * Constructor
	 */
	function init(){
		variables.chatURL = "https://api.anthropic.com/v1/messages"
		variables.name = "Claude"
		// https://docs.anthropic.com/en/docs/agents-and-tools/tool-use/overview
		addHeader( name: "anthropic-version", value: static.DEFAULT_HEADERS[ "anthropic-version" ] )
	}

	@override
	public array function getDeclaredCapabilities() {
		return static.CAPABILITIES
	}

	/**
	 * Invoke a request to the provider
	 *
	 * @chatRequest The AI request to send to the provider
	 *
	 * @return The response from the provider according to the return format in the AI request
	 */
	function invoke( required AiChatRequest chatRequest ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.invoke( arguments.chatRequest )
	}

	/**
	 * Invoke a request to the provider in streaming mode
	 *
	 * @chatRequest The Chat request to send to the provider
	 * @callback A callback function to be called with each chunk of the stream: function( chunk )
	 *
	 * @return void
	 */
	function invokeStream( required AiChatRequest chatRequest, required function callback ){
		// Seed the chat request with defaults
		arguments.chatRequest.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
		return super.invokeStream( arguments.chatRequest, arguments.callback )
	}

	/**
	 * Claude streaming chat request - overridden to use Claude-specific authentication
	 *
	 * @chatRequest The AiChatRequest object to send to the provider
	 * @callback A callback function to be called with each chunk of the stream
	 */
	@override
	public function chatStream( required AiChatRequest chatRequest, required function callback, numeric interactionCount = 0 ){
		// Apply service-level defaults so model is always set
		arguments.chatRequest
			.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
			.setModelIfEmpty( variables.params.model ?: "" )
			.setApiKeyIfEmpty( getAPIKey() )
			.mergeServiceParams( variables.params )
			.mergeServiceHeaders( variables.headers );

		var userCallback = arguments.callback;
		var thisChatRequest = arguments.chatRequest;

		var allMessages = arguments.chatRequest.getMessages();
		var apiMessages = allMessages.filter( m => ( m.role ?: "" ) != "system" );
		var systemMessages = allMessages
			.filter( m => ( m.role ?: "" ) == "system" )
			.map( m => toString( m.content ?: "" ) )
			.filter( msg => msg.len() );
		var systemPrompt = systemMessages.toList( char( 10 ) & char( 10 ) );

		var dataPacket = {
			"model"   : arguments.chatRequest.getModel(),
			"messages": apiMessages,
			"stream"  : true
		}.append( arguments.chatRequest.getParams() );

		if( systemPrompt.len() ){
			dataPacket[ "system" ] = systemPrompt;
		}

		if( arguments.chatRequest.getParams()?.tools?.len() ) {
			dataPacket[ "tools" ] = formatToolsForClaude( arguments.chatRequest.getParams().tools );
		}

		BoxAnnounce(
			"onAIChatRequest",
			{
				"dataPacket" : dataPacket,
				"chatRequest": arguments.chatRequest,
				"provider"   : this
			}
		);

		if( arguments.chatRequest.getLogRequestToConsole() ){
			println( "AI Request (Stream)" );
			println( dataPacket );
		}

		var streamState = {
			"messageId": "",
			"model": arguments.chatRequest.getModel(),
			"content": "",
			"toolCalls": [],
			"toolInputBuffers": {},
			"toolCallIndexMap": {},
			"stopReason": "",
			"emittedAnyText": false,
			"usage": { "input_tokens": 0, "output_tokens": 0 }
		};

		// -------------------------------------------------------------------------------------------
		// --- Fire beforeLLMCall middleware (streaming) ---
		// -------------------------------------------------------------------------------------------
		var streamLlmBefore = arguments.chatRequest.fireMiddleware( "beforeLLMCall", { chatRequest: arguments.chatRequest, dataPacket: dataPacket } );
		if( streamLlmBefore.isTerminal() ){
			arguments.callback( { type: "middleware_stop", result: streamLlmBefore } )
			return
		}

		var httpRequest = http( getChatURL() )
			.method( "POST" )
			.charset( "utf-8" )
			.timeout( arguments.chatRequest.getTimeout() )
			.header( "content-type", "application/json" )
			.header( "x-api-key", arguments.chatRequest.getApiKey() )
			.header( "anthropic-version", getHeaders()[ "anthropic-version" ] )
			.sse( true );

		for( var thisHeader in arguments.chatRequest.getHeaders() ){
			httpRequest.header( thisHeader, arguments.chatRequest.getHeaders()[ thisHeader ] );
		}

		httpRequest
			.body( jsonSerialize( dataPacket ) )
			.onChunk( ( chunk, lastEventId, httpResult, httpClient, response ) => {
				if( chunk.data == "[DONE]" || chunk?.data?.trim()?.isEmpty() ){
					return;
				}

				try {
					var parsedChunk = jsonDeserialize( chunk.data );

					if( parsedChunk.type == "message_start" ){
						streamState.model = parsedChunk.message?.model ?: streamState.model;
						streamState.messageId = parsedChunk.message?.id ?: streamState.messageId;
						if( !isNull( parsedChunk.message?.usage ) ){
							streamState.usage.input_tokens = parsedChunk.message.usage.input_tokens ?: 0;
						}
						return;
					}

					if( parsedChunk.type == "content_block_start" && parsedChunk.content_block?.type == "tool_use" ){
						var contentBlockIndex = parsedChunk.index ?: 0;
						var newToolCall = {
							"type": "tool_use",
							"id": parsedChunk.content_block.id ?: "",
							"name": parsedChunk.content_block.name ?: "",
							"input": parsedChunk.content_block.input ?: {},
							"contentIndex": contentBlockIndex
						};

						streamState.toolCalls.append( newToolCall );
						streamState.toolCallIndexMap[ toString( contentBlockIndex ) ] = streamState.toolCalls.len();
						streamState.toolInputBuffers[ toString( contentBlockIndex ) ] = "";
						return;
					}

					if( parsedChunk.type == "content_block_delta" && parsedChunk.delta?.type == "input_json_delta" ){
						var bufferKey = toString( parsedChunk.index ?: 0 );
						if( !streamState.toolInputBuffers.keyExists( bufferKey ) ){
							streamState.toolInputBuffers[ bufferKey ] = "";
						}
						streamState.toolInputBuffers[ bufferKey ] &= parsedChunk.delta.partial_json ?: "";
						return;
					}

					if( parsedChunk.type == "content_block_delta" && parsedChunk.delta?.type == "text_delta" ){
						var textChunk = parsedChunk.delta.text ?: "";
						streamState.emittedAnyText = streamState.emittedAnyText || textChunk.len();
						streamState.content &= textChunk;

						userCallback({
							"id": streamState.messageId,
							"provider": "Claude",
							"model": streamState.model,
							"object": "chat.completion.chunk",
							"choices": [
								{
									"index": 0,
									"delta": {
										"role": "assistant",
										"content": textChunk
									}
								}
							]
						});
						return;
					}

					if( parsedChunk.type == "message_delta" ){
						streamState.stopReason = parsedChunk.delta?.stop_reason ?: streamState.stopReason;
						if( !isNull( parsedChunk.usage ) ){
							streamState.usage.output_tokens = parsedChunk.usage.output_tokens ?: 0;
						}
						return;
					}
				} catch( any e ){
					writeLog(
						text: "Error parsing stream chunk: #e.message# - Data: #chunk.data#",
						type: "error",
						log : "ai"
					)
				}
			} )
			.onError( ( error, httpResult ) => {
				var errorMessage = "HTTP Error: #error.message#";

				writeLog(
					text: "Stream Request Error: #errorMessage#",
					type: "error",
					log : "ai"
				)

				BoxAnnounce( "onAIError", {
					error: error,
					errorMessage: errorMessage,
					provider: this,
					operation: "stream",
					aiRequest: thisChatRequest,
					canRetry: true
				} );

				throw(
					type   : "ProviderError",
					message: errorMessage
				);
			} )
			.onComplete( ( httpResult ) => {
				if( thisChatRequest.getLogResponse() ){
					writeLog(
						text: "Stream completed successfully",
						type: "info",
						log : "ai"
					)
				}

				BoxAnnounce(
					"onAIChatResponse",
					{
						"chatRequest" : thisChatRequest,
						"provider"    : this,
						"streamComplete" : true
					}
				);
			} )
			.send();

		// -------------------------------------------------------------------------------------------
		// --- Usage Event Announcement (Streaming) ---
		// -------------------------------------------------------------------------------------------
		var claudeStreamTotalTokens = streamState.usage.input_tokens + streamState.usage.output_tokens;
		if( claudeStreamTotalTokens > 0 ){
			BoxAnnounce( "onAITokenCount", {
				provider         : this,
				operation        : "stream",
				model            : arguments.chatRequest.getModel(),
				promptTokens     : streamState.usage.input_tokens,
				completionTokens : streamState.usage.output_tokens,
				totalTokens      : claudeStreamTotalTokens,
				aiRequest        : arguments.chatRequest,
				usage            : streamState.usage,
				timestamp        : now()
			} )
		}

		if( streamState.stopReason == "tool_use" && streamState.toolCalls.len() ){
			var runtimeChatRequest = arguments.chatRequest;

			streamState.toolCalls.each( toolCall => {
				var bufferKey = toString( toolCall.contentIndex ?: 0 );
				var inputBuffer = streamState.toolInputBuffers[ bufferKey ] ?: "";
				if( inputBuffer.len() ){
					try {
						toolCall.input = jsonDeserialize( inputBuffer );
					} catch( any e ){}
				}
			} );

			var sanitizedToolCalls = streamState.toolCalls
				.filter( toolCall => ( toolCall.name ?: "" ).len() && ( toolCall.id ?: "" ).len() )
				.map( toolCall => {
					return {
						"type" : "tool_use",
						"id"   : toolCall.id,
						"name" : toolCall.name,
						"input": toolCall.input ?: {}
					};
				} );

			if( !sanitizedToolCalls.len() ){
				var fallbackFromToolUse = chat( runtimeChatRequest );
				var fallbackToolText = isSimpleValue( fallbackFromToolUse ) ? toString( fallbackFromToolUse ) : "";
				if( fallbackToolText.len() ){
					userCallback({
						"id": streamState.messageId,
						"provider": "Claude",
						"model": streamState.model,
						"object": "chat.completion.chunk",
						"choices": [
							{
								"index": 0,
								"delta": {
									"role": "assistant",
									"content": fallbackToolText
								}
							}
						]
					});
				}
				return;
			}

			runtimeChatRequest.getMessages().append({
				"role"    : "assistant",
				"content" : sanitizedToolCalls
			});

			// A terminal middleware result (suspend/cancel/reject) stops the tool chain immediately
			// instead of invoking the remaining tool calls in the batch
			var claudeStreamTerminalResult = "";
			for( var toolCall in sanitizedToolCalls ) {
				var toolExecResult = executeClaudeTool( toolCall, runtimeChatRequest );
				if ( isObject( toolExecResult ) ) {
					claudeStreamTerminalResult = toolExecResult
					break
				}
			}

			if ( isObject( claudeStreamTerminalResult ) ) {
				userCallback( { type: "middleware_stop", result: claudeStreamTerminalResult } )
				return
			}

			var finalResponse = chat( runtimeChatRequest );
			var finalText = isSimpleValue( finalResponse ) ? toString( finalResponse ) : "";

			if( finalText.len() ){
				userCallback({
					"id": streamState.messageId,
					"provider": "Claude",
					"model": streamState.model,
					"object": "chat.completion.chunk",
					"choices": [
						{
							"index": 0,
							"delta": {
								"role": "assistant",
								"content": finalText
							}
						}
					]
				});
			}
		}

		if( !streamState.emittedAnyText && streamState.stopReason != "tool_use" ){
			var fallbackResponse = chat( arguments.chatRequest );
			var fallbackText = isSimpleValue( fallbackResponse ) ? toString( fallbackResponse ) : "";
			if( fallbackText.len() ){
				userCallback({
					"id": streamState.messageId,
					"provider": "Claude",
					"model": streamState.model,
					"object": "chat.completion.chunk",
					"choices": [
						{
							"index": 0,
							"delta": {
								"role": "assistant",
								"content": fallbackText
							}
						}
					]
				});
			}
		}

		// -------------------------------------------------------------------------------------------
		// --- Fire afterLLMCall middleware (streaming), in reverse order ---
		// -------------------------------------------------------------------------------------------
		// Only fire on the pure-text path. The tool_use and no-text-fallback branches above call
		// chat(), which already fires afterLLMCall — firing again here would double-fire.
		if( streamState.emittedAnyText && streamState.stopReason != "tool_use" ){
			arguments.chatRequest.fireMiddleware(
				hook   : "afterLLMCall",
				context: { chatRequest: arguments.chatRequest, streamState: { "content": streamState.content, "finishReason": streamState.stopReason, "toolCalls": streamState.toolCalls, "usage": streamState.usage } },
				reverse: true
			)
		}
	}

	/**
	 * Claude chat request
	 * Customized for Claude
	 * https://docs.anthropic.com/en/api/messages-examples
	 *
	 * @chatRequest The AIChatRequest object to send to the provider
	 * @interactionCount Current tool call interaction count (used internally)
	 *
	 * @throws ProviderError if the provider returns an error from the request
	 * @throws MaxInteractionsExceeded if tool calls exceed the maximum allowed interactions
	 */
	@override
	public function chat( required AiChatRequest chatRequest, numeric interactionCount = 0 ){
		// Apply service-level defaults so model is always set
		arguments.chatRequest
			.mergeServiceParams( static.DEFAULT_CHAT_PARAMS )
			.setModelIfEmpty( variables.params.model ?: "" )
			.setApiKeyIfEmpty( getAPIKey() )
			.mergeServiceParams( variables.params )
			.mergeServiceHeaders( variables.headers );

		// -------------------------------------------------------------------------------------------
		// --- Resume short-circuit ---
		// A batch tool-call suspension (see afterToolBatch()) was resolved via AiAgent.resume()
		// with a finalized resume ledger — finish that same tool batch directly instead of
		// calling the LLM again (no replay, nothing that already ran re-runs).
		// -------------------------------------------------------------------------------------------
		var resumeCtx = arguments.chatRequest.getResumeContext() ?: {}
		if ( !resumeCtx.isEmpty() && resumeCtx.keyExists( "assistantMessage" ) ) {
			return resumeToolBatch( arguments.chatRequest, resumeCtx, arguments.interactionCount )
		}

		// No auth header, claude uses x-api-key
		arguments.chatRequest
			.setSendAuthHeader( false )
			.addHeader( "x-api-key", arguments.chatRequest.getApiKey() )
			.addHeader( "anthropic-version", getHeaders()[ "anthropic-version" ] )

		// Build the packet according to Claude's API requirements
		// https://docs.anthropic.com/en/api/messages#body-messages
		var allMessages = arguments.chatRequest.getMessages();
		var apiMessages = allMessages.filter( m => ( m.role ?: "" ) != "system" );
		var systemMessages = allMessages
			.filter( m => ( m.role ?: "" ) == "system" )
			.map( m => toString( m.content ?: "" ) )
			.filter( msg => msg.len() );
		var systemPrompt = systemMessages.toList( char( 10 ) & char( 10 ) );

		var dataPacket = {
			"model"   : arguments.chatRequest.getModel(),
			"messages": apiMessages
		}.append( arguments.chatRequest.getParams() );

		if( systemPrompt.len() ){
			dataPacket[ "system" ] = systemPrompt;
		}

		// Add tool support if tools are present
		if( arguments.chatRequest.getParams()?.tools?.len() ) {
			dataPacket[ "tools" ] = formatToolsForClaude( arguments.chatRequest.getParams().tools )
		}

		// -------------------------------------------------------------------------------------------
		// --- Structured output via forced tool-use ---
		// The Anthropic Messages API has no response_format; the robust pattern is to expose the
		// requested schema as a tool's input_schema and force the model to call it, then read
		// tool_use.input. https://docs.anthropic.com/en/docs/build-with-claude/tool-use
		// -------------------------------------------------------------------------------------------
		var usingStructuredOutput = arguments.chatRequest.isStructuredOutput();
		if( usingStructuredOutput ){
			injectStructuredOutputTool( dataPacket, arguments.chatRequest );
		}

		// -------------------------------------------------------------------------------------------
		// --- Fire beforeLLMCall middleware ---
		// -------------------------------------------------------------------------------------------
		var llmContext = { chatRequest: arguments.chatRequest, dataPacket: dataPacket }
		var llmBeforeResult = arguments.chatRequest.fireMiddleware( hook: "beforeLLMCall", context: llmContext )
		if ( llmBeforeResult.isTerminal() ) {
			return llmBeforeResult
		}

		// -------------------------------------------------------------------------------------------
		// --- Fire WrapLLM -> HTTP Call ---
		// -------------------------------------------------------------------------------------------
		var capturedDataPacket  = dataPacket;
		var capturedChatRequest = arguments.chatRequest;
		var result = arguments.chatRequest.fireWrapMiddleware(
			hook         : "wrapLLMCall",
			context      : llmContext,
			innerFunction: () => sendChatRequest( capturedChatRequest, capturedDataPacket )
		)

		// -------------------------------------------------------------------------------------------
		// --- Fire afterLLMCall middleware, in reverse order ---
		// -------------------------------------------------------------------------------------------
		arguments.chatRequest.fireMiddleware(
			hook   : "afterLLMCall",
			context: { chatRequest: arguments.chatRequest, result: result },
			reverse: true
		)

		// If an error is returned, throw it
		if( result.keyExists( "error" ) ){
			writeLog(
				text: result.error.toString(),
				type: "error",
				log : "ai"
			)
			throw(
				type   : "ProviderError",
				message: result.error.toString()
			);
		}
		// Announce token usage
		if ( result.keyExists( "usage" ) ) {
			BoxAnnounce( "onAITokenCount", {
				provider         : this,
				operation        : "chat",
				model            : arguments.chatRequest.getModel(),
				promptTokens     : result.usage.input_tokens ?: 0,
				completionTokens : result.usage.output_tokens ?: 0,
				totalTokens      : ( result.usage.input_tokens ?: 0 ) + ( result.usage.output_tokens ?: 0 ),
				aiRequest        : arguments.chatRequest,
				usage            : result.usage,
				timestamp        : now()
			} )
		}
		// Structured output: the forced synthetic tool's input IS the result. Authoritative path —
		// if the block is absent (truncated at max_tokens, a refusal, or tool_choice not honored)
		// we fail loudly instead of feeding prose to the JSON populator.
		if( usingStructuredOutput ){
			// Local copy: lambdas don't capture the class `static` scope.
			var toolName         = static.STRUCTURED_OUTPUT_TOOL;
			var structuredBlocks = ( result.keyExists( "content" ) && isArray( result.content ) )
				? result.content.filter( b => ( b?.type ?: "" ) == "tool_use" && ( b?.name ?: "" ) == toolName )
				: [];
			if( structuredBlocks.len() ){
				return populateStructuredOutput( jsonSerialize( structuredBlocks.first().input ?: {} ), arguments.chatRequest );
			}
			var stopReason = result.stop_reason ?: "unknown";
			writeLog(
				text: "Structured output requested but no '#toolName#' tool_use block returned (model=#arguments.chatRequest.getModel()#, stop_reason=#stopReason#)",
				type: "error",
				log : "ai"
			)
			throw(
				type   : "StructuredOutputError",
				message: "Model did not return the forced structured_output tool (stop_reason=#stopReason#)."
					& ( stopReason == "max_tokens" ? " Response was truncated — increase max_tokens." : "" )
			);
		}

		// Handle tool use responses
		// Check if Claude wants to use tools
		var usingTools = false
		for( var contentBlock in result.content ) {
			if( contentBlock?.type == "tool_use" ) {
				usingTools = true;
				break;
			}
		}

		// If Claude wants to use tools, we need to handle that
		if( usingTools ){
			/**
			 * ---------------------------------------------------------------------------------------------------------
			 * Max Interactions Check
			 * ---------------------------------------------------------------------------------------------------------
			 */
			var maxAllowed = arguments.chatRequest.getMaxInteractions() > 0 ? arguments.chatRequest.getMaxInteractions() : variables.maxInteractions;
			if( arguments.interactionCount >= maxAllowed ){
				writeLog(
					text: "Max tool call interactions (#maxAllowed#) exceeded",
					type: "error",
					log : "ai"
				)
				throw(
					type   : "MaxInteractionsExceeded",
					message: "Tool calls exceeded maximum allowed interactions (#maxAllowed#). This may indicate an infinite loop."
				);
			}

			var toolCalls = result.content.filter( contentBlock -> contentBlock?.type == "tool_use" );

			// Add the role assistant message with tool calls
			var assistantMessage = { "role": "assistant", "content": result.content }
			var thisChatRequest = arguments.chatRequest
			var messages = thisChatRequest.getMessages()
			messages.append( assistantMessage )

			// ── Pass 1: decide ────────────────────────────────────────────────────────────────
			// Fire beforeToolCall for EVERY tool call in this turn before invoking any of them —
			// see OpenAIService.chat() for the full rationale (this mirrors it exactly).
			var batch = []
			var terminalToolResult = ""

			for( var toolCall in toolCalls ) {
				var toolAttempt = thisChatRequest.getTool( toolCall.name )
				if ( !toolAttempt.isPresent() ) {
					writeLog(
						text: "Unable to find tool named: [#toolCall.name#]",
						type: "warning",
						log : "ai"
					)
					batch.append( {
						tool    : javacast( "null", "" ),
						toolCall: toolCall,
						toolName: toolCall.name,
						toolArgs: {},
						result  : AiMiddlewareResult.reject( "Tool ['#toolCall.name#'] not found in chat request" )
					} )
					continue
				}

				var tool = toolAttempt.get()
				var toolContext = {
					tool       : tool,
					toolCall   : toolCall,
					chatRequest: thisChatRequest,
					toolName   : toolCall.name ?: tool.getName(),
					toolArgs   : toolCall.input ?: {}
				}
				var toolBeforeResult = thisChatRequest.fireMiddleware( "beforeToolCall", toolContext )

				if ( toolBeforeResult.isCancelled() ) {
					messages.append({
						"role" : "user",
						"content" : [{
							"type"        : "tool_result",
							"tool_use_id" : toolCall.id,
							"content"     : "[Tool call blocked: #toolBeforeResult.getReason()#]"
						}]
					});
					terminalToolResult = toolBeforeResult
					break
				}

				batch.append( { tool: tool, toolCall: toolCall, toolName: toolContext.toolName, toolArgs: toolContext.toolArgs, result: toolBeforeResult } )
			}

			if ( isObject( terminalToolResult ) ) {
				return terminalToolResult
			}

			// ── Suspend the whole batch at once, if anything needs a human decision ────────────
			if ( batch.some( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() ) ) {
				var batchResult = thisChatRequest.fireMiddleware(
					"afterToolBatch",
					{ chatRequest: thisChatRequest, assistantMessage: assistantMessage, batch: batch }
				)

				// No attached middleware's afterToolBatch() converted the pending entries into
				// anything (the default is continue()) — e.g. a custom middleware suspended a
				// tool call directly from beforeToolCall() without participating in the
				// defer()/afterToolBatch() protocol at all. Fall back to a generic combined
				// suspend so a tool call ANY middleware said needs a decision is never silently
				// executed.
				if ( !batchResult.isSuspended() && !batchResult.isCancelled() ) {
					var pending = batch.filter( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() )
					var pendingActions = pending.map( ( entry ) => {
						var data = entry.result.getData()
						return {
							toolName    : entry.toolName,
							toolArgs    : ( isStruct( entry.toolArgs ) ) ? entry.toolArgs : {},
							suspensionID: data.suspensionID ?: ""
						}
					} )
					batchResult = AiMiddlewareResult.suspend( { pendingActions: pendingActions } )
				}

				if ( batchResult.isTerminal() ) {
					if ( !batchResult.isSuspended() ) {
						return batchResult
					}
					var resumeLedger = batch.map( ( entry ) => {
						if ( entry.result.isDeferred() || entry.result.isSuspended() ) {
							return { toolName: entry.toolName, status: "pending" }
						}
						if ( entry.result.isRejected() ) {
							return { toolName: entry.toolName, status: "blocked", reason: entry.result.getReason() }
						}
						return { toolName: entry.toolName, status: "execute" }
					} )
					var mergedData = duplicate( batchResult.getData() )
					mergedData[ "assistantMessage" ] = assistantMessage
					mergedData[ "resumeLedger" ]     = resumeLedger
					return AiMiddlewareResult.suspend( mergedData )
				}
			}

			// ── Pass 2: execute ─────────────────────────────────────────────────────────────────
			for ( var entry in batch ) {
				if ( entry.result.isRejected() ) {
					messages.append({
						"role" : "user",
						"content" : [{
							"type"        : "tool_result",
							"tool_use_id" : entry.toolCall.id,
							"content"     : "[Tool call blocked: #entry.result.getReason()#]"
						}]
					});
					continue
				}

				var capturedTool     = entry.tool
				var capturedToolCall = entry.toolCall
				var toolResult = thisChatRequest.fireWrapMiddleware(
					"wrapToolCall",
					{ tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, toolName: entry.toolName, toolArgs: entry.toolCall.input ?: {} },
					() => capturedTool.invoke( args: capturedToolCall.input, chatRequest: thisChatRequest )
				);

				thisChatRequest.fireMiddleware(
					hook   : "afterToolCall",
					context: { tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, result: toolResult },
					reverse: true
				);

				messages.append({
					"role" : "user",
					"content" : [{
						"type"        : "tool_result",
						"tool_use_id" : entry.toolCall.id,
						"content"     : toolResult
					}]
				});
			}

			// Recursively call chat with the updated chat request and incremented interaction count
			return chat( thisChatRequest, arguments.interactionCount + 1 );
		}

		// Determine return formats
		var content = result.content.first().text
		switch( arguments.chatRequest.getReturnFormat() ){
			case "all":
				return result.content;
			case "raw":
				return result;
			case "json":
				return JSONDeserialize( extractFromCodeBlock( content, "json" ) );
			case "xml" :
				return xmlParse( extractFromCodeBlock( content, "xml" ) );
			case  "structuredOutput":
				return populateStructuredOutput( content, arguments.chatRequest );
			case "single": default:
				return content;
		}
	}

	/**
	 * Inject a forced structured-output tool into the Claude request packet.
	 *
	 * Exposes the request's structured-output schema as the synthetic tool's input_schema
	 * and pins tool_choice to it, so Claude is guaranteed to return a single tool_use block
	 * whose input conforms to the schema. Any real tools are left in place but will not be
	 * called while tool_choice is forced.
	 *
	 * @dataPacket  The Claude request packet (mutated in place)
	 * @chatRequest The request carrying the structured-output schema
	 */
	private void function injectStructuredOutputTool( required struct dataPacket, required AiChatRequest chatRequest ){
		var cleanSchema = SchemaBuilder::cleanSchema( arguments.chatRequest.getStructuredOutput() );

		if( !arguments.dataPacket.keyExists( "tools" ) ){
			arguments.dataPacket[ "tools" ] = [];
		}
		arguments.dataPacket.tools.append( {
			"name"        : static.STRUCTURED_OUTPUT_TOOL,
			"description" : "Record the response as structured data that conforms to the required JSON schema.",
			"input_schema": cleanSchema
		} );

		arguments.dataPacket[ "tool_choice" ] = {
			"type" : "tool",
			"name" : static.STRUCTURED_OUTPUT_TOOL
		};
	}

	/**
	 * Format tools for Claude's specific tool format
	 * @see https://docs.anthropic.com/en/api/messages#body-tools
	 *
	 * @tools The tools to format
	 *
	 * @return An array of tools formatted for Claude
	 */
	private array function formatToolsForClaude( required array tools ) {
		var claudeTools = []

		for( var tool in arguments.tools ) {
			var argumentsSchema = tool.getArgumentsSchema();
			var claudeTool = {
				"name": tool.getName(),
				"description": tool.getDescription(),
				"input_schema": {
					"type": "object",
					"properties": argumentsSchema.properties,
					"required": argumentsSchema.required
				}
			}
			claudeTools.append( claudeTool )
		}

		return claudeTools
	}

	/**
	 * Execute a Claude tool call, firing the beforeToolCall / wrapToolCall / afterToolCall
	 * middleware hooks around the invocation so approval/suspension middleware (e.g. HITL)
	 * behaves consistently with the other providers.
	 *
	 * @toolCall The tool call object from Claude: { type:"tool_use", id: "", name: "toolName", input: {} }
	 * @chatRequest The original chat request containing the tool
	 *
	 * @return An AiMiddlewareResult if the tool call was suspended or cancelled by middleware —
	 *         the caller must hard-stop the batch and surface it. Null (void) otherwise, meaning
	 *         either the tool executed normally or was rejected (rejection is absorbed here: the
	 *         reason is appended as the tool result and the caller should continue the batch).
	 */
	private any function executeClaudeTool( required struct toolCall, required AiChatRequest chatRequest ) {
		var messages = arguments.chatRequest.getMessages();

		// Get the tool from the chat request
		var toolAttempt = arguments.chatRequest.getTool( toolCall.name );

		if( !toolAttempt.isPresent() ){
			writeLog(
				text: "Unable to find tool named: [#toolCall.name#]",
				type: "warning",
				log : "ai"
			)
			messages.append({
				"role" : "user",
				"content" : [{
					"type"        : "tool_result",
					"tool_use_id" : toolCall.id,
					"content"     : "Tool ['#toolCall.name#'] not found in chat request"
				}]
			});
			return;
		}

		var tool = toolAttempt.get();

		// -------------------------------------------------------------------------------------------
		// --- Fire Tool Middleware ---
		// -------------------------------------------------------------------------------------------
		var toolContext = {
			tool       : tool,
			toolCall   : toolCall,
			chatRequest: arguments.chatRequest,
			// Normalized keys so shape-agnostic middleware (GuardrailMiddleware argPatterns,
			// FlightRecorderMiddleware, etc.) can inspect the real arguments — Claude's toolCall
			// carries them in `.input` (already a struct), not OpenAI's `.function.arguments`.
			toolName   : toolCall.name ?: tool.getName(),
			toolArgs   : toolCall.input ?: {}
		}
		var toolBeforeResult = arguments.chatRequest.fireMiddleware( "beforeToolCall", toolContext )

		// executeClaudeTool() is only used by chatStream() now (see chat()'s own batched pass-1/
		// pass-2 handling) — streaming doesn't batch tool-call approvals, so a "defer" here (mode
		// "web") means exactly what a "suspend" always meant for a single tool call.
		if ( toolBeforeResult.isDeferred() ) {
			toolBeforeResult = AiMiddlewareResult.suspend( toolBeforeResult.getData() )
		}

		// Suspend/Cancel: hard-stop so the caller can break the batch and surface the terminal
		// result. Suspend needs a human to resume it externally; cancel (e.g.
		// MaxToolCallsMiddleware's limit, or a human choosing to quit in HITL's CLI mode) means
		// abort the run outright — neither should let the batch continue.
		if ( toolBeforeResult.isSuspended() || toolBeforeResult.isCancelled() ) {
			messages.append({
				"role" : "user",
				"content" : [{
					"type"        : "tool_result",
					"tool_use_id" : toolCall.id,
					"content"     : toolBeforeResult.isSuspended()
						? "[Suspended: awaiting human approval]"
						: "[Tool call blocked: #toolBeforeResult.getReason()#]"
				}]
			});
			return toolBeforeResult
		}

		// Reject: skip only this tool call — append the reason as its tool result and let the
		// caller continue processing the rest of the batch/chain instead of surfacing a raw
		// middleware result.
		if ( toolBeforeResult.isRejected() ) {
			messages.append({
				"role" : "user",
				"content" : [{
					"type"        : "tool_result",
					"tool_use_id" : toolCall.id,
					"content"     : "[Tool call blocked: #toolBeforeResult.getReason()#]"
				}]
			});
			return;
		}

		// -------------------------------------------------------------------------------------------
		// --- Invoke the Tool, wrapped in wrapToolCall middleware ---
		// -------------------------------------------------------------------------------------------
		var capturedTool        = tool;
		var capturedToolCall    = toolCall;
		var capturedChatRequest = arguments.chatRequest;
		var toolResult = arguments.chatRequest.fireWrapMiddleware(
			"wrapToolCall",
			toolContext,
			() => capturedTool.invoke( args: capturedToolCall.input, chatRequest: capturedChatRequest )
		);

		// -------------------------------------------------------------------------------------------
		// --- Fire afterToolCall Middleware ---
		// -------------------------------------------------------------------------------------------
		arguments.chatRequest.fireMiddleware(
			hook   : "afterToolCall",
			context: { tool: tool, toolCall: toolCall, chatRequest: arguments.chatRequest, result: toolResult },
			reverse: true
		);

		messages.append({
			"role" : "user",
			"content" : [{
				"type"        : "tool_result",
				"tool_use_id" : toolCall.id,
				"content"     : toolResult
			}]
		});
	}

	/**
	 * Finish processing a tool-call batch that was suspended for human approval (see
	 * afterToolBatch()), using the finalized resume ledger AiAgent.resume() built. No LLM call —
	 * and nothing that already executed (or was already blocked) during the original attempt
	 * runs again, since pass 1 never actually invokes a tool while any part of the batch could
	 * still suspend (see chat()'s "Pass 1: decide" / "Pass 2: execute" split).
	 *
	 * @chatRequest      The chat request to continue — its messages are the pre-LLM-call
	 *                    messages from the original (suspended) attempt
	 * @resumeCtx         The resume context AiAgent.resume() built: { assistantMessage, resumeLedger }
	 * @interactionCount Current tool call interaction count (used internally)
	 */
	private any function resumeToolBatch( required AiChatRequest chatRequest, required struct resumeCtx, required numeric interactionCount ) {
		// Consume the resume context immediately — chat() recurses for the NEXT turn below, and
		// that recursive call must not re-detect this same resume context and loop forever.
		arguments.chatRequest.setResumeContext( {} )

		var thisChatRequest  = arguments.chatRequest
		var assistantMessage = arguments.resumeCtx.assistantMessage
		var ledger            = arguments.resumeCtx.resumeLedger ?: []
		var toolCalls          = ( assistantMessage.content ?: [] ).filter( contentBlock -> contentBlock?.type == "tool_use" )

		var messages = thisChatRequest.getMessages()
		messages.append( assistantMessage )

		for ( var i = 1; i <= toolCalls.len(); i++ ) {
			var toolCall    = toolCalls[ i ]
			var ledgerEntry = ( i <= ledger.len() )
				? ledger[ i ]
				: { status: "blocked", reason: "No resume decision was recorded for this tool call." }

			if ( ledgerEntry.status == "cancel" ) {
				var cancelReason = ledgerEntry.reason ?: "Cancelled by human operator during resume."
				messages.append( {
					"role"   : "user",
					"content": [ { "type": "tool_result", "tool_use_id": toolCall.id, "content": "[Tool call blocked: #cancelReason#]" } ]
				} )
				thisChatRequest.setMessages( messages )
				return AiMiddlewareResult.cancel( cancelReason )
			}

			if ( ledgerEntry.status == "blocked" ) {
				messages.append( {
					"role"   : "user",
					"content": [ { "type": "tool_result", "tool_use_id": toolCall.id, "content": "[Tool call blocked: #ledgerEntry.reason ?: ""#]" } ]
				} )
				continue
			}

			// "execute"
			var toolAttempt = thisChatRequest.getTool( toolCall.name )
			if ( !toolAttempt.isPresent() ) {
				writeLog(
					text: "Unable to find tool named: [#toolCall.name#]",
					type: "warning",
					log : "ai"
				)
				messages.append( {
					"role"   : "user",
					"content": [ { "type": "tool_result", "tool_use_id": toolCall.id, "content": "Tool ['#toolCall.name#'] not found in chat request" } ]
				} )
				continue
			}

			var tool     = toolAttempt.get()
			var toolArgs = !isNull( ledgerEntry.editedArgs ) ? ledgerEntry.editedArgs : ( toolCall.input ?: {} )
			var capturedTool = tool
			var capturedArgs = toolArgs
			var toolResult = thisChatRequest.fireWrapMiddleware(
				"wrapToolCall",
				{ tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, toolName: toolCall.name ?: tool.getName(), toolArgs: toolArgs },
				() => capturedTool.invoke( args: capturedArgs, chatRequest: thisChatRequest )
			)

			thisChatRequest.fireMiddleware(
				hook   : "afterToolCall",
				context: { tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, result: toolResult },
				reverse: true
			)

			messages.append( {
				"role"   : "user",
				"content": [ { "type": "tool_result", "tool_use_id": toolCall.id, "content": toolResult } ]
			} )
		}

		thisChatRequest.setMessages( messages )
		return chat( thisChatRequest, arguments.interactionCount + 1 )
	}

}
