 * ----------------------------------------------------------------------------------
 * AWS Bedrock Service Provider
 *
 * This provider enables integration with AWS Bedrock for accessing foundation models
 * like Claude, Titan, Llama, and others through AWS's managed service.
 *
 * Unlike other providers that use API keys, Bedrock authenticates with AWS Signature
 * Version 4 request signing by default, using credentials resolved via a subset of
 * AWS's standard default credential provider chain (see resolveAwsCredentials()),
 * in order:
 *   1. Explicit `awsAccessKeyId`/`awsSecretAccessKey`/`awsSessionToken` passed to configure()
 *   2. `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY` / `AWS_SESSION_TOKEN` environment variables
 *   3. A Bedrock long-term API key (bearer auth) — an explicit `bearerToken` passed to
 *      configure(), or the `AWS_BEARER_TOKEN_BEDROCK` environment variable — used ONLY when no
 *      AWS access key was resolved via steps 1/2 above; explicit/env AWS credentials always win
 *      and skip bearer auth entirely (see useBearerAuth()). Bearer auth is opt-in only: it is
 *      never inferred from a generic `apiKey` — `configure( "a-string" )` sets `modelId` (see
 *      configure()'s docblock for why Bedrock deliberately deviates from the module-wide
 *      "string = apiKey" contract here).
 *   4. ECS/EKS container credentials (`AWS_CONTAINER_CREDENTIALS_RELATIVE_URI` or `_FULL_URI`)
 *   5. EC2 IMDSv2 instance-role credentials (session-token handshake + role lookup)
 * Steps 4/5 are cached in a store SHARED across instances (see credentialCacheKey()) and refreshed
 * once within 5 minutes of expiry.
 *
 * Tools and schema-typed structured output are model-agnostic on the Converse API (one
 * `toolConfig`, one forced `toolChoice`), which is the default. On the InvokeModel path they are
 * gated: NO_TOOL_SUPPORT_FAMILIES (titan, llama, mistral) and legacy Cohere Command support
 * neither, and the whole Cohere family is gated for structured output. A gated request throws
 * `UnsupportedProviderCapability` rather than silently dropping the capability.
 *
 * Supported model families:
 * - Anthropic Claude (claude-3-*, claude-instant-*) — tools + structured output
 * - Amazon Titan (amazon.titan-*, amazon.titan-embed-text-v1/v2 for embeddings)
 * - Meta Llama (meta.llama-*)
 * - Cohere (cohere.*) — has its own transform (transformRequestForCohere), which picks Command
 *   R's `chat` body or legacy Command's `generate` body from the model id; cohere.embed-* is
 *   supported for embeddings via its own batched embed shape
 * - Legacy Mistral (mistral.mistral-7b-instruct-*, mixtral-*, mistral-large/small-2402-*)
 * - Opaque inference-profile / provisioned-model ARNs with no vendor substring — assumed
 *   Claude, preserving the historical default for the common case
 * - Everything else (AI21 Jamba, modern Mistral, Amazon Nova, and other post-2024 families)
 *   — served by Converse by default, which is model-agnostic and needs no per-vendor transform.
 *   Forced onto InvokeModel they fall through to the OpenAI-shaped transform.
 *
 * @see https://docs.aws.amazon.com/bedrock/latest/userguide/what-is-bedrock.html
 * @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_InvokeModel.html
 * @see https://docs.aws.amazon.com/sdkref/latest/guide/standardized-credentials.html
 */
import bxModules.bxai.models.util.AwsSignatureV4;
import bxModules.bxai.models.util.SchemaBuilder;
import bxModules.bxai.models.middleware.AiMiddlewareResult;
import bxModules.bxai.models.providers.capabilities.IAiChatService;
import bxModules.bxai.models.providers.capabilities.IAiEmbeddingsService;

class extends = "BaseService" implements="IAiChatService, IAiEmbeddingsService" {

	/**
	 * AWS Region for Bedrock
	 */
	property name="region" default="us-east-1";

	/**
	 * AWS Access Key ID (optional - can use environment variables or IAM role)
	 */
	property name="awsAccessKeyId" default="";

	/**
	 * AWS Secret Access Key (optional - can use environment variables or IAM role)
	 */
	property name="awsSecretAccessKey" default="";

	/**
	 * AWS Session Token (optional - for temporary credentials)
	 */
	property name="awsSessionToken" default="";

	/**
	 * The model ID for Bedrock (e.g., anthropic.claude-3-sonnet-20240229-v1:0)
	 */
	property name="modelId" default="";

	/**
	 * Endpoint override for the Bedrock runtime host (e.g. a VPC endpoint, LocalStack, or a
	 * proxy). When empty, the default "bedrock-runtime.{region}.amazonaws.com" host is used.
	 * Accepts a full "scheme://host[:port]" value; scheme defaults to https if omitted.
	 */
	property name="baseURL" default="";

	/**
	 * Explicit Bedrock long-term API key (bearer token) — opt-in only. When set, and no AWS
	 * access key is available (see useBearerAuth()), requests authenticate with
	 * "Authorization: Bearer {bearerToken}" instead of AWS SigV4 signing. Never inferred from
	 * `apiKey` (see configure()'s docblock for why); the `AWS_BEARER_TOKEN_BEDROCK` environment
	 * variable is the other, equally explicit, way to opt in.
	 */
	property name="bearerToken" default="";

	/**
	 * Which Bedrock runtime API to speak: "converse" (Converse/ConverseStream — the default) or
	 * "invoke" (InvokeModel/InvokeModelWithResponseStream, the per-vendor native bodies). Empty
	 * means "not configured"; see resolveBedrockApi() for the full precedence chain and the
	 * automatic per-request fallbacks.
	 */
	property name="bedrockApi" default="";

	/**
	 * Static defaults
	 */
	static {
		CAPABILITIES = [ "chat", "stream", "embeddings" ]
		DEFAULT_CHAT_PARAMS = {
			"model"      : "anthropic.claude-3-sonnet-20240229-v1:0",
			"max_tokens" : 4096
		};
		// Bedrock service name for AWS signing
		AWS_SERVICE = "bedrock";
		// Synthetic tool name used to force Claude into structured-output mode on Bedrock
		STRUCTURED_OUTPUT_TOOL = "structured_output";
		// The request-owned runtime slot the Converse -> InvokeModel fallback records its decision
		// in (see stickBedrockApi). NOT a providerOption: that struct belongs to the caller.
		RUNTIME_BEDROCK_API_KEY = "_bxaiRuntimeBedrockApi";
		// Cohere's Bedrock embed API accepts at most this many texts per InvokeModel call
		COHERE_EMBED_BATCH_SIZE = 96;
		// After a failed container/IMDS credential resolution attempt (e.g. off-EC2, no role
		// attached), skip retrying the network round-trip for this many seconds — otherwise every
		// request pays the ~1-2s IMDS/container timeout again (worst case: once per text in
		// sendTitanEmbeddings).
		NEGATIVE_CACHE_SECONDS = 60;
		// The window above applies only while there are still USABLE cached credentials to serve —
		// a refresh hiccup, where there is no urgency. When nothing resolved and there is nothing
		// to fall back on, every request in the runtime would be signed with empty credentials and
		// get a guaranteed AWS 403, so the window has to be short enough that a pod which started
		// before its credential endpoint was reachable recovers promptly instead of hard-failing
		// for a full minute. Short, not zero: zero would re-pay the metadata timeout per request,
		// which is the cost this cache exists to avoid.
		NEGATIVE_CACHE_SECONDS_EMPTY = 5;
		// Auto-resolved (container/IMDS) credentials, cached across INSTANCES rather than on one.
		// aiService() builds a fresh provider per call (aiService.bx: `new "#targetClass#"()`), so
		// an instance-scoped cache never survives to be read a second time: every request would
		// re-hit the metadata endpoint and the negative cache below could never fire. Keyed by
		// credentialCacheKey(); each entry is { credentials: {}, lastFailure: null|datetime }.
		CREDENTIAL_CACHE = {};
		// Model families whose Bedrock request transform genuinely has no representation for
		// tools / schema-typed structured output (see assertCapabilitySupported()).
		// The OpenAI-shaped families (openai/gpt-oss and the catch-all) and Cohere Command R are
		// deliberately absent: their transforms now emit tools/tool_choice/response_format.
		// Legacy Cohere Command (cohere.command-text-*/command-light-text-*) is prompt-shaped
		// and IS gated — see isLegacyCohere().
		NO_TOOL_SUPPORT_FAMILIES = [ "titan", "llama", "mistral" ];
		// Anchored match for the legacy, prompt-shaped Cohere Command models. Command R/R+
		// (cohere.command-r*) speak the chat shape with tools; command-text / command-light-text
		// only understand { prompt, ... } and have no tool representation at all.
		LEGACY_COHERE_PATTERN = "(^|\.)cohere\.command-(light-)?text";
		// Anchored (start-of-string or region-prefix dot, e.g. "eu.mistral.") match for the
		// legacy, prompt-shaped Mistral models. Everything else on Bedrock's Mistral line is
		// OpenAI-shaped.
		LEGACY_MISTRAL_PATTERN = "(^|\.)mistral\.(mistral-7b-instruct-|mixtral-|mistral-(large|small)-2402-)";

		// ------------------------------------------------------------------------------------
		// Converse API (#272)
		// ------------------------------------------------------------------------------------
		// The two runtime APIs this provider can speak. "converse" is the model-agnostic
		// Converse/ConverseStream operation; "invoke" is the per-vendor InvokeModel body.
		BEDROCK_APIS       = [ "converse", "invoke" ];
		DEFAULT_BEDROCK_API = "converse";
		// Model ids that Converse cannot serve, so a request for them is routed to InvokeModel
		// regardless of the configured API.
		//
		// Deliberately SHORT and evidence-based. AWS retired the consolidated
		// "conversation-inference-supported-models-features" matrix (it now redirects to the
		// per-model "Models at a glance" cards), so there is no longer a single authoritative
		// list to mirror. Only text-COMPLETION models — which have no notion of a `messages[]`
		// conversation at all and therefore cannot be expressed as a Converse request — are
		// listed here:
		//   - legacy Cohere Command (command-text-*, command-light-text-*): the `{ prompt }`
		//     generate shape (same ids already gated by LEGACY_COHERE_PATTERN)
		//   - AI21 Jurassic-2 (ai21.j2-*): the `{ prompt }` complete shape
		// Everything else is attempted over Converse and falls back on the runtime
		// ValidationException below if AWS says the model or operation is unsupported — a
		// self-correcting list beats a guessed one.
		NO_CONVERSE_MODEL_PATTERNS = [
			"(^|\.)cohere\.command-(light-)?text",
			"(^|\.)ai21\.j2-"
		];
		// A Converse ValidationException whose message says the model/operation is unsupported is
		// the trigger for a one-shot InvokeModel retry. AWS does not publish the exact wording
		// (the troubleshooting page gives no verbatim patterns), so this matches the shape of the
		// sentence rather than a specific string, and ONLY in combination with an actual
		// ValidationException — no other error class ever falls back.
		//
		// Two conditions, because a bare "does not support" sentence is ALSO how AWS reports a
		// feature-level 400 ("this model does not support toolChoice", "…toolResult.status",
		// "…images"). Those are accurate messages about a request that InvokeModel would reject
		// just as hard, and re-sending them over the other API only replaces AWS's diagnosis with
		// this module's own UnsupportedProviderCapability. So the sentence must ALSO name the
		// operation/Converse itself (within the same clause), and must NOT name a request feature.
		//
		// The subject is deliberately NOT a bare "model". "Invocation of model ID <id> with
		// on-demand throughput isn't supported" — the single most common Bedrock 400 there is — is
		// a sentence about THROUGHPUT MODE, not about the API: InvokeModel rejects it exactly as
		// hard, and re-sending it there only replaces AWS's actionable "use an inference profile"
		// with a generic failure. Requiring the unsupported thing to be named as the operation
		// ("does not support the Converse operation", "is not supported by Converse") keeps every
		// genuine api-level message matching while that whole family of messages falls through.
		CONVERSE_UNSUPPORTED_PATTERN = "(?:(converse(-?stream)?|operation)[^;\n]{0,60}?(does ?n[o']?t support|is ?n[o']?t supported|isn't supported|not supported|unsupported))|(?:(does ?n[o']?t support|is ?n[o']?t supported|isn't supported|not supported|unsupported)[^;\n]{0,60}?(converse(-?stream)?|operation))";
		// Checked against the RAW message BEFORE the model-id scrub, and vetoes the fallback
		// outright. Each of these names a condition InvokeModel is subject to just as much as
		// Converse is — a throughput mode the model has no on-demand entitlement for, an IAM
		// denial, a throttle. Retrying them over the other API cannot help, and swallowing AWS's
		// own remediation text ("Retry your request with the ID or ARN of an inference profile")
		// is strictly worse than surfacing it.
		CONVERSE_FALLBACK_VETO_PATTERN = "on-?demand throughput|inference profile|provisioned throughput|not authorized|AccessDenied|Throttling";
		// Model ids and ARNs are stripped out of the message before the pattern above is applied
		// (see shouldFallbackToInvoke). They are the reason the proximity window cannot simply
		// exclude "." — "The model cohere.command-text-v14 doesn't support Converse" puts two dots
		// between the subject and the verb — and the reason the feature veto below has to be
		// anchored: "amazon.titan-image-generator-v1" is not a message about image blocks.
		CONVERSE_MODEL_ID_PATTERN = "arn:[^\s]+|[A-Za-z0-9-]+\.[A-Za-z0-9.\-]+(:[0-9]+)?";
		// A Converse 400 naming any of these is about the REQUEST, not about the API: surface the
		// AWS message verbatim rather than falling back and mistranslating it.
		// Anchored to FIELD context: a bare "image"/"system"/"document" also occurs inside model
		// ids (amazon.titan-image-generator-v1, stability.stable-image-core-v1:0), and vetoing on
		// those turned "this model is not supported" into "surface the AWS error" — exactly the
		// case the fallback exists for.
		CONVERSE_FEATURE_ERROR_PATTERN = "(toolConfig|toolChoice|toolResult\.status|image (block|content|format)|document (block|content|format)|system (prompt|message|content))";
		// Model ids already logged as having fallen back, so the info line is emitted once per
		// model id per JVM rather than once per request. Static for the same reason
		// CREDENTIAL_CACHE is: aiService() builds a fresh provider per call.
		CONVERSE_FALLBACK_LOGGED = {};
		// Converse `stopReason` -> the module's normalized OpenAI-shaped finish_reason.
		CONVERSE_STOP_REASONS = {
			"end_turn"                      : "stop",
			"tool_use"                      : "tool_calls",
			"max_tokens"                    : "length",
			"stop_sequence"                 : "stop",
			"guardrail_intervened"          : "content_filter",
			"content_filtered"              : "content_filter",
			"malformed_model_output"        : "stop",
			"malformed_tool_use"            : "stop",
			"model_context_window_exceeded" : "length"
		};
		// Converse ImageBlock.format / DocumentBlock.format / VideoBlock.format enums.
		CONVERSE_IMAGE_FORMATS    = "png,jpeg,gif,webp";
		CONVERSE_DOCUMENT_FORMATS = "pdf,csv,doc,docx,xls,xlsx,html,txt,md";
		CONVERSE_VIDEO_FORMATS    = "mkv,mov,mp4,webm,flv,mpeg,mpg,wmv,three_gp";
		// Request params that Converse models natively as first-class fields; every OTHER caller
		// param (thinking, top_k, reasoning_effort, anthropic_beta, …) goes to
		// additionalModelRequestFields verbatim.
		CONVERSE_NATIVE_PARAMS = "model,stream,messages,tools,tool_choice,response_format,max_tokens,max_completion_tokens,max_gen_len,temperature,top_p,stop,stop_sequences,system,anthropic_version";
		// extendedInfo marker on a BedrockStreamError that has ALREADY been announced on onAIError
		// (throwBedrockStreamError does the announce). Every other BedrockStreamError throw has
		// not, so the stream catch announces those rather than keying on the type.
		BEDROCK_ERROR_ANNOUNCED = "bedrockErrorAnnounced";
		// Every Converse ContentBlock member the module recognizes. One list, used both by the
		// dialect detector and the fallback check — they had drifted, and guardContent was in one
		// and not the other.
		CONVERSE_CONTENT_BLOCK_KEYS = [ "text", "image", "document", "video", "toolUse", "toolResult", "guardContent", "reasoningContent", "cachePoint" ];
	}

	/**
	 * Constructor
	 */
	function init(){
		variables.name          = "Bedrock";
		// Bedrock doesn't use a fixed URL - it's constructed per request based on region and model
		variables.chatURL       = "";
		variables.embeddingsURL = "";
		// Auto-resolved credential state (ECS/EKS container or EC2 IMDSv2) lives in
		// static.CREDENTIAL_CACHE, shared across instances and keyed by credentialCacheKey() —
		// see that method and the static block. Explicit/env credentials never populate it.

		// Set default params
		defaults( static.DEFAULT_CHAT_PARAMS );

		// Load AWS credentials from environment if not provided
		loadAwsCredentialsFromEnvironment();

		return this;
	}

	@override
	public array function getDeclaredCapabilities() {
		return static.CAPABILITIES
	}

	/**
	 * Configure the service with AWS credentials and region
	 *
	 *         OR a simple string for backward compatibility (treated as modelId).
	 *
	 *         Bedrock deliberately deviates from BaseService's module-wide "string = apiKey"
	 *         contract here: a Bedrock model id (e.g. "anthropic.claude-3-sonnet-20240229-v1:0")
	 *         is by far the more useful single-string argument, and this has been Bedrock's
	 *         behavior since before bearer auth existed — changing it would silently break
	 *         every existing `configure( "anthropic.claude-..." )` caller. Bearer tokens have
	 *         their own explicit configuration instead: the `bearerToken` struct key (see
	 *         below) or the `AWS_BEARER_TOKEN_BEDROCK` environment variable — see
	 *         useBearerAuth()/getBearerToken().
	 *
	 * @options A struct containing: region, awsAccessKeyId, awsSecretAccessKey, awsSessionToken (optional), modelId (optional), baseURL (optional), bearerToken (optional)
	 *          OR a plain string model ID
	 *
	 * @return The service instance
	 */
	IAiService function configure( required any options ){
		if ( isSimpleValue( arguments.options ) ) {
			// If a simple string is passed, treat it as model ID for compatibility — see the
			// docblock above for why Bedrock does not follow BaseService's "string = apiKey"
			// contract.
			variables.modelId = arguments.options;
		} else if ( isStruct( arguments.options ) ) {
			// Snapshot the caller's own options BEFORE delegating: BaseService.configure() does
			// `variables.options = arguments.options` and then appends providers.Bedrock.options
			// with override=true, which mutates the caller's struct IN PLACE — so after the call
			// there is no longer any record of what the caller actually asked for.
			var callerOptions = duplicate( arguments.options );

			// Delegate to BaseService for the module-settings merges (defaultParams,
			// providers.Bedrock.{params,options}) that struct-based configure() must not skip.
			super.configure( arguments.options );

			// Start from the merged struct so module-level provider options (region, baseURL,
			// bearerToken, credentials) take effect at all, then re-apply the caller's OWN struct
			// on top. BaseService.configure() appends providers.Bedrock.options with override=true,
			// which otherwise lets a module-wide region silently beat an explicit per-call one and
			// send the request to the wrong region. Explicit arguments win; module settings fill
			// the gaps. Copied rather than mutated in place because BaseService appends into the
			// caller's own struct by reference.
			var resolvedOptions = duplicate( variables.options );
			resolvedOptions.append( callerOptions, true );

			// ------------------------------------------------------------------------------------
			// Credential sources, highest precedence first. Each is evaluated as an ATOMIC SET: the
			// source that supplies a complete key pair supplies the session token too, or leaves it
			// empty. Merging the sources first and then reading the token off the merged struct is
			// what this replaces — it let a caller's explicit pair pick up a session token from
			// provider settings or the module-global apiKey, which is a token belonging to different
			// credentials, and SigV4 signs the mismatched triple for AWS to reject.
			//
			// The module-global apiKey is the BROADEST configured scope (aiChat()/aiService() inject
			// it for every provider), so it ranks below provider-specific settings, which in turn
			// rank below what this call stated explicitly.
			// ------------------------------------------------------------------------------------
			// Read module settings the way BaseService does: `static.` resolves to THIS class's own
			// static scope, so BaseService's MODULE_SETTINGS is not reachable through it.
			var providerOptions = {};
			var moduleSettings  = getModuleInfo( "bxai" ).settings ?: {};
			if (
				isStruct( moduleSettings )
				&& isStruct( moduleSettings.providers ?: "" )
				&& isStruct( moduleSettings.providers[ variables.name ] ?: "" )
				&& isStruct( ( moduleSettings.providers[ variables.name ].options ?: "" ) )
			) {
				providerOptions = moduleSettings.providers[ variables.name ].options;
			}

			var nestedApiKey      = ( isStruct( resolvedOptions.apiKey ?: "" ) ) ? resolvedOptions.apiKey : {};
			var credentialSources = [ callerOptions, providerOptions, nestedApiKey ];

			// Region is not part of the credential set, so it just takes the highest-priority value.
			for ( var source in credentialSources ) {
				if ( len( source.region ?: "" ) ) {
					variables.region = source.region;
					break;
				}
			}

			var adoptedCompleteSet = false;
			for ( var source in credentialSources ) {
				if ( len( source.awsAccessKeyId ?: "" ) && len( source.awsSecretAccessKey ?: "" ) ) {
					variables.awsAccessKeyId     = source.awsAccessKeyId;
					variables.awsSecretAccessKey = source.awsSecretAccessKey;
					variables.awsSessionToken    = source.awsSessionToken ?: "";
					adoptedCompleteSet           = true;
					break;
				}
			}

			if ( !adoptedCompleteSet ) {
				// No source supplied a complete pair. Override only the individual values that were
				// actually stated, highest-priority source first, leaving the rest of the chain (the
				// environment values init() loaded) intact — blanking an environment-supplied secret
				// because an access key id was configured alone is its own regression.
				for ( var credKey in [ "awsAccessKeyId", "awsSecretAccessKey", "awsSessionToken" ] ) {
					for ( var source in credentialSources ) {
						if ( len( source[ credKey ] ?: "" ) ) {
							variables[ credKey ] = source[ credKey ];
							break;
						}
					}
				}
			}

			// These remain at top level
			if ( resolvedOptions.keyExists( "modelId" ) ) {
				variables.modelId = resolvedOptions.modelId;
			}
			if ( resolvedOptions.keyExists( "model" ) ) {
				variables.params.model = resolvedOptions.model;
			}
			if ( resolvedOptions.keyExists( "baseURL" ) && len( resolvedOptions.baseURL ) ) {
				variables.baseURL = resolvedOptions.baseURL.trim();
			}
			if ( resolvedOptions.keyExists( "bearerToken" ) && len( resolvedOptions.bearerToken ) ) {
				variables.bearerToken = resolvedOptions.bearerToken;
			}
			if ( resolvedOptions.keyExists( "bedrockApi" ) && len( resolvedOptions.bedrockApi ?: "" ) ) {
				variables.bedrockApi = resolvedOptions.bedrockApi.lcase().trim();
			}
		}

		return this;
	}

	/**
	 * Load AWS credentials from environment variables if not already set
	 */
	private function loadAwsCredentialsFromEnvironment(){
		if ( !len( variables.awsAccessKeyId ) ) {
			variables.awsAccessKeyId = getSystemSetting( "AWS_ACCESS_KEY_ID", "" );
		}
		if ( !len( variables.awsSecretAccessKey ) ) {
			variables.awsSecretAccessKey = getSystemSetting( "AWS_SECRET_ACCESS_KEY", "" );
		}
		if ( !len( variables.awsSessionToken ) ) {
			variables.awsSessionToken = getSystemSetting( "AWS_SESSION_TOKEN", "" );
		}
		if ( !len( variables.region ) || variables.region == "us-east-1" ) {
			var envRegion = getSystemSetting( "AWS_REGION", getSystemSetting( "AWS_DEFAULT_REGION", "" ) );
			if ( len( envRegion ) ) {
				variables.region = envRegion;
			}
		}
		if ( !len( variables.baseURL ) ) {
			variables.baseURL = getSystemSetting( "BOXLANG_MODULES_BXAI_BEDROCK_BASEURL", "" );
		}
		// Env-supplied API selection. Read here (init) rather than in resolveBedrockApi() so it is
		// resolved exactly once per instance, mirroring BEDROCK_BASEURL. Kept in its own variable
		// from the configured one so resolveBedrockApi() can rank env ABOVE module settings —
		// variables.bedrockApi is what configure() writes.
		variables.bedrockApiFromEnv = getSystemSetting( "BOXLANG_MODULES_BXAI_BEDROCK_API", "" ).lcase().trim();
	}

	/**
	 * Whether a cached, auto-resolved credentials struct (see resolveAwsCredentials()) is still
	 * usable: present, carries an "expiration", and has more than 5 minutes left before it expires.
	 * Pure/no I/O — the 5-minute refresh buffer is deliberately testable without a clock seam or
	 * real container/IMDS network calls.
	 *
	 * @cached A struct as returned by loadContainerCredentials()/loadImdsCredentials() (or {})
	 *
	 * @return True if the cached credentials can still be used as-is
	 */
	public boolean function isCredentialCacheValid( required struct cached ){
		if ( arguments.cached.isEmpty() || !arguments.cached.keyExists( "expiration" ) ) {
			return false;
		}
		// Key material must actually be present. A container endpoint answering `200 {}` yields a
		// struct with empty keys and a synthesized 60-minute expiry, which otherwise read as valid
		// — suppressing the IMDS fallback and signing every request with an empty secret for an
		// hour. An expiry alone is not evidence of credentials.
		if ( !len( arguments.cached.accessKeyId ?: "" ) || !len( arguments.cached.secretAccessKey ?: "" ) ) {
			return false;
		}
		return dateDiff( "n", now(), arguments.cached.expiration ) > 5;
	}

	/**
	 * The subset of variables.params that module settings actually configured — what belongs on the
	 * request, as opposed to this service's own built-in defaults.
	 *
	 * Two keys must not be merged blindly. "model" has dedicated resolution here (variables.modelId
	 * → request → params) and merging it would make AiBaseRequest.getModel() report the default
	 * Claude id for a request routed to another family. And DEFAULT_CHAT_PARAMS.max_tokens is
	 * Claude-shaped (4096): imposing it on every family overrides each transform's own fallback —
	 * Llama's max_gen_len tops out at 2048, so a merged 4096 makes AWS reject every Llama call. A
	 * value equal to the built-in default is therefore treated as "not configured"; one that
	 * differs came from settings and is forwarded.
	 */
	private struct function configuredServiceParams(){
		var configured = {};

		for ( var key in variables.params ) {
			if ( key == "model" ) {
				continue;
			}
			if ( static.DEFAULT_CHAT_PARAMS.keyExists( key ) && static.DEFAULT_CHAT_PARAMS[ key ] == variables.params[ key ] ) {
				continue;
			}
			configured[ key ] = variables.params[ key ];
		}

		return configured;
	}

	/**
	 * Resolve the AWS credentials to sign this request with, following (a subset of) the standard
	 * AWS default credential provider chain:
	 *   1. Explicit struct credentials passed to configure() (variables.awsAccessKeyId/SecretAccessKey)
	 *   2. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN environment variables
	 *      (both loaded into the same variables.* at construction/configure() time — by the time
	 *      this runs, steps 1 and 2 are indistinguishable and handled by the same check below)
	 *   3. Bedrock bearer token — handled entirely separately by useBearerAuth()/getBearerToken(),
	 *      which short-circuits SigV4 (and this method) altogether; this method is only reached
	 *      when useBearerAuth() is false
	 *   4. ECS/EKS container credentials (AWS_CONTAINER_CREDENTIALS_RELATIVE_URI / _FULL_URI)
	 *   5. EC2 IMDSv2 instance-role credentials
	 *
	 * Auto-resolved credentials (steps 4/5) are cached in static.CREDENTIAL_CACHE — SHARED across
	 * instances, keyed by credentialCacheKey() — and re-resolved once within
	 * 5 minutes of their reported expiration (see isCredentialCacheValid()). A failed resolution
	 * attempt (nothing anywhere in the chain) is itself negative-cached for
	 * static.NEGATIVE_CACHE_SECONDS so an off-EC2 caller with no role attached doesn't pay the
	 * container/IMDS network timeout on every single request. If a refresh attempt fails while the
	 * previously cached credentials are still within their 5-minute expiry buffer but not yet
	 * ACTUALLY expired, those still-valid cached credentials are reused rather than discarded (see
	 * fallbackToCachedOrEmptyCredentials()). Only when nothing resolves and nothing cached is still
	 * valid does today's original behavior apply: the (empty) variables.aws* values are returned
	 * as-is and the signed request will fail with AWS's own auth error.
	 *
	 * The read-modify-write of the cache entry is guarded by a named lock derived from the cache key
	 * (not from instance identity) so concurrent requests for the same credential source can't race
	 * each other into duplicate container/IMDS calls or clobber each other's cache writes, while
	 * different sources don't serialize against each other.
	 *
	 * Sharing the cache across instances is the point: aiService() constructs a fresh provider on
	 * every call, so an instance-scoped cache was read exactly once and never hit — every request
	 * paid a metadata round-trip, and the negative cache could never fire at all.
	 *
	 * @return Struct: { accessKeyId, secretAccessKey, sessionToken }
	 */
	public struct function resolveAwsCredentials(){
		// 1 + 2: explicit struct / environment credentials, already resolved onto the instance.
		if ( len( variables.awsAccessKeyId ) && len( variables.awsSecretAccessKey ) ) {
			return {
				accessKeyId     : variables.awsAccessKeyId,
				secretAccessKey : variables.awsSecretAccessKey,
				sessionToken    : variables.awsSessionToken
			};
		}

		// Every failure in the auto-resolution chain degrades to empty credentials, so AWS answers
		// with its own auth error rather than an exception surfacing from a credential LOOKUP. The
		// named locks below use throwontimeout="true" (required by convention), so a contended lock
		// would otherwise be the one failure here that escapes into chat().
		try {
			return resolveAutoAwsCredentials();
		} catch ( any e ) {
			writeLog(
				text: "Bedrock: auto credential resolution failed (#e.type#): #e.message#",
				type: "error",
				log : "ai"
			);
			return {
				accessKeyId     : variables.awsAccessKeyId,
				secretAccessKey : variables.awsSecretAccessKey,
				sessionToken    : variables.awsSessionToken
			};
		}
	}

	/**
	 * The container/IMDS half of resolveAwsCredentials(), behind the shared cache. Separated so the
	 * caller can guarantee this never throws — see resolveAwsCredentials().
	 *
	 * @return Struct: { accessKeyId, secretAccessKey, sessionToken }
	 */
	private struct function resolveAutoAwsCredentials(){
		var cacheKey  = credentialCacheKey();
		var lockName  = "bedrock-credentials-#cacheKey#";

		// ------------------------------------------------------------------------------------
		// Fast path: a readonly lock, no network I/O. This is the overwhelmingly common case and
		// must not serialize behind the exclusive lock below — BoxLang's lock registry is
		// JVM-static, so an exclusive lock here would funnel every Bedrock request in the runtime
		// through one gate for what is a pure read.
		// ------------------------------------------------------------------------------------
		var cached = "";
		lock name="#lockName#" type="readonly" timeout="10" throwontimeout="true" {
			// duplicate() INSIDE the lock: `?:` yields the live entry, and every field read below
			// happens after the lock releases. Aliasing it let a writer mutate the entry mid-decision
			// — validate one credentials struct and return another, or (worse) null lastFailure
			// between the isNull() check and the dateDiff() below, which throws "Can't cast null to
			// a DateTime" straight out of chat(). Snapshotting is the whole fix.
			cached = duplicate( static.CREDENTIAL_CACHE[ cacheKey ] ?: { "credentials" : {}, "lastFailure" : null } );
		}

		if ( isCredentialCacheValid( cached.credentials ) ) {
			// Copied, never handed out by reference: this struct lives in a cache shared across
			// every instance and thread, and a caller mutating it would corrupt what everyone else
			// signs with, outside any lock.
			return duplicate( cached.credentials );
		}

		// Negative cache. The window depends on whether there is anything usable to serve: with
		// good cached credentials this is just refresh suppression, but with nothing to fall back
		// on it is suppressing requests that will all 403, so it expires quickly.
		if ( !isNull( cached.lastFailure ) ) {
			var negativeWindow = len( cached.credentials.secretAccessKey ?: "" )
				? static.NEGATIVE_CACHE_SECONDS
				: static.NEGATIVE_CACHE_SECONDS_EMPTY;

			if ( dateDiff( "s", cached.lastFailure, now() ) < negativeWindow ) {
				return duplicate( fallbackToCachedOrEmptyCredentials( cached.credentials ) );
			}
		}

		// ------------------------------------------------------------------------------------
		// Slow path: resolve OUTSIDE any lock. Two threads racing here may each pay one metadata
		// round-trip, which is strictly better than holding an exclusive JVM-wide lock across
		// ~5s of HTTP (container endpoint + three sequential IMDS calls) and an untimed token-file
		// read — that queues every other Bedrock request behind it and, past the lock timeout,
		// throws type="lock", which RetryMiddleware does not treat as non-retryable and would
		// re-queue onto the same congested lock.
		// ------------------------------------------------------------------------------------
		var creds = loadContainerCredentials();
		if ( isNull( creds ) ) {
			creds = loadImdsCredentials();
		}

		var result = {};

		lock name="#lockName#" type="exclusive" timeout="10" throwontimeout="true" {
			var entry = static.CREDENTIAL_CACHE[ cacheKey ] ?: { "credentials" : {}, "lastFailure" : null };

			if ( !isNull( creds ) ) {
				entry.credentials = creds;
				entry.lastFailure = null;
				result            = creds;
			} else {
				// Nothing resolved. Only arm the negative-cache window when there is nothing valid
				// already cached — a concurrent thread may have just stored good credentials, and
				// stamping a failure over those is what makes the negative branch serve stale keys
				// while perfectly usable ones sit in the entry.
				if ( !isCredentialCacheValid( entry.credentials ) ) {
					entry.lastFailure = now();
				}
				result = fallbackToCachedOrEmptyCredentials( entry.credentials );
			}

			static.CREDENTIAL_CACHE[ cacheKey ] = entry;
		}

		return duplicate( result );
	}

	/**
	 * Key under which auto-resolved credentials are shared across instances.
	 *
	 * Built ONLY from what actually determines the credential values — the container endpoint in
	 * use, or EC2 IMDS otherwise. Region is deliberately NOT part of the key: the metadata service
	 * returns the same instance/pod credentials regardless of which region they are later used to
	 * sign for, so including it bounded nothing and cost real money — it made an app targeting M
	 * regions pay M cold metadata probes and keep M independent negative-cache windows, and it let
	 * caller-supplied region strings (unvalidated, straight off the options struct) mint unbounded
	 * cache entries each retaining a live secret. Keyed on the source alone the cardinality is at
	 * most one entry per configured endpoint.
	 *
	 * @return The cache key
	 */
	public string function credentialCacheKey(){
		var relativeUri = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "" );
		var fullUri     = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_FULL_URI", "" );
		var source      = len( relativeUri ) ? "container-relative:" & relativeUri
			: ( len( fullUri ) ? "container-full:" & fullUri : "ec2-imds" );

		// Hashed so an endpoint URI cannot inject characters into a lock name or struct key.
		return hash( lCase( source ), "MD5" );
	}

	/**
	 * Fallback used by resolveAwsCredentials() whenever a (real or negative-cache-skipped)
	 * container/IMDS resolution attempt doesn't yield fresh credentials: if the previously
	 * auto-resolved credentials are within the 5-minute expiry buffer (isCredentialCacheValid()
	 * already said no) but are not yet ACTUALLY expired, keep using them — a refresh hiccup
	 * shouldn't discard credentials that still work — otherwise fall back to the original (likely
	 * empty) explicit/env values.
	 *
	 * @cached The cached credentials for this credential source (may be empty)
	 *
	 * @return Struct: { accessKeyId, secretAccessKey, sessionToken }
	 */
	private struct function fallbackToCachedOrEmptyCredentials( required struct cached ){
		if (
			!arguments.cached.isEmpty()
			&& arguments.cached.keyExists( "expiration" )
			&& dateCompare( now(), arguments.cached.expiration ) < 0
		) {
			writeLog(
				text: "Bedrock: credential refresh failed (or was skipped via the negative cache) while "
					& "still within the 5-minute expiry buffer; reusing still-valid cached credentials "
					& "(expires #arguments.cached.expiration#)",
				type: "warning",
				log : "ai"
			);
			return arguments.cached;
		}

		// Nothing usable anywhere in the chain — keep today's behavior (empty credentials; the
		// signed request will be rejected by AWS with its own auth error).
		return {
			accessKeyId     : variables.awsAccessKeyId,
			secretAccessKey : variables.awsSecretAccessKey,
			sessionToken    : variables.awsSessionToken
		};
	}

	/**
	 * Load temporary credentials from the ECS/EKS container credentials endpoint, per
	 * AWS_CONTAINER_CREDENTIALS_RELATIVE_URI (resolved against the fixed 169.254.170.2 link-local
	 * address) or AWS_CONTAINER_CREDENTIALS_FULL_URI (used as-is, optionally with
	 * AWS_CONTAINER_AUTHORIZATION_TOKEN as a bearer Authorization header).
	 * @see https://docs.aws.amazon.com/sdkref/latest/guide/feature-container-credentials.html
	 *
	 * @return Struct { accessKeyId, secretAccessKey, sessionToken, expiration } or null if the
	 *         endpoint isn't configured or the request fails
	 */
	/**
	 * Resolve the container credential provider's authorization token.
	 *
	 * EKS Pod Identity supplies AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE and rotates the file's
	 * contents, so the file is read on every call rather than cached; ECS supplies the token
	 * inline via AWS_CONTAINER_AUTHORIZATION_TOKEN. The file variant takes precedence, matching
	 * the AWS container credential provider specification. An unreadable file falls back to the
	 * inline value instead of failing the whole credential chain.
	 *
	 * @see https://docs.aws.amazon.com/sdkref/latest/guide/feature-container-credentials.html
	 *
	 * @return The authorization token, or an empty string when neither variable is set
	 */
	public string function containerAuthorizationToken(){
		var tokenFile = getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE", "" );

		if ( len( tokenFile ) ) {
			// The file's contents become an Authorization header, so the path is validated before it
			// is read, per this project's path-traversal rule. AWS supplies an absolute path here.
			if ( tokenFile.find( ".." ) ) {
				writeLog(
					text: "Bedrock: refusing AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE [#tokenFile#] — path traversal is not accepted",
					type: "warning",
					log : "ai"
				);
				return getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN", "" );
			}
			try {
				return fileRead( tokenFile ).trim();
			} catch ( any e ) {
				writeLog(
					text: "Bedrock: could not read AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE [#tokenFile#]: #e.message#",
					type: "warning",
					log : "ai"
				);
			}
		}

		return getSystemSetting( "AWS_CONTAINER_AUTHORIZATION_TOKEN", "" );
	}

	/**
	 * Extract the real host from an absolute URI, so a trust decision cannot be fooled by the
	 * authority's own syntax.
	 *
	 * Two traps this exists for. A URI may carry `userinfo@` before the host, so
	 * `http://127.0.0.1:80@evil.example/creds` has a real host of `evil.example` while a naive
	 * "everything before the first colon" read returns `127.0.0.1`. And an IPv6 literal is
	 * bracketed and full of colons, so that same read turns `http://[::1]/` into `[`.
	 *
	 * @uri An absolute URI
	 *
	 * @return The lowercased host, with any userinfo, port and IPv6 brackets removed
	 */
	private string function extractUriHost( required string uri ){
		// Strip the scheme, then take the authority: everything up to the first / ? or ##
		var authority = arguments.uri.reReplaceNoCase( "^[a-z][a-z0-9+.-]*://", "" );
		authority     = authority.listFirst( "/?##" );

		// Userinfo may itself contain @, so the host follows the LAST one
		if ( authority.find( "@" ) ) {
			authority = authority.listLast( "@" );
		}

		// Bracketed IPv6 literal: the host is what is inside the brackets, and any port follows them
		if ( authority.startsWith( "[" ) ) {
			var closing = authority.find( "]" );
			return closing > 1 ? lCase( authority.mid( 2, closing - 2 ) ) : "";
		}

		return lCase( authority.listFirst( ":" ) );
	}

	/**
	 * Whether a container credential endpoint may be contacted, per the AWS SDKs' rule for
	 * AWS_CONTAINER_CREDENTIALS_FULL_URI.
	 *
	 * The request carries a bearer authorization token, so the destination cannot be arbitrary: over
	 * plain HTTP only loopback and the documented ECS/EKS link-local addresses are permitted, and any
	 * other host must use HTTPS. Without this an environment variable pointing at an attacker-chosen
	 * plain-HTTP host would be handed the token verbatim. The IMDS address is deliberately absent —
	 * it is not a container credential endpoint.
	 *
	 * @see https://docs.aws.amazon.com/sdkref/latest/guide/feature-container-credentials.html
	 *
	 * @uri The configured full URI
	 *
	 * @return True if the endpoint is allowed
	 */
	public boolean function isTrustedContainerCredentialUri( required string uri ){
		var normalized = trim( arguments.uri );

		// HTTPS to any host is acceptable — the token is protected in transit.
		if ( normalized.reFindNoCase( "^https://" ) ) {
			return true;
		}

		if ( normalized.reFindNoCase( "^http://" ) ) {
			var host = extractUriHost( normalized );

			var trustedHosts = [ "localhost", "127.0.0.1", "::1", "169.254.170.2", "169.254.170.23", "fd00:ec2::23" ];
			if ( trustedHosts.findNoCase( host ) ) {
				return true;
			}
			// Any 127.x.x.x loopback address
			if ( host.reFind( "^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$" ) ) {
				return true;
			}
		}

		if ( len( normalized ) ) {
			writeLog(
				text: "Bedrock: refusing to send a container credential token to untrusted endpoint [#normalized#] — "
					& "plain HTTP is allowed only for loopback and the ECS/EKS link-local addresses; use HTTPS "
					& "for any other host",
				type: "warning",
				log : "ai"
			);
		}
		return false;
	}

	private any function loadContainerCredentials(){
		var relativeUri = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "" );
		var fullUri      = getSystemSetting( "AWS_CONTAINER_CREDENTIALS_FULL_URI", "" );

		if ( !len( relativeUri ) && !len( fullUri ) ) {
			return null;
		}

		// RELATIVE_URI wins when both are set, per the AWS container credential provider spec — and
		// credentialCacheKey() keys on that same precedence, so preferring FULL_URI here fetched from
		// one endpoint and cached the result under the other.
		var url = "";
		if ( len( relativeUri ) ) {
			// RELATIVE_URI is concatenated onto the fixed ECS address, so it must actually be a path.
			// A value like "@evil.example/creds" would otherwise assemble into
			// "http://169.254.170.2@evil.example/creds", whose real host is evil.example — the
			// userinfo trick, arriving through the one input that skipped the trust check.
			if ( !relativeUri.startsWith( "/" ) || relativeUri.find( "@" ) ) {
				writeLog(
					text: "Bedrock: ignoring AWS_CONTAINER_CREDENTIALS_RELATIVE_URI [#relativeUri#] — it must be a "
						& "path beginning with / and may not contain userinfo",
					type: "warning",
					log : "ai"
				);
				return null;
			}
			url = "http://169.254.170.2" & relativeUri;
		} else if ( isTrustedContainerCredentialUri( fullUri ) ) {
			// The TRIMMED value, because that is what was validated. Fetching the raw env string
			// meant a trailing newline (trivial from a k8s env-from-file) passed validation, failed
			// the HTTP call, was swallowed, and silently fell through to IMDS — signing with the EC2
			// instance role instead of the ECS task role. A silent privilege swap, not an error.
			url = trim( fullUri );
		} else {
			// Refused, not silently unauthenticated: the request would carry a bearer token.
			return null;
		}

		var authToken = containerAuthorizationToken();

		try {
			// bx:http rather than the fluent http() builder purely because the builder exposes no
			// redirect control, and following a redirect here defeats the endpoint allowlist above:
			// verified that the default client follows a 302 from a trusted address to an arbitrary
			// host and returns that host's body as a 200, which we would then cache as credentials.
			// AWS SDKs do not follow redirects on this endpoint either.
			var result = "";
			if ( len( authToken ) ) {
				bx:http url="#url#" method="GET" timeout="2" redirect="false" throwonerror="false" result="result" {
					bx:httpparam type="header" name="Authorization" value="#authToken#";
				}
			} else {
				bx:http url="#url#" method="GET" timeout="2" redirect="false" throwonerror="false" result="result" {
				}
			}

			var statusCode = val( listFirst( result.statusCode ?: "0", " " ) );
			if ( statusCode != 200 ) {
				// Logged, not silent: a 302 (refused redirect), 401 or 403 here is the difference
				// between "no container credentials configured" and "configured but rejected", and
				// this whole code path previously failed invisibly.
				writeLog(
					text: "Bedrock: container credential endpoint returned status #statusCode#; falling through to IMDS",
					type: "warning",
					log : "ai"
				);
				return null;
			}

			var body = jsonDeserialize( result.fileContent );

			// A 200 carrying no key material is a failed resolution, not a credential set: return
			// null so the chain falls through to IMDS instead of caching an empty set behind a
			// synthesized expiry.
			if ( !len( body.AccessKeyId ?: "" ) || !len( body.SecretAccessKey ?: "" ) ) {
				writeLog(
					text: "Bedrock: container credential endpoint returned no key material; falling through to IMDS",
					type: "warning",
					log : "ai"
				);
				return null;
			}

			return {
				accessKeyId     : body.AccessKeyId,
				secretAccessKey : body.SecretAccessKey,
				sessionToken    : body.Token ?: "",
				expiration      : len( body.Expiration ?: "" ) ? parseDateTime( body.Expiration ) : dateAdd( "n", 60, now() )
			};
		} catch ( any e ) {
			writeLog(
				text: "Bedrock: failed to load ECS/EKS container credentials: #e.message#",
				type: "warning",
				log : "ai"
			);
			return null;
		}
	}

	/**
	 * Load temporary credentials from the EC2 IMDSv2 instance metadata service: fetch a session
	 * token (PUT /latest/api/token), use it to discover the attached instance-profile role name,
	 * then fetch that role's credentials.
	 * @see https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/instance-metadata-v2-how-it-works.html
	 *
	 * @return Struct { accessKeyId, secretAccessKey, sessionToken, expiration } or null if IMDS
	 *         is unreachable or no role is attached
	 */
	private any function loadImdsCredentials(){
		try {
			var tokenResult = http( url = "http://169.254.169.254/latest/api/token" )
				.method( "PUT" )
				.timeout( 1 )
				.throwOnError( false )
				.header( "X-aws-ec2-metadata-token-ttl-seconds", "21600" )
				.send();

			if ( val( listFirst( tokenResult.statusCode, " " ) ) != 200 ) {
				return null;
			}
			var token = trim( tokenResult.fileContent );

			var roleResult = http( url = "http://169.254.169.254/latest/meta-data/iam/security-credentials/" )
				.method( "GET" )
				.timeout( 1 )
				.throwOnError( false )
				.header( "X-aws-ec2-metadata-token", token )
				.send();

			if ( val( listFirst( roleResult.statusCode, " " ) ) != 200 || !len( trim( roleResult.fileContent ) ) ) {
				return null;
			}
			var role = trim( listFirst( roleResult.fileContent, char( 10 ) ) );

			var credResult = http( url = "http://169.254.169.254/latest/meta-data/iam/security-credentials/#role#" )
				.method( "GET" )
				.timeout( 1 )
				.throwOnError( false )
				.header( "X-aws-ec2-metadata-token", token )
				.send();

			if ( val( listFirst( credResult.statusCode, " " ) ) != 200 ) {
				return null;
			}

			var body = jsonDeserialize( credResult.fileContent );

			// Same rule as the container endpoint: a 200 with no key material is a failed
			// resolution, not an empty-but-valid credential set to cache behind an expiry.
			if ( !len( body.AccessKeyId ?: "" ) || !len( body.SecretAccessKey ?: "" ) ) {
				return null;
			}

			return {
				accessKeyId     : body.AccessKeyId,
				secretAccessKey : body.SecretAccessKey,
				sessionToken    : body.Token ?: "",
				expiration      : len( body.Expiration ?: "" ) ? parseDateTime( body.Expiration ) : dateAdd( "n", 60, now() )
			};
		} catch ( any e ) {
			writeLog(
				text: "Bedrock: failed to load EC2 IMDSv2 instance-role credentials: #e.message#",
				type: "warning",
				log : "ai"
			);
			return null;
		}
	}

	/**
	 * True when this service should authenticate with a Bedrock long-term API key (bearer
	 * token) instead of AWS SigV4 request signing.
	 *
	 * Bearer auth is explicit opt-in ONLY — an explicit `bearerToken` passed to configure(), or
	 * the AWS_BEARER_TOKEN_BEDROCK environment variable. It is NEVER inferred from a generic
	 * `apiKey` value: aiService()/aiChat() inject the module-wide settings.apiKey (or a
	 * BEDROCK_API_KEY env var) into every provider's options as a plain string, including
	 * Bedrock's, so treating any non-empty apiKey as a bearer token would make a caller with (say)
	 * a global OpenAI key and no AWS credentials silently attempt Bedrock bearer auth with the
	 * wrong key.
	 *
	 * Explicit/env AWS credentials always WIN over bearer auth regardless: bearer auth is only
	 * used when NO AWS access key is available at all (variables.awsAccessKeyId is empty after
	 * struct + environment resolution) AND a bearer token is present — kept as cheap insurance
	 * even though bearerToken/AWS_BEARER_TOKEN_BEDROCK are already explicit opt-ins.
	 */
	public boolean function useBearerAuth(){
		if ( len( variables.awsAccessKeyId ) ) {
			return false;
		}
		return len( variables.bearerToken ) > 0
			|| len( getSystemSetting( "AWS_BEARER_TOKEN_BEDROCK", "" ) ) > 0;
	}

	/**
	 * The bearer token to use when useBearerAuth() is true: the explicit `bearerToken` config
	 * value, falling back to the AWS_BEARER_TOKEN_BEDROCK environment variable.
	 */
	public string function getBearerToken(){
		if ( len( variables.bearerToken ) > 0 ) {
			return variables.bearerToken;
		}
		return getSystemSetting( "AWS_BEARER_TOKEN_BEDROCK", "" );
	}

	/**
	 * Get the Bedrock endpoint URL for the configured region/baseURL and model
	 *
	 * @modelIdOrArn The model ID or inference profile / provisioned-model ARN to invoke
	 *
	 * @return The full endpoint URL
	 */
	public string function getBedrockEndpoint( required string modelIdOrArn ){
		return "#getBedrockScheme()#://#getBedrockHost()##getBedrockPath( arguments.modelIdOrArn )#";
	}

	/**
	 * Get the Bedrock host: the configured baseURL's host (scheme, path, and port-carrying
	 * authority aside — port stays with the host) when an override is set, otherwise the
	 * standard regional Bedrock runtime host. This is used for both the request URL and the
	 * SigV4/request "Host" header, so the two always agree. Any path prefix carried by baseURL
	 * (e.g. "/bedrock" in "https://proxy.internal/bedrock") is NOT part of the host — see
	 * getBedrockPathPrefix(), which is prepended to the request path instead.
	 */
	public string function getBedrockHost(){
		if ( !len( variables.baseURL ) ) {
			return "bedrock-runtime.#variables.region#.amazonaws.com";
		}
		return listFirst( reReplaceNoCase( variables.baseURL, "^[a-z][a-z0-9+.-]*://", "", "one" ), "/" );
	}

	/**
	 * The path prefix carried by baseURL, if any (e.g. "bedrock" for
	 * "https://proxy.internal/bedrock"), with any leading/trailing slashes stripped. Empty string
	 * when baseURL has no path component — the common case: a bare host, or no override at all.
	 *
	 * Prepended to the request path in getBedrockPath()/getBedrockStreamPath() so a proxy/gateway
	 * sitting in front of Bedrock at a sub-path is supported for both the wire URL and the path
	 * signed by AwsSignatureV4 — previously getBedrockHost()'s listFirst() silently discarded
	 * everything in baseURL after the host.
	 */
	private string function getBedrockPathPrefix(){
		if ( !len( variables.baseURL ) ) {
			return "";
		}
		var withoutScheme = reReplaceNoCase( variables.baseURL, "^[a-z][a-z0-9+.-]*://", "", "one" );
		// Guard listRest() with find() first: with no delimiter present it does not reliably
		// return "" (see the same pattern in BaseRegistry.bx's key.listRest( "@" ) usage).
		if ( !withoutScheme.find( "/" ) ) {
			return "";
		}
		var prefix = withoutScheme.listRest( "/" );
		if ( !len( prefix ) ) {
			return "";
		}
		return ( right( prefix, 1 ) == "/" ) ? left( prefix, len( prefix ) - 1 ) : prefix;
	}

	/**
	 * The URL scheme to use — "http" only when baseURL explicitly opts into it (e.g. a local
	 * LocalStack/proxy endpoint), "https" otherwise (including the default AWS endpoint).
	 */
	private string function getBedrockScheme(){
		return ( len( variables.baseURL ) && variables.baseURL.reFindNoCase( "^http://" ) > 0 ) ? "http" : "https";
	}

	/**
	 * Get the request path for a model invocation.
	 *
	 * The Bedrock InvokeModel API has exactly one route — POST /model/{modelId}/invoke — where
	 * {modelId} accepts a plain model ID or an inference-profile / application-inference-profile
	 * / provisioned-model ARN. There is no separate "/application-inference-profile/..." route.
	 * Any baseURL path prefix (see getBedrockPathPrefix()) is prepended ahead of "/model/...", so
	 * a proxy/gateway mounted at a sub-path is reachable.
	 *
	 * The modelId/ARN is percent-encoded as a single opaque path segment (including its literal
	 * ":" and, for ARNs, "/" characters) exactly once here — this ENCODED form is both what goes
	 * on the wire AND what is passed, unchanged, as AwsSignatureV4.signRequest()'s `path`
	 * argument. signRequest() re-encodes it a SECOND time internally (via its private
	 * uriEncodePath()) when building the canonical request — that double-encoding is deliberate
	 * and correct: it is AWS's documented "double URI-encode except S3" canonical-request rule
	 * (matches botocore's own SigV4 implementation), not a bug. Passing a RAW/unencoded path into
	 * signRequest() instead would single-encode the canonical request and produce a signature
	 * mismatch against what AWS computes for the actual (encoded) wire path. Sharing the exact
	 * same already-encoded string for both the wire path and the signer's `path` argument is what
	 * keeps the two in agreement.
	 *
	 * @modelIdOrArn The model ID or ARN to invoke
	 */
	public string function getBedrockPath( required string modelIdOrArn ){
		var prefix = getBedrockPathPrefix();
		return "#len( prefix ) ? ( '/' & prefix ) : ''#/model/#encodeBedrockModelId( arguments.modelIdOrArn )#/invoke";
	}

	/**
	 * Get the Bedrock streaming endpoint URL for the configured region/baseURL and model
	 *
	 * @modelIdOrArn The model ID or ARN to invoke
	 *
	 * @return The full streaming endpoint URL
	 */
	public string function getBedrockStreamEndpoint( required string modelIdOrArn ){
		return "#getBedrockScheme()#://#getBedrockHost()##getBedrockStreamPath( arguments.modelIdOrArn )#";
	}

	/**
	 * Get the request path for a streaming model invocation. See getBedrockPath() for the
	 * routing + encoding + baseURL-path-prefix rationale — same rules, "-with-response-stream"
	 * suffix.
	 *
	 * @modelIdOrArn The model ID or ARN to invoke
	 */
	public string function getBedrockStreamPath( required string modelIdOrArn ){
		var prefix = getBedrockPathPrefix();
		return "#len( prefix ) ? ( '/' & prefix ) : ''#/model/#encodeBedrockModelId( arguments.modelIdOrArn )#/invoke-with-response-stream";
	}

	/**
	 * Percent-encode a Bedrock model ID or ARN as a single opaque path segment, using the same
	 * per-character encoding AwsSignatureV4 applies when building the canonical request (see
	 * AwsSignatureV4.uriEncodeComponent()). Encodes literal ":" (present in most model IDs, e.g.
	 * "anthropic.claude-3-sonnet-20240229-v1:0") and, for ARNs, "/" as well — both are otherwise
	 * illegal/ambiguous in a URL path segment.
	 *
	 * @modelIdOrArn The model ID or ARN to encode
	 */
	public string function encodeBedrockModelId( required string modelIdOrArn ){
		return new AwsSignatureV4().encodeComponent( arguments.modelIdOrArn );
	}

	/**
	 * Get the request path for a Converse call — POST /model/{modelId}/converse. Same routing,
	 * encoding and baseURL-path-prefix rules as getBedrockPath(); see that method's docblock for
	 * the (deliberate) double-encoding rationale.
	 *
	 * @modelIdOrArn The model ID or ARN to invoke
	 */
	public string function getConversePath( required string modelIdOrArn ){
		var prefix = getBedrockPathPrefix();
		return "#len( prefix ) ? ( '/' & prefix ) : ''#/model/#encodeBedrockModelId( arguments.modelIdOrArn )#/converse";
	}

	/**
	 * Get the request path for a ConverseStream call — POST /model/{modelId}/converse-stream.
	 *
	 * @modelIdOrArn The model ID or ARN to invoke
	 */
	public string function getConverseStreamPath( required string modelIdOrArn ){
		var prefix = getBedrockPathPrefix();
		return "#len( prefix ) ? ( '/' & prefix ) : ''#/model/#encodeBedrockModelId( arguments.modelIdOrArn )#/converse-stream";
	}

	/**
	 * Get the request path for a CountTokens call — POST /model/{modelId}/count-tokens.
	 *
	 * @modelIdOrArn The model ID or ARN to count against
	 */
	public string function getCountTokensPath( required string modelIdOrArn ){
		var prefix = getBedrockPathPrefix();
		return "#len( prefix ) ? ( '/' & prefix ) : ''#/model/#encodeBedrockModelId( arguments.modelIdOrArn )#/count-tokens";
	}

	/**
	 * The request path for one Bedrock runtime operation. Single seam so the send functions take
	 * an operation name rather than each growing an if/else over four path builders.
	 *
	 * @modelIdOrArn The model ID or ARN
	 * @operation    "invoke" | "invoke-with-response-stream" | "converse" | "converse-stream" | "count-tokens"
	 */
	public string function getBedrockOperationPath( required string modelIdOrArn, required string operation ){
		switch ( arguments.operation ) {
			case "converse":
				return getConversePath( arguments.modelIdOrArn );
			case "converse-stream":
				return getConverseStreamPath( arguments.modelIdOrArn );
			case "count-tokens":
				return getCountTokensPath( arguments.modelIdOrArn );
			case "invoke-with-response-stream":
				return getBedrockStreamPath( arguments.modelIdOrArn );
			case "invoke":
			default:
				return getBedrockPath( arguments.modelIdOrArn );
		}
	}

	/**
	 * The full endpoint URL for one Bedrock runtime operation.
	 *
	 * @modelIdOrArn The model ID or ARN
	 * @operation    See getBedrockOperationPath()
	 */
	public string function getBedrockOperationEndpoint( required string modelIdOrArn, required string operation ){
		return "#getBedrockScheme()#://#getBedrockHost()##getBedrockOperationPath( arguments.modelIdOrArn, arguments.operation )#";
	}

	/**
	 * Decide which Bedrock runtime API this request speaks: "converse" or "invoke".
	 *
	 * Configured precedence, highest first. NOTE this is NOT the shape the other Bedrock settings
	 * use: region and credentials resolve caller > module setting > environment, whereas
	 * bedrockApi ranks the ENVIRONMENT above the module setting, so an operator can force one API
	 * for a deployment without editing the module config:
	 *   0. a runtime decision already settled on for THIS request (a Converse -> InvokeModel
	 *      fallback, or a resume restoring the API the conversation was built in). It outranks
	 *      even the caller's option because AWS has already refused to honour that option, and it
	 *      is cleared at the top of the next logical call so the caller's pin governs again.
	 *   1. `providerOptions.bedrockApi` on the request itself
	 *   2. the `BOXLANG_MODULES_BXAI_BEDROCK_API` environment variable
	 *   3. the `bxai_bedrockApi` key in the application scope, when there is one
	 *   4. the configured module setting (`settings.providers.Bedrock.options.bedrockApi`, applied
	 *      onto variables.bedrockApi by configure())
	 *   5. static.DEFAULT_BEDROCK_API ("converse")
	 * An unrecognized value is ignored rather than throwing — it falls through to the next source.
	 *
	 * Then the AUTOMATIC fallbacks, which override whatever the chain resolved. Converse cannot
	 * express these requests at all, so honouring a configured "converse" would just produce an
	 * AWS 400:
	 *   a. the model id matches static.NO_CONVERSE_MODEL_PATTERNS (text-completion models with no
	 *      `messages[]` conversation representation)
	 *   b. the request carries `providerOptions.rawBody` — the invoke-only escape hatch, whose
	 *      whole point is to put a hand-built native vendor body on the wire
	 * The third fallback trigger (a Converse ValidationException saying the model or operation is
	 * unsupported) can only be observed AFTER a call, so it lives in chat()/chatStream(); see
	 * shouldFallbackToInvoke().
	 *
	 * @chatRequest The request being sent (read-only)
	 * @modelId     The resolved Bedrock model id
	 *
	 * @return "converse" or "invoke"
	 */
	public string function resolveBedrockApi( required AiBaseRequest chatRequest, required string modelId, boolean honourRuntimeDecision = true ){
		var sources = [
			// 0. The RUNTIME decision, ranked above even the caller's own option. A Converse ->
			// InvokeModel fallback records the API it settled on in the request's private runtime
			// slot (stickBedrockApi()). That is what makes the decision sticky: every later
			// resolve on this request — the tool-loop recursion, the resume path, the dialect
			// helpers — sees the API the conversation is actually being built in rather than
			// re-resolving "converse" and rebuilding Converse-dialect blocks the invoke body
			// cannot express. It outranks the caller option because by the time it is set, AWS has
			// already refused to honour that option; it is cleared at the top of the next logical
			// call, so the caller's pin governs again from the next request on.
			// honourRuntimeDecision=false is countTokens(): it counts what the NEXT logical call
			// will send, and that call clears the stick before it resolves.
			arguments.honourRuntimeDecision ? stuckBedrockApi( arguments.chatRequest ) : "",
			arguments.chatRequest.getProviderOption( "bedrockApi", "" ),
			variables.bedrockApiFromEnv ?: "",
			applicationScopeSetting( "bxai_bedrockApi" ),
			variables.bedrockApi ?: ""
		];

		var api = static.DEFAULT_BEDROCK_API;
		for ( var source in sources ) {
			if ( isSimpleValue( source ) && static.BEDROCK_APIS.contains( lcase( trim( source ) ) ) ) {
				api = lcase( trim( source ) );
				break;
			}
		}

		if ( api == "invoke" ) {
			return "invoke";
		}

		// (a) A model Converse has no representation for.
		if ( isNoConverseModel( arguments.modelId ) ) {
			logConverseFallbackOnce( arguments.modelId, "the model id is on the known no-Converse list" );
			return "invoke";
		}

		// (b) The invoke-only escape hatch.
		var rawBody = arguments.chatRequest.getProviderOption( "rawBody", "" );
		if ( ( isStruct( rawBody ) && !rawBody.isEmpty() ) || ( isSimpleValue( rawBody ) && len( rawBody ) ) ) {
			logConverseFallbackOnce( arguments.modelId, "providerOptions.rawBody is an InvokeModel-only escape hatch" );
			return "invoke";
		}

		return "converse";
	}

	/**
	 * Record the runtime-chosen Bedrock API on the REQUEST, so every later resolveBedrockApi()
	 * for this request returns it.
	 *
	 * Written to the request's OWN runtime slot, never to providerOptions. providerOptions is an
	 * alias of the caller's struct (AiChatRequest.init() takes it by reference, and
	 * AiBaseRunnable.getMergedOptions() hands the same struct to every request built from those
	 * options), so writing `bedrockApi` there pinned "invoke" permanently onto the caller's own
	 * options — every subsequent request skipped Converse, and an explicit caller pin of
	 * "converse" was silently overwritten by one transient AWS ValidationException.
	 *
	 * @chatRequest The request the decision belongs to
	 * @bedrockApi  "converse" or "invoke"
	 */
	private void function stickBedrockApi( required AiBaseRequest chatRequest, required string bedrockApi ){
		if ( structKeyExists( arguments.chatRequest, "setRuntimeOption" ) ) {
			arguments.chatRequest.setRuntimeOption( static.RUNTIME_BEDROCK_API_KEY, arguments.bedrockApi );
		}
	}

	/**
	 * The runtime-chosen Bedrock API for this request, or "" when none has been settled on.
	 *
	 * @chatRequest The request to read
	 */
	private string function stuckBedrockApi( required AiBaseRequest chatRequest ){
		if ( !structKeyExists( arguments.chatRequest, "getRuntimeOption" ) ) {
			return "";
		}
		var stuckValue = arguments.chatRequest.getRuntimeOption( static.RUNTIME_BEDROCK_API_KEY, "" );
		return isSimpleValue( stuckValue ) ? stuckValue : "";
	}

	/**
	 * Drop any runtime API decision left on this request, so a fresh logical call re-resolves from
	 * the configured chain instead of inheriting the previous run's fallback. Called at the top of
	 * chat()/chatStream() for the FIRST turn of a run only — a resume deliberately restores the
	 * persisted decision (see the `bedrockApi` suspend payload), and turns 2+ of a tool loop must
	 * keep speaking whatever dialect turn 1 settled on.
	 *
	 * @chatRequest The request starting a new logical call
	 */
	private void function clearStuckBedrockApi( required AiBaseRequest chatRequest ){
		if ( structKeyExists( arguments.chatRequest, "clearRuntimeOption" ) ) {
			arguments.chatRequest.clearRuntimeOption( static.RUNTIME_BEDROCK_API_KEY );
		}
	}

	/**
	 * One simple value out of a resume context, accepted either at its top level or inside the
	 * `suspendData` the checkpointer round-tripped (AiAgent.resume() hands back the whole saved
	 * state, with the suspend payload under `suspendData`).
	 *
	 * @resumeCtx The resume context
	 * @key       The key to read
	 */
	private string function resumeSuspendValue( required struct resumeCtx, required string key ){
		var direct = arguments.resumeCtx[ arguments.key ] ?: "";
		if ( isSimpleValue( direct ) && len( direct ) ) {
			return direct;
		}
		var suspendData = arguments.resumeCtx.suspendData ?: "";
		if ( isStruct( suspendData ) ) {
			var nested = suspendData[ arguments.key ] ?: "";
			if ( isSimpleValue( nested ) && len( nested ) ) {
				return nested;
			}
		}
		return "";
	}

	/**
	 * Read one key from the application scope, or "" when there is no application scope in this
	 * context (a scheduled task, a CLI run, a unit test). Reading `application` outside an
	 * application boundary throws, so the probe is guarded — the absence of an application scope
	 * is a normal condition here, not an error worth logging on every request.
	 *
	 * @key The application-scope key to read
	 */
	private string function applicationScopeSetting( required string key ){
		try {
			if ( isDefined( "application" ) && isStruct( application ) && application.keyExists( arguments.key ) ) {
				var value = application[ arguments.key ];
				return isSimpleValue( value ) ? value : "";
			}
		} catch ( any e ) {
			// No application scope in this context — fall through to the next configured source.
		}
		return "";
	}

	/**
	 * Whether a model id is one Converse cannot serve (see static.NO_CONVERSE_MODEL_PATTERNS).
	 *
	 * @modelId The Bedrock model ID or ARN (any case)
	 */
	public boolean function isNoConverseModel( required string modelId ){
		for ( var pattern in static.NO_CONVERSE_MODEL_PATTERNS ) {
			if ( reFindNoCase( pattern, arguments.modelId ) > 0 ) {
				return true;
			}
		}
		return false;
	}

	/**
	 * Log an InvokeModel fallback exactly once per model id AND REASON per JVM, at info on the
	 * `ai` log. The set lives in static.CONVERSE_FALLBACK_LOGGED for the same reason
	 * CREDENTIAL_CACHE does: aiService() constructs a fresh provider per call, so an
	 * instance-scoped set would make "once" mean "every request".
	 *
	 * Keyed on model id + reason, not the model id alone: resolveBedrockApi() writes this key from
	 * its read-only resolution path (rawBody / the no-Converse list), so a model that had ever
	 * resolved that way permanently silenced the far more interesting runtime log — the one saying
	 * a Converse call FAILED with a ValidationException and was re-sent over InvokeModel.
	 *
	 * @modelId The model id that fell back
	 * @reason  Why it fell back, for the log line
	 */
	private void function logConverseFallbackOnce( required string modelId, required string reason ){
		var logKey = arguments.modelId & "|" & arguments.reason;
		if ( static.CONVERSE_FALLBACK_LOGGED.keyExists( logKey ) ) {
			return;
		}
		static.CONVERSE_FALLBACK_LOGGED[ logKey ] = true;
		writeLog(
			text: "Bedrock: falling back from the Converse API to InvokeModel for model [#arguments.modelId#] — #arguments.reason#",
			type: "info",
			log : "ai"
		);
	}

	/**
	 * Whether a failed Converse call should be retried once over InvokeModel.
	 *
	 * TRUE only for a `ValidationException` whose message says the model or the operation is not
	 * supported — that is AWS telling us this particular model cannot serve Converse, which is
	 * exactly what the fallback exists for. Every other failure (throttling, access denied, a
	 * genuinely malformed request, a 5xx) must surface, not be silently re-sent against a
	 * different API and a different body.
	 *
	 * AWS publishes no verbatim wording for these messages, so this matches the sentence shape
	 * (static.CONVERSE_UNSUPPORTED_PATTERN) rather than a literal string, and only in combination
	 * with the ValidationException name.
	 *
	 * @errorMessage The AWS error body/message text
	 */
	public boolean function shouldFallbackToInvoke( required string errorMessage ){
		if ( !arguments.errorMessage.findNoCase( "ValidationException" ) ) {
			return false;
		}
		// A feature-level 400 is AWS accurately describing THIS request. Falling back would send
		// the same unsupported feature over InvokeModel and replace the accurate message with a
		// generic one, so the AWS text is surfaced verbatim instead.
		// Checked against the RAW message: the veto words are field paths (toolResult.status), and
		// stripping model ids would take them with it.
		if ( reFindNoCase( static.CONVERSE_FEATURE_ERROR_PATTERN, arguments.errorMessage ) > 0 ) {
			return false;
		}
		// Conditions InvokeModel is subject to as well (throughput mode, IAM, throttling). Also
		// checked RAW: the scrub eats "on-demand" and the model id the message is complaining
		// about, and an inference-profile ARN is exactly what CONVERSE_MODEL_ID_PATTERN removes.
		if ( reFindNoCase( static.CONVERSE_FALLBACK_VETO_PATTERN, arguments.errorMessage ) > 0 ) {
			return false;
		}
		// Model ids and ARNs out first: they are dotted, so they broke the proximity window
		// between the subject ("the model ...") and the verb ("does not support"), and they carry
		// words ("image", "document") that read as request features.
		var scrubbed = reReplaceNoCase( arguments.errorMessage, static.CONVERSE_MODEL_ID_PATTERN, " ", "all" );
		return reFindNoCase( static.CONVERSE_UNSUPPORTED_PATTERN, scrubbed ) > 0;
	}

	/**
	 * Whether this request may still be re-sent over InvokeModel at all.
	 *
	 * The fallback rebuilds the body from chatRequest.getMessages() against a DIFFERENT API. That
	 * is only safe on the first turn: from turn 2 the conversation contains Converse-dialect
	 * blocks the tool loop appended ({ toolUse }, { toolResult }, bare { text }), which the
	 * per-vendor InvokeModel transforms either pass to the model verbatim (Claude: a hard 400) or
	 * drop entirely in flattenMessageContent() (every other family: an empty conversation, and a
	 * model answering from nothing). A mid-loop Converse failure must surface as itself.
	 *
	 * @chatRequest      The request whose messages would be rebuilt
	 * @interactionCount The tool-loop turn (0 = the first call of this run)
	 */
	private boolean function canFallbackToInvoke( required AiChatRequest chatRequest, required numeric interactionCount ){
		if ( arguments.interactionCount > 0 ) {
			return false;
		}
		return !hasConverseDialectMessages( arguments.chatRequest.getMessages() );
	}

	/**
	 * Whether any message already carries a Converse-dialect content block — a caller-supplied
	 * conversation replayed from a previous Converse run counts just as much as one this tool
	 * loop built, so the check is over the CONTENT, not over a turn counter.
	 *
	 * @messages The conversation
	 */
	private boolean function hasConverseDialectMessages( required array messages ){
		for ( var msg in arguments.messages ) {
			if ( !isStruct( msg ) ) {
				continue;
			}
			var content = msg.content ?: "";
			if ( !isArray( content ) ) {
				continue;
			}
			for ( var part in content ) {
				if ( !isStruct( part ) ) {
					continue;
				}
				// A Converse ContentBlock is a single-member union with no discriminating `type`;
				// every normalized module shape HAS a `type`.
				if ( part.keyExists( "type" ) ) {
					continue;
				}
				for ( var member in static.CONVERSE_CONTENT_BLOCK_KEYS ) {
					if ( part.keyExists( member ) ) {
						return true;
					}
				}
			}
		}
		return false;
	}

	/**
	 * Detect the model family from the model ID
	 *
	 * @modelId The Bedrock model ID
	 *
	 * @return The model family: "claude", "titan", "llama", "cohere", "mistral", or "openai"
	 */
	private string function detectModelFamily( required string modelId ){
		var id = arguments.modelId.lcase();

		if ( id.findNoCase( "anthropic" ) || id.findNoCase( "claude" ) ) {
			return "claude";
		} else if ( id.findNoCase( "amazon.titan" ) ) {
			return "titan";
		} else if ( id.findNoCase( "meta.llama" ) ) {
			return "llama";
		} else if ( id.findNoCase( "cohere" ) ) {
			return "cohere";
		} else if ( isLegacyMistral( id ) ) {
			return "mistral";
		} else if ( id.startsWith( "arn:" ) ) {
			// Opaque inference-profile / provisioned-model ARNs carry no vendor substring in
			// the id itself, so none of the checks above can match. These previously fell
			// through to the Claude default and worked for Claude-backed profiles (the common
			// case) — preserve that explicitly instead of silently routing them into the
			// openai fallback below (400).
			return "claude";
		}

		// Every other Bedrock family — ai21 Jamba (OpenAI-shaped; no dedicated branch needed),
		// zai/GLM, qwen, deepseek, moonshotai/Kimi, minimax, nvidia/Nemotron, google/gemma,
		// modern Mistral (Ministral 3, Magistral, Devstral, Voxtral, Mistral-Large-2407+),
		// plain openai/gpt-oss, Amazon Nova and anything unrecognized — is served by Converse by
		// default; this family name only decides the InvokeModel body, where they all speak the
		// OpenAI chat-completions shape on Bedrock.
		// Defaulting here (rather than to Claude) means an unsupported model fails loudly
		// against the wrong shape instead of transformResponseFromClaude() silently returning "".
		return "openai";
	}

	/**
	 * Legacy Mistral models (7B-Instruct, Mixtral, Mistral-Large/Small-2402) use the raw
	 * <s>[INST] prompt/outputs shape. Newer Mistral models (Ministral 3, Magistral,
	 * Devstral, Voxtral, Mistral-Large-2407+) are OpenAI-shaped and reject that legacy
	 * format with a 400. Anchored to the start of the id or a region-prefix dot (e.g.
	 * "eu.mistral.mixtral-...") so region-prefixed ids still match, and case-insensitive
	 * regardless of caller casing.
	 *
	 * @id The Bedrock model ID (any case)
	 *
	 * @return True if this is a legacy, prompt-shaped Mistral model
	 */
	private boolean function isLegacyMistral( required string id ){
		return reFindNoCase( static.LEGACY_MISTRAL_PATTERN, arguments.id ) > 0;
	}

	/**
	 * Legacy Cohere Command models (command-text-*, command-light-text-*) use the raw
	 * { prompt, ... } generate shape and have no tools / chat_history representation.
	 * Command R and R+ (cohere.command-r*) use the chat shape and do support tools.
	 *
	 * @id The Bedrock model ID (any case)
	 *
	 * @return True if this is a legacy, prompt-shaped Cohere Command model
	 */
	private boolean function isLegacyCohere( required string id ){
		return reFindNoCase( static.LEGACY_COHERE_PATTERN, arguments.id ) > 0;
	}

	/**
	 * Guard against silently dropping tools / schema-typed structured output on model families
	 * whose Bedrock request transform genuinely has no representation for them: Titan, Llama and
	 * legacy Mistral each have a dedicated, prompt-shaped, tool-less request builder in
	 * transformRequestForModel() (see static.NO_TOOL_SUPPORT_FAMILIES), as does legacy Cohere
	 * Command (command-text-* / command-light-text-*, gated by id rather than by family since
	 * Command R/R+ share the "cohere" family and DO support tools).
	 *
	 * Families that now pass: claude (Messages API tools + forced structured-output tool),
	 * cohere Command R/R+ (tools / parameter_definitions), and openai — the gpt-oss models plus
	 * the catch-all for every other Bedrock family that speaks the OpenAI chat-completions body
	 * (Nova, DeepSeek, Qwen, AI21 Jamba, modern Mistral, GLM, Kimi, …). The catch-all is
	 * deliberately allowed rather than gated: those models take the OpenAI `tools` /
	 * `response_format` fields, and there is no evidence any of them reject that shape. A model
	 * that genuinely does not support tools will now say so itself with a Bedrock 400, which is
	 * more accurate than this module guessing on its behalf.
	 *
	 * @modelFamily The detected model family (see detectModelFamily())
	 * @chatRequest The chat request carrying params.tools / isStructuredOutput()
	 * @modelId     The Bedrock model id, for the id-level (legacy Cohere) gate
	 *
	 * @throws UnsupportedProviderCapability when the family is one of
	 *         static.NO_TOOL_SUPPORT_FAMILIES (or is a legacy Cohere Command id) and the caller
	 *         supplied tools and/or a schema-typed structured output request
	 */
	private void function assertCapabilitySupported(
		required string modelFamily,
		required AiChatRequest chatRequest,
		string modelId    = "",
		string bedrockApi = "invoke"
	){
		var params        = arguments.chatRequest.getParams();
		var hasTools      = isStruct( params ) && params.keyExists( "tools" ) && isArray( params.tools ) && params.tools.len() > 0;
		var hasStructured = arguments.chatRequest.isStructuredOutput();

		if ( !hasTools && !hasStructured ) {
			return;
		}

		var legacyCohere  = ( arguments.modelFamily == "cohere" && isLegacyCohere( arguments.modelId ) );

		if ( arguments.bedrockApi == "converse" ) {
			// Converse has ONE model-agnostic toolConfig, so this module no longer has an opinion
			// about most families — a model that cannot do tools says so itself and AWS's
			// ValidationException is surfaced verbatim. But two cases are known-unserviceable
			// rather than merely unknown, and letting them through only swaps a clear pre-flight
			// error for an AWS 400 on a request that could never have worked:
			//   (a) TOOLS on Titan (no tool-use capability at all) and on legacy Cohere Command
			//       (text-completion models, which resolveBedrockApi() routes off Converse
			//       entirely — so a Converse tool request against one is a contradiction).
			//   (b) SCHEMA-TYPED STRUCTURED OUTPUT, which this module implements on Converse as a
			//       FORCED toolChoice. Titan/Llama/Mistral, legacy Cohere AND Cohere Command R do
			//       not honour a forced tool choice, so the forced block never arrives and chat()
			//       throws StructuredOutputError after a paid round trip.
			//       Cohere is gated for the WHOLE family, Command R included: AWS documents
			//       toolChoice support for Anthropic, Mistral Large and Nova only, so Command R
			//       takes the toolConfig and then answers with prose whenever it feels like it.
			//       Command R keeps working for plain TOOLS (which it does support) — this gates
			//       only the forced-choice structured-output path.
			// @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolChoice.html
			var converseToolsGated      = hasTools && ( arguments.modelFamily == "titan" || legacyCohere );
			var converseStructuredGated = hasStructured
				&& ( static.NO_TOOL_SUPPORT_FAMILIES.contains( arguments.modelFamily ) || arguments.modelFamily == "cohere" );
			if ( !converseToolsGated && !converseStructuredGated ) {
				return;
			}
			var converseCapability = converseToolsGated && converseStructuredGated
				? "tools and schema-typed structured output"
				: ( converseToolsGated ? "tools" : "schema-typed structured output (a forced toolChoice)" );
			var converseLabel = legacyCohere ? "legacy cohere Command" : arguments.modelFamily;
			writeLog(
				text: "Bedrock model family '#converseLabel#' does not support #converseCapability# over the Converse API",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "UnsupportedProviderCapability",
				message: "Bedrock model family '#converseLabel#' does not support #converseCapability# on the Converse API. "
					& capabilityRemediation( converseStructuredGated )
			);
		}

		var familyGated   = static.NO_TOOL_SUPPORT_FAMILIES.contains( arguments.modelFamily ) || legacyCohere;
		// Cohere Command R/R+ takes `tools`, but Bedrock's Cohere chat body documents no
		// response_format — schema-typed structured output stays gated for the whole family
		// rather than silently degrading into "parse whatever prose came back".
		var structuredGated = familyGated || arguments.modelFamily == "cohere";

		var blockedTools      = hasTools && familyGated;
		var blockedStructured = hasStructured && structuredGated;

		if ( !blockedTools && !blockedStructured ) {
			return;
		}

		var capability = blockedTools && blockedStructured
			? "tools and schema-typed structured output"
			: ( blockedTools ? "tools" : "schema-typed structured output" );
		var label = legacyCohere ? "legacy cohere Command" : arguments.modelFamily;

		writeLog(
			text: "Bedrock model family '#label#' does not support #capability# — this module's request transform for this family has no representation for it on Bedrock",
			type: "error",
			log : "ai"
		);

		throw(
			type   : "UnsupportedProviderCapability",
			message: "Bedrock model family '#label#' does not support #capability#. "
				& capabilityRemediation( blockedStructured )
		);
	}

	/**
	 * The "use one of these instead" half of an UnsupportedProviderCapability message.
	 *
	 * Cohere Command R is only recommended for TOOL CALLING. It is not a way out of a
	 * structured-output gate on either API: Bedrock honours a forced toolChoice for Anthropic,
	 * Mistral Large and Nova only, so Command R takes the forced block and then answers with
	 * prose — recommending it there just moved the failure to a StructuredOutputError one paid
	 * round trip later.
	 *
	 * @structuredBlocked Whether schema-typed structured output is (part of) what was refused
	 */
	private string function capabilityRemediation( required boolean structuredBlocked ){
		if ( arguments.structuredBlocked ) {
			return "Use a Claude (anthropic.claude-*) or OpenAI-shaped (openai.gpt-oss-*) model on Bedrock for "
				& "schema-typed structured output; Cohere Command R (cohere.command-r*) supports tool calling but "
				& "does not honour the forced tool choice structured output is built on.";
		}
		return "Use a Claude (anthropic.claude-*), OpenAI-shaped (openai.gpt-oss-*) or Cohere Command R "
			& "(cohere.command-r*) model on Bedrock for tool calling.";
	}

	/**
	 * Refuse schema-typed structured output on the STREAMING InvokeModel path for the OpenAI-shaped
	 * families.
	 *
	 * The sync InvokeModel path serves these models' structured output through their native
	 * `response_format`, read back off the finished response body. Streaming has nowhere to read it
	 * back from: the streaming accumulator only knows how to collect a FORCED TOOL block (Claude's,
	 * and Converse's synthetic one), and no openai.* body on Bedrock produces one. So the request
	 * ran, was billed, streamed prose, and then either returned prose where a typed struct was
	 * promised or died in the populator. Refused BEFORE the call instead.
	 *
	 * @modelFamily The detected model family
	 * @bedrockApi  The resolved runtime API ("converse" | "invoke")
	 * @chatRequest The chat request
	 *
	 * @throws UnsupportedProviderCapability
	 */
	private void function assertStreamingStructuredOutputSupported(
		required string modelFamily,
		required string bedrockApi,
		required AiChatRequest chatRequest
	){
		if (
			arguments.bedrockApi == "converse"
			|| arguments.modelFamily != "openai"
			|| !arguments.chatRequest.isStructuredOutput()
		) {
			return;
		}

		writeLog(
			text: "Bedrock: schema-typed structured output is not supported when STREAMING an OpenAI-shaped model over InvokeModel "
				& "(the native response_format is only readable from a complete response body)",
			type: "error",
			log : "ai"
		);
		throw(
			type   : "UnsupportedProviderCapability",
			message: "Bedrock model family 'openai' does not support schema-typed structured output when streaming over InvokeModel "
				& "(its native response_format can only be read back from a complete response). "
				& "Use chat() instead of chatStream(), or the Converse API (bedrockApi='converse'). "
				& capabilityRemediation( true )
		);
	}

	/**
	 * Transform an OpenAI-format request to Bedrock model-specific format
	 *
	 * @messages    Array of messages in OpenAI format
	 * @params      Additional parameters
	 * @modelFamily The detected model family
	 * @modelId     The Bedrock model ID (used by the Cohere transform to pick chat vs generate)
	 *
	 * @return Struct formatted for the specific Bedrock model
	 */
	private struct function transformRequestForModel(
		required array messages,
		required struct params,
		required string modelFamily,
		string modelId = ""
	){
		switch ( arguments.modelFamily ) {
			case "claude":
				return transformRequestForClaude( arguments.messages, arguments.params );
			case "cohere":
				return transformRequestForCohere( arguments.messages, arguments.params, arguments.modelId );
			case "titan":
				return transformRequestForTitan( arguments.messages, arguments.params );
			case "llama":
				return transformRequestForLlama( arguments.messages, arguments.params );
			case "mistral":
				return transformRequestForMistral( arguments.messages, arguments.params );
			case "openai":
			default:
				// ai21 and every other unmapped family speak the OpenAI shape on Bedrock
				return transformRequestForOpenAI( arguments.messages, arguments.params, arguments.modelId );
		}
	}

	// ==============================================================================================
	// Converse API — request transform (#272)
	// ==============================================================================================

	/**
	 * Build a Bedrock Converse / ConverseStream request body.
	 *
	 * One transform for every model family: Converse is model-agnostic, so the six per-vendor
	 * request builders above collapse into this. The module's normalized (OpenAI-shaped) messages
	 * become typed Converse content blocks; anything Converse does not model natively
	 * (`thinking`, `top_k`, `reasoning_effort`, `anthropic_beta`, …) is forwarded verbatim in
	 * `additionalModelRequestFields`, where AWS hands it straight to the underlying model.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_Converse.html
	 *
	 * @chatRequest The request (for providerOptions and the structured-output schema)
	 * @messages    The conversation messages, in the module's normalized shape OR already in
	 *              Converse content-block shape (the transform is idempotent — see
	 *              converseContentBlocks())
	 * @params      The caller params
	 * @modelId     The Bedrock model id
	 *
	 * @return The Converse request body
	 */
	private struct function transformRequestForConverse(
		required AiBaseRequest chatRequest,
		required array messages,
		required struct params,
		required string modelId,
		string operation = "converse"
	){
		var result           = {};
		var systemBlocks     = [];
		var converseMessages = [];

		for ( var msg in arguments.messages ) {
			var role = msg.role ?: "user";

			if ( role == "system" ) {
				systemBlocks.append( converseSystemBlocks( msg ), true );
				continue;
			}

			var blocks = converseContentBlocks( msg );
			if ( !blocks.len() ) {
				continue;
			}

			// Converse requires strictly alternating user/assistant turns, and the module's tool
			// loop appends one `role: "tool"` (or one Claude tool_result user) message PER tool
			// call. Merge consecutive same-role turns into one message with several content
			// blocks — otherwise a two-tool turn is rejected outright with a ValidationException.
			var converseRole = ( role == "assistant" ) ? "assistant" : "user";
			if ( converseMessages.len() && converseMessages.last().role == converseRole ) {
				converseMessages.last().content.append( blocks, true );
				continue;
			}
			converseMessages.append( { "role": converseRole, "content": blocks } );
		}

		result[ "messages" ] = converseMessages;

		// A caller-supplied params.system fills in when no real system message exists — matches
		// transformRequestForClaude()'s precedence.
		var paramsSystem = arguments.params.system ?: "";
		if ( !systemBlocks.len() && isArray( paramsSystem ) ) {
			// An ARRAY params.system (Anthropic's block form, which the InvokeModel path accepts
			// verbatim) used to reach trim() and throw. Map each entry onto a SystemContentBlock,
			// carrying a cache_control marker across as the sibling cachePoint block Converse
			// models a checkpoint with.
			for ( var systemPart in paramsSystem ) {
				if ( isSimpleValue( systemPart ) ) {
					if ( len( trim( systemPart ) ) ) {
						systemBlocks.append( { "text": systemPart } );
					}
					continue;
				}
				if ( !isStruct( systemPart ) ) {
					continue;
				}
				if ( len( systemPart.text ?: "" ) ) {
					systemBlocks.append( { "text": systemPart.text } );
				}
				if ( systemPart.keyExists( "cachePoint" ) ) {
					systemBlocks.append( { "cachePoint": systemPart.cachePoint } );
				} else if ( systemPart.keyExists( "cache_control" ) && !isNull( systemPart.cache_control ) ) {
					systemBlocks.append( { "cachePoint": { "type": "default" } } );
				}
			}
		} else if ( !systemBlocks.len() && isSimpleValue( paramsSystem ) && len( trim( paramsSystem ) ) ) {
			systemBlocks.append( { "text": paramsSystem } );
		}
		if ( systemBlocks.len() ) {
			result[ "system" ] = systemBlocks;
		}

		// ---- inferenceConfig -------------------------------------------------------------------
		var inferenceConfig = {};
		// Cast explicitly: a numeric STRING ("512", "0.7") — which is what every one of these
		// arrives as from a config file, an env var or a URL param — was serialized back out as a
		// JSON string, and Converse's inferenceConfig is typed (integer / float), so AWS rejected
		// the request outright.
		var maxTokens       = arguments.params.max_tokens ?: arguments.params.max_completion_tokens ?: arguments.params.max_gen_len ?: "";
		if ( isNumeric( maxTokens ) ) {
			inferenceConfig[ "maxTokens" ] = javacast( "int", val( maxTokens ) );
		}
		if ( isNumeric( arguments.params.temperature ?: "" ) ) {
			inferenceConfig[ "temperature" ] = javacast( "double", val( arguments.params.temperature ) );
		}
		if ( isNumeric( arguments.params.top_p ?: "" ) ) {
			inferenceConfig[ "topP" ] = javacast( "double", val( arguments.params.top_p ) );
		}
		var stopSequences = arguments.params.stop_sequences ?: arguments.params.stop ?: "";
		if ( isArray( stopSequences ) && stopSequences.len() ) {
			inferenceConfig[ "stopSequences" ] = stopSequences;
		} else if ( isSimpleValue( stopSequences ) && len( stopSequences ) ) {
			inferenceConfig[ "stopSequences" ] = [ stopSequences ];
		}
		if ( !inferenceConfig.isEmpty() ) {
			result[ "inferenceConfig" ] = inferenceConfig;
		}

		// ---- toolConfig ------------------------------------------------------------------------
		var toolSpecs = [];
		if ( isArray( arguments.params.tools ?: "" ) && arguments.params.tools.len() ) {
			toolSpecs = formatToolsForConverse( arguments.params.tools );
		}

		// Structured output is a forced synthetic tool on the Converse path for EVERY family —
		// Converse's toolConfig is model-agnostic, so the Claude-only gate the InvokeModel path
		// needs does not apply here.
		var wantsStructured = arguments.chatRequest.isStructuredOutput();
		if ( wantsStructured ) {
			toolSpecs.append( {
				"toolSpec" : {
					"name"        : static.STRUCTURED_OUTPUT_TOOL,
					"description" : "Record the response as structured data that conforms to the required JSON schema.",
					"inputSchema" : { "json": SchemaBuilder::cleanSchema( arguments.chatRequest.getStructuredOutput() ) }
				}
			} );
		}

		// tool_choice "none" means "do not call a tool". Converse's ToolChoice union has no `none`
		// member, so converseToolChoice() maps it to {} — which sent the tools with NO toolChoice,
		// i.e. Converse's default of `auto`. The only way to express "none" on this API is to omit
		// toolConfig altogether. Structured output forces a tool and therefore overrides it.
		var suppressTools = !wantsStructured && lcase( trim( arguments.params.tool_choice ?: "" ) ) == "none";
		if ( suppressTools ) {
			writeLog(
				text: "Bedrock Converse: tool_choice 'none' — omitting toolConfig entirely (Converse has no ToolChoice 'none' member, so sending the tools would let the model call them)",
				type: "debug",
				log : "ai"
			);
		}

		if ( toolSpecs.len() && !suppressTools ) {
			var toolConfig = { "tools": toolSpecs };
			var toolChoice = wantsStructured
				? { "tool": { "name": static.STRUCTURED_OUTPUT_TOOL } }
				: converseToolChoice( arguments.params.tool_choice ?: "" );
			if ( isStruct( toolChoice ) && !toolChoice.isEmpty() ) {
				toolConfig[ "toolChoice" ] = toolChoice;
			}
			result[ "toolConfig" ] = toolConfig;
		}

		// ---- guardrailConfig / performanceConfig -----------------------------------------------
		// First-class Converse fields, sourced from the SAME providerOptions the InvokeModel path
		// sends as X-Amzn-Bedrock-* headers (see buildProviderOptionHeaders(), still used there),
		// so a caller does not have to know which API is on the wire.
		var providerOptions = arguments.chatRequest.getProviderOptions();
		// buildProviderOptionHeaders() STRIPS every x-amzn-bedrock-guardrail*/trace header on the
		// Converse path, because Converse models them in the body instead. So the body form has to
		// accept the header spellings too (and the bedrockHeaders shorthand), or a caller who set
		// guardrails the header way silently ran with NO guardrail at all on the default API.
		// Struct keys are case-insensitive, so the lookups below cover any header casing.
		var guardrailHeaders = isStruct( providerOptions.bedrockHeaders ?: "" ) ? providerOptions.bedrockHeaders : {};
		var guardrailId      = providerOptionOrHeader( providerOptions, guardrailHeaders, "guardrailIdentifier", "X-Amzn-Bedrock-GuardrailIdentifier" );
		var guardrailVersion = providerOptionOrHeader( providerOptions, guardrailHeaders, "guardrailVersion", "X-Amzn-Bedrock-GuardrailVersion" );
		var guardrailTrace   = providerOptionOrHeader( providerOptions, guardrailHeaders, "guardrailTrace", "X-Amzn-Bedrock-Trace" );

		if ( len( guardrailId ) && len( guardrailVersion ) ) {
			var guardrailConfig = {
				"guardrailIdentifier" : guardrailId,
				"guardrailVersion"    : guardrailVersion
			};
			if ( len( guardrailTrace ) ) {
				guardrailConfig[ "trace" ] = guardrailTrace.lcase();
			}
			// streamProcessingMode lives on ConverseStream's GuardrailStreamConfiguration only —
			// Converse's own GuardrailConfiguration has no such member, and sending it there is an
			// unknown-field 400.
			if ( arguments.operation == "converse-stream" && len( providerOptions.guardrailStreamProcessingMode ?: "" ) ) {
				guardrailConfig[ "streamProcessingMode" ] = providerOptions.guardrailStreamProcessingMode;
			}
			result[ "guardrailConfig" ] = guardrailConfig;
		} else if ( len( guardrailId ) || len( guardrailVersion ) || len( guardrailTrace ) ) {
			// Something guardrail-shaped was supplied but could not be mapped onto Converse's
			// GuardrailConfiguration (which requires BOTH identifier and version). The header form
			// is stripped on this path, so saying nothing would mean running unguarded.
			writeLog(
				text: "Bedrock Converse: guardrail provider options were supplied but could not be mapped onto guardrailConfig "
					& "(identifier=#len( guardrailId ) ? "set" : "missing"#, version=#len( guardrailVersion ) ? "set" : "missing"#) — "
					& "the X-Amzn-Bedrock-Guardrail* headers are NOT sent on the Converse API, so this request runs WITHOUT a guardrail",
				type: "warning",
				log : "ai"
			);
		}

		// ---- response_format ------------------------------------------------------------------
		// Converse has NO response_format field (it is not in CONVERSE_NATIVE_PARAMS' company by
		// accident — it IS listed there precisely so it is never forwarded to
		// additionalModelRequestFields, where the model would reject it). When the module is doing
		// structured output itself, the forced tool above already covers it. Otherwise the caller
		// asked for a response shape that this API silently cannot honour, so say so.
		if ( !wantsStructured && !isNull( arguments.params.response_format ) && !isEmpty( arguments.params.response_format ) ) {
			writeLog(
				text: "Bedrock Converse: `response_format` was supplied but the Converse API has no such field — it was DROPPED and this request runs with no response-format constraint. "
					& "Use the module's structured output (aiChatRequest().structuredOutput()) or set bedrockApi='invoke' for a model whose native body supports it",
				type: "warning",
				log : "ai"
			);
		}

		// The header spelling is X-Amzn-Bedrock-PerformanceConfig-Latency; the Converse field is
		// performanceConfig.latency ("standard" | "optimized").
		var latency = providerOptionOrHeader( providerOptions, guardrailHeaders, "performanceConfigLatency", "X-Amzn-Bedrock-PerformanceConfig-Latency" );
		if ( isSimpleValue( latency ) && len( latency ) ) {
			result[ "performanceConfig" ] = { "latency": latency.lcase() };
		}

		if ( isArray( providerOptions.additionalModelResponseFieldPaths ?: "" ) && providerOptions.additionalModelResponseFieldPaths.len() ) {
			result[ "additionalModelResponseFieldPaths" ] = providerOptions.additionalModelResponseFieldPaths;
		}
		if ( isStruct( providerOptions.requestMetadata ?: "" ) && !providerOptions.requestMetadata.isEmpty() ) {
			result[ "requestMetadata" ] = providerOptions.requestMetadata;
		}

		// ---- additionalModelRequestFields ------------------------------------------------------
		// Everything Converse does not model itself, forwarded verbatim to the model: Claude's
		// `thinking`, `top_k` and `anthropic_beta`, `reasoning_effort`, and anything a future
		// vendor adds. Passing these through is what keeps Converse from being a downgrade
		// against the hand-built per-vendor bodies it replaces.
		var extraFields = {};
		for ( var key in arguments.params ) {
			if ( listFindNoCase( static.CONVERSE_NATIVE_PARAMS, key ) ) {
				continue;
			}
			extraFields[ key ] = arguments.params[ key ];
		}
		if ( isStruct( providerOptions.additionalModelRequestFields ?: "" ) ) {
			extraFields.append( providerOptions.additionalModelRequestFields, true );
		}
		if ( !extraFields.isEmpty() ) {
			result[ "additionalModelRequestFields" ] = extraFields;
		}

		return result;
	}

	/**
	 * Build the Converse `system[]` blocks for one system message: text plus, when the message
	 * carries a `cache_control` marker (on the message or inside its blocks), a sibling
	 * `cachePoint` entry. Converse models a cache checkpoint as its own array ELEMENT rather than
	 * as a property of the block it follows — see the prompt-caching docs.
	 *
	 * @msg The system message
	 *
	 * @return Array of SystemContentBlock structs
	 */
	private array function converseSystemBlocks( required struct msg ){
		var blocks        = [];
		var needCachePoint = arguments.msg.keyExists( "cache_control" ) && !isNull( arguments.msg.cache_control );

		if ( isArray( arguments.msg.content ?: "" ) ) {
			for ( var part in arguments.msg.content ) {
				if ( !isStruct( part ) ) {
					continue;
				}
				if ( part.keyExists( "cachePoint" ) ) {
					blocks.append( { "cachePoint": part.cachePoint } );
					continue;
				}
				var text = part.text ?: "";
				if ( len( text ) ) {
					blocks.append( { "text": text } );
				}
				if ( part.keyExists( "cache_control" ) && !isNull( part.cache_control ) ) {
					needCachePoint = true;
				}
			}
		} else {
			var systemText = flattenMessageContent( arguments.msg.content ?: "" );
			if ( len( systemText ) ) {
				blocks.append( { "text": systemText } );
			}
		}

		if ( needCachePoint ) {
			blocks.append( { "cachePoint": { "type": "default" } } );
		}

		return blocks;
	}

	/**
	 * Turn one non-system message into Converse content blocks.
	 *
	 * Accepts the module's normalized shapes AND blocks that are ALREADY Converse-shaped, so a
	 * follow-up turn built by buildToolAssistantMessage()/buildToolResultMessage() with the
	 * "converse" dialect survives a second pass through this transform unchanged (the tool loop
	 * re-transforms the whole conversation on every turn).
	 *
	 * @msg The message
	 *
	 * @return Array of ContentBlock structs
	 */
	private array function converseContentBlocks( required struct msg ){
		var blocks = [];
		var role   = arguments.msg.role ?: "user";

		// An OpenAI-shaped `role: "tool"` result message. It can carry a cache_control marker like
		// any other turn, so it falls through to the same cachePoint append below.
		if ( role == "tool" ) {
			blocks.append( converseToolResultBlock( arguments.msg.tool_call_id ?: "", arguments.msg.content ?: "" ) );
			if ( arguments.msg.keyExists( "cache_control" ) && !isNull( arguments.msg.cache_control ) ) {
				blocks.append( { "cachePoint": { "type": "default" } } );
			}
			return blocks;
		}

		var content = arguments.msg.content ?: "";

		if ( isSimpleValue( content ) ) {
			if ( len( content ) ) {
				blocks.append( { "text": content } );
			}
		} else if ( isArray( content ) ) {
			for ( var part in content ) {
				var block = converseContentBlock( part );
				if ( isStruct( block ) && !block.isEmpty() ) {
					blocks.append( block );
				}
			}
		} else {
			blocks.append( { "text": content.toString() } );
		}

		// An OpenAI-shaped assistant turn carries its tool calls beside the content, not in it.
		if ( isArray( arguments.msg.tool_calls ?: "" ) ) {
			for ( var toolCall in arguments.msg.tool_calls ) {
				blocks.append( {
					"toolUse" : {
						"toolUseId" : toolCall.id ?: "",
						"name"      : toolCallName( toolCall ),
						"input"     : toolCallArgs( toolCall )
					}
				} );
			}
		}

		if ( arguments.msg.keyExists( "cache_control" ) && !isNull( arguments.msg.cache_control ) ) {
			blocks.append( { "cachePoint": { "type": "default" } } );
		}

		return blocks;
	}

	/**
	 * Map one content part onto a Converse ContentBlock. Returns an empty struct for anything
	 * Converse has no representation for (which is then skipped by the caller).
	 *
	 * @part One content part, in any of the module's shapes or already Converse-shaped
	 */
	private struct function converseContentBlock( required any part ){
		if ( isSimpleValue( arguments.part ) ) {
			return len( arguments.part ) ? { "text": arguments.part } : {};
		}
		if ( !isStruct( arguments.part ) ) {
			return {};
		}

		// Already Converse-shaped: a ContentBlock is a union with exactly one member and no
		// discriminating `type` key, which is precisely what the module's own block shapes have.
		if ( !arguments.part.keyExists( "type" ) ) {
			for ( var member in static.CONVERSE_CONTENT_BLOCK_KEYS ) {
				if ( arguments.part.keyExists( member ) ) {
					return arguments.part;
				}
			}
			return {};
		}

		switch ( arguments.part.type ) {
			case "text":
				return len( arguments.part.text ?: "" ) ? { "text": arguments.part.text } : {};

			case "image_url":
				// OpenAI shape: { type: "image_url", image_url: { url } } — a data URI carries the
				// bytes Converse needs; a remote http(s) URL does not, and Converse's ImageSource
				// has no url member, so there is nothing to send.
				// The url may be given as the scalar itself ({ type: "image_url", image_url: "data:..." }),
				// a shape several callers and OpenAI-compatible clients emit; reading `.url` off a
				// string silently produced an empty block and dropped the image.
				var imageUrlPart = arguments.part.image_url ?: "";
				var imageUrl     = isStruct( imageUrlPart )
					? ( imageUrlPart.url ?: "" )
					: ( isSimpleValue( imageUrlPart ) ? imageUrlPart : "" );
				return converseMediaBlock( "image", imageUrl, "" );

			case "image":
				// Anthropic shape: { type: "image", source: { type: "base64", media_type, data } }
				var imgSource = arguments.part.source ?: {};
				if ( isStruct( imgSource ) && len( imgSource.data ?: "" ) ) {
					return {
						"image" : {
							"format" : converseImageFormat( imgSource.media_type ?: "" ),
							"source" : { "bytes": imgSource.data }
						}
					};
				}
				return converseMediaBlock( "image", imgSource.url ?: "", "" );

			case "document":
			case "file":
				var docSource = arguments.part.source ?: {};
				// The format is derived from the RAW name: converseDocumentName() strips "." (it
				// is not in Converse's allowed name character set), so normalizing first would
				// leave converseDocumentFormat()'s extension fallback with nothing to read and
				// turn every docx/xlsx/pdf with a generic MIME type into "txt".
				var rawDocName = arguments.part.name ?: "";
				if ( isStruct( docSource ) && len( docSource.data ?: "" ) ) {
					return {
						"document" : {
							"format" : converseDocumentFormat( docSource.media_type ?: "", rawDocName ),
							"name"   : converseDocumentName( rawDocName ),
							"source" : { "bytes": docSource.data }
						}
					};
				}
				return converseMediaBlock( "document", ( isStruct( docSource ) ? ( docSource.url ?: "" ) : "" ), rawDocName );

			case "video":
				// AiMessage.video()/videoFile(): { type: "video", video: { url } }. Only a data URI
				// carries the bytes Converse's VideoSource needs (same rule as image/document).
				var vidSource = arguments.part.video ?: {};
				if ( isStruct( vidSource ) && len( vidSource.data ?: "" ) ) {
					return {
						"video" : {
							"format" : converseVideoFormat( vidSource.media_type ?: "" ),
							"source" : { "bytes": vidSource.data }
						}
					};
				}
				return converseMediaBlock( "video", ( isStruct( vidSource ) ? ( vidSource.url ?: "" ) : "" ), "" );

			case "tool_use":
				return {
					"toolUse" : {
						"toolUseId" : arguments.part.id ?: "",
						"name"      : arguments.part.name ?: "",
						"input"     : isStruct( arguments.part.input ?: "" ) ? arguments.part.input : {}
					}
				};

			case "tool_result":
				return converseToolResultBlock( arguments.part.tool_use_id ?: "", arguments.part.content ?: "" );

			case "thinking":
				var reasoningText = { "text": arguments.part.thinking ?: "" };
				// The signature is opaque and MUST be round-tripped unmodified or the next turn is
				// rejected — the same contract the InvokeModel path honours by never touching the
				// native thinking blocks.
				if ( len( arguments.part.signature ?: "" ) ) {
					reasoningText[ "signature" ] = arguments.part.signature;
				}
				return { "reasoningContent": { "reasoningText": reasoningText } };

			case "redacted_thinking":
				return { "reasoningContent": { "redactedContent": arguments.part.data ?: "" } };

			default:
				return {};
		}
	}

	/**
	 * Build an image/document block from a URL-ish source. Converse's ImageSource/DocumentSource
	 * carry raw `bytes`, so only a `data:` URI can be converted here; a remote http(s) URL is
	 * dropped with a warning rather than being silently turned into prose that reads like the
	 * model saw the file.
	 *
	 * @kind "image", "document" or "video"
	 * @url  The source URL (data: URI or remote)
	 * @name The RAW (un-normalized) document name — documents only; the format is derived from it
	 *       before the name itself is normalized (see converseDocumentName()).
	 */
	private struct function converseMediaBlock( required string kind, required string url, string name = "" ){
		if ( !len( arguments.url ) ) {
			return {};
		}

		var parsed = parseDataUri( arguments.url );
		if ( parsed.isEmpty() ) {
			writeLog(
				text: "Bedrock Converse: dropping a #arguments.kind# content block sourced from a remote URL — Converse carries #arguments.kind# bytes inline and has no URL source. Embed the file (aiMessage().imageFile()/documentFile()) or use bedrockApi: ""invoke"".",
				type: "warning",
				log : "ai"
			);
			return {};
		}

		if ( arguments.kind == "image" ) {
			return {
				"image" : {
					"format" : converseImageFormat( parsed.mimeType ),
					"source" : { "bytes": parsed.data }
				}
			};
		}

		if ( arguments.kind == "video" ) {
			return {
				"video" : {
					"format" : converseVideoFormat( parsed.mimeType ),
					"source" : { "bytes": parsed.data }
				}
			};
		}

		return {
			"document" : {
				"format" : converseDocumentFormat( parsed.mimeType, arguments.name ),
				"name"   : converseDocumentName( arguments.name ),
				"source" : { "bytes": parsed.data }
			}
		};
	}

	/**
	 * Split a `data:<mime>;base64,<payload>` URI into its parts.
	 *
	 * @uri The candidate URI
	 *
	 * @return { mimeType, data }, or an empty struct when this is not a base64 data URI
	 */
	private struct function parseDataUri( required string uri ){
		if ( reFindNoCase( "^data:", arguments.uri ) == 0 || !arguments.uri.find( "," ) ) {
			return {};
		}
		var header  = arguments.uri.listFirst( "," );
		var payload = arguments.uri.listRest( "," );
		if ( !header.findNoCase( "base64" ) || !len( payload ) ) {
			return {};
		}
		// "data:;base64,..." / "data:base64,..." carry NO media type. listFirst(";") then returned
		// the literal "base64" as the mime type, which converseImageFormat() read as the subtype
		// and mapped to png. A missing type is missing, not "base64".
		var declaredMime = reReplaceNoCase( header, "^data:", "", "one" ).listFirst( ";" );
		return {
			"mimeType" : declaredMime.find( "/" ) ? declaredMime : "",
			"data"     : payload
		};
	}

	/**
	 * Map a MIME type onto a Converse ImageBlock `format` enum value (png|jpeg|gif|webp).
	 * Anything unrecognized defaults to png — the format is metadata AWS uses to decode the
	 * bytes, and an absent/invalid value is a hard 400.
	 *
	 * @mimeType The source MIME type, e.g. "image/jpeg"
	 */
	private string function converseImageFormat( required string mimeType ){
		var subtype = arguments.mimeType.listLast( "/" ).lcase();
		if ( subtype == "jpg" ) {
			subtype = "jpeg";
		}
		return listFindNoCase( static.CONVERSE_IMAGE_FORMATS, subtype ) ? subtype : "png";
	}

	/**
	 * Map a MIME type onto a Converse VideoBlock `format` enum value. Anything unrecognized
	 * defaults to mp4 — the format is how AWS decodes the bytes, and an absent/invalid value is a
	 * hard 400.
	 *
	 * @mimeType The source MIME type, e.g. "video/quicktime"
	 */
	private string function converseVideoFormat( required string mimeType ){
		var subtype = arguments.mimeType.listLast( "/" ).lcase();
		if ( subtype == "quicktime" ) {
			subtype = "mov";
		} else if ( subtype == "x-msvideo" || subtype == "x-ms-wmv" ) {
			subtype = ( subtype == "x-ms-wmv" ) ? "wmv" : "mp4";
		} else if ( subtype == "x-matroska" ) {
			subtype = "mkv";
		} else if ( subtype == "3gpp" ) {
			subtype = "three_gp";
		}
		return listFindNoCase( static.CONVERSE_VIDEO_FORMATS, subtype ) ? subtype : "mp4";
	}

	/**
	 * Map a MIME type (falling back to the document name's extension) onto a Converse
	 * DocumentBlock `format` enum value.
	 *
	 * @mimeType The source MIME type
	 * @name     The document name, used when the MIME type is absent or generic
	 */
	private string function converseDocumentFormat( required string mimeType, string name = "" ){
		var subtype = arguments.mimeType.listLast( "/" ).lcase();
		// application/vnd.openxmlformats-officedocument.wordprocessingml.document etc. never map
		// by subtype; fall through to the file extension for those.
		if ( listFindNoCase( static.CONVERSE_DOCUMENT_FORMATS, subtype ) ) {
			return subtype;
		}
		if ( subtype == "plain" ) {
			return "txt";
		}
		var extension = arguments.name.contains( "." ) ? arguments.name.listLast( "." ).lcase() : "";
		return listFindNoCase( static.CONVERSE_DOCUMENT_FORMATS, extension ) ? extension : "txt";
	}

	/**
	 * Converse constrains DocumentBlock.name to alphanumerics, single spaces, hyphens,
	 * parentheses and square brackets (AWS calls out prompt-injection risk in file names), so a
	 * caller-supplied name is normalized rather than rejected.
	 *
	 * @name The requested document name
	 */
	private string function converseDocumentName( required string name ){
		var cleaned = trim( reReplace( arguments.name, "[^a-zA-Z0-9 \-\(\)\[\]]", " ", "all" ) );
		cleaned     = trim( reReplace( cleaned, " +", " ", "all" ) );
		return len( cleaned ) ? left( cleaned, 200 ) : "document";
	}

	/**
	 * Build a Converse `toolResult` content block.
	 *
	 * A struct/array result goes on the wire as a `json` block (Converse's own typed carrier)
	 * rather than being stringified; everything else becomes a `text` block.
	 *
	 * `status` is emitted ONLY for a failure. AWS documents ToolResultBlock.status as "only
	 * supported by Amazon Nova and Anthropic Claude 3 and 4 models", and "success" is its default
	 * — so sending it unconditionally bought nothing and handed every other family an unknown
	 * field to reject. A model that rejects the member now only ever meets it on a call that
	 * genuinely failed, where saying so is worth the risk.
	 *
	 * @toolUseId The toolUseId being answered
	 * @content   The tool result
	 * @status    "error" when the tool loop KNOWS this call failed (blocked, cancelled, tool not
	 *            found); "" when the caller has no such flag, in which case the module's own
	 *            blocked/not-found marker text is the only remaining signal.
	 */
	private struct function converseToolResultBlock( required string toolUseId, required any content, string status = "" ){
		var block   = { "toolUseId": arguments.toolUseId };
		var isError = ( arguments.status == "error" );

		if ( isStruct( arguments.content ) || isArray( arguments.content ) ) {
			block[ "content" ] = [ { "json": arguments.content } ];
		} else {
			var text = isSimpleValue( arguments.content ) ? arguments.content : arguments.content.toString();
			block[ "content" ] = [ { "text": text } ];
			// No status means the caller supplied this tool result themselves (a replayed
			// foreign-dialect history). Sniffing its TEXT for this module's own blocked/not-found
			// marker wording mislabelled any tool whose legitimate output happened to start that
			// way as an error; every result this module builds passes an explicit status.
		}

		if ( isError ) {
			block[ "status" ] = "error";
		}
		return { "toolResult": block };
	}

	/**
	 * Format the request's tools as Converse `Tool` union entries.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ToolConfiguration.html
	 *
	 * @tools The tools to format
	 */
	private array function formatToolsForConverse( required array tools ){
		return arguments.tools.map( ( tool ) => {
			var argumentsSchema = tool.getArgumentsSchema();
			return {
				"toolSpec" : {
					"name"        : tool.getName(),
					"description" : tool.getDescription(),
					"inputSchema" : {
						"json" : {
							"type"       : "object",
							"properties" : argumentsSchema.properties,
							"required"   : argumentsSchema.required
						}
					}
				}
			};
		} );
	}

	/**
	 * Map the module's `tool_choice` vocabulary onto Converse's ToolChoice union.
	 *
	 *   "auto"                                   -> { auto: {} }
	 *   "required" / "any"                       -> { any: {} }
	 *   "none"                                   -> {} (no toolConfig.toolChoice; Converse has no
	 *                                               "none" member — omitting it is the closest)
	 *   { type: "tool", name }                   -> { tool: { name } }
	 *   { type: "function", function: { name } } -> { tool: { name } }
	 *   already-Converse { auto|any|tool: ... }  -> passthrough
	 *
	 * @toolChoice The caller's tool_choice value
	 */
	public struct function converseToolChoice( required any toolChoice ){
		if ( isSimpleValue( arguments.toolChoice ) ) {
			switch ( lcase( trim( arguments.toolChoice ) ) ) {
				case "auto":
					return { "auto": {} };
				case "any":
				case "required":
					return { "any": {} };
				default:
					return {};
			}
		}

		if ( !isStruct( arguments.toolChoice ) ) {
			return {};
		}

		for ( var member in [ "auto", "any", "tool" ] ) {
			if ( arguments.toolChoice.keyExists( member ) ) {
				return arguments.toolChoice;
			}
		}

		var name = arguments.toolChoice.name ?: "";
		if ( !len( name ) && isStruct( arguments.toolChoice.function ?: "" ) ) {
			name = arguments.toolChoice.function.name ?: "";
		}
		if ( len( name ) ) {
			return { "tool": { "name": name } };
		}

		var choiceType = lcase( arguments.toolChoice.type ?: "" );
		if ( choiceType == "any" || choiceType == "required" ) {
			return { "any": {} };
		}
		if ( choiceType == "auto" ) {
			return { "auto": {} };
		}
		return {};
	}

	/**
	 * Transform request for Claude models on Bedrock
	 * Uses Claude Messages API format with Bedrock-specific wrapper
	 */
	private struct function transformRequestForClaude( required array messages, required struct params ){
		// Passthrough-with-exclusions: forward every caller param except the ones this
		// transform rebuilds itself (model, stream, messages, tools — see below) or
		// overwrites/defaults (anthropic_version, max_tokens). Built via a shallow,
		// key-by-key copy rather than params.duplicate(): duplicate() deep-copies the
		// whole struct including tool objects, and BoxLang's DuplicationUtil throws on
		// non-Serializable Java objects a tool may hold (e.g. a Thread). A shallow copy
		// never recurses into tools' object graph. "system" is intentionally NOT
		// excluded here — see the system/message split below for why.
		var result = {};
		for ( var key in arguments.params ) {
			if ( !listFindNoCase( "model,stream,messages,tools", key ) ) {
				result[ key ] = arguments.params[ key ];
			}
		}

		result[ "anthropic_version" ] = "bedrock-2023-05-31";
		result[ "max_tokens" ]        = arguments.params.max_tokens ?: 4096;

		// Separate system message from other messages.
		//
		// `system` is emitted as a plain string whenever it can be — that is the shape every
		// existing caller and test expects. It is promoted to Anthropic's array-of-blocks form
		// ONLY when a system message actually needs it: content that is already block-shaped, or
		// a `cache_control` marker (on the message, or inside its blocks) that a flattened string
		// would silently drop, taking prompt caching with it.
		// @see https://docs.aws.amazon.com/bedrock/latest/userguide/prompt-caching.html
		var systemPrompt         = "";
		var systemBlocks         = [];
		var systemNeedsBlocks    = false;
		var conversationMessages = [];

		for ( var msg in arguments.messages ) {
			if ( msg.role == "system" ) {
				if ( isArray( msg.content ) ) {
					systemNeedsBlocks = true;
					systemBlocks.append( msg.content, true );
					systemPrompt = flattenMessageContent( msg.content );
					continue;
				}

				systemPrompt = isSimpleValue( msg.content ) ? msg.content : msg.content.toString();

				var systemBlock = { "type": "text", "text": systemPrompt };
				if ( isStruct( msg ) && msg.keyExists( "cache_control" ) && !isNull( msg.cache_control ) ) {
					systemBlock[ "cache_control" ] = msg.cache_control;
					systemNeedsBlocks              = true;
				}
				systemBlocks.append( systemBlock );
			} else {
				// Preserve structured content (arrays of tool_use / tool_result blocks)
				// as-is; only flatten non-simple, non-array content. Flattening arrays
				// with toString() would break multi-turn tool conversations.
				conversationMessages.append( {
					"role"    : msg.role,
					"content" : ( isSimpleValue( msg.content ) || isArray( msg.content ) ) ? msg.content : msg.content.toString()
				} );
			}
		}

		result[ "messages" ] = conversationMessages;

		// A real system message wins over a caller-supplied params.system (matches
		// ClaudeService); otherwise leave params.system, already copied through above,
		// in place.
		if ( systemNeedsBlocks && systemBlocks.len() ) {
			result[ "system" ] = systemBlocks;
		} else if ( len( trim( systemPrompt ) ) ) {
			result[ "system" ] = systemPrompt;
		}

		// Add tool support if tools are present. Bedrock's Claude Messages API uses
		// the same tool schema as the direct Anthropic Messages API.
		if ( arguments.params?.tools?.len() ) {
			result[ "tools" ] = formatToolsForClaude( arguments.params.tools );
		}

		return result;
	}

	/**
	 * Flatten a message's `content` into a plain string for the legacy (non-Claude) Bedrock
	 * request formats, which only understand a single text blob per message.
	 *
	 * - A plain string is returned as-is (no behavior change for the common case).
	 * - Array-shaped content (image parts, tool_use/tool_result blocks, etc. — as produced by
	 *   Claude-style multi-block messages carried over in conversation history) is reduced to
	 *   just its `type == "text"` parts, joined with a space; non-text parts are skipped rather
	 *   than stringified, since Titan/Llama/Mistral/OpenAI-compatible have no representation for
	 *   them. Previously these transforms did `"..." & msg.content & "..."`, which on an array
	 *   coerced to BoxLang's array-to-string form (unusable prose) instead of the intended text.
	 * - Anything else (e.g. a struct) falls back to its string representation.
	 *
	 * @content A message's `content` value: string, array of content-block structs, or other
	 *
	 * @return The flattened plain-text content
	 */
	public string function flattenMessageContent( required any content ){
		if ( isSimpleValue( arguments.content ) ) {
			return arguments.content;
		}

		if ( isArray( arguments.content ) ) {
			return arguments.content
				.filter( part -> isStruct( part ) && ( part.type ?: "" ) == "text" )
				.map( part -> part.text ?: "" )
				.toList( " " );
		}

		return arguments.content.toString();
	}

	/**
	 * Transform request for Amazon Titan models
	 */
	private struct function transformRequestForTitan( required array messages, required struct params ){
		// Titan uses a simpler format with inputText
		var inputText = "";

		for ( var msg in arguments.messages ) {
			if ( msg.role == "system" ) {
				inputText &= "System: " & flattenMessageContent( msg.content ) & char( 10 );
			} else if ( msg.role == "user" ) {
				inputText &= "User: " & flattenMessageContent( msg.content ) & char( 10 );
			} else if ( msg.role == "assistant" ) {
				inputText &= "Assistant: " & flattenMessageContent( msg.content ) & char( 10 );
			}
		}

		inputText &= "Assistant: ";

		var result = {
			"inputText"            : inputText,
			"textGenerationConfig" : {
				"maxTokenCount" : arguments.params.max_tokens ?: 4096,
				"temperature"   : arguments.params.temperature ?: 0.7,
				"topP"          : arguments.params.top_p ?: 0.9
			}
		};

		return result;
	}

	/**
	 * Transform request for Meta Llama models
	 */
	private struct function transformRequestForLlama( required array messages, required struct params ){
		// Llama uses a prompt-based format
		var prompt = "";

		for ( var msg in arguments.messages ) {
			if ( msg.role == "system" ) {
				prompt &= "<<SYS>>" & char( 10 ) & flattenMessageContent( msg.content ) & char( 10 ) & "<</SYS>>" & char( 10 ) & char( 10 );
			} else if ( msg.role == "user" ) {
				prompt &= "[INST] " & flattenMessageContent( msg.content ) & " [/INST]" & char( 10 );
			} else if ( msg.role == "assistant" ) {
				prompt &= flattenMessageContent( msg.content ) & char( 10 );
			}
		}

		return {
			"prompt"      : prompt,
			"max_gen_len" : arguments.params.max_tokens ?: 2048,
			"temperature" : arguments.params.temperature ?: 0.7,
			"top_p"       : arguments.params.top_p ?: 0.9
		};
	}

	/**
	 * Transform request for Mistral models
	 */
	private struct function transformRequestForMistral( required array messages, required struct params ){
		// Mistral uses a similar format to OpenAI
		var prompt = "";

		for ( var msg in arguments.messages ) {
			if ( msg.role == "user" ) {
				prompt &= "<s>[INST] " & flattenMessageContent( msg.content ) & " [/INST]";
			} else if ( msg.role == "assistant" ) {
				prompt &= flattenMessageContent( msg.content ) & "</s>";
			} else if ( msg.role == "system" ) {
				// Prepend system message to first user message
				prompt = flattenMessageContent( msg.content ) & char( 10 ) & char( 10 ) & prompt;
			}
		}

		return {
			"prompt"      : prompt,
			"max_tokens"  : arguments.params.max_tokens ?: 4096,
			"temperature" : arguments.params.temperature ?: 0.7,
			"top_p"       : arguments.params.top_p ?: 0.9
		};
	}

	/**
	 * Transform request for OpenAI-compatible models on Bedrock (cross-region inference profiles)
	 * These models use the standard OpenAI API format
	 */
	private struct function transformRequestForOpenAI( required array messages, required struct params, string modelId = "" ){
		// Bedrock's InvokeModel body for openai.gpt-oss-* IS the OpenAI Create-chat-completion
		// body — AWS documents it by reference to OpenAI's own parameter list — and every other
		// family that falls through to this transform (Nova, DeepSeek, Qwen, AI21 Jamba, modern
		// Mistral, GLM, Kimi, …) speaks the same shape. So this is a passthrough-with-exclusions
		// like transformRequestForClaude(), not the four-key allow-list it used to be: tools,
		// tool_choice, response_format, reasoning_effort, stop, seed, frequency/presence_penalty
		// and the rest all reach the wire instead of being silently dropped.
		//
		// `model` and `stream` are excluded deliberately: Bedrock populates both from the URL
		// and the operation, and documents that a mismatched value is an error.
		// @see https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters-openai.html
		var result = {};
		for ( var key in arguments.params ) {
			if ( !listFindNoCase( "model,stream,messages,tools,max_tokens,max_completion_tokens", key ) ) {
				result[ key ] = arguments.params[ key ];
			}
		}

		// A COPY, not the live array. Every other transform here builds its messages with a loop,
		// a filter or a slice and so hands back a fresh array; this one passed the caller's array
		// straight through, which made the emitted packet a live view of the conversation. The
		// tool loop appends the assistant turn and the tool results to that same array after the
		// call, so anything holding the packet — FlightRecorder tapes, a middleware that stashed
		// it, a serialized suspend payload — saw messages that were not on the wire.
		result[ "messages" ] = arguments.messages.duplicate();

		// Only one spelling is emitted — sending both is rejected by the OpenAI schema; the other
		// is accepted as an alias on the way in (both are excluded from the passthrough above).
		// max_completion_tokens is the field AWS's own examples use for the `openai.*` models this
		// transform was written for. It is ALSO the catch-all for every family not in
		// transformRequestForModel()'s switch (ai21 and anything new), and those speak plain
		// OpenAI, where the field is max_tokens — emitting the newer spelling to them was an
		// unknown-field rejection.
		var maxTokensValue = arguments.params.max_completion_tokens ?: arguments.params.max_tokens ?: 4096;
		// Anchored on the start OR a dot, so the cross-region inference profile ids AWS returns
		// ("us.openai.gpt-oss-120b-1:0", "eu.openai.…") match too — startsWith() saw only the
		// region prefix and sent max_tokens, which these models reject.
		result[ reFindNoCase( "(^|\.)openai\.", arguments.modelId ) ? "max_completion_tokens" : "max_tokens" ] = maxTokensValue;

		// Tools use the OpenAI function schema, which is exactly what BaseTool.getSchema() emits —
		// the same helper OpenAIService.chat() uses to build its own packet.
		if ( arguments.params?.tools?.len() ) {
			result[ "tools" ] = arguments.params.tools.map( tool -> tool.getSchema() );
		}

		return result;
	}

	/**
	 * Transform request for Cohere models on Bedrock.
	 *
	 * Two genuinely different wire formats live under the "cohere" family:
	 *   - Command R / R+ (cohere.command-r*): the chat shape
	 *     { message, chat_history[{role:USER|CHATBOT, message}], preamble, max_tokens,
	 *       temperature, p, k, stop_sequences, tools[{name,description,parameter_definitions}],
	 *       tool_results }
	 *   - legacy Command (cohere.command-text-*, cohere.command-light-text-*): the generate shape
	 *     { prompt, max_tokens, temperature, p, k, stop_sequences } — no tools, no history.
	 *
	 * Both were previously routed to transformRequestForClaude(), which builds an
	 * anthropic_version/messages body Cohere rejects outright — Cohere-on-Bedrock was not
	 * functional end to end (GitHub #248). transformResponseFromCohere() already understood both
	 * response shapes; this closes the request side so all three switches agree.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters-cohere-command-r-plus.html
	 *
	 * @messages Array of messages in OpenAI format
	 * @params   Additional parameters
	 * @modelId  The Bedrock model ID, used to pick the chat vs generate shape
	 *
	 * @return Struct formatted for the Cohere model
	 */
	private struct function transformRequestForCohere( required array messages, required struct params, string modelId = "" ){
		// Cohere's own parameter names differ from the OpenAI vocabulary the module speaks:
		// top_p -> p, top_k -> k, stop -> stop_sequences. Translate rather than drop.
		var result = {};
		for ( var key in arguments.params ) {
			if ( listFindNoCase( "model,stream,messages,tools,tool_choice,response_format,max_tokens,top_p,top_k,stop", key ) ) {
				continue;
			}
			result[ key ] = arguments.params[ key ];
		}

		result[ "max_tokens" ] = arguments.params.max_tokens ?: 4096;
		if ( arguments.params.keyExists( "p" ) || arguments.params.keyExists( "top_p" ) ) {
			result[ "p" ] = arguments.params.p ?: arguments.params.top_p;
		}
		if ( arguments.params.keyExists( "k" ) || arguments.params.keyExists( "top_k" ) ) {
			result[ "k" ] = arguments.params.k ?: arguments.params.top_k;
		}
		if ( arguments.params.keyExists( "stop_sequences" ) ) {
			result[ "stop_sequences" ] = arguments.params.stop_sequences;
		} else if ( arguments.params.keyExists( "stop" ) ) {
			result[ "stop_sequences" ] = isArray( arguments.params.stop ) ? arguments.params.stop : [ arguments.params.stop ];
		}

		// ---- Fold a completed tool exchange back into Cohere's `tool_results` ----
		// The shared tool loop records an OpenAI-shaped assistant turn (tool_calls) followed by
		// role:"tool" results. Cohere has no such messages: the follow-up turn carries
		// `tool_results` INSTEAD of `message` (they are mutually exclusive unless
		// force_single_step), with `tools` passed again alongside.
		// Only the TRAILING exchange folds: `tool_results` is Cohere's representation of "here is
		// what the tools you JUST asked for returned". Folding every exchange in the conversation
		// re-sent turn 1's and turn 2's results on turn 3 as though the model had only now asked
		// for them — the model saw its own earlier answers arriving again as fresh tool output.
		var toolResults   = [];
		var foldFromIndex = 0;
		for ( var i = arguments.messages.len(); i >= 1; i-- ) {
			var candidate = arguments.messages[ i ];
			if ( isStruct( candidate ) && ( candidate.role ?: "" ) == "tool" ) {
				continue;
			}
			if (
				isStruct( candidate ) && ( candidate.role ?: "" ) == "assistant"
				&& candidate.keyExists( "tool_calls" ) && isArray( candidate.tool_calls )
			) {
				foldFromIndex = i;
			}
			// Any other role ends the trailing block: the tool exchange is over.
			break;
		}

		if ( foldFromIndex ) {
			var trailingCalls = {};
			for ( var call in arguments.messages[ foldFromIndex ].tool_calls ) {
				trailingCalls[ call.id ?: "" ] = call;
			}
			for ( var i = foldFromIndex + 1; i <= arguments.messages.len(); i++ ) {
				var resultMsg = arguments.messages[ i ];
				if ( !isStruct( resultMsg ) || ( resultMsg.role ?: "" ) != "tool" ) {
					continue;
				}
				var sourceCall = trailingCalls[ resultMsg.tool_call_id ?: "" ] ?: {};
				toolResults.append( {
					"call" : {
						"name"       : sourceCall.keyExists( "function" ) ? ( sourceCall.function.name ?: "" ) : "",
						"parameters" : toolCallArgs( sourceCall )
					},
					// Cohere's fine-grained citation logic requires outputs to be a LIST of dicts,
					// even for a single scalar result.
					"outputs" : [ { "result": isSimpleValue( resultMsg.content ) ? resultMsg.content : jsonSerialize( resultMsg.content ) } ]
				} );
			}
		}

		// Everything before the trailing tool exchange is plain conversation. Earlier tool
		// exchanges are NOT replayed as `tool_results` — re-sending old results is what this fold
		// is fixing — but they are not dropped either: they are NARRATED into chat_history as
		// CHATBOT turns. Cohere's chat_history has no tool role, so a dropped exchange meant round
		// 3 had no memory that round 1 had ever called a tool or what it returned, and the model
		// re-asked for the same thing it had already been told.
		var historyUpperBound = foldFromIndex ? foldFromIndex - 1 : arguments.messages.len();
		var priorMessages     = historyUpperBound > 0 ? arguments.messages.slice( 1, historyUpperBound ) : [];
		var conversation      = [];
		// tool_call_id -> the call it answers, for the tool name. Rebuilt as each assistant turn
		// goes by, so an id is resolved against the round it belongs to.
		var priorCalls = {};
		for ( var priorMsg in priorMessages ) {
			if ( !isStruct( priorMsg ) ) {
				continue;
			}
			var priorRole = priorMsg.role ?: "";
			if ( priorRole == "system" ) {
				continue;
			}

			if ( priorRole == "tool" ) {
				var answeredCall = priorCalls[ priorMsg.tool_call_id ?: "" ] ?: {};
				var answeredName = answeredCall.keyExists( "function" ) ? ( answeredCall.function.name ?: "" ) : "";
				var resultText   = isSimpleValue( priorMsg.content ?: "" )
					? ( priorMsg.content ?: "" )
					: jsonSerialize( priorMsg.content );
				conversation.append( {
					"role"    : "assistant",
					"content" : len( answeredName )
						? "Tool #answeredName# returned: #resultText#"
						: "Tool returned: #resultText#"
				} );
				continue;
			}

			if ( priorRole == "assistant" && priorMsg.keyExists( "tool_calls" ) && isArray( priorMsg.tool_calls ) ) {
				for ( var priorCall in priorMsg.tool_calls ) {
					priorCalls[ priorCall.id ?: "" ] = priorCall;
				}
				// Any prose the model streamed alongside its tool call is a real assistant turn and
				// is kept; the tool_calls themselves become the "Tool ... returned" turns above.
				var priorText = flattenMessageContent( priorMsg.content ?: "" );
				if ( len( trim( priorText ) ) ) {
					conversation.append( { "role": "assistant", "content": priorText } );
				}
				continue;
			}

			conversation.append( priorMsg );
		}

		// ---- Legacy Command: a single flattened prompt, nothing else ----
		if ( isLegacyCohere( arguments.modelId ) ) {
			var promptLines = [];
			for ( var msg in arguments.messages ) {
				promptLines.append( flattenMessageContent( msg.content ) );
			}
			result[ "prompt" ] = promptLines.toList( char( 10 ) );
			result.delete( "chat_history" );
			return result;
		}

		// ---- Command R / R+ ----
		var historySource = conversation;
		if ( toolResults.len() ) {
			// Answering tools: every prior turn is history, and `message` must be absent.
			result[ "tool_results" ] = toolResults;
			result.delete( "message" );
		} else {
			// The final message is the turn being answered; everything before it is chat_history.
			result[ "message" ] = conversation.len() ? flattenMessageContent( conversation.last().content ) : "";
			historySource       = conversation.len() > 1 ? conversation.slice( 1, conversation.len() - 1 ) : [];
		}

		if ( historySource.len() ) {
			var history = [];
			for ( var msg in historySource ) {
				history.append( {
					"role"    : msg.role == "assistant" ? "CHATBOT" : ( msg.role == "system" ? "SYSTEM" : "USER" ),
					"message" : flattenMessageContent( msg.content )
				} );
			}
			result[ "chat_history" ] = history;
		}

		// System messages become the preamble. A caller-supplied params.preamble stays in place
		// when there is no real system message (it was copied through above).
		var systemMessages = arguments.messages.filter( msg -> msg.role == "system" );
		if ( systemMessages.len() ) {
			var preambleParts = [];
			for ( var msg in systemMessages ) {
				preambleParts.append( flattenMessageContent( msg.content ) );
			}
			result[ "preamble" ] = preambleParts.toList( char( 10 ) );
		}

		if ( arguments.params?.tools?.len() ) {
			result[ "tools" ] = formatToolsForCohere( arguments.params.tools );
		}

		return result;
	}

	/**
	 * Format tools into Cohere's parameter_definitions schema, mirroring CohereService's own
	 * conversion so a tool behaves identically whether it is called direct or through Bedrock.
	 *
	 * @tools The tools to format
	 *
	 * @return An array of Cohere-shaped tool definitions
	 */
	private array function formatToolsForCohere( required array tools ){
		return arguments.tools.map( tool -> {
			var schema     = tool.getSchema();
			var required   = schema.function.parameters.required ?: [];
			var definition = {
				"name"                  : schema.function.name,
				"description"           : schema.function.description ?: "",
				"parameter_definitions" : {}
			};

			( schema.function.parameters.properties ?: {} ).each( ( paramName, paramDef ) => {
				definition.parameter_definitions[ paramName ] = {
					"type"        : paramDef.type ?: "string",
					"description" : paramDef.description ?: "",
					"required"    : required.findNoCase( paramName ) > 0
				};
			} );

			return definition;
		} );
	}

	/**
	 * Transform Bedrock response to OpenAI-compatible format
	 *
	 * @response    The raw response from Bedrock
	 * @modelFamily The model family
	 * @modelId     The model ID
	 *
	 * @return OpenAI-compatible response struct
	 */
	public struct function transformResponseFromModel(
		required struct response,
		required string modelFamily,
		required string modelId
	){
		switch ( arguments.modelFamily ) {
			case "claude":
				return transformResponseFromClaude( arguments.response, arguments.modelId );
			case "cohere":
				return transformResponseFromCohere( arguments.response, arguments.modelId );
			case "titan":
				return transformResponseFromTitan( arguments.response, arguments.modelId );
			case "llama":
				return transformResponseFromLlama( arguments.response, arguments.modelId );
			case "mistral":
				return transformResponseFromMistral( arguments.response, arguments.modelId );
			case "openai":
			default:
				return transformResponseFromOpenAI( arguments.response, arguments.modelId );
		}
	}

	/**
	 * Derive the model's reasoning from a raw Bedrock body as a plain string, so an OutputGuard
	 * has a copy it can legally rewrite.
	 *
	 * The native carriers are off limits for mutation. Claude's `thinking` blocks must be echoed
	 * back "complete and unmodified" within a tool-use turn or the next request is rejected, so
	 * this reads them without ever writing to them.
	 *
	 * Shape-driven rather than family-driven: the thinking-block and OpenAI-envelope carriers are
	 * mutually exclusive on the wire, so the detected family adds nothing here.
	 *
	 * @response The raw provider body
	 *
	 * @return The reasoning text, or an empty string when the model produced none
	 */
	private string function deriveReasoning( required struct response ){
		// Converse: reasoningContent blocks inside output.message.content. Same read-only contract
		// as the thinking blocks below — the block's `signature` must survive the round trip
		// unmodified, so this derives a caller-facing copy and never writes to the block.
		var converseBlocks = arguments.response.output?.message?.content ?: "";
		if ( isArray( converseBlocks ) ) {
			var reasoningBlocks = converseBlocks.filter( b -> isStruct( b ) && b.keyExists( "reasoningContent" ) );
			if ( reasoningBlocks.len() ) {
				return reasoningBlocks.map( b -> b.reasoningContent?.reasoningText?.text ?: "" ).toList( "" );
			}
		}

		// Claude / Claude-backed inference profiles: typed `thinking` content blocks. Joined with
		// no delimiter, matching ClaudeService and the streaming path's plain concatenation.
		if ( arguments.response.keyExists( "content" ) && isArray( arguments.response.content ) ) {
			var thinkingBlocks = arguments.response.content.filter( b -> isStruct( b ) && ( b.type ?: "" ) == "thinking" );
			if ( thinkingBlocks.len() ) {
				return thinkingBlocks.map( b -> b.thinking ?: "" ).toList( "" );
			}
		}

		// OpenAI-shaped families, in either native spelling (DeepSeek-on-Bedrock uses
		// `reasoning_content`). transformResponseFromOpenAI() returns these bodies verbatim, so
		// without this the unscrubbed native key would be the one the caller reads.
		if ( arguments.response.keyExists( "choices" ) && isArray( arguments.response.choices ) && arguments.response.choices.len() ) {
			var message = arguments.response.choices.first().message ?: "";
			if ( isStruct( message ) ) {
				for ( var candidate in [ "reasoning", "reasoning_content" ] ) {
					if ( message.keyExists( candidate ) && !isNull( message[ candidate ] ) && isSimpleValue( message[ candidate ] ) ) {
						return message[ candidate ];
					}
				}
			}
		}

		return "";
	}

	/**
	 * Copy the derived (and possibly guard-scrubbed) reasoning from the raw body onto the
	 * normalized envelope, so the caller never reads an unscrubbed native spelling.
	 *
	 * @openAIResponse The normalized OpenAI-shaped envelope - MUTATED in place
	 * @rawResponse    The raw provider body carrying the derived `reasoning` key
	 *
	 * @return void
	 */
	private void function applyDerivedReasoning( required any openAIResponse, required struct rawResponse ){
		if ( !arguments.rawResponse.keyExists( "reasoning" ) || !isSimpleValue( arguments.rawResponse.reasoning ) ) {
			return;
		}
		if ( !isStruct( arguments.openAIResponse ) ) {
			return;
		}

		var choices = arguments.openAIResponse.choices ?: [];
		if ( !isArray( choices ) || choices.isEmpty() ) {
			return;
		}

		var message = choices.first().message ?: "";
		if ( !isStruct( message ) ) {
			return;
		}

		var scrubbed = arguments.rawResponse.reasoning;

		// A guard that redacted everything leaves an empty string: absence is normal, so drop the
		// key rather than reporting "" as if the model had thought and said nothing.
		if ( !len( scrubbed ) ) {
			message.delete( "reasoning" );
			message.delete( "reasoning_content" );
			return;
		}

		message[ "reasoning" ] = scrubbed;
		// The passthrough path can carry the unscrubbed native spelling straight from the wire
		// body; overwrite rather than delete so the shape a caller may already read is preserved.
		if ( message.keyExists( "reasoning_content" ) ) {
			message[ "reasoning_content" ] = scrubbed;
		}
	}

	// ==============================================================================================
	// Converse API — response transform (#272)
	// ==============================================================================================

	/**
	 * Transform a Bedrock Converse response into the module's normalized (OpenAI-shaped) envelope,
	 * the same struct every other transformResponseFrom*() returns and every downstream consumer
	 * in this class reads.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_Converse.html
	 *
	 * @response The raw Converse response body
	 * @modelId  The Bedrock model id
	 */
	/**
	 * Converse `usage` -> the module's normalized (OpenAI-shaped) usage struct.
	 *
	 * Converse reports `inputTokens` EXCLUSIVE of cached tokens, so the billed prompt total is
	 * inputTokens + cacheRead + cacheWrite; prompt_tokens carries that total, and total_tokens is
	 * always prompt + completion. AWS's own usage.totalTokens is cache-EXCLUSIVE, so reporting it
	 * as total_tokens made total_tokens smaller than prompt_tokens on any cached request — it is
	 * kept verbatim under `bedrock.totalTokens` by the callers instead.
	 *
	 * The cache counters are reported under BOTH the Anthropic spelling the rest of the ecosystem
	 * uses and the raw AWS one, so a caller need not know which API served the request.
	 *
	 * Shared by the sync transform and the streaming `metadata` event, which were two copies of
	 * this arithmetic and could drift apart into reporting different totals for the same request.
	 *
	 * @usage The raw Converse TokenUsage block
	 */
	private struct function normalizeConverseUsage( required struct usage ){
		var cacheRead        = arguments.usage.cacheReadInputTokens ?: 0;
		var cacheWrite       = arguments.usage.cacheWriteInputTokens ?: 0;
		var inputTokens      = arguments.usage.inputTokens ?: 0;
		var promptTokens     = inputTokens + cacheRead + cacheWrite;
		var completionTokens = arguments.usage.outputTokens ?: 0;

		var normalized = {
			"prompt_tokens"               : promptTokens,
			"completion_tokens"           : completionTokens,
			"total_tokens"                : promptTokens + completionTokens,
			"cache_read_input_tokens"     : cacheRead,
			"cache_creation_input_tokens" : cacheWrite,
			"cacheReadInputTokens"        : cacheRead,
			"cacheWriteInputTokens"       : cacheWrite,
			"uncached_input_tokens"       : inputTokens
		};
		if ( isArray( arguments.usage.cacheDetails ?: "" ) ) {
			normalized[ "cacheDetails" ] = arguments.usage.cacheDetails;
		}
		return normalized;
	}

	public struct function transformResponseFromConverse( required struct response, required string modelId ){
		// A body with no `output` is not a Converse response — it is an InvokeModel body (a
		// replay fixture, a cache entry, a middleware canned response built for the other API)
		// that reached this transform because the API was resolved as Converse. Every read below
		// safe-navigates, so it used to yield an empty-but-valid envelope: no text, no tool calls,
		// and a green test asserting nothing. An error body is the one legitimate exception —
		// chat() reads `error` itself and never gets here with one, but the streaming/replay
		// paths can.
		if ( !arguments.response.keyExists( "output" ) && !arguments.response.keyExists( "error" ) ) {
			throw(
				type   : "BedrockError",
				message: "Response is not a Converse body (missing output.message). Keys present: [#arguments.response.keyArray().toList( ", " )#]. "
					& "A Converse response is { output: { message: { role, content } }, stopReason, usage }; "
					& "an InvokeModel-shaped body reached the Converse transform, so the request and the response disagree about which API was used.",
				detail : "converseResponseShape"
			);
		}

		var blocks    = arguments.response.output?.message?.content ?: [];
		if ( !isArray( blocks ) ) {
			blocks = [];
		}

		var textParts = [];
		var reasoning = "";
		var toolCalls = [];

		for ( var block in blocks ) {
			if ( !isStruct( block ) ) {
				continue;
			}
			if ( block.keyExists( "text" ) ) {
				textParts.append( block.text ?: "" );
				continue;
			}
			if ( block.keyExists( "reasoningContent" ) ) {
				reasoning &= ( block.reasoningContent?.reasoningText?.text ?: "" );
				continue;
			}
			if ( block.keyExists( "toolUse" ) ) {
				toolCalls.append( {
					"id"       : block.toolUse.toolUseId ?: "",
					"type"     : "function",
					"function" : {
						"name"      : block.toolUse.name ?: "",
						"arguments" : jsonSerialize( block.toolUse.input ?: {} )
					}
				} );
			}
		}

		var assistantMessage = {
			"role"    : "assistant",
			"content" : textParts.toList( char( 10 ) )
		};
		// Absence is normal, never an error: omit rather than reporting "".
		if ( len( reasoning ) ) {
			assistantMessage[ "reasoning" ] = reasoning;
		}
		if ( toolCalls.len() ) {
			assistantMessage[ "tool_calls" ] = toolCalls;
		}

		var stopReason = arguments.response.stopReason ?: "end_turn";
		if ( stopReason == "guardrail_intervened" ) {
			// Same surface the InvokeModel path gives an intervention (checkGuardrailIntervention);
			// there is no response object to attach structured data to.
			writeLog(
				text: "Bedrock guardrail intervened for this request (stopReason=guardrail_intervened, model=#arguments.modelId#)",
				type: "warning",
				log : "ai"
			);
		}

		var usage           = isStruct( arguments.response.usage ?: "" ) ? arguments.response.usage : {};
		var normalizedUsage = normalizeConverseUsage( usage );
		var inputTokens     = usage.inputTokens ?: 0;
		var completionTokens = normalizedUsage.completion_tokens;

		var result = {
			"choices" : [
				{
					"message"       : assistantMessage,
					"finish_reason" : static.CONVERSE_STOP_REASONS[ stopReason ] ?: "stop",
					"index"         : 0
				}
			],
			"usage" : normalizedUsage,
			"model" : arguments.modelId,
			// Converse-only metadata that has no OpenAI-shaped home, kept namespaced so it can
			// never collide with a provider field a caller already reads.
			"bedrock" : {
				"stopReason"  : stopReason,
				// AWS's raw (cache-exclusive) total, kept verbatim for anyone reconciling against
				// a Bedrock invoice or the CloudWatch metric.
				"totalTokens" : usage.totalTokens ?: ( inputTokens + completionTokens )
			}
		};

		if ( isStruct( arguments.response.metrics ?: "" ) ) {
			result.bedrock[ "latencyMs" ] = arguments.response.metrics.latencyMs ?: 0;
		}
		if ( isStruct( arguments.response.trace ?: "" ) ) {
			result.bedrock[ "trace" ] = arguments.response.trace;
		}
		if ( !isNull( arguments.response.additionalModelResponseFields ) ) {
			result.bedrock[ "additionalModelResponseFields" ] = arguments.response.additionalModelResponseFields;
		}

		return result;
	}

	/**
	 * Transform Claude Bedrock response to OpenAI format
	 */
	private struct function transformResponseFromClaude( required struct response, required string modelId ){
		var content   = "";
		var reasoning = "";

		// Claude may return multiple "text" content blocks (e.g. interleaved with tool_use
		// or thinking blocks) — join all of them rather than reading only the first block.
		if (
			arguments.response.keyExists( "content" ) && isArray( arguments.response.content ) && arguments.response.content.len() > 0
		) {
			var textBlocks = arguments.response.content.filter( b -> isStruct( b ) && ( b.type ?: "" ) == "text" );
			content = textBlocks.map( b -> b.text ?: "" ).toList( char( 10 ) );

			// Extended thinking arrives as its own block type. Surface it on the standard
			// `message.reasoning` key rather than dropping it — the streaming path already
			// maps `delta.thinking` this way, and normalizeReasoningMessage() cannot rescue
			// this one because the native `thinking` key never survives onto the message.
			// Joined with no delimiter, matching ClaudeService and the streaming path, which
			// accumulates thinking deltas by plain concatenation — so sync and stream report
			// identical reasoning for the same response.
			var thinkingBlocks = arguments.response.content.filter( b -> isStruct( b ) && ( b.type ?: "" ) == "thinking" );
			reasoning          = thinkingBlocks.map( b -> b.thinking ?: "" ).toList( "" );
		}

		// Absence is normal, never an error: omit the key entirely rather than emitting "".
		var assistantMessage = { "role" : "assistant", "content" : content };
		if ( len( reasoning ) ) {
			assistantMessage[ "reasoning" ] = reasoning;
		}

		return {
			"choices" : [
				{
					"message"       : assistantMessage,
					"finish_reason" : arguments.response.stop_reason ?: "stop",
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : arguments.response.usage?.input_tokens ?: 0,
				"completion_tokens" : arguments.response.usage?.output_tokens ?: 0,
				"total_tokens"      : ( arguments.response.usage?.input_tokens ?: 0 ) + (
					arguments.response.usage?.output_tokens ?: 0
				)
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Transform Titan response to OpenAI format
	 */
	private struct function transformResponseFromTitan( required struct response, required string modelId ){
		var content = "";

		if (
			arguments.response.keyExists( "results" ) && isArray( arguments.response.results ) && arguments.response.results.len() > 0
		) {
			content = arguments.response.results[ 1 ].outputText ?: "";
		}

		return {
			"choices" : [
				{
					"message"       : { "role" : "assistant", "content" : content },
					"finish_reason" : "stop",
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : arguments.response.inputTextTokenCount ?: 0,
				"completion_tokens" : arguments.response.results[ 1 ]?.tokenCount ?: 0,
				"total_tokens"      : ( arguments.response.inputTextTokenCount ?: 0 ) + (
					arguments.response.results[ 1 ]?.tokenCount ?: 0
				)
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Transform Llama response to OpenAI format
	 */
	private struct function transformResponseFromLlama( required struct response, required string modelId ){
		return {
			"choices" : [
				{
					"message" : {
						"role"    : "assistant",
						"content" : arguments.response.generation ?: ""
					},
					"finish_reason" : arguments.response.stop_reason ?: "stop",
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : arguments.response.prompt_token_count ?: 0,
				"completion_tokens" : arguments.response.generation_token_count ?: 0,
				"total_tokens"      : ( arguments.response.prompt_token_count ?: 0 ) + (
					arguments.response.generation_token_count ?: 0
				)
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Transform Cohere response to OpenAI format
	 *
	 * Two wire shapes exist on Bedrock and neither resembles Claude's:
	 * - Command R / R+ (cohere.command-r*): { text, generation_id, finish_reason, ... }
	 * - Command / Command Light (cohere.command-text-*): { generations: [ { text, finish_reason } ] }
	 *
	 * Cohere carries no usage block, so sendBedrockRequest's X-Amzn-Bedrock-*-Token-Count header
	 * backfill lands on response.usage and is read back here, exactly as the Mistral transform does.
	 */
	private struct function transformResponseFromCohere( required struct response, required string modelId ){
		var content      = "";
		var finishReason = "";
		var matched      = false;

		if ( arguments.response.keyExists( "text" ) && isSimpleValue( arguments.response.text ) ) {
			// Command R / R+ chat shape
			matched      = true;
			content      = arguments.response.text;
			finishReason = arguments.response.finish_reason ?: "";
		} else if (
			arguments.response.keyExists( "generations" ) && isArray( arguments.response.generations ) && arguments.response.generations.len() > 0 && isStruct(
				arguments.response.generations[ 1 ]
			)
		) {
			// Legacy Command generate shape
			matched      = true;
			content      = arguments.response.generations[ 1 ].text ?: "";
			finishReason = arguments.response.generations[ 1 ].finish_reason ?: "";
		}

		// An unrecognized Cohere body would otherwise normalize to an empty assistant message —
		// the exact silent-drop this transform exists to stop. Say so rather than returning "".
		if ( !matched ) {
			writeLog(
				text: "Bedrock Cohere response matched neither the Command R ({text}) nor the legacy Command ({generations}) shape; returning empty content for model #arguments.modelId#",
				type: "warning",
				log : "ai"
			);
		}

		// A finish_reason of "error" is a provider failure, not a completion — Cohere returns it
		// with text: "". Normalizing it to a successful empty response would hide the failure from
		// callers, who would have no way to retry or report it. Throw, matching how every other
		// Bedrock failure surfaces (ProviderError).
		if ( ucase( trim( finishReason ) ) == "ERROR" ) {
			writeLog(
				text: "Bedrock Cohere generation failed with finish_reason 'error' for model #arguments.modelId#",
				type: "error",
				log : "ai"
			);

			throw(
				type   : "ProviderError",
				message: "Cohere generation failed on Bedrock (finish_reason: error) for model #arguments.modelId#."
			);
		}

		return {
			"choices" : [
				{
					"message" : {
						"role"    : "assistant",
						"content" : content
					},
					"finish_reason" : mapCohereFinishReason( finishReason ),
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : arguments.response.usage?.prompt_tokens ?: 0,
				"completion_tokens" : arguments.response.usage?.completion_tokens ?: 0,
				"total_tokens"      : arguments.response.usage?.total_tokens ?: 0
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Map Cohere's finish reasons onto the OpenAI vocabulary the normalized struct promises.
	 *
	 * AWS documents these values for Command R/R+: complete, max_tokens, error_limit, error_toxic,
	 * error, user_cancel. `error` is handled by the caller (it is a provider failure, not a finish
	 * reason — see transformResponseFromCohere) and never reaches here. Anything unrecognized,
	 * including an empty value, falls back to "stop" as the Titan stream transform does.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters-cohere-command-r-plus.html
	 */
	private string function mapCohereFinishReason( required string finishReason ){
		switch ( ucase( trim( arguments.finishReason ) ) ) {
			case "MAX_TOKENS":
			// the model's context limit was reached — a length outcome, not a failure
			case "ERROR_LIMIT":
				return "length";
			case "ERROR_TOXIC":
				return "content_filter";
			default:
				return "stop";
		}
	}

	/**
	 * Transform Mistral response to OpenAI format
	 */
	private struct function transformResponseFromMistral( required struct response, required string modelId ){
		var content = "";

		if (
			arguments.response.keyExists( "outputs" ) && isArray( arguments.response.outputs ) && arguments.response.outputs.len() > 0
		) {
			content = arguments.response.outputs[ 1 ].text ?: "";
		}

		// Bedrock's legacy Mistral InvokeModel response has no "usage" block. sendBedrockRequest
		// backfills prompt/completion token counts from the X-Amzn-Bedrock-*-Token-Count response
		// headers onto the response body (when present) before this transform runs.
		return {
			"choices" : [
				{
					"message"       : { "role" : "assistant", "content" : content },
					"finish_reason" : arguments.response.outputs[ 1 ]?.stop_reason ?: "stop",
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : arguments.response.usage?.prompt_tokens ?: 0,
				"completion_tokens" : arguments.response.usage?.completion_tokens ?: 0,
				"total_tokens"      : arguments.response.usage?.total_tokens ?: (
					( arguments.response.usage?.prompt_tokens ?: 0 ) + ( arguments.response.usage?.completion_tokens ?: 0 )
				)
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Transform OpenAI-compatible response from Bedrock
	 * These models already return OpenAI-format responses, so minimal transformation needed
	 */
	private struct function transformResponseFromOpenAI( required struct response, required string modelId ){
		// OpenAI-compatible models already return the standard format
		// Just ensure all expected fields exist
		var content = "";

		// Try standard OpenAI response format first
		if (
			arguments.response.keyExists( "choices" ) && isArray( arguments.response.choices ) && arguments.response.choices.len() > 0
		) {
			// Already in OpenAI format, just return it with model ID override
			var result = duplicate( arguments.response );
			result[ "model" ] = arguments.modelId;
			return result;
		}

		// Fallback: check for message content directly (some variations)
		if ( arguments.response.keyExists( "message" ) && arguments.response.message.keyExists( "content" ) ) {
			content = arguments.response.message.content;
		} else if ( arguments.response.keyExists( "content" ) ) {
			// Direct content field
			if ( isArray( arguments.response.content ) && arguments.response.content.len() > 0 ) {
				var contentBlock = arguments.response.content[ 1 ];
				if ( isStruct( contentBlock ) && contentBlock.keyExists( "text" ) ) {
					content = contentBlock.text;
				}
			} else if ( isSimpleValue( arguments.response.content ) ) {
				content = arguments.response.content;
			}
		}

		var promptTokens     = arguments.response.usage?.prompt_tokens ?: arguments.response.usage?.input_tokens ?: 0;
		var completionTokens = arguments.response.usage?.completion_tokens ?: arguments.response.usage?.output_tokens ?: 0;

		return {
			"choices" : [
				{
					"message"       : { "role" : "assistant", "content" : content },
					"finish_reason" : arguments.response.finish_reason ?: arguments.response.stop_reason ?: "stop",
					"index"         : 0
				}
			],
			"usage" : {
				"prompt_tokens"     : promptTokens,
				"completion_tokens" : completionTokens,
				"total_tokens"      : arguments.response.usage?.total_tokens ?: ( promptTokens + completionTokens )
			},
			"model" : arguments.modelId
		};
	}

	/**
	 * Format tools for the Bedrock Claude Messages API. Identical schema to the
	 * direct Anthropic Messages API.
	 * @see https://docs.anthropic.com/en/api/messages#body-tools
	 *
	 * @tools The tools to format
	 *
	 * @return An array of tools formatted for Claude
	 */
	private array function formatToolsForClaude( required array tools ) {
		var claudeTools = [];

		for ( var tool in arguments.tools ) {
			var argumentsSchema = tool.getArgumentsSchema();
			claudeTools.append( {
				"name"        : tool.getName(),
				"description" : tool.getDescription(),
				"input_schema": {
					"type"      : "object",
					"properties": argumentsSchema.properties,
					"required"  : argumentsSchema.required
				}
			} );
		}

		return claudeTools;
	}

	/**
	 * Inject a forced structured-output tool into the Claude request packet.
	 *
	 * Exposes the request's structured-output schema as the synthetic tool's input_schema
	 * and pins tool_choice to it, so Claude is guaranteed to return a single tool_use block
	 * whose input conforms to the schema. Any real tools are left in place but will not be
	 * called while tool_choice is forced.
	 *
	 * @dataPacket  The Claude request packet (mutated in place)
	 * @chatRequest The request carrying the structured-output schema
	 */
	private void function injectStructuredOutputTool( required struct dataPacket, required AiChatRequest chatRequest ){
		var cleanSchema = SchemaBuilder::cleanSchema( arguments.chatRequest.getStructuredOutput() );

		if ( !arguments.dataPacket.keyExists( "tools" ) ) {
			arguments.dataPacket[ "tools" ] = [];
		}
		arguments.dataPacket.tools.append( {
			"name"        : static.STRUCTURED_OUTPUT_TOOL,
			"description" : "Record the response as structured data that conforms to the required JSON schema.",
			"input_schema": cleanSchema
		} );

		arguments.dataPacket[ "tool_choice" ] = {
			"type" : "tool",
			"name" : static.STRUCTURED_OUTPUT_TOOL
		};
	}

	/**
	 * Inject an OpenAI `response_format` json_schema block into the request packet.
	 *
	 * The OpenAI-shaped Bedrock families take the same structured-output field OpenAIService
	 * builds, so the schema goes on the wire natively — no forced-tool trick is needed here (that
	 * is a Claude-only workaround, since Claude on Bedrock has no response_format).
	 *
	 * @dataPacket  The OpenAI-shaped request packet (mutated in place)
	 * @chatRequest The request carrying the structured-output schema
	 */
	private void function injectStructuredOutputFormat( required struct dataPacket, required AiChatRequest chatRequest ){
		arguments.dataPacket[ "response_format" ] = {
			"type"        : "json_schema",
			"json_schema" : {
				"name"   : "response",
				"strict" : true,
				"schema" : SchemaBuilder::cleanSchema( arguments.chatRequest.getStructuredOutput() )
			}
		};
	}

	/**
	 * ------------------------------------------------------------------------------------------
	 * Tool-call dialect helpers
	 * ------------------------------------------------------------------------------------------
	 * chat(), chatStream() and the two resume paths run ONE tool loop (decide / suspend /
	 * execute / follow-up). These six helpers are the only family-specific parts of it: where the
	 * tool calls live in a response, and what an assistant turn and a tool result look like on the
	 * way back. Claude uses the Messages API blocks (tool_use / tool_result); the OpenAI-shaped
	 * families use choices[].message.tool_calls and role:"tool" messages.
	 *
	 * Reading a single tool call (name/arguments) is shape-detected rather than family-driven, so
	 * the same helper works on a Claude block, an OpenAI tool_call, and the normalized tool_use
	 * shape the streaming accumulator produces for BOTH families.
	 */

	/**
	 * Pull the tool calls out of a raw provider response.
	 *
	 * @result      The raw Bedrock response body
	 * @modelFamily The detected model family
	 *
	 * @return Array of tool calls in the family's native shape (empty when there are none)
	 */
	private array function extractResponseToolCalls( required struct result, required string modelFamily ){
		// Converse and Claude both carry their tool calls on the assistant TURN — output.message
		// for Converse, the top-level content array for Claude — which is exactly what
		// extractAssistantToolCalls() reads off a recorded turn. One implementation of each shape,
		// so a live response and a resumed one can never disagree about what the model asked for.
		if ( arguments.modelFamily == "converse" ) {
			var converseTurn = arguments.result.output?.message ?: {};
			return isStruct( converseTurn ) ? extractAssistantToolCalls( converseTurn, "converse" ) : [];
		}

		if ( arguments.modelFamily == "claude" ) {
			return extractAssistantToolCalls( arguments.result, "claude" );
		}

		if ( arguments.modelFamily == "cohere" ) {
			// Command R returns { tool_calls: [ { name, parameters } ] } — no call ids at all, so
			// synthesize stable positional ones; they are what tool_results are matched on when
			// the follow-up turn is built (see transformRequestForCohere).
			var cohereCalls = arguments.result.tool_calls ?: [];
			if ( !isArray( cohereCalls ) ) {
				return [];
			}
			// Positional alone is NOT unique: every turn of a multi-turn tool loop restarts at 1,
			// so turn 2's first call reused turn 1's id and the tool_results fold matched the
			// wrong call.
			var callBatchId = createUUID().replace( "-", "", "all" ).left( 12 );
			var normalized = [];
			for ( var i = 1; i <= cohereCalls.len(); i++ ) {
				normalized.append( {
					"type"  : "tool_use",
					"id"    : "cohere_tool_#i#_#callBatchId#",
					"name"  : cohereCalls[ i ].name ?: "",
					"input" : cohereCalls[ i ].parameters ?: {}
				} );
			}
			return normalized;
		}

		if ( arguments.modelFamily != "openai" ) {
			return [];
		}

		if ( !arguments.result.keyExists( "choices" ) || !isArray( arguments.result.choices ) || !arguments.result.choices.len() ) {
			return [];
		}
		var toolCalls = arguments.result.choices.first().message?.tool_calls ?: [];
		return isArray( toolCalls ) ? toolCalls : [];
	}

	/**
	 * Build the assistant turn to record for a tool-calling response.
	 *
	 * @result      The raw Bedrock response body
	 * @modelFamily The detected model family
	 */
	private struct function buildToolAssistantMessage( required struct result, required string modelFamily ){
		if ( arguments.modelFamily == "converse" ) {
			// The Converse content blocks go back verbatim — text, toolUse AND reasoningContent
			// (whose signature must survive the round trip unmodified). transformRequestForConverse()
			// passes already-Converse blocks through untouched, so this is idempotent.
			var converseContent = arguments.result.output?.message?.content ?: [];
			return { "role": "assistant", "content": isArray( converseContent ) ? converseContent : [] };
		}
		if ( arguments.modelFamily == "claude" ) {
			return { "role": "assistant", "content": arguments.result.content };
		}
		if ( arguments.modelFamily == "cohere" ) {
			// Cohere has no assistant-turn representation for its own tool calls in the request
			// body; the OpenAI shape is used as the module's internal carrier and is folded back
			// into `tool_results` by transformRequestForCohere().
			return buildStreamAssistantMessage( extractResponseToolCalls( arguments.result, "cohere" ), "openai" );
		}
		return arguments.result.choices.first().message;
	}

	/**
	 * Build the assistant turn for a STREAMED tool-calling response, from the normalized
	 * tool_use-shaped calls the stream accumulator produced.
	 *
	 * @toolCalls   Normalized tool calls: { type, id, name, input }
	 * @modelFamily The detected model family
	 * @streamState The stream accumulator, for the parts of the turn that are NOT tool calls: the
	 *              assistant text and the reasoning block (with its signature). Dropping those
	 *              rewrote history — the model's own words vanished from the turn it is asked to
	 *              continue, and a reasoning model lost the signed thinking block it needs to
	 *              carry reasoning across the tool call.
	 */
	private struct function buildStreamAssistantMessage(
		required array toolCalls,
		required string modelFamily,
		struct streamState = {}
	){
		if ( arguments.modelFamily == "converse" ) {
			var converseBlocks = [];

			// Reasoning first, mirroring the block order Converse returns on a non-streamed turn.
			var streamedReasoning = arguments.streamState.reasoning ?: "";
			if ( isSimpleValue( streamedReasoning ) && len( streamedReasoning ) ) {
				var reasoningText = { "text": streamedReasoning };
				// ConverseStream delivers the signature as its OWN contentBlockDelta, after the
				// reasoning text. It is opaque and must be round-tripped byte-identical.
				var reasoningSignature = arguments.streamState.reasoningSignature ?: "";
				if ( isSimpleValue( reasoningSignature ) && len( reasoningSignature ) ) {
					reasoningText[ "signature" ] = reasoningSignature;
				}
				converseBlocks.append( { "reasoningContent": { "reasoningText": reasoningText } } );
			}

			var streamedText = arguments.streamState.content ?: "";
			if ( isSimpleValue( streamedText ) && len( streamedText ) ) {
				converseBlocks.append( { "text": streamedText } );
			}

			converseBlocks.append(
				arguments.toolCalls.map( toolCall -> ( {
					"toolUse" : {
						"toolUseId" : toolCall.id ?: "",
						"name"      : toolCall.name ?: "",
						"input"     : isStruct( toolCall.input ?: "" ) ? toolCall.input : {}
					}
				} ) ),
				true
			);

			return { "role": "assistant", "content": converseBlocks };
		}
		if ( arguments.modelFamily == "claude" ) {
			// The recorded turn has to be the WHOLE turn, in Anthropic's block order: thinking,
			// then any prose the model streamed alongside its tool call, then the tool_use blocks.
			// Sending back only the tool_use blocks threw away everything the model said, and the
			// next turn was answered against a turn that never happened.
			var claudeBlocks = [];

			var claudeThinking = arguments.streamState.reasoning ?: "";
			var claudeSignature = arguments.streamState.reasoningSignature ?: "";
			// Anthropic REJECTS an unsigned thinking block on a tool-use round trip ("thinking
			// blocks must be passed back complete and unmodified"), so a thinking block with no
			// signature_delta captured is omitted rather than sent and 400'd.
			if (
				isSimpleValue( claudeThinking ) && len( claudeThinking )
				&& isSimpleValue( claudeSignature ) && len( claudeSignature )
			) {
				claudeBlocks.append( {
					"type"      : "thinking",
					"thinking"  : claudeThinking,
					"signature" : claudeSignature
				} );
			} else if ( isSimpleValue( claudeThinking ) && len( claudeThinking ) ) {
				// Dropping it is the lesser evil (an unsigned block is a hard 400), but it is not
				// free: Anthropic may still reject the tool-use turn for having no thinking block
				// when thinking is enabled, and the resulting error says nothing about a missing
				// signature_delta. Leave a trail so that is diagnosable from the log.
				writeLog(
					text: "Bedrock: the assistant turn's thinking block was omitted from the tool-use round trip — "
						& "reasoning text was streamed but no signature_delta was captured, and Anthropic rejects an "
						& "unsigned thinking block. The model may reject the tool-use turn.",
					type: "warn",
					log : "ai"
				);
			}

			var claudeText = arguments.streamState.content ?: "";
			if ( isSimpleValue( claudeText ) && len( claudeText ) ) {
				claudeBlocks.append( { "type": "text", "text": claudeText } );
			}

			claudeBlocks.append( arguments.toolCalls, true );
			return { "role": "assistant", "content": claudeBlocks };
		}

		var openAIText = arguments.streamState.content ?: "";
		return {
			"role"       : "assistant",
			"content"    : ( isSimpleValue( openAIText ) ? openAIText : "" ),
			"tool_calls" : arguments.toolCalls.map( toolCall -> ( {
				"id"       : toolCall.id ?: "",
				"type"     : "function",
				"function" : {
					"name"      : toolCall.name ?: "",
					"arguments" : jsonSerialize( toolCall.input ?: {} )
				}
			} ) )
		};
	}

	/**
	 * Read the tool calls back out of a recorded assistant turn (the resume paths, which are
	 * handed the assistantMessage the suspension captured rather than a live response).
	 *
	 * @assistantMessage The recorded assistant turn
	 * @modelFamily      The detected model family
	 */
	private array function extractAssistantToolCalls( required struct assistantMessage, required string modelFamily ){
		if ( arguments.modelFamily == "converse" ) {
			var converseContent = arguments.assistantMessage.content ?: [];
			if ( !isArray( converseContent ) ) {
				return [];
			}
			return converseContent
				.filter( block -> isStruct( block ) && block.keyExists( "toolUse" ) )
				.map( block -> ( {
					"type"  : "tool_use",
					"id"    : block.toolUse.toolUseId ?: "",
					"name"  : block.toolUse.name ?: "",
					"input" : isStruct( block.toolUse.input ?: "" ) ? block.toolUse.input : {}
				} ) );
		}
		if ( arguments.modelFamily == "claude" ) {
			var content = arguments.assistantMessage.content ?: [];
			return isArray( content ) ? content.filter( contentBlock -> ( contentBlock?.type ?: "" ) == "tool_use" ) : [];
		}
		var toolCalls = arguments.assistantMessage.tool_calls ?: [];
		return isArray( toolCalls ) ? toolCalls : [];
	}

	/**
	 * The tool name carried by one tool call, in any of the three shapes above.
	 */
	private string function toolCallName( required struct toolCall ){
		if ( arguments.toolCall.keyExists( "function" ) && isStruct( arguments.toolCall.function ) ) {
			return arguments.toolCall.function.name ?: "";
		}
		return arguments.toolCall.name ?: "";
	}

	/**
	 * The arguments carried by one tool call, normalized to a struct. OpenAI serializes them as a
	 * JSON string; Claude and the stream accumulator hand back a struct already.
	 */
	private struct function toolCallArgs( required struct toolCall ){
		if ( arguments.toolCall.keyExists( "function" ) && isStruct( arguments.toolCall.function ) ) {
			var raw = arguments.toolCall.function.arguments ?: "";
			if ( !len( trim( raw ) ) ) {
				return {};
			}
			try {
				var parsed = jsonDeserialize( raw );
				return isStruct( parsed ) ? parsed : {};
			} catch ( any e ) {
				writeLog(
					text: "Could not parse tool arguments for [#toolCallName( arguments.toolCall )#]: #e.message#",
					type: "error",
					log : "ai"
				);
				return {};
			}
		}
		var input = arguments.toolCall.input ?: {};
		return isStruct( input ) ? input : {};
	}

	/**
	 * Build the message that carries one tool's result back to the model.
	 *
	 * @toolCall    The tool call being answered
	 * @content     The tool result (or a blocked/not-found marker)
	 * @modelFamily The detected model family
	 * @status      "error" when the loop KNOWS the call failed (blocked, cancelled, tool not
	 *              found). Only the Converse dialect has a place to put it; every other dialect
	 *              carries the failure in the marker text alone, as it always has.
	 */
	private struct function buildToolResultMessage(
		required struct toolCall,
		required any content,
		required string modelFamily,
		string status = ""
	){
		if ( arguments.modelFamily == "converse" ) {
			return {
				"role"    : "user",
				"content" : [ converseToolResultBlock( arguments.toolCall.id ?: "", arguments.content, arguments.status ) ]
			};
		}
		if ( arguments.modelFamily == "claude" ) {
			return {
				"role"    : "user",
				"content" : [ { "type": "tool_result", "tool_use_id": arguments.toolCall.id ?: "", "content": arguments.content } ]
			};
		}
		return {
			"role"         : "tool",
			"tool_call_id" : arguments.toolCall.id ?: "",
			"content"      : arguments.content
		};
	}

	/**
	 * Resolve the model id the same way chat()/chatStream() do, for the paths that need the model
	 * family but were not handed a model id (the resume short-circuits).
	 */
	private string function resolveModelId( required AiChatRequest chatRequest ){
		var modelId = len( variables.modelId ) ? variables.modelId : arguments.chatRequest.getModel();
		return len( modelId ) ? modelId : ( variables.params.model ?: "" );
	}

	/**
	 * The tool-call dialect for a request: "converse" when this request goes out over the Converse
	 * API, otherwise the detected model family. This — not detectModelFamily() — is what the six
	 * dialect helpers above switch on, so the Converse content-block shapes are used for follow-up
	 * turns whenever the Converse API is the one on the wire.
	 *
	 * @chatRequest The request
	 * @modelId     The resolved model id, when the caller already has it
	 */
	private string function resolveToolDialect( required AiChatRequest chatRequest, string modelId = "" ){
		var id = len( arguments.modelId ) ? arguments.modelId : resolveModelId( arguments.chatRequest );
		return resolveBedrockApi( arguments.chatRequest, id ) == "converse" ? "converse" : detectModelFamily( id );
	}

	/**
	 * Finish processing a tool-call batch that was suspended for human approval (see
	 * afterToolBatch()), using the finalized resume ledger AiAgent.resume() built. No LLM call —
	 * and nothing that already executed (or was already blocked) during the original attempt
	 * runs again, since pass 1 never actually invokes a tool while any part of the batch could
	 * still suspend (see chat()'s "Pass 1: decide" / "Pass 2: execute" split).
	 *
	 * @chatRequest      The chat request to continue — its messages are the pre-LLM-call
	 *                    messages from the original (suspended) attempt
	 * @resumeCtx         The resume context AiAgent.resume() built: { assistantMessage, resumeLedger }
	 * @interactionCount Current tool call interaction count (used internally)
	 */
	private any function resumeToolBatch( required AiChatRequest chatRequest, required struct resumeCtx, required numeric interactionCount ) {
		// Consume the resume context immediately — chat() recurses for the NEXT turn below, and
		// that recursive call must not re-detect this same resume context and loop forever.
		arguments.chatRequest.setResumeContext( {} )

		var thisChatRequest  = arguments.chatRequest
		var assistantMessage = arguments.resumeCtx.assistantMessage
		var ledger           = arguments.resumeCtx.resumeLedger ?: []

		// The dialect the SUSPENDED turn was built in, not whatever the config resolves to now.
		// A run that fell back Converse -> InvokeModel at request time recorded `invoke` in the
		// suspend payload; re-resolving here would read the configured default ("converse") and
		// hand extractAssistantToolCalls() a dialect the recorded assistant turn is not in, which
		// silently yields zero tool calls — every approved tool skipped.
		var persistedDialect = resumeSuspendValue( arguments.resumeCtx, "toolDialect" )
		var persistedApi     = resumeSuspendValue( arguments.resumeCtx, "bedrockApi" )
		if ( len( persistedApi ) ) {
			stickBedrockApi( thisChatRequest, persistedApi )
		}
		var modelFamily = len( persistedDialect ) ? persistedDialect : resolveToolDialect( thisChatRequest )
		var toolCalls   = extractAssistantToolCalls( assistantMessage, modelFamily )

		// The ledger is positional: entry i is the decision for tool call i. If the recorded turn
		// no longer yields the same number of calls the ledger was built for, every pairing below
		// is wrong — approving one tool would execute another. Fail instead of guessing.
		if ( toolCalls.len() != ledger.len() ) {
			throw(
				type   : "ResumeLedgerMismatch",
				message: "Bedrock resume ledger does not match the recorded assistant turn: #ledger.len()# decision(s) "
					& "for #toolCalls.len()# tool call(s) (dialect '#modelFamily#'). The suspended turn cannot be resumed safely.",
				detail : "resumeLedgerArity"
			)
		}

		var messages = thisChatRequest.getMessages()
		messages.append( assistantMessage )

		for ( var i = 1; i <= toolCalls.len(); i++ ) {
			var toolCall    = toolCalls[ i ]
			var ledgerEntry = ( i <= ledger.len() )
				? ledger[ i ]
				: { status: "blocked", reason: "No resume decision was recorded for this tool call." }

			if ( ledgerEntry.status == "cancel" ) {
				var cancelReason = ledgerEntry.reason ?: "Cancelled by human operator during resume."
				messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #cancelReason#]", modelFamily, "error" ) )
				thisChatRequest.setMessages( messages )
				return AiMiddlewareResult.cancel( cancelReason )
			}

			if ( ledgerEntry.status == "blocked" ) {
				messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #ledgerEntry.reason ?: ""#]", modelFamily, "error" ) )
				continue
			}

			// "execute"
			var callName    = toolCallName( toolCall )
			var toolAttempt = thisChatRequest.getTool( callName )
			if ( !toolAttempt.isPresent() ) {
				writeLog(
					text: "Unable to find tool named: [#callName#]",
					type: "warning",
					log : "ai"
				)
				messages.append( buildToolResultMessage( toolCall, "Tool ['#callName#'] not found in chat request", modelFamily, "error" ) )
				continue
			}

			var tool     = toolAttempt.get()
			// editedArgs (a human edit) > ledger toolArgs (pass-1 middleware rewrites) > the raw call
			// (checkpoints written before the ledger carried toolArgs).
			var toolArgs = isStruct( ledgerEntry.editedArgs ?: "" ) ? ledgerEntry.editedArgs
				: ( isStruct( ledgerEntry.toolArgs ?: "" ) ? ledgerEntry.toolArgs : toolCallArgs( toolCall ) )
			var capturedTool = tool
			var capturedArgs = toolArgs
			var toolResult = thisChatRequest.fireWrapMiddleware(
				"wrapToolCall",
				{ tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, toolName: len( callName ) ? callName : tool.getName(), toolArgs: toolArgs },
				() => capturedTool.invoke( args: capturedArgs, chatRequest: thisChatRequest )
			)

			thisChatRequest.fireMiddleware(
				hook   : "afterToolCall",
				context: { tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, result: toolResult },
				reverse: true
			)

			messages.append( buildToolResultMessage( toolCall, toolResult, modelFamily ) )
		}

		thisChatRequest.setMessages( messages )
		return chat( thisChatRequest, arguments.interactionCount + 1 )
	}

	/**
	 * Build the request body for one chat/stream call, for whichever runtime API is in play.
	 *
	 * Shared by chat(), chatStream() and both InvokeModel-fallback retries — the retry has to
	 * rebuild the body from scratch against the other API, and doing that in one place is what
	 * keeps the fallback from drifting away from the primary path.
	 *
	 * @chatRequest The request
	 * @modelId     The resolved model id
	 * @bedrockApi  "converse" or "invoke"
	 * @stream      Whether this body is for the streaming operation — a few Converse members
	 *              (guardrailConfig.streamProcessingMode) exist ONLY on ConverseStream.
	 *
	 * @return The request body struct
	 */
	private struct function buildBedrockChatPacket(
		required AiChatRequest chatRequest,
		required string modelId,
		required string bedrockApi,
		boolean stream = false
	){
		if ( arguments.bedrockApi == "converse" ) {
			return transformRequestForConverse(
				chatRequest = arguments.chatRequest,
				messages    = arguments.chatRequest.getMessages(),
				params      = arguments.chatRequest.getParams(),
				modelId     = arguments.modelId,
				operation   = arguments.stream ? "converse-stream" : "converse"
			);
		}

		// The InvokeModel-only escape hatch: a hand-built native vendor body replaces the
		// transform wholesale. resolveBedrockApi() has already routed such a request here.
		var rawBody = arguments.chatRequest.getProviderOption( "rawBody", "" );
		if ( isStruct( rawBody ) && !rawBody.isEmpty() ) {
			return duplicate( rawBody );
		}
		// A JSON STRING is accepted too — resolveBedrockApi() already routes on `len( rawBody )`
		// for a simple value, so without this a string rawBody sent the request to InvokeModel and
		// then silently ignored the body the caller supplied.
		if ( isSimpleValue( rawBody ) && len( trim( rawBody ) ) ) {
			var parsedRawBody = "";
			try {
				parsedRawBody = jsonDeserialize( rawBody );
			} catch ( any e ) {
				throw(
					type   : "ProviderError",
					message: "providerOptions.rawBody was given as a string but is not valid JSON: #e.message#",
					detail : "rawBody must be a struct, or a JSON string that deserializes to one."
				);
			}
			if ( !isStruct( parsedRawBody ) ) {
				throw(
					type   : "ProviderError",
					message: "providerOptions.rawBody deserialized to a #( isArray( parsedRawBody ) ? "array" : "simple value" )#, not a request body struct.",
					detail : "rawBody must be a struct, or a JSON string that deserializes to one."
				);
			}
			return parsedRawBody;
		}

		var modelFamily = detectModelFamily( arguments.modelId );
		var dataPacket  = transformRequestForModel(
			messages    = arguments.chatRequest.getMessages(),
			params      = arguments.chatRequest.getParams(),
			modelFamily = modelFamily,
			modelId     = arguments.modelId
		);

		// -------------------------------------------------------------------------------------------
		// --- Structured output via forced tool-use (Claude models only) ---
		// Claude on Bedrock has no response_format; the robust pattern is to expose the requested
		// schema as a tool's input_schema and force the model to call it, then read tool_use.input.
		// @see https://aws.amazon.com/blogs/machine-learning/structured-data-response-with-amazon-bedrock-prompt-engineering-and-tool-use/
		// -------------------------------------------------------------------------------------------
		if ( arguments.chatRequest.isStructuredOutput() ) {
			if ( modelFamily == "claude" ) {
				injectStructuredOutputTool( dataPacket, arguments.chatRequest );
			} else if ( modelFamily == "openai" ) {
				// The OpenAI-shaped families take response_format natively; the JSON then arrives as
				// ordinary message content and is populated by the returnFormat switch at the tail of
				// chat(), exactly as it is for the direct OpenAI provider.
				injectStructuredOutputFormat( dataPacket, arguments.chatRequest );
			}
		}

		return dataPacket;
	}

	/**
	 * The raw JSON carrying the forced structured-output tool's input, for whichever API served
	 * the response. Empty when the model did not return the block at all — which chat() treats as
	 * a hard failure rather than feeding prose to the JSON populator.
	 *
	 * @result      The raw provider response body
	 * @modelFamily The dialect ("converse" or the model family)
	 */
	private string function extractStructuredOutputJSON( required struct result, required string modelFamily ){
		var toolName = static.STRUCTURED_OUTPUT_TOOL;

		if ( arguments.modelFamily == "converse" ) {
			var converseBlocks = arguments.result.output?.message?.content ?: [];
			if ( !isArray( converseBlocks ) ) {
				return "";
			}
			// `=>` (closure), not `->` (lambda): a lambda cannot see the enclosing `toolName`.
			var converseHits = converseBlocks.filter( ( block ) =>
				isStruct( block ) && block.keyExists( "toolUse" ) && ( block.toolUse.name ?: "" ) == toolName
			);
			return converseHits.len() ? jsonSerialize( converseHits.first().toolUse.input ?: {} ) : "";
		}

		var blocks = ( arguments.result.keyExists( "content" ) && isArray( arguments.result.content ) )
			? arguments.result.content.filter( b => ( b?.type ?: "" ) == "tool_use" && ( b?.name ?: "" ) == toolName )
			: [];
		return blocks.len() ? jsonSerialize( blocks.first().input ?: {} ) : "";
	}

	/**
	 * The provider-reported stop reason on a raw body, for whichever API served it — used in the
	 * structured-output failure message.
	 *
	 * @result      The raw provider response body
	 * @modelFamily The dialect
	 */
	private string function rawStopReason( required struct result, required string modelFamily ){
		if ( arguments.modelFamily == "converse" ) {
			return arguments.result.stopReason ?: "unknown";
		}
		return arguments.result.stop_reason ?: "unknown";
	}

	/**
	 * Override chat to handle Bedrock-specific request signing and model transformation
	 *
	 * @chatRequest      The AiChatRequest object
	 * @interactionCount Current tool call interaction count
	 */
		@override
	public function chat( required AiChatRequest chatRequest, numeric interactionCount = 0 ){
		// -------------------------------------------------------------------------------------------
		// --- Resume short-circuit ---
		// A batch tool-call suspension (see afterToolBatch()) was resolved via AiAgent.resume()
		// with a finalized resume ledger — finish that same tool batch directly instead of
		// calling the LLM again (no replay, nothing that already ran re-runs).
		// -------------------------------------------------------------------------------------------
		var resumeCtx = arguments.chatRequest.getResumeContext() ?: {}
		if ( !resumeCtx.isEmpty() && resumeCtx.keyExists( "assistantMessage" ) ) {
			return resumeToolBatch( arguments.chatRequest, resumeCtx, arguments.interactionCount )
		}

		// A brand new logical call re-resolves the API from the configured chain. Any runtime
		// fallback decision belongs to the run that observed the AWS error, not to this one — the
		// same request object is commonly reused, and a stale "invoke" would silently skip Converse
		// forever. Turns 2+ of a tool loop and every resume keep the decision they are mid-way
		// through (a resume restores it explicitly from the suspend payload).
		if ( arguments.interactionCount == 0 && resumeCtx.isEmpty() ) {
			clearStuckBedrockApi( arguments.chatRequest );
		}

		// Get the model to use
		var modelId = len( variables.modelId ) ? variables.modelId : arguments.chatRequest.getModel();
		if ( !len( modelId ) ) {
			modelId = variables.params.model;
		}

		// Push service-level params into the request, as every other provider does. configure()
		// merges settings.defaultParams and settings.providers.Bedrock.params into variables.params,
		// but variables.params was only ever read for .model — so module-configured temperature /
		// top_p / max_tokens never reached the InvokeModel body.
		arguments.chatRequest
			.setModelIfEmpty( modelId )
			.mergeServiceParams( configuredServiceParams() );

		// Determine the endpoint identifier (use inference profile ARN if provided)
		var inferenceProfileArn = arguments.chatRequest.getProviderOption( "inferenceProfileArn" );
		var endpointId = len( inferenceProfileArn ) ? inferenceProfileArn : modelId;

		// Which runtime API this request speaks — Converse by default, InvokeModel when configured
		// or when one of the automatic fallbacks fires (see resolveBedrockApi()).
		var bedrockApi = resolveBedrockApi( arguments.chatRequest, modelId );

		// The dialect the tool loop's six helpers switch on: "converse" for the Converse path,
		// the detected model family for the per-vendor InvokeModel bodies.
		var modelFamily = ( bedrockApi == "converse" ) ? "converse" : detectModelFamily( modelId );

		// Fail loudly if tools / schema-typed structured output were requested on a family this
		// module doesn't wire them up for, instead of silently dropping them. Invoke path only —
		// Converse has one model-agnostic toolConfig.
		assertCapabilitySupported( detectModelFamily( modelId ), arguments.chatRequest, modelId, bedrockApi );

		var dataPacket = buildBedrockChatPacket( arguments.chatRequest, modelId, bedrockApi );

		// Structured output: on the Converse path it is ALWAYS the forced synthetic tool (built
		// into transformRequestForConverse for every family); on the invoke path it is Claude's
		// forced tool or the OpenAI-shaped families' native response_format.
		var usingStructuredOutput = arguments.chatRequest.isStructuredOutput()
			&& ( bedrockApi == "converse" || modelFamily == "claude" );

		// -------------------------------------------------------------------------------------------
		// --- Fire beforeLLMCall middleware ---
		// -------------------------------------------------------------------------------------------
		var llmContext = { chatRequest: arguments.chatRequest, dataPacket: dataPacket, fallbackRetry: false }
		var llmBeforeResult = arguments.chatRequest.fireMiddleware( hook: "beforeLLMCall", context: llmContext )
		if ( llmBeforeResult.isTerminal() ) {
			return llmBeforeResult
		}
		// Honour a REPLACED packet, not just in-place edits. Middleware that rebuilds the body
		// assigns a new struct to context.dataPacket; reading only the original local sent the
		// pre-hook body and silently dropped the replacement. The fallback retry leg below already
		// re-read its context — this makes the first leg behave identically.
		if ( isStruct( llmContext.dataPacket ?: "" ) ) {
			dataPacket = llmContext.dataPacket;
		}

		// -------------------------------------------------------------------------------------------
		// --- Fire WrapLLM -> Bedrock Call ---
		// -------------------------------------------------------------------------------------------
		var capturedDataPacket  = dataPacket;
		var capturedChatRequest = arguments.chatRequest;
		var capturedEndpointId  = endpointId;
		var capturedOperation   = bedrockApi;
		// Whether a Converse failure is even ELIGIBLE to be retried over InvokeModel — decided
		// before the call, because it depends only on the conversation (see canFallbackToInvoke()).
		// It also gates the onAIError announce inside the transport: a failure this method is about
		// to recover from is not an error the application ever saw.
		var mayFallback = ( bedrockApi == "converse" ) && canFallbackToInvoke( arguments.chatRequest, arguments.interactionCount );
		var announceFirstError = !mayFallback;
		// Counts the times the REAL transport ran, so the fallback below knows whether the result
		// it is looking at came off the wire or was substituted by a middleware.
		var transportAttempts = { "count": 0 };
		var result = arguments.chatRequest.fireWrapMiddleware(
			hook         : "wrapLLMCall",
			context      : llmContext,
			innerFunction: () => {
				transportAttempts.count++;
				return sendBedrockRequest(
					modelId        = capturedEndpointId,
					dataPacket     = capturedDataPacket,
					aiRequest      = capturedChatRequest,
					operation      = capturedOperation,
					announceErrors = announceFirstError
				);
			}
		)

		// A middleware that returns something other than a Bedrock response struct (a bare string,
		// null, an array) breaks every reader below — result.keyExists() on a string dies with a
		// cast error outside any try, several frames from the cause. Fail here naming the
		// contract, mirroring the streaming path's identical check.
		if ( isNull( result ) || !isStruct( result ) ) {
			var syncReturnedType = isNull( result ) ? "null" : ( isArray( result ) ? "array" : ( isSimpleValue( result ) ? "simple value" : "unsupported" ) );
			throw(
				type   : "BedrockError",
				message: "wrapLLMCall middleware returned a #syncReturnedType# for a NON-STREAMING Bedrock call. "
					& "The sync transport contract requires the raw Bedrock response body as a struct "
					& "(or an { error: { message, statusCode, response } } struct). "
					& "Middleware that substitutes a canned response must return that struct, not text.",
				detail : "bedrock-sync-response"
			);
		}

		// -------------------------------------------------------------------------------------------
		// --- Converse -> InvokeModel fallback (one shot) ---
		// -------------------------------------------------------------------------------------------
		// AWS answered a Converse call with a ValidationException saying this MODEL or OPERATION is
		// not supported. That is the one error class the fallback exists for: rebuild the body
		// against InvokeModel and send it once. Every other failure — a throttle, a feature-level
		// 400, anything at all from turn 2 of a tool loop (where the conversation is already in the
		// Converse dialect and cannot be re-expressed as a vendor body) — falls straight through to
		// the error branch below.
		//
		// The retry re-enters the TRANSPORT, not the wrapper: beforeLLMCall, onAIChatRequest and
		// wrapLLMCall describe one logical LLM call, and firing them a second time made a recovered
		// fallback look like two calls to every middleware in the chain.
		if ( isStruct( result ) && result.keyExists( "error" ) ) {
			var converseError       = result.error.toString();
			var attemptsBeforeRetry = transportAttempts.count;
			var tookFallback        = false;
			if ( mayFallback && shouldFallbackToInvoke( converseError ) ) {
				tookFallback = true;
				logConverseFallbackOnce( modelId, "Converse returned a ValidationException reporting the model or operation is unsupported" );
				bedrockApi  = "invoke";
				// Sticky for the rest of THIS request: the tool loop's recursion, the dialect
				// helpers and any resume must all speak the API the fallback settled on, not
				// re-resolve the configured default and rebuild Converse blocks.
				stickBedrockApi( arguments.chatRequest, "invoke" );
				modelFamily = detectModelFamily( modelId );
				assertCapabilitySupported( modelFamily, arguments.chatRequest, modelId, "invoke" );
				dataPacket  = buildBedrockChatPacket( arguments.chatRequest, modelId, "invoke" );
				usingStructuredOutput = arguments.chatRequest.isStructuredOutput() && modelFamily == "claude";

				// The retry leg is one logical LLM call with the first attempt, but its body was
				// rebuilt FROM SCRATCH against a different API — so every in-place edit
				// beforeLLMCall made to the Converse packet is gone. Re-fire the hook over the
				// new packet, flagged `fallbackRetry: true` so middleware that must not
				// double-count (metering, tracing) can tell the legs apart, and so middleware
				// that re-applies edits knows to.
				var retryContext = {
					chatRequest  : arguments.chatRequest,
					dataPacket   : dataPacket,
					fallbackRetry: true
				};
				var retryBefore = arguments.chatRequest.fireMiddleware( hook: "beforeLLMCall", context: retryContext );
				if ( retryBefore.isTerminal() ) {
					return retryBefore;
				}
				if ( isStruct( retryContext.dataPacket ?: "" ) ) {
					dataPacket = retryContext.dataPacket;
				}

				// wrapLLMCall wraps the retry too, under the same `fallbackRetry` flag. A
				// middleware that IS the transport (a replay, a cache, a test double) has to be
				// able to answer the invoke leg as well — bypassing the wrapper here would send a
				// real network request out from under it.
				var retryPacket = dataPacket;
				result = arguments.chatRequest.fireWrapMiddleware(
					hook         : "wrapLLMCall",
					context      : retryContext,
					innerFunction: () => {
						transportAttempts.count++;
						return sendBedrockRequest(
							modelId         = capturedEndpointId,
							dataPacket      = retryPacket,
							aiRequest       = capturedChatRequest,
							operation       = "invoke",
							announceRequest = false
						);
					}
				);
			}

			// Exactly one onAIError for a failure the caller actually sees. The transport
			// announces its own (with the real computed canRetry) whenever it ran; this covers
			// the two cases where it did not: the first attempt was told to hold the announce
			// back for a fallback that never happened, and a retry leg a middleware substituted
			// (so no transport ran at all) that still came back an error.
			if ( isStruct( result ) && result.keyExists( "error" ) ) {
				var retryRanTransport = transportAttempts.count > attemptsBeforeRetry;
				// No fallback was taken, so the announce is owed unless the transport already made
				// it. `!announceFirstError` alone was not that test: with mayFallback false the
				// transport was told to announce, but a middleware that SUBSTITUTED the call means
				// it never ran — an error result nobody announced at all. Count the attempts
				// instead of assuming the flag implies the call happened.
				if ( tookFallback ? !retryRanTransport : ( transportAttempts.count == 0 || !announceFirstError ) ) {
					var heldStatus = isStruct( result.error ) ? val( result.error.statusCode ?: 0 ) : 0;
					announceBedrockError( result.error, arguments.chatRequest, "chat", heldStatus >= 500 || heldStatus == 429 );
				}
			}
		}

		// -------------------------------------------------------------------------------------------
		// --- Fire afterLLMCall middleware, in reverse order ---
		// -------------------------------------------------------------------------------------------
		// Fired with the raw Bedrock body, matching ClaudeService/CohereService/GeminiService.
		// PromptSecurity::getResponseText/setResponseText resolves each provider's native shape and
		// mutates it in place, which is what lets an OutputGuard redaction also scrub the content
		// reused as the assistant turn on the tool-call path below.
		//
		// Reasoning is attached as a DERIVED top-level key first (same convention ClaudeService
		// uses) so a guard has something it can legally rewrite. The native `thinking` blocks in
		// result.content must NOT be touched: Bedrock requires the thinking blocks of the latest
		// assistant message to be passed back "complete and unmodified" on a tool-use turn, and a
		// modified block is rejected outright ("thinking or redacted_thinking blocks in the latest
		// assistant message cannot be modified"). The blocks stay byte-identical for the round
		// trip; this derived string is the caller-facing copy and never reaches the wire.
		// @see https://docs.aws.amazon.com/bedrock/latest/userguide/claude-messages-extended-thinking.html
		// Normally already attached by sendBedrockRequest() ahead of its announce; still needed
		// here for the wrapLLMCall-canned-response path, where that never ran.
		if ( !result.keyExists( "reasoning" ) ) {
			var derivedReasoning = deriveReasoning( result );
			if ( len( derivedReasoning ) ) {
				result[ "reasoning" ] = derivedReasoning;
			}
		}

		arguments.chatRequest.fireMiddleware(
			hook   : "afterLLMCall",
			context: { chatRequest: arguments.chatRequest, result: result },
			reverse: true
		)

		// Check for errors. sendBedrockRequest() already announced onAIError (with the real
		// computed canRetry, and the aiRequest-keyed payload matching BaseService's contract) for
		// this exact failure — don't re-announce here with a second, hardcoded canRetry:true.
		if ( result.keyExists( "error" ) ) {
			writeLog(
				text: "Bedrock error: #result.error.toString()#",
				type: "error",
				log : "ai"
			);

			throw( type: "ProviderError", message: result.error.toString() );
		}

		// Transform response to OpenAI format
		var openAIResponse = ( modelFamily == "converse" )
			? transformResponseFromConverse( result, modelId )
			: transformResponseFromModel( result, modelFamily, modelId );

		// An OutputGuard may have scrubbed result.reasoning in place while afterLLMCall ran, so
		// that copy — not the raw thinking blocks it was derived from — is what the caller gets.
		applyDerivedReasoning( openAIResponse, result );

		// Bedrock overrides chat() wholesale, so it never passes through
		// BaseService.sendChatRequest() where every other provider gets this. Without it an
		// OpenAI-shaped Bedrock model answering with a native `reasoning_content` key reaches
		// the caller un-normalized — transformResponseFromOpenAI() returns such bodies verbatim.
		normalizeReasoningMessage( openAIResponse );

		// Announce token usage
		if ( openAIResponse.keyExists( "usage" ) ) {
			boxAnnounce(
				"onAITokenCount",
				{
					provider            : this,
					operation           : "chat",
					model               : modelId,
					promptTokens        : openAIResponse.usage.prompt_tokens,
					completionTokens    : openAIResponse.usage.completion_tokens,
					totalTokens         : openAIResponse.usage.total_tokens,
					aiRequest           : arguments.chatRequest,
					usage               : openAIResponse.usage,
					timestamp           : now()
				}
			);
		}

		// -------------------------------------------------------------------------------------------
		// --- Structured output (Claude): the forced synthetic tool's input IS the result. ---
		// Authoritative path — if the block is absent (truncated at max_tokens, a refusal, or
		// tool_choice not honored) we fail loudly instead of feeding prose to the JSON populator.
		// -------------------------------------------------------------------------------------------
		if ( usingStructuredOutput ) {
			// Local copy: lambdas don't capture the class `static` scope.
			var toolName       = static.STRUCTURED_OUTPUT_TOOL;
			var structuredJSON = extractStructuredOutputJSON( result, modelFamily );
			if ( len( structuredJSON ) ) {
				return populateStructuredOutput( structuredJSON, arguments.chatRequest );
			}
			var stopReason = rawStopReason( result, modelFamily );
			writeLog(
				text: "Structured output requested but no '#toolName#' tool_use block returned (model=#modelId#, stop_reason=#stopReason#)",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "StructuredOutputError",
				message: "Model did not return the forced structured_output tool (stop_reason=#stopReason#)."
					& ( stopReason == "max_tokens" ? " Response was truncated — increase max_tokens." : "" )
			);
		}

		// -------------------------------------------------------------------------------------------
		// --- Handle Claude tool-use (native tool_use blocks from the Bedrock Claude Messages API) ---
		// -------------------------------------------------------------------------------------------
		var responseToolCalls = extractResponseToolCalls( result, modelFamily );
		if ( responseToolCalls.len() ) {
			var maxAllowed = arguments.chatRequest.getMaxInteractions() > 0 ? arguments.chatRequest.getMaxInteractions() : variables.maxInteractions;
			if ( arguments.interactionCount >= maxAllowed ) {
				writeLog(
					text: "Max tool call interactions (#maxAllowed#) exceeded",
					type: "error",
					log : "ai"
				);
				throw(
					type   : "MaxInteractionsExceeded",
					message: "Tool calls exceeded maximum allowed interactions (#maxAllowed#). This may indicate an infinite loop."
				);
			}

			var toolCalls = responseToolCalls;

			// Record the assistant turn (Claude: text + tool_use blocks; OpenAI: the message
			// carrying tool_calls) — see the tool-call dialect helpers.
			var assistantMessage = buildToolAssistantMessage( result, modelFamily )
			var thisChatRequest  = arguments.chatRequest
			var messages         = thisChatRequest.getMessages()
			messages.append( assistantMessage )

			// ── Pass 1: decide ──────────────────────────────────────────────────────────
			// Fire beforeToolCall for EVERY tool call in this turn before invoking any of
			// them — see OpenAIService.chat() for the full rationale (this mirrors it).
			var batch = []
			var terminalToolResult = ""

			for ( var toolCall in toolCalls ) {
				var callName    = toolCallName( toolCall )
				var toolAttempt = thisChatRequest.getTool( callName )
				if ( !toolAttempt.isPresent() ) {
					writeLog(
						text: "Unable to find tool named: [#callName#]",
						type: "warning",
						log : "ai"
					);
					batch.append( {
						tool    : javacast( "null", "" ),
						toolCall: toolCall,
						toolName: callName,
						toolArgs: {},
						result  : AiMiddlewareResult.reject( "Tool ['#callName#'] not found in chat request" )
					} )
					continue
				}

				var tool        = toolAttempt.get()
				var toolContext = {
					tool       : tool,
					toolCall   : toolCall,
					chatRequest: thisChatRequest,
					toolName   : len( callName ) ? callName : tool.getName(),
					toolArgs   : toolCallArgs( toolCall )
				}
				var originalToolArgs = duplicate( toolContext.toolArgs )
				var toolBeforeResult = thisChatRequest.fireMiddleware( "beforeToolCall", toolContext )

				if ( toolBeforeResult.isCancelled() ) {
					messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #toolBeforeResult.getReason()#]", modelFamily, "error" ) );
					terminalToolResult = toolBeforeResult
					break
				}

				batch.append( { tool: tool, toolCall: toolCall, toolName: toolContext.toolName, toolArgs: resolveToolArgs( toolContext, originalToolArgs, () => toolCallArgs( toolCall ) ), result: toolBeforeResult } )
			}

			if ( isObject( terminalToolResult ) ) {
				return terminalToolResult
			}

			// ── Suspend the whole batch at once, if anything needs a human decision ──────
			if ( batch.some( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() ) ) {
				var batchResult = thisChatRequest.fireMiddleware(
					"afterToolBatch",
					{ chatRequest: thisChatRequest, assistantMessage: assistantMessage, batch: batch }
				)

				// No attached middleware's afterToolBatch() converted the pending entries
				// into anything (the default is continue()) — e.g. a custom middleware
				// suspended a tool call directly from beforeToolCall() without participating
				// in the defer()/afterToolBatch() protocol at all. Fall back to a generic
				// combined suspend so a tool call ANY middleware said needs a decision is
				// never silently executed.
				if ( !batchResult.isSuspended() && !batchResult.isCancelled() ) {
					var pending = batch.filter( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() )
					var pendingActions = pending.map( ( entry ) => {
						var data = entry.result.getData()
						return {
							toolName    : entry.toolName,
							toolArgs    : ( isStruct( entry.toolArgs ) ) ? entry.toolArgs : {},
							suspensionID: data.suspensionID ?: ""
						}
					} )
					batchResult = AiMiddlewareResult.suspend( { pendingActions: pendingActions } )
				}

				if ( batchResult.isTerminal() ) {
					if ( !batchResult.isSuspended() ) {
						return batchResult
					}
					var resumeLedger = batch.map( ( entry ) => {
						if ( entry.result.isDeferred() || entry.result.isSuspended() ) {
							return { toolName: entry.toolName, status: "pending", toolArgs: entry.toolArgs }
						}
						if ( entry.result.isRejected() ) {
							return { toolName: entry.toolName, status: "blocked", reason: entry.result.getReason() }
						}
						// toolArgs: the beforeToolCall-resolved arguments. Without them the resume path
						// re-derived args from the raw tool call and silently dropped every middleware
						// rewrite that the non-suspended path had honoured.
						return { toolName: entry.toolName, status: "execute", toolArgs: entry.toolArgs }
					} )
					var mergedData = duplicate( batchResult.getData() )
					mergedData[ "assistantMessage" ] = assistantMessage
					mergedData[ "resumeLedger" ]     = resumeLedger
					// The API/dialect this turn was actually built in, so the resume rebuilds the
					// follow-up turn in the same one (see resumeToolBatch()).
					mergedData[ "toolDialect" ]      = modelFamily
					mergedData[ "bedrockApi" ]       = resolveBedrockApi( thisChatRequest, resolveModelId( thisChatRequest ) )
					return AiMiddlewareResult.suspend( mergedData )
				}
			}

			// ── Pass 2: execute ────────────────────────────────────────────────────────
			for ( var entry in batch ) {
				if ( entry.result.isRejected() ) {
					messages.append( buildToolResultMessage( entry.toolCall, "[Tool call blocked: #entry.result.getReason()#]", modelFamily, "error" ) );
					continue
				}

				// Use the resolved arguments from pass 1, including middleware replacements.
				var capturedTool = entry.tool
				var capturedArgs = entry.toolArgs
				var toolResult = thisChatRequest.fireWrapMiddleware(
					"wrapToolCall",
					{ tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, toolName: entry.toolName, toolArgs: capturedArgs },
					() => capturedTool.invoke( args: capturedArgs, chatRequest: thisChatRequest )
				);

				thisChatRequest.fireMiddleware(
					hook   : "afterToolCall",
					context: { tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, result: toolResult },
					reverse: true
				);

				messages.append( buildToolResultMessage( entry.toolCall, toolResult, modelFamily ) );
			}

			// Recurse with tool results now in context
			return chat( thisChatRequest, arguments.interactionCount + 1 );
		}

		// Handle response based on return format
		var content = openAIResponse.choices[ 1 ].message.content;

		switch ( arguments.chatRequest.getReturnFormat() ) {
			case "all":
				return openAIResponse.choices;
			case "raw":
				return openAIResponse;
			case "json":
				return extractJSONContent( content );
			case "xml":
				return xmlParse( extractFromCodeBlock( content, "xml" ) );
			case "structuredOutput":
				return populateStructuredOutput( content, arguments.chatRequest );
			case "single":
			default:
				return content;
		}
	}

	/**
	 * Count the input tokens a request would consume, without invoking the model.
	 *
	 * POSTs the request's Converse-shaped `messages` / `system` / `toolConfig` to
	 * `/model/{modelId}/count-tokens` as `{ input: { converse: { ... } } }`. AWS documents the
	 * count as matching what the same input would be billed for through Converse or InvokeModel.
	 *
	 * CountTokensInput is a union of exactly one of `converse` or `invokeModel` (the latter's `body`
	 * is a blob: the vendor JSON's UTF-8 bytes, base64-encoded on the REST wire). The form used is
	 * chosen by resolveBedrockApi() with `honourRuntimeDecision = false`.
	 *
	 * THE SCOPE OF THE COUNT: this is the API a FRESH logical call for this request would use — not
	 * necessarily the one a mid-loop follow-up would. If the request is currently inside a tool
	 * loop, or is being resumed, and its FIRST turn fell back from Converse to InvokeModel at
	 * runtime (stickBedrockApi()), that decision sticks for the remaining turns but is deliberately
	 * ignored here: honouring it would make countTokens() report against a fallback the caller may
	 * never trigger, and the resolver's read-only path must not itself mutate or consume the stuck
	 * decision. Call countTokens() before starting the conversation for the number that matches it.
	 *
	 * @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CountTokens.html
	 *
	 * @chatRequest The request to count
	 *
	 * @return The input token count
	 *
	 * @throws ProviderError on a non-200 response
	 */
	public numeric function countTokens( required AiChatRequest chatRequest ){
		var modelId = len( variables.modelId ) ? variables.modelId : arguments.chatRequest.getModel();
		if ( !len( modelId ) ) {
			modelId = variables.params.model;
		}

		// CountTokensInput is a union of exactly one of `converse` or `invokeModel`, and the two
		// count DIFFERENT bodies. Counting a Converse body for a request that goes out over
		// InvokeModel reports a number for a request that will never be sent — and for the models
		// that are on the invoke path precisely BECAUSE Converse cannot express them
		// (NO_CONVERSE_MODEL_PATTERNS), building the Converse body at all is meaningless. Route by
		// the same resolver the call itself uses.
		var countTokensInput = {};
		if ( resolveBedrockApi( arguments.chatRequest, modelId, false ) == "converse" ) {
			var conversePacket = transformRequestForConverse(
				chatRequest = arguments.chatRequest,
				messages    = arguments.chatRequest.getMessages(),
				params      = arguments.chatRequest.getParams(),
				modelId     = modelId
			);

			// CountTokensInput.converse takes messages / system / toolConfig ONLY —
			// inferenceConfig and additionalModelRequestFields are not members of it, and sending
			// them is a 400.
			var converseInput = { "messages": conversePacket.messages ?: [] };
			for ( var key in [ "system", "toolConfig" ] ) {
				if ( conversePacket.keyExists( key ) ) {
					converseInput[ key ] = conversePacket[ key ];
				}
			}
			countTokensInput = { "converse": converseInput };
		} else {
			// The raw HTTP API models body as a blob: encode the vendor JSON bytes as base64.
			// @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_CountTokens.html
			var invokeBody = buildBedrockChatPacket( arguments.chatRequest, modelId, "invoke" );
			countTokensInput = { "invokeModel": { "body": toBase64( charsetDecode( jsonSerialize( invokeBody ), "UTF-8" ) ) } };
		}

		var host     = getBedrockHost();
		var path     = getCountTokensPath( modelId );
		var endpoint = getBedrockOperationEndpoint( modelId, "count-tokens" );
		var payload  = jsonSerialize( { "input": countTokensInput } );

		var httpService = http( url = endpoint )
			.method( "POST" )
			.charset( "UTF-8" )
			.timeout( arguments.chatRequest.getTimeout() )
			.throwOnError( false )
			.header( "Content-Type", "application/json" )
			.header( "Accept", "application/json" );

		if ( useBearerAuth() ) {
			httpService.header( "Authorization", "Bearer #getBearerToken()#" );
		} else {
			var creds         = resolveAwsCredentials();
			var signedHeaders = new AwsSignatureV4().signRequest(
				method      = "POST",
				host        = host,
				path        = path,
				queryString = "",
				headers     = { "content-type": "application/json", "accept": "application/json" },
				payload         = payload,
				region          = variables.region,
				service         = static.AWS_SERVICE,
				accessKeyId     = creds.accessKeyId,
				secretAccessKey = creds.secretAccessKey,
				sessionToken    = creds.sessionToken
			);
			httpService.header( "Host", host );
			for ( var headerName in signedHeaders ) {
				httpService.header( headerName, signedHeaders[ headerName ] );
			}
		}

		var httpResult = httpService.body( payload ).send();
		var statusCode = val( listFirst( httpResult.statusCode, " " ) );
		if ( statusCode != 200 ) {
			var countError = "Bedrock CountTokens failed with status #statusCode#: #httpResult.fileContent#";
			if ( statusCode == 400 && httpResult.fileContent.findNoCase( "support" ) && httpResult.fileContent.findNoCase( "count" ) ) {
				// Observed live: AWS serves CountTokens only for a bare Anthropic foundation-model id —
				// not for a `global.`/`us.`/`eu.` inference profile, not for other vendors.
				countError &= " (CountTokens accepts only a bare Anthropic foundation-model id, e.g. anthropic.claude-haiku-4-5-20251001-v1:0; inference-profile ids and other vendors are rejected)";
			}
			writeLog( text: countError, type: "error", log: "ai" );
			throw( type: "ProviderError", message: countError );
		}

		return val( jsonDeserialize( httpResult.fileContent ).inputTokens ?: 0 );
	}

	/**
	 * One provider option, accepted under its camelCase name, its X-Amzn-Bedrock-* header
	 * spelling, or that header spelling inside the `bedrockHeaders` shorthand struct — the three
	 * ways a caller can express the same Bedrock setting. Struct keys are case-insensitive, so
	 * header casing does not matter.
	 *
	 * @providerOptions The request's providerOptions
	 * @headers         The providerOptions.bedrockHeaders struct (or an empty struct)
	 * @optionKey       The camelCase provider-option name
	 * @headerKey       The X-Amzn-Bedrock-* header name
	 *
	 * @return The value, or "" when none of the three carry it
	 */
	private string function providerOptionOrHeader(
		required struct providerOptions,
		required struct headers,
		required string optionKey,
		required string headerKey
	){
		for ( var candidate in [
			arguments.providerOptions[ arguments.optionKey ] ?: "",
			arguments.providerOptions[ arguments.headerKey ] ?: "",
			arguments.headers[ arguments.headerKey ] ?: ""
		] ) {
			if ( isSimpleValue( candidate ) && len( trim( candidate ) ) ) {
				return trim( candidate );
			}
		}
		return "";
	}

	/**
	 * Build extra request headers driven by providerOptions:
	 *   - Generic passthrough: any providerOptions key already shaped like a Bedrock header
	 *     (matches `x-amzn-bedrock-*`, case-insensitive) is forwarded verbatim. Keys must be the
	 *     FULL header name — `X-Amzn-Bedrock-Service-Tier`, not `Service-Tier` — since the regex
	 *     anchors on the prefix and a bare suffix is silently ignored. Covers ad-hoc headers like
	 *     X-Amzn-Bedrock-PerformanceConfig-Latency / -Service-Tier / -Request-Metadata / -Trace.
	 *   - Struct shorthand: `providerOptions.bedrockHeaders = { "X-Amzn-Bedrock-...": "value" }`.
	 *     Appended verbatim, so the same full-name rule applies — this struct is NOT prefixed for
	 *     you, and a bare suffix becomes a header name Bedrock does not recognize.
	 *   - First-class Guardrails: `guardrailIdentifier` / `guardrailVersion` map to
	 *     X-Amzn-Bedrock-GuardrailIdentifier / -GuardrailVersion, and `guardrailTrace` maps to
	 *     `X-Amzn-Bedrock-Trace` (values ENABLED / DISABLED / ENABLED_FULL) — which is the header
	 *     InvokeModel's Request Syntax and URI Request Parameters actually document, and the one
	 *     that produces the `amazon-bedrock-trace.guardrails` block in the response body. AWS's own
	 *     reference is self-inconsistent here: its "Use a guardrail" EXAMPLE additionally shows an
	 *     `X-Amzn-Bedrock-GuardrailTrace` header alongside `X-Amzn-Bedrock-Trace`, but no such
	 *     parameter appears in either authoritative section. A caller who wants that variant can
	 *     send it through the generic passthrough above; we deliberately send the documented one.
	 *     @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_InvokeModel.html
	 *
	 * Pure/no I/O, so it's directly unit-testable without a signer or HTTP call.
	 *
	 * @providerOptions An AiBaseRequest's providerOptions struct (chatRequest.getProviderOptions())
	 *
	 * @return Struct of header name -> value to add to the Bedrock InvokeModel request
	 */
	public struct function buildProviderOptionHeaders( required struct providerOptions, string operation = "invoke" ){
		var extraHeaders = {};
		// Converse models guardrails and performance config as first-class REQUEST BODY fields
		// (see transformRequestForConverse()), so the header form is dropped there rather than
		// sent twice under two different names.
		var isConverse   = arguments.operation.startsWith( "converse" );

		for ( var key in arguments.providerOptions ) {
			if ( key.reFindNoCase( "^x-amzn-bedrock-" ) ) {
				if ( isConverse && key.reFindNoCase( "^x-amzn-bedrock-(guardrail|trace$|performanceconfig)" ) ) {
					continue;
				}
				extraHeaders[ key ] = arguments.providerOptions[ key ];
			}
		}

		if ( isConverse ) {
			// The bedrockHeaders shorthand goes through the SAME guardrail/trace/performanceconfig
			// filter as the loose keys above. Appended verbatim it bypassed it entirely, so a
			// caller who set guardrails the header way sent them BOTH as headers and (via
			// transformRequestForConverse's header-spelling lookups) as guardrailConfig in the body
			// — the double-specification 400 the filter exists to prevent.
			if ( arguments.providerOptions.keyExists( "bedrockHeaders" ) && isStruct( arguments.providerOptions.bedrockHeaders ) ) {
				for ( var shorthandKey in arguments.providerOptions.bedrockHeaders ) {
					if ( shorthandKey.reFindNoCase( "^x-amzn-bedrock-(guardrail|trace$|performanceconfig)" ) ) {
						continue;
					}
					extraHeaders[ shorthandKey ] = arguments.providerOptions.bedrockHeaders[ shorthandKey ];
				}
			}
			return extraHeaders;
		}

		if (
			arguments.providerOptions.keyExists( "bedrockHeaders" ) && isStruct( arguments.providerOptions.bedrockHeaders )
		) {
			extraHeaders.append( arguments.providerOptions.bedrockHeaders, true );
		}

		if (
			arguments.providerOptions.keyExists( "guardrailIdentifier" ) && len( arguments.providerOptions.guardrailIdentifier )
		) {
			extraHeaders[ "X-Amzn-Bedrock-GuardrailIdentifier" ] = arguments.providerOptions.guardrailIdentifier;
		}
		if (
			arguments.providerOptions.keyExists( "guardrailVersion" ) && len( arguments.providerOptions.guardrailVersion )
		) {
			extraHeaders[ "X-Amzn-Bedrock-GuardrailVersion" ] = arguments.providerOptions.guardrailVersion;
		}
		if (
			arguments.providerOptions.keyExists( "guardrailTrace" ) && len( arguments.providerOptions.guardrailTrace )
		) {
			extraHeaders[ "X-Amzn-Bedrock-Trace" ] = arguments.providerOptions.guardrailTrace;
		}

		return extraHeaders;
	}

	/**
	 * Detect a Bedrock Guardrails intervention on a response and log it. Bedrock reports this
	 * via the `x-amzn-bedrock-guardrailaction` response header on InvokeModel, or (per some
	 * model/response shapes) an `amazon-bedrock-guardrailAction` field in the response body.
	 * There is no AiChatResponse/metadata object in this module to attach structured data to
	 * (chat() returns plain strings/structs/arrays depending on returnFormat) — a warn-level log
	 * line is the minimum surface for this, per the module's error-handling convention.
	 *
	 * @httpResult The raw HTTP result (for response headers)
	 * @response   The parsed JSON response body
	 */
	private void function checkGuardrailIntervention( required struct httpResult, required struct response ){
		var action          = "";
		var responseHeaders = arguments.httpResult.responseHeader ?: {};
		if ( isStruct( responseHeaders ) ) {
			for ( var headerName in responseHeaders ) {
				if ( headerName.reFindNoCase( "^x-amzn-bedrock-guardrailaction$" ) ) {
					// Normalized like every other header read here: an array-shaped multi-value
					// header would make the findNoCase() below an arrayFindNoCase() against header
					// values, silently missing the intervention it exists to report.
					action = firstHeaderValue( responseHeaders[ headerName ] );
					break;
				}
			}
		}
		if ( !len( action ) && arguments.response.keyExists( "amazon-bedrock-guardrailAction" ) ) {
			action = arguments.response[ "amazon-bedrock-guardrailAction" ];
		}

		if ( len( action ) && action.findNoCase( "INTERVENED" ) ) {
			writeLog(
				text: "Bedrock guardrail intervened for this request (action=#action#)",
				type: "warning",
				log : "ai"
			);
		}
	}

	/**
	 * Send a signed request to AWS Bedrock
	 *
	 * @modelId    The model ID or inference profile ARN to invoke
	 * @dataPacket The request payload
	 * @aiRequest  The AiRequest for logging settings
	 *
	 * @return The parsed response from Bedrock
	 */
	/**
	 * Announce onAIError with BaseService's payload contract (aiRequest-keyed, real canRetry).
	 * Extracted so the Converse fallback can DEFER the announce until it knows whether the
	 * failure was recovered — see chat().
	 *
	 * @error        The error struct ({ message, statusCode, response })
	 * @aiRequest    The request that failed
	 * @operation    "chat" or "stream"
	 * @canRetry     Whether a retry could plausibly succeed. Recomputed from the status code when
	 *               the caller has one; defaults to the conservative false.
	 */
	/**
	 * The AWS error class, as " [ValidationException]", read from the `x-amzn-errortype` response
	 * header — or "" when the header is absent.
	 *
	 * AWS returns the exception NAME only in that header for several Bedrock runtime errors; the
	 * body is then just `{"message":"..."}`. shouldFallbackToInvoke() gates on the name appearing
	 * in the text it is handed, so a body-only error looked like "not a ValidationException" and
	 * the Converse fallback never fired for exactly the models it exists for.
	 *
	 * The header value can be `ValidationException:http://internal.amazon.com/...` — everything
	 * from the first ":" is dropped.
	 *
	 * @httpResult The BoxLang http result
	 */
	private string function bedrockErrorTypeSuffix( required any httpResult ){
		var responseHeaders = arguments.httpResult.responseHeader ?: {};
		if ( !isStruct( responseHeaders ) ) {
			return "";
		}
		var errorType = responseHeaders[ "x-amzn-errortype" ] ?: "";
		// A repeated header arrives as an array of values.
		if ( isArray( errorType ) ) {
			errorType = errorType.len() ? errorType.first() : "";
		}
		if ( !isSimpleValue( errorType ) || !len( trim( errorType ) ) ) {
			return "";
		}
		return " [" & trim( listFirst( trim( errorType ), ":" ) ) & "]";
	}

	private void function announceBedrockError(
		required any error,
		required AiBaseRequest aiRequest,
		string operation  = "chat",
		boolean canRetry  = false
	){
		var errorStruct = isStruct( arguments.error ) ? arguments.error : { "message": arguments.error.toString() };
		boxAnnounce(
			"onAIError",
			{
				error        : errorStruct,
				errorMessage : errorStruct.message ?: errorStruct.toString(),
				provider     : this,
				operation    : arguments.operation,
				aiRequest    : arguments.aiRequest,
				canRetry     : arguments.canRetry
			}
		);
	}

	private struct function sendBedrockRequest(
		required string modelId,
		required struct dataPacket,
		required AiBaseRequest aiRequest,
		string operation         = "invoke",
		boolean announceRequest  = true,
		boolean announceErrors   = true
	){
		var host     = getBedrockHost();
		var path     = getBedrockOperationPath( arguments.modelId, arguments.operation );
		var endpoint = getBedrockOperationEndpoint( arguments.modelId, arguments.operation );
		var payload  = jsonSerialize( arguments.dataPacket );

		// Announce the request. Suppressed on the InvokeModel leg of a Converse fallback: that is
		// the SAME logical chat request, re-expressed, and announcing it twice made one recovered
		// call look like two to every listener.
		if ( arguments.announceRequest ) {
			boxAnnounce(
				"onAIChatRequest",
				{
					"dataPacket"  : arguments.dataPacket,
					"chatRequest" : arguments.aiRequest,
					"provider"    : this
				}
			);
		}

		// Log the request if enabled
		if ( arguments.aiRequest.getLogRequest() ) {
			writeLog(
				text: buildBedrockRequestLog( arguments.aiRequest, arguments.dataPacket, endpoint ),
				type: "info",
				log : "ai"
			);
		}

		if ( arguments.aiRequest.getLogRequestToConsole() ) {
			println( buildBedrockRequestLog( arguments.aiRequest, arguments.dataPacket, endpoint ) );
		}

		// Provider-option-driven extra headers (generic x-amzn-bedrock-* passthrough + Guardrails)
		// — must be included in BOTH the signature (when SigV4 is used) and the wire request.
		var extraHeaders = buildProviderOptionHeaders( arguments.aiRequest.getProviderOptions(), arguments.operation );

		// Make the HTTP request using fluent API
		var httpService = http( url = endpoint )
			.method( "POST" )
			.charset( "UTF-8" )
			.timeout( arguments.aiRequest.getTimeout() )
			.throwOnError( false )
			.header( "Content-Type", "application/json" )
			.header( "Accept", "application/json" );

		if ( useBearerAuth() ) {
			// Bedrock long-term API key: bearer auth, no SigV4 signing, no AWS credentials needed.
			httpService.header( "Authorization", "Bearer #getBearerToken()#" );
		} else {
			// Sign the request using AWS Signature V4. Extra headers must be part of what's
			// signed, or AWS will reject the request with a signature mismatch.
			var headersToSign = {
				"content-type" : "application/json",
				"accept"       : "application/json"
			};
			headersToSign.append( extraHeaders, true );

			var creds         = resolveAwsCredentials();
			var signer        = new AwsSignatureV4();
			var signedHeaders = signer.signRequest(
				method      = "POST",
				host        = host,
				path        = path,
				queryString = "",
				headers     = headersToSign,
				payload         = payload,
				region          = variables.region,
				service         = static.AWS_SERVICE,
				accessKeyId     = creds.accessKeyId,
				secretAccessKey = creds.secretAccessKey,
				sessionToken    = creds.sessionToken
			);

			httpService.header( "Host", host );
			for ( var headerName in signedHeaders ) {
				httpService.header( headerName, signedHeaders[ headerName ] );
			}
		}

		// Add the extra headers themselves onto the wire request (signRequest only returns the
		// AWS-computed Authorization/x-amz-* headers, not the ones it was asked to sign).
		for ( var headerName in extraHeaders ) {
			httpService.header( headerName, extraHeaders[ headerName ] );
		}

		// Add body and send
		var httpResult = httpService.body( payload ).send();

		// Log response if enabled
		if ( arguments.aiRequest.getLogResponse() ) {
			writeLog(
				text: buildBedrockResponseLog( arguments.aiRequest, httpResult, arguments.modelId ),
				type: "info",
				log : "ai"
			);
		}

		if ( arguments.aiRequest.getLogResponseToConsole() ) {
			println( buildBedrockResponseLog( arguments.aiRequest, httpResult, arguments.modelId ) );
		}

		// Check for HTTP errors
		var statusCode = val( listFirst( httpResult.statusCode, " " ) );
		if ( statusCode != 200 ) {
			var errorResponse = {
				"error" : {
					"message"    : "Bedrock request failed with status #statusCode##bedrockErrorTypeSuffix( httpResult )#: #httpResult.fileContent#",
					"statusCode" : statusCode,
					"response"   : httpResult.fileContent
				}
			};

			// Rate limiting (429): announce a dedicated event matching BaseService's
			// onAIRateLimitHit contract (BaseService.bx:360-367 uses the key "chatRequest", not
			// "aiRequest"), so rate-limit-aware middleware works the same as it does for every
			// other provider.
			if ( statusCode == 429 ) {
				var errorData = {};
				try {
					errorData = jsonDeserialize( httpResult.fileContent );
				} catch ( any e ) {
					errorData = { "message" : httpResult.fileContent };
				}

				var responseHeaders = httpResult.responseHeader ?: {};
				boxAnnounce(
					"onAIRateLimitHit",
					{
						provider    : this,
						operation   : "chat",
						statusCode  : statusCode,
						errorData   : errorData,
						chatRequest : arguments.aiRequest,
						retryAfter  : firstHeaderValue( responseHeaders[ "retry-after" ] ?: "" )
					}
				);
			}

			// Held back when the caller is about to attempt a Converse -> InvokeModel fallback: a
			// failure that is then recovered is not an error the application ever experienced.
			// chat() announces it itself if the fallback is declined or also fails.
			if ( arguments.announceErrors ) {
				announceBedrockError( errorResponse.error, arguments.aiRequest, "chat", statusCode >= 500 || statusCode == 429 );
			}

			return errorResponse;
		}

		// Parse and return response
		var response = jsonDeserialize( httpResult.fileContent );

		// Some legacy model families (e.g. Mistral) return no "usage" block in the response
		// body — AWS instead exposes token counts via response headers. Backfill them onto the
		// response so the family-specific transform can read them like any other usage field.
		if ( !response.keyExists( "usage" ) && isStruct( httpResult.responseHeader ?: {} ) ) {
			var inputTokenHeader  = firstHeaderValue( httpResult.responseHeader[ "X-Amzn-Bedrock-Input-Token-Count" ] ?: "" );
			var outputTokenHeader = firstHeaderValue( httpResult.responseHeader[ "X-Amzn-Bedrock-Output-Token-Count" ] ?: "" );
			if ( len( inputTokenHeader ) || len( outputTokenHeader ) ) {
				response[ "usage" ] = {
					"prompt_tokens"     : val( inputTokenHeader ),
					"completion_tokens" : val( outputTokenHeader ),
					"total_tokens"      : val( inputTokenHeader ) + val( outputTokenHeader )
				};
			}
		}

		checkGuardrailIntervention( httpResult, response );

		// Attach the derived reasoning BEFORE announcing, matching BaseService.sendChatRequest(),
		// which normalizes reasoning ahead of its own announce so listeners and the eventual caller
		// see the same shape. Announcing the untouched native body here meant an onAIChatResponse
		// listener was the only consumer that never saw the model's reasoning.
		var announcedReasoning = deriveReasoning( response );
		if ( len( announcedReasoning ) ) {
			response[ "reasoning" ] = announcedReasoning;
		}

		boxAnnounce(
			"onAIChatResponse",
			{
				"chatRequest" : arguments.aiRequest,
				"response"    : response,
				"rawResponse" : httpResult,
				"provider"    : this
			}
		);

		return response;
	}

	/**
	 * Stream chat responses from Bedrock using InvokeModelWithResponseStream
	 *
	 * Bedrock streaming uses AWS event-stream format which is different from SSE.
	 * Each event contains headers and a payload with the streaming chunk.
	 *
	 * @chatRequest      The AiChatRequest object
	 * @callback         A callback function to be called with each chunk: function( chunk )
	 * @interactionCount Current tool call interaction count (used internally when the streamed
	 *                   turn ends in tool_use and this method recurses for the follow-up turn)
	 */
	@override
	public function chatStream( required AiChatRequest chatRequest, required function callback, numeric interactionCount = 0 ){
		// -------------------------------------------------------------------------------------------
		// --- Resume short-circuit ---
		// A batch tool-call suspension (see afterToolBatch()) was resolved via AiAgent.resumeStream()
		// with a finalized resume ledger — finish that same tool batch directly instead of calling
		// the LLM again (no replay, nothing that already ran re-runs). Mirrors chat()'s short-circuit.
		// -------------------------------------------------------------------------------------------
		var resumeCtx = arguments.chatRequest.getResumeContext() ?: {}
		if ( !resumeCtx.isEmpty() && resumeCtx.keyExists( "assistantMessage" ) ) {
			return resumeToolBatchStream( arguments.chatRequest, arguments.callback, resumeCtx, arguments.interactionCount )
		}

		// See chat()'s identical reset — a new logical call must not inherit the previous run's
		// runtime fallback decision.
		if ( arguments.interactionCount == 0 && resumeCtx.isEmpty() ) {
			clearStuckBedrockApi( arguments.chatRequest );
		}

		// Get the model to use
		var modelId = len( variables.modelId ) ? variables.modelId : arguments.chatRequest.getModel();
		if ( !len( modelId ) ) {
			modelId = variables.params.model;
		}

		// Push service-level params into the request, as every other provider does. configure()
		// merges settings.defaultParams and settings.providers.Bedrock.params into variables.params,
		// but variables.params was only ever read for .model — so module-configured temperature /
		// top_p / max_tokens never reached the InvokeModel body.
		arguments.chatRequest
			.setModelIfEmpty( modelId )
			.mergeServiceParams( configuredServiceParams() );

		// Determine the endpoint identifier (use inference profile ARN if provided)
		var inferenceProfileArn = arguments.chatRequest.getProviderOption( "inferenceProfileArn" );
		var endpointId = len( inferenceProfileArn ) ? inferenceProfileArn : modelId;

		// Which runtime API this request speaks — see resolveBedrockApi().
		var streamBedrockApi = resolveBedrockApi( arguments.chatRequest, modelId );

		// The dialect the tool loop's helpers and the stream chunk transform switch on.
		var modelFamily = ( streamBedrockApi == "converse" ) ? "converse" : detectModelFamily( modelId );

		// Fail loudly if tools / schema-typed structured output were requested on a family this
		// module doesn't wire them up for, instead of silently dropping them. Invoke path only.
		assertCapabilitySupported( detectModelFamily( modelId ), arguments.chatRequest, modelId, streamBedrockApi );
		assertStreamingStructuredOutputSupported( modelFamily, streamBedrockApi, arguments.chatRequest );

		// Build the request body for whichever API is on the wire. On the Converse path the
		// structured-output schema goes out as the forced synthetic tool for EVERY family; on the
		// invoke path it is Claude's forced tool or the OpenAI-shaped native response_format.
		// Either way the streamed forced block is accumulated, never executed as a tool.
		var dataPacket = buildBedrockChatPacket( arguments.chatRequest, modelId, streamBedrockApi, true );

		var usingStructuredOutput = arguments.chatRequest.isStructuredOutput()
			&& ( streamBedrockApi == "converse" || modelFamily == "claude" );

		// Records what actually happened on the wire, so the catch below can tell a stream that
		// failed BEFORE it started from one that failed part-way through. `delivered` flips the
		// moment the first chunk reaches the caller's callback; `transportFailed` is set only by
		// invokeBedrockStreamTransport()'s non-200 branch.
		var streamAttempt = { "delivered": false, "transportFailed": false, "transportRan": false };

		// Send the streaming request (use endpointId which may be an inference profile ARN)
		var streamState = "";
		try {
			streamState = sendBedrockStreamRequest(
				modelId       = endpointId,
				dataPacket    = dataPacket,
				aiRequest     = arguments.chatRequest,
				modelFamily   = modelFamily,
				callback      = arguments.callback,
				operation     = ( streamBedrockApi == "converse" ) ? "converse-stream" : "invoke-with-response-stream",
				streamAttempt = streamAttempt
			);
		} catch ( any e ) {
			// The streaming mirror of chat()'s one-shot fallback: a ConverseStream
			// ValidationException saying the model or operation is unsupported is re-sent once over
			// InvokeModelWithResponseStream. Every other failure rethrows untouched.
			//
			// Three conditions, all necessary:
			//  - the failure came from the non-200 HTTP branch (transportFailed), or the transport
			//    never ran at all because a middleware substituted the call. A ValidationException
			//    delivered as an EXCEPTION FRAME mid-stream carries the same wording, but by then
			//    the connection was accepted and a retry would replay a stream the caller has seen.
			//  - !delivered: no chunk ever reached the callback, so nothing is being replayed.
			//  - canFallbackToInvoke: the conversation can still be expressed as a vendor body (see
			//    that method) — from turn 2 of a tool loop it cannot.
			var streamFellOverBeforeAnyOutput = !( local.streamAttempt.delivered ?: false )
				&& ( ( local.streamAttempt.transportFailed ?: false ) || !( local.streamAttempt.transportRan ?: false ) );
			if (
				local.streamBedrockApi != "converse"
				|| !local.streamFellOverBeforeAnyOutput
				|| !canFallbackToInvoke( arguments.chatRequest, arguments.interactionCount )
				|| !shouldFallbackToInvoke( e.message & " " & ( e.detail ?: "" ) )
			) {
				rethrow;
			}
			// `local.` throughout: inside a catch block an UNQUALIFIED read resolves against the
			// instance `variables` scope before the function's locals, so plain `modelId` here is
			// the service-level variables.modelId (usually empty), not this request's model.
			logConverseFallbackOnce( local.modelId, "ConverseStream returned a ValidationException reporting the model or operation is unsupported" );
			local.streamBedrockApi     = "invoke";
			// Sticky for the rest of THIS request — see chat()'s fallback and stickBedrockApi().
			stickBedrockApi( arguments.chatRequest, "invoke" );
			local.modelFamily          = detectModelFamily( local.modelId );
			assertCapabilitySupported( local.modelFamily, arguments.chatRequest, local.modelId, "invoke" );
			// The Converse leg served structured output through its synthetic forced tool; the
			// InvokeModel leg for an OpenAI-shaped family cannot, and silently degrading here
			// returned prose where a typed struct was promised.
			assertStreamingStructuredOutputSupported( local.modelFamily, "invoke", arguments.chatRequest );
			local.dataPacket           = buildBedrockChatPacket( arguments.chatRequest, local.modelId, "invoke", true );
			local.usingStructuredOutput = arguments.chatRequest.isStructuredOutput() && local.modelFamily == "claude";
			// isFallbackRetry: the body was rebuilt from scratch against a different API, so
			// beforeLLMCall is re-fired over the NEW packet (flagged, so middleware can re-apply
			// in-place edits and not double-count) while onAIChatRequest — a per-application-call
			// event — is suppressed.
			local.streamState = sendBedrockStreamRequest(
				modelId            = local.endpointId,
				dataPacket         = local.dataPacket,
				aiRequest          = arguments.chatRequest,
				modelFamily        = local.modelFamily,
				callback           = arguments.callback,
				operation          = "invoke-with-response-stream",
				streamAttempt      = { "delivered": false, "transportFailed": false, "transportRan": false },
				isFallbackRetry    = true
			);
		}

		// beforeLLMCall middleware short-circuited the call — nothing was streamed.
		if ( isNull( streamState ) || !isStruct( streamState ) || ( streamState.terminated ?: false ) ) {
			return;
		}

		// -------------------------------------------------------------------------------------------
		// --- Structured output (Claude): the accumulated forced-tool input IS the result. ---
		// Same authoritative-or-throw contract as chat(): if the block never arrived (truncated at
		// max_tokens, a refusal, tool_choice not honored) fail loudly rather than hand prose to the
		// JSON populator.
		// -------------------------------------------------------------------------------------------
		if ( usingStructuredOutput ) {
			var structuredJSON = streamState.structuredOutputJSON ?: "";
			if ( len( trim( structuredJSON ) ) ) {
				var structuredResult = populateStructuredOutput( structuredJSON, arguments.chatRequest );
				// Emitted on the normalized envelope as `choices[].delta.structured_output` AND
				// returned, matching ClaudeService.chatStream()'s contract exactly.
				emitStreamChunkGuarded(
					arguments.callback,
					{
						"model"   : modelId,
						"object"  : "chat.completion.chunk",
						"choices" : [ {
							"index"         : 0,
							"finish_reason" : "stop",
							"delta"         : { "role": "assistant", "structured_output": structuredResult }
						} ]
					},
					arguments.chatRequest
				);
				return structuredResult;
			}

			var soStopReason = streamState.stopReason ?: "unknown";
			writeLog(
				text: "Structured output requested but no '#static.STRUCTURED_OUTPUT_TOOL#' tool_use block was streamed (model=#modelId#, stop_reason=#soStopReason#)",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "StructuredOutputError",
				message: "Model did not return the forced structured_output tool (stop_reason=#soStopReason#)."
					& ( soStopReason == "max_tokens" ? " Response was truncated — increase max_tokens." : "" )
			);
		}

		// -------------------------------------------------------------------------------------------
		// --- Streamed tool-use: run the batch through the middleware pipeline and continue ---
		// Mirrors chat()'s pass-1-decide / pass-2-execute split (and ClaudeService.chatStream()),
		// so a streamed tool call gets the same beforeToolCall / wrapToolCall / afterToolCall /
		// afterToolBatch treatment — and the same all-or-nothing batch suspension — as a sync one.
		// -------------------------------------------------------------------------------------------
		if ( !listFindNoCase( "converse,claude,openai,cohere", modelFamily ) ) {
			return;
		}

		// Close out any argument buffer the stream's terminator never closed BEFORE deciding to run
		// anything: both families only finalized on a happy-path terminator, so a stream that ended
		// on stop/length (or was truncated mid input_json_delta) used to run every tool with `{}`.
		// Throws BedrockStreamError when a buffer is truncated — the tools do not run.
		// The drain runs AFTER sendBedrockStreamRequest() has returned, so its throw is outside that
		// method's catch and reached the caller with no onAIError at all — a billed call that failed
		// and left audit/replay middleware no record of it.
		try {
			drainPendingStreamToolCalls( streamState, modelFamily, modelId, arguments.callback );
		} catch ( any e ) {
			announceBedrockError(
				error     = { "message" : e.message },
				aiRequest = arguments.chatRequest,
				operation = "stream",
				canRetry  = false
			);
			rethrow;
		}

		// drainPendingStreamToolCalls() above either finalized every buffer or threw, so by here
		// an entry in toolCalls has real arguments.
		if ( !( streamState.toolCalls ?: [] ).len() ) {
			return;
		}

		var maxAllowed = arguments.chatRequest.getMaxInteractions() > 0 ? arguments.chatRequest.getMaxInteractions() : variables.maxInteractions;
		if ( arguments.interactionCount >= maxAllowed ) {
			writeLog(
				text: "Max tool call interactions (#maxAllowed#) exceeded",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "MaxInteractionsExceeded",
				message: "Tool calls exceeded maximum allowed interactions (#maxAllowed#). This may indicate an infinite loop."
			);
		}

		var thisChatRequest = arguments.chatRequest;
		var userCallback    = arguments.callback;
		var toolCalls       = streamState.toolCalls;

		// Record the assistant turn. streamState.toolCalls is normalized to the tool_use shape
		// for BOTH families (see startStreamToolCall / startStreamOpenAIToolCall), so the dialect
		// helper renders it back into whatever the family expects on the next turn.
		var assistantMessage = buildStreamAssistantMessage( toolCalls, modelFamily, streamState )
		var messages         = thisChatRequest.getMessages()
		messages.append( assistantMessage )

		// ── Pass 1: decide ──────────────────────────────────────────────────────────────────
		var batch              = []
		var terminalToolResult = ""

		for ( var toolCall in toolCalls ) {
			var callName    = toolCallName( toolCall )
			var toolAttempt = thisChatRequest.getTool( callName )
			if ( !toolAttempt.isPresent() ) {
				writeLog(
					text: "Unable to find tool named: [#callName#]",
					type: "warning",
					log : "ai"
				);
				batch.append( {
					tool    : javacast( "null", "" ),
					toolCall: toolCall,
					toolName: callName,
					toolArgs: {},
					result  : AiMiddlewareResult.reject( "Tool ['#callName#'] not found in chat request" )
				} )
				continue
			}

			var tool        = toolAttempt.get()
			var toolContext = {
				tool       : tool,
				toolCall   : toolCall,
				chatRequest: thisChatRequest,
				toolName   : len( callName ) ? callName : tool.getName(),
				toolArgs   : toolCallArgs( toolCall )
			}
			var originalToolArgs = duplicate( toolContext.toolArgs )
			var toolBeforeResult = thisChatRequest.fireMiddleware( "beforeToolCall", toolContext )

			// Cancel aborts the run outright — a cancelled run is never resumed, so nothing to batch.
			// The blocked toolResult is still recorded, exactly as chat() does: the assistant turn
			// with the toolUse block is already in `messages`, and a toolUse with no matching
			// toolResult is a malformed conversation the next Bedrock call rejects outright.
			if ( toolBeforeResult.isCancelled() ) {
				messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #toolBeforeResult.getReason()#]", modelFamily, "error" ) );
				terminalToolResult = toolBeforeResult
				break
			}

			batch.append( { tool: tool, toolCall: toolCall, toolName: toolContext.toolName, toolArgs: resolveToolArgs( toolContext, originalToolArgs, () => toolCallArgs( toolCall ) ), result: toolBeforeResult } )
		}

		if ( isObject( terminalToolResult ) ) {
			emitStreamChunkGuarded( userCallback, { type: "middleware_stop", result: terminalToolResult }, thisChatRequest )
			return
		}

		// ── Suspend the whole batch at once, if anything needs a human decision ──────────────
		if ( batch.some( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() ) ) {
			var batchResult = thisChatRequest.fireMiddleware(
				"afterToolBatch",
				{ chatRequest: thisChatRequest, assistantMessage: assistantMessage, batch: batch }
			)

			// No attached middleware converted the pending entries into anything — fall back to a
			// generic combined suspend so nothing a middleware flagged is silently executed.
			if ( !batchResult.isSuspended() && !batchResult.isCancelled() ) {
				var pending = batch.filter( ( entry ) => entry.result.isDeferred() || entry.result.isSuspended() )
				var pendingActions = pending.map( ( entry ) => {
					var data = entry.result.getData()
					return {
						toolName    : entry.toolName,
						toolArgs    : ( isStruct( entry.toolArgs ) ) ? entry.toolArgs : {},
						suspensionID: data.suspensionID ?: ""
					}
				} )
				batchResult = AiMiddlewareResult.suspend( { pendingActions: pendingActions } )
			}

			if ( batchResult.isTerminal() ) {
				if ( !batchResult.isSuspended() ) {
					emitStreamChunkGuarded( userCallback, { type: "middleware_stop", result: batchResult }, thisChatRequest )
					return
				}
				var resumeLedger = batch.map( ( entry ) => {
					if ( entry.result.isDeferred() || entry.result.isSuspended() ) {
						return { toolName: entry.toolName, status: "pending", toolArgs: entry.toolArgs }
					}
					if ( entry.result.isRejected() ) {
						return { toolName: entry.toolName, status: "blocked", reason: entry.result.getReason() }
					}
					return { toolName: entry.toolName, status: "execute", toolArgs: entry.toolArgs }
				} )
				var mergedData = duplicate( batchResult.getData() )
				mergedData[ "assistantMessage" ] = assistantMessage
				mergedData[ "resumeLedger" ]     = resumeLedger
				// The API/dialect this turn was actually built in, so the resume rebuilds the
				// follow-up turn in the same one (see resumeToolBatch()).
				mergedData[ "toolDialect" ]      = modelFamily
				mergedData[ "bedrockApi" ]       = resolveBedrockApi( thisChatRequest, resolveModelId( thisChatRequest ) )
				emitStreamChunkGuarded( userCallback, { type: "middleware_stop", result: AiMiddlewareResult.suspend( mergedData ) }, thisChatRequest )
				return
			}
			// continue: afterToolBatch() decided nothing needs to stay pending after all.
		}

		// ── Pass 2: execute ─────────────────────────────────────────────────────────────────
		for ( var entry in batch ) {
			if ( entry.result.isRejected() ) {
				messages.append( buildToolResultMessage( entry.toolCall, "[Tool call blocked: #entry.result.getReason()#]", modelFamily, "error" ) );
				continue
			}

			var capturedTool = entry.tool
			var capturedArgs = entry.toolArgs
			var toolResult = thisChatRequest.fireWrapMiddleware(
				"wrapToolCall",
				{ tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, toolName: entry.toolName, toolArgs: capturedArgs },
				() => capturedTool.invoke( args: capturedArgs, chatRequest: thisChatRequest )
			);

			thisChatRequest.fireMiddleware(
				hook   : "afterToolCall",
				context: { tool: entry.tool, toolCall: entry.toolCall, chatRequest: thisChatRequest, result: toolResult },
				reverse: true
			);

			messages.append( buildToolResultMessage( entry.toolCall, toolResult, modelFamily ) );
		}

		thisChatRequest.setMessages( messages );

		// Recurse for the follow-up turn — unlike ClaudeService (which falls back to a blocking
		// chat() for the follow-up), InvokeModelWithResponseStream can stream the continuation too,
		// so the caller keeps receiving chunks for every turn.
		return chatStream( thisChatRequest, userCallback, arguments.interactionCount + 1 );
	}

	/**
	 * Streaming mirror of resumeToolBatch(): finish processing a tool-call batch that was
	 * suspended for human approval during chatStream(), using the finalized resume ledger
	 * AiAgent.resumeStream() built. No LLM call for the suspended turn itself, and nothing that
	 * already ran (or was already blocked) runs again — see resumeToolBatch() for the full
	 * rationale; this is the same mechanics emitting through the streaming callback.
	 *
	 * @chatRequest      The chat request to continue — its messages are the pre-LLM-call messages
	 *                    from the original (suspended) attempt
	 * @callback         The streaming callback for chunks (and the middleware_stop sentinel)
	 * @resumeCtx        The resume context AiAgent.resumeStream() built: { assistantMessage, resumeLedger }
	 * @interactionCount Current tool call interaction count (used internally)
	 */
	private any function resumeToolBatchStream(
		required AiChatRequest chatRequest,
		required function callback,
		required struct resumeCtx,
		required numeric interactionCount
	) {
		// Consume the resume context immediately — the follow-up turn below recurses into
		// chatStream(), which must not re-detect this same resume context and loop forever.
		arguments.chatRequest.setResumeContext( {} )

		var thisChatRequest  = arguments.chatRequest
		var userCallback     = arguments.callback

		// chatStream()'s ceiling guard lives inside its own tool-loop branch, so it never sees a
		// resume: every suspend/resume cycle would otherwise lift the ceiling by one turn. Checked
		// up front, as CohereService.resumeToolBatchStream() does.
		var resumeMaxAllowed = thisChatRequest.getMaxInteractions() > 0 ? thisChatRequest.getMaxInteractions() : variables.maxInteractions;
		if ( arguments.interactionCount >= resumeMaxAllowed ) {
			writeLog(
				text: "Max tool call interactions (#resumeMaxAllowed#) exceeded",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "MaxInteractionsExceeded",
				message: "Tool calls exceeded maximum allowed interactions (#resumeMaxAllowed#). This may indicate an infinite loop."
			);
		}

		var assistantMessage = arguments.resumeCtx.assistantMessage
		var ledger           = arguments.resumeCtx.resumeLedger ?: []

		// The dialect the SUSPENDED turn was built in, not whatever the config resolves to now.
		// A run that fell back Converse -> InvokeModel at request time recorded `invoke` in the
		// suspend payload; re-resolving here would read the configured default ("converse") and
		// hand extractAssistantToolCalls() a dialect the recorded assistant turn is not in, which
		// silently yields zero tool calls — every approved tool skipped.
		var persistedDialect = resumeSuspendValue( arguments.resumeCtx, "toolDialect" )
		var persistedApi     = resumeSuspendValue( arguments.resumeCtx, "bedrockApi" )
		if ( len( persistedApi ) ) {
			stickBedrockApi( thisChatRequest, persistedApi )
		}
		var modelFamily = len( persistedDialect ) ? persistedDialect : resolveToolDialect( thisChatRequest )
		var toolCalls   = extractAssistantToolCalls( assistantMessage, modelFamily )

		// The ledger is positional: entry i is the decision for tool call i. If the recorded turn
		// no longer yields the same number of calls the ledger was built for, every pairing below
		// is wrong — approving one tool would execute another. Fail instead of guessing.
		if ( toolCalls.len() != ledger.len() ) {
			throw(
				type   : "ResumeLedgerMismatch",
				message: "Bedrock resume ledger does not match the recorded assistant turn: #ledger.len()# decision(s) "
					& "for #toolCalls.len()# tool call(s) (dialect '#modelFamily#'). The suspended turn cannot be resumed safely.",
				detail : "resumeLedgerArity"
			)
		}

		var messages = thisChatRequest.getMessages()
		messages.append( assistantMessage )

		for ( var i = 1; i <= toolCalls.len(); i++ ) {
			var toolCall    = toolCalls[ i ]
			var ledgerEntry = ( i <= ledger.len() )
				? ledger[ i ]
				: { status: "blocked", reason: "No resume decision was recorded for this tool call." }

			if ( ledgerEntry.status == "cancel" ) {
				var cancelReason = ledgerEntry.reason ?: "Cancelled by human operator during resume."
				messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #cancelReason#]", modelFamily, "error" ) )
				thisChatRequest.setMessages( messages )
				userCallback( { type: "middleware_stop", result: AiMiddlewareResult.cancel( cancelReason ) } )
				return
			}

			if ( ledgerEntry.status == "blocked" ) {
				messages.append( buildToolResultMessage( toolCall, "[Tool call blocked: #ledgerEntry.reason ?: ""#]", modelFamily, "error" ) )
				continue
			}

			// "execute"
			var callName    = toolCallName( toolCall )
			var toolAttempt = thisChatRequest.getTool( callName )
			if ( !toolAttempt.isPresent() ) {
				writeLog(
					text: "Unable to find tool named: [#callName#]",
					type: "warning",
					log : "ai"
				)
				messages.append( buildToolResultMessage( toolCall, "Tool ['#callName#'] not found in chat request", modelFamily, "error" ) )
				continue
			}

			var tool         = toolAttempt.get()
			var toolArgs     = isStruct( ledgerEntry.editedArgs ?: "" ) ? ledgerEntry.editedArgs
				: ( isStruct( ledgerEntry.toolArgs ?: "" ) ? ledgerEntry.toolArgs : toolCallArgs( toolCall ) )
			var capturedTool = tool
			var capturedArgs = toolArgs
			var toolResult   = thisChatRequest.fireWrapMiddleware(
				"wrapToolCall",
				{ tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, toolName: len( callName ) ? callName : tool.getName(), toolArgs: toolArgs },
				() => capturedTool.invoke( args: capturedArgs, chatRequest: thisChatRequest )
			)

			thisChatRequest.fireMiddleware(
				hook   : "afterToolCall",
				context: { tool: tool, toolCall: toolCall, chatRequest: thisChatRequest, result: toolResult },
				reverse: true
			)

			messages.append( buildToolResultMessage( toolCall, toolResult, modelFamily ) )
		}

		thisChatRequest.setMessages( messages )

		return chatStream( thisChatRequest, userCallback, arguments.interactionCount + 1 )
	}

	/**
	 * Send a signed streaming request to AWS Bedrock
	 *
	 * AWS Bedrock streaming uses binary event-stream format (application/vnd.amazon.eventstream)
	 * which is different from SSE. Since BoxLang's HTTP streaming is designed for SSE,
	 * we make a synchronous request and parse the binary event-stream response.
	 *
	 * @modelId     The model ID or inference profile ARN to invoke
	 * @dataPacket  The request payload
	 * @aiRequest   The AiRequest for logging settings
	 * @modelFamily The detected model family for response transformation
	 * @callback    The callback function for streaming chunks
	 * @operation   The runtime operation ("converse-stream" or "invoke-with-response-stream")
	 * @streamAttempt Out-parameter the caller reads to decide whether a failure is recoverable:
	 *                `delivered` is set once ANY chunk has reached the caller's callback, and
	 *                `transportFailed` once the HTTP leg has returned a non-200. A fallback is only
	 *                safe when the failure was a transport failure and nothing was delivered.
	 * @isFallbackRetry True on the InvokeModel leg of a Converse fallback — one logical call with
	 *                the Converse attempt that preceded it. beforeLLMCall and wrapLLMCall are still
	 *                fired (the body was rebuilt against a different API, and a substituting
	 *                middleware has to be able to answer this leg) but carry `fallbackRetry: true`
	 *                in their context, and onAIChatRequest — a per-application-call event — is
	 *                suppressed.
	 */
	private function sendBedrockStreamRequest(
		required string modelId,
		required struct dataPacket,
		required AiChatRequest aiRequest,
		required string modelFamily,
		required function callback,
		string operation           = "invoke-with-response-stream",
		struct streamAttempt       = {},
		boolean isFallbackRetry    = false
	){
		var host     = getBedrockHost();
		var path     = getBedrockOperationPath( arguments.modelId, arguments.operation );
		var endpoint = getBedrockOperationEndpoint( arguments.modelId, arguments.operation );

		// -------------------------------------------------------------------------------------------
		// --- Fire beforeLLMCall middleware (streaming) ---
		// -------------------------------------------------------------------------------------------
		// `stream: true` / `transport` are part of the context contract: middleware that produces a
		// canned response (FlightRecorder replay, caches) MUST return a raw event-stream body here,
		// not the parsed chat struct the sync path takes.
		// Re-fired on the InvokeModel leg of a Converse fallback, flagged `fallbackRetry: true`:
		// that leg's body was rebuilt from scratch against a different API, so every in-place edit
		// the hook made to the Converse packet is gone. The flag is what lets middleware tell the
		// two legs of one logical call apart (see chat()'s fallback for the sync mirror).
		var streamContext = {
			chatRequest  : arguments.aiRequest,
			dataPacket   : arguments.dataPacket,
			stream       : true,
			transport    : "bedrock-event-stream",
			fallbackRetry: arguments.isFallbackRetry
		};
		var streamLlmBefore = arguments.aiRequest.fireMiddleware( "beforeLLMCall", streamContext );
		if( streamLlmBefore.isTerminal() ){
			emitStreamChunkGuarded( arguments.callback, { type: "middleware_stop", result: streamLlmBefore }, arguments.aiRequest )
			return { "terminated": true }
		}

		// A replacement packet must reach signing, logging and the transport wrapper too.
		if ( isStruct( streamContext.dataPacket ?: "" ) ) {
			arguments.dataPacket = streamContext.dataPacket;
		}

		// The wrap context is the SAME struct beforeLLMCall received (as on the sync path, which
		// reuses llmContext for both hooks): keys a middleware stashes in beforeLLMCall are visible
		// to wrapLLMCall, and the packet swap above is already reflected in it.
		streamContext.dataPacket = arguments.dataPacket;

		// Announce the request (suppressed on a fallback retry — same logical call)
		if ( !arguments.isFallbackRetry ) {
			boxAnnounce(
				"onAIChatRequest",
				{
					"dataPacket"  : arguments.dataPacket,
					"chatRequest" : arguments.aiRequest,
					"provider"    : this
				}
			);
		}

		// Log the request if enabled
		if ( arguments.aiRequest.getLogRequest() ) {
			writeLog(
				text: buildBedrockRequestLog( arguments.aiRequest, arguments.dataPacket, endpoint, true ),
				type: "info",
				log : "ai"
			);
		}

		if ( arguments.aiRequest.getLogRequestToConsole() ) {
			println( buildBedrockRequestLog( arguments.aiRequest, arguments.dataPacket, endpoint, true ) );
		}

		// Provider-option-driven extra headers (generic x-amzn-bedrock-* passthrough + Guardrails)
		var extraHeaders = buildProviderOptionHeaders( arguments.aiRequest.getProviderOptions(), arguments.operation );

		// -------------------------------------------------------------------------------------------
		// --- Fire WrapLLM -> Bedrock streaming transport ---
		// -------------------------------------------------------------------------------------------
		// The sync path has always been wrapLLMCall-wrapped; the streaming path was not, so no
		// middleware could observe, time, or substitute a streamed call. The inner function returns
		// the RAW event-stream body — exactly what parseBedrockEventStream() consumes — so a
		// middleware canned response replaces the network call without changing anything
		// downstream. Two body shapes are accepted:
		//   - binary: a real AWS event-stream (prelude + headers + payload frames)
		//   - string: a concatenation of JSON frames, for replays that cannot carry binary.
		//     InvokeModel-family frames are `{"bytes":"<base64 of the model's event JSON>"}`.
		//     ConverseStream frames MUST additionally name the event, because ConverseStream's whole
		//     event vocabulary lives in the frame's `:event-type` header and the payloads are
		//     otherwise indistinguishable structs:
		//         {"eventType":"contentBlockDelta","bytes":"<base64 of the event JSON>"}
		//     A ConverseStream replay without `eventType` decodes to a payload no branch can
		//     identify, and the whole stream yields nothing.
		//     `stream: true` / `transport` on the context is what tells a middleware this hook
		//     wraps the STREAMING transport (a substituted response must be a raw event-stream
		//     body, not the chat struct the sync context takes); `fallbackRetry` is true on the
		//     InvokeModel leg of a Converse fallback so a metering middleware can count once.
		//
		// The body is serialized INSIDE the inner function, not before the hook: the sync path
		// serializes inside sendBedrockRequest(), so a wrapLLMCall middleware that edits
		// `context.dataPacket` in place and then calls handler() reaches the wire there — and
		// now here too, instead of a string frozen before the hook ran being signed and sent.
		var capturedHost         = host;
		var capturedPath         = path;
		var capturedEndpoint     = endpoint;
		var capturedDataPacket   = arguments.dataPacket;
		var capturedExtraHeaders = extraHeaders;
		var capturedAiRequest    = arguments.aiRequest;
		var capturedStreamAttempt = arguments.streamAttempt;
		var responseBody         = arguments.aiRequest.fireWrapMiddleware(
			hook         : "wrapLLMCall",
			context      : streamContext,
			innerFunction: () => invokeBedrockStreamTransport(
				host          = capturedHost,
				path          = capturedPath,
				endpoint      = capturedEndpoint,
				payload       = jsonSerialize( capturedDataPacket ),
				extraHeaders  = capturedExtraHeaders,
				aiRequest     = capturedAiRequest,
				streamAttempt = capturedStreamAttempt
			)
		);

		// A middleware that treats wrapLLMCall as a chat round trip returns the parsed response
		// struct; parseBedrockEventStream() would then run reMatchNoCase() over it and die with a
		// cast error outside any try. Fail here instead, naming the contract.
		if ( isNull( responseBody ) || ( !isBinary( responseBody ) && !isSimpleValue( responseBody ) ) ) {
			var returnedType = isNull( responseBody ) ? "null" : ( isStruct( responseBody ) ? "struct" : ( isArray( responseBody ) ? "array" : "unsupported" ) );
			throw(
				type   : "BedrockStreamError",
				message: "wrapLLMCall middleware returned a #returnedType# for a STREAMING Bedrock call. "
					& "The streaming transport contract requires the raw AWS event-stream body (binary, or a string of {""bytes"":...} frames). "
					& "Middleware that substitutes a canned response must check `context.stream` (or `context.transport == 'bedrock-event-stream'`) and return a stream body.",
				detail : "bedrock-event-stream"
			);
		}

		// Parse the AWS event-stream binary response
		// The response contains multiple events, each with a binary header and JSON payload
		var bedrockUsage = { "inputTokens": 0, "outputTokens": 0, "totalTokens": 0, "raw": {} };
		// Accumulate the streamed assistant text so afterLLMCall middleware can inspect it
		var bedrockContent = "";
		// Reasoning is accumulated separately and never folded into bedrockContent — content is
		// the answer, and is what gets persisted to memory. Kept so an OutputGuard can inspect
		// streamed reasoning too, matching the sync path's derived copy.
		var bedrockReasoning = "";
		var userStreamCallback = arguments.callback;
		// Owned HERE, not by the parser, so a mid-stream callback exception is re-raised only after
		// the usage below has been announced: the model was already called and billed by the time a
		// chunk reached the caller, and a billed call that loses its onAITokenCount is a hole in
		// every cost/audit listener. Mirrors OpenAIService.chatStream.
		var streamCallbackError = newStreamCallbackErrorHolder();
		var usageCapturingCallback = ( chunk ) => {
			// Capture usage data from the normalized chunk if present
			if( !isNull( chunk.usage ) && isStruct( chunk.usage ) ){
				bedrockUsage.inputTokens  = chunk.usage.keyExists( "prompt_tokens" )     ? chunk.usage.prompt_tokens     : bedrockUsage.inputTokens;
				bedrockUsage.outputTokens = chunk.usage.keyExists( "completion_tokens" ) ? chunk.usage.completion_tokens : bedrockUsage.outputTokens;
				bedrockUsage.totalTokens  = bedrockUsage.inputTokens + bedrockUsage.outputTokens;
				bedrockUsage.raw          = chunk.usage;
			}
			// Guard on len(): the final amazon-bedrock-invocationMetrics event arrives as a
			// usage-only chunk with `choices: []`, and first() on an EMPTY array throws ("Cannot
			// return first element of array") — safe navigation only short-circuits a null. The
			// throw was swallowed by processBedrockEvent's catch at debug level, so the caller's
			// stream callback silently never received that final usage chunk.
			if ( isArray( chunk.choices ?: "" ) && chunk.choices.len() ) {
				var streamDelta   = chunk.choices.first().delta ?: {};
				bedrockContent   &= ( streamDelta.content ?: "" );
				bedrockReasoning &= ( streamDelta.reasoning ?: "" );
			}
			// Marked BEFORE the callback runs: once the caller has been handed a chunk, this stream
			// can never be retried over another API without replaying output it already consumed.
			capturedStreamAttempt[ "delivered" ] = true;
			emitStreamChunkGuarded( userStreamCallback, chunk, capturedAiRequest, streamCallbackError );
		};

		// Held in a named variable rather than built inline in the context: middleware mutates this
		// struct (PromptSecurity::setResponseText/setResponseReasoning write into it), and an
		// anonymous literal is unreachable the moment fireMiddleware returns — so a redaction
		// reported success while provably changing nothing. BaseService.sendStreamRequest keeps and
		// returns the same struct it handed the middleware; this now matches.
		//
		// The tool-accumulation keys below are written by transformStreamChunk() as Claude's
		// content_block_start / input_json_delta / content_block_stop events arrive:
		//   toolCalls            - finalized [{ type, id, name, input }] blocks (afterLLMCall reads this)
		//   toolInputBuffers     - contentIndex -> partial_json fragments still being accumulated
		//   toolCallIndexMap     - contentIndex -> position in toolCalls
		//   structuredOutputJSON - raw JSON of the forced structured_output tool's input, which is
		//                          NOT a real tool call and is never executed as one
		var streamState = {
			"content"             : "",
			"reasoning"           : "",
			"finishReason"        : "",
			"toolCalls"           : [],
			"toolInputBuffers"    : {},
			"toolCallIndexMap"    : {},
			"structuredOutputJSON": "",
			"stopReason"          : "",
			"reasoningSignature"  : "",
			"usage"               : {},
			// Declared here rather than lazily created by the first accumulator that needs them:
			//   finalizedToolCalls    - blockKey -> true, so the end-of-stream drain can tell a
			//                           closed argument buffer from one the stream never closed
			//   structuredOutputIndex - the blockKey of the forced structured_output tool's block
			//   cohereCallBatchId     - per-stream id suffix for Cohere's positional tool-call ids
			"finalizedToolCalls"   : {},
			"structuredOutputIndex": "",
			"cohereCallBatchId"    : ""
		};

		try {
			parseBedrockEventStream(
				responseData = responseBody,
				modelFamily  = arguments.modelFamily,
				modelId      = arguments.modelId,
				callback     = usageCapturingCallback,
				logEnabled   = arguments.aiRequest.getLogResponse(),
				aiRequest    = arguments.aiRequest,
				streamState  = streamState
			);
		} catch ( any e ) {
			// The caller's stream callback exception lands here after the model has already been
			// billed. Announce it — a failure with no onAIError leaves audit/replay middleware with
			// no record of a call that happened. Only skip the announce for something that has
			// ALREADY announced: an exception FRAME (throwBedrockStreamError marks it) or a captured
			// caller-callback error (captureStreamCallbackError announced it). Keying on the type
			// alone silenced the malformed-frame / truncated-tool-arguments / drain throws too.
			var alreadyAnnounced = local.streamCallbackError.captured
				|| ( e.extendedInfo ?: "" ) == static.BEDROCK_ERROR_ANNOUNCED;
			if ( !local.alreadyAnnounced ) {
				announceBedrockError(
					error     = { "message" : e.message },
					aiRequest = arguments.aiRequest,
					operation = "stream",
					canRetry  = false
				);
			}
			// A captured caller-callback error is NOT re-raised here: the usage below has to be
			// announced first (the call was billed), and rethrowStreamCallbackError() re-raises it
			// after that, before afterLLMCall. Mirrors OpenAIService.chatStream.
			if ( !local.streamCallbackError.captured ) {
				rethrow;
			}
		}

		// -------------------------------------------------------------------------------------------
		// --- Usage Event Announcement (Streaming) ---
		// -------------------------------------------------------------------------------------------
		if( bedrockUsage.totalTokens > 0 ){
			boxAnnounce( "onAITokenCount", {
				provider         : this,
				operation        : "stream",
				model            : arguments.modelId,
				promptTokens     : bedrockUsage.inputTokens,
				completionTokens : bedrockUsage.outputTokens,
				totalTokens      : bedrockUsage.totalTokens,
				aiRequest        : arguments.aiRequest,
				usage            : bedrockUsage.raw,
				timestamp        : now()
			} );
		}

		// Log completion
		if ( arguments.aiRequest.getLogResponse() ) {
			writeLog(
				text: "Bedrock stream completed successfully",
				type: "info",
				log : "ai"
			);
		}

		boxAnnounce(
			"onAIChatResponse",
			{
				"chatRequest"    : arguments.aiRequest,
				"provider"       : this,
				"streamComplete" : true
			}
		);

		// Usage is accounted for; now let the caller's own callback exception out - before
		// afterLLMCall, which describes a call that produced a complete response.
		rethrowStreamCallbackError( streamCallbackError );

		// -------------------------------------------------------------------------------------------
		// --- Fire afterLLMCall middleware (streaming), in reverse order ---
		// -------------------------------------------------------------------------------------------
		streamState.content      = bedrockContent;
		streamState.reasoning    = bedrockReasoning;
		streamState.usage        = bedrockUsage.raw;
		// The normalized OpenAI-shaped finish_reason, not Converse's raw stopReason: every other
		// provider (and this provider's own sync path) reports "stop"/"tool_calls"/"length" here,
		// so afterLLMCall middleware reading streamState.finishReason saw a different vocabulary
		// on the streaming Converse path than anywhere else. An unrecognized value passes through.
		streamState.finishReason = static.CONVERSE_STOP_REASONS[ streamState.stopReason ?: "" ] ?: ( streamState.stopReason ?: "" );

		arguments.aiRequest.fireMiddleware(
			hook   : "afterLLMCall",
			context: { chatRequest: arguments.aiRequest, streamState: streamState },
			reverse: true
		)

		return streamState;
	}

	/**
	 * The raw HTTP leg of a Bedrock InvokeModelWithResponseStream call: sign, send, check the
	 * status, and hand back the raw AWS event-stream body. Split out of sendBedrockStreamRequest()
	 * so it can sit inside a wrapLLMCall inner function.
	 *
	 * @host         The Bedrock host being signed for
	 * @path         The signed request path
	 * @endpoint     The full endpoint URL
	 * @payload      The serialized JSON request body
	 * @extraHeaders Provider-option-driven extra headers (Guardrails, x-amzn-bedrock-* passthrough)
	 * @aiRequest    The AiChatRequest, for timeout/logging and error announcements
	 * @streamAttempt Out-parameter: `transportFailed` is set here, and ONLY here, so a caller can
	 *                distinguish "the connection was refused before a byte of output" (safe to
	 *                retry over another API) from an exception frame delivered mid-stream.
	 *
	 * @return The raw event-stream response body (binary, or a string)
	 *
	 * @throws ProviderError on a non-200 response
	 */
	private any function invokeBedrockStreamTransport(
		required string host,
		required string path,
		required string endpoint,
		required string payload,
		required struct extraHeaders,
		required AiChatRequest aiRequest,
		struct streamAttempt = {}
	){
		arguments.streamAttempt[ "transportRan" ] = true;

		// Build HTTP request - use synchronous request and process binary response
		var httpService = http( url = arguments.endpoint )
			.method( "POST" )
			.charset( "UTF-8" )
			.timeout( arguments.aiRequest.getTimeout() )
			.throwOnError( false )
			.header( "Content-Type", "application/json" )
			.header( "Accept", "application/vnd.amazon.eventstream" );

		if ( useBearerAuth() ) {
			httpService.header( "Authorization", "Bearer #getBearerToken()#" );
		} else {
			// Sign the request using AWS Signature V4
			var headersToSign = {
				"content-type" : "application/json",
				"accept"       : "application/vnd.amazon.eventstream"
			};
			headersToSign.append( arguments.extraHeaders, true );

			var creds         = resolveAwsCredentials();
			var signer        = new AwsSignatureV4();
			var signedHeaders = signer.signRequest(
				method      = "POST",
				host        = arguments.host,
				path        = arguments.path,
				queryString = "",
				headers     = headersToSign,
				payload         = arguments.payload,
				region          = variables.region,
				service         = static.AWS_SERVICE,
				accessKeyId     = creds.accessKeyId,
				secretAccessKey = creds.secretAccessKey,
				sessionToken    = creds.sessionToken
			);

			httpService.header( "Host", arguments.host );
			for ( var headerName in signedHeaders ) {
				httpService.header( headerName, signedHeaders[ headerName ] );
			}
		}

		for ( var extraHeaderName in arguments.extraHeaders ) {
			httpService.header( extraHeaderName, arguments.extraHeaders[ extraHeaderName ] );
		}

		// Send request and get response
		var httpResult = httpService.body( arguments.payload ).send();

		// Check for HTTP errors
		var statusCode = val( listFirst( httpResult.statusCode, " " ) );
		if ( statusCode != 200 ) {
			var errorMessage = "Bedrock stream request failed with status #statusCode##bedrockErrorTypeSuffix( httpResult )#: #httpResult.fileContent#";
			writeLog( text: errorMessage, type: "error", log: "ai" );
			// The stream never opened, so nothing was delivered to the caller: this is the ONE
			// streaming failure a Converse -> InvokeModel fallback may act on.
			arguments.streamAttempt[ "transportFailed" ] = true;

			// Rate limiting (429): announce a dedicated event matching BaseService's
			// onAIRateLimitHit contract (BaseService.bx:360-367 uses the key "chatRequest", not
			// "aiRequest").
			if ( statusCode == 429 ) {
				var errorData = {};
				try {
					errorData = jsonDeserialize( httpResult.fileContent );
				} catch ( any e ) {
					errorData = { "message" : httpResult.fileContent };
				}

				var responseHeaders = httpResult.responseHeader ?: {};
				boxAnnounce(
					"onAIRateLimitHit",
					{
						provider    : this,
						operation   : "stream",
						statusCode  : statusCode,
						errorData   : errorData,
						chatRequest : arguments.aiRequest,
						retryAfter  : firstHeaderValue( responseHeaders[ "retry-after" ] ?: "" )
					}
				);
			}

			announceBedrockError(
				error     = { "message" : errorMessage, "statusCode" : statusCode },
				aiRequest = arguments.aiRequest,
				operation = "stream",
				canRetry  = statusCode >= 500 || statusCode == 429
			);

			throw( type: "ProviderError", message: errorMessage );
		}

		// Guardrails may be reported on the initial response headers even for a streaming call
		checkGuardrailIntervention( httpResult, {} );

		return httpResult.fileContent;
	}

	/**
	 * Parse AWS event-stream binary format from Bedrock response
	 *
	 * AWS event-stream format:
	 * - Each event has: prelude (8 bytes) + headers + payload + CRC (4 bytes)
	 * - Prelude: total_length (4 bytes) + headers_length (4 bytes)
	 * - The payload is typically JSON with a "bytes" field containing base64-encoded data
	 *
	 * @responseData  The raw response data from Bedrock
	 * @modelFamily   The model family for response transformation
	 * @modelId       The model ID
	 * @callback      The callback function for streaming chunks
	 * @logEnabled    Whether verbose info-level parse logging is enabled (mirrors aiRequest.getLogResponse())
	 */
	private function parseBedrockEventStream(
		required any responseData,
		required string modelFamily,
		required string modelId,
		required function callback,
		boolean logEnabled = false,
		any aiRequest      = "",
		struct streamState = {}
	){
		var data = arguments.responseData;

		// Debug: Log raw response info
		if ( arguments.logEnabled ) {
			writeLog(
				text: "parseBedrockEventStream - Raw data type: #( isBinary( data ) ? 'binary' : 'string' )#, length: #( isBinary( data ) ? arrayLen( data ) : len( data ) )#",
				type: "info",
				log : "ai"
			);
		}

		// AWS event-stream is a binary protocol. We need to parse it properly.
		// Format: Each event consists of:
		// - Prelude (8 bytes): total_length (4 bytes, big-endian) + headers_length (4 bytes, big-endian)
		// - Prelude CRC (4 bytes)
		// - Headers (variable length)
		// - Payload (variable length) - contains JSON with "bytes" field holding base64 data
		// - Message CRC (4 bytes)

		if ( !isBinary( data ) ) {
			// A string body is the replay contract (see the wrapLLMCall comment in
			// sendBedrockStreamRequest): a concatenation of `{"bytes":"<base64>"}` frames, each
			// optionally prefixed with the event name it would have carried in its `:event-type`
			// header. ConverseStream REQUIRES that name — its messageStart / contentBlockStart /
			// contentBlockDelta / contentBlockStop / messageStop / metadata payloads are bare
			// structs with nothing to tell them apart, so an un-named frame reaches
			// processBedrockEvent()'s default branch and the whole replay yields nothing.
			// Matched as WHOLE objects rather than as a fixed key order: jsonSerialize() emits
			// struct keys alphabetically, so a frame built with it is {"bytes":...,"eventType":...}
			// — the reverse of the order the old anchored pattern required, and every such replay
			// matched nothing at all. `[^{}]*` cannot cross a brace, so a match is exactly one
			// frame object; the event name is read back off the deserialized struct below.
			// `[^"]*`, not `[^"]+`: an EMPTY bytes value is a legitimate frame. ConverseStream's
			// contentBlockStop / messageStop payloads can be empty objects, so a replay that
			// base64-encodes `{}`-ish content to "" was skipped entirely and the stream never saw
			// its terminator — which the drain then reported as truncated tool arguments.
			var jsonMatches = reMatchNoCase( '\{[^{}]*"bytes":"[^"]*"[^{}]*\}', data );
			if ( !jsonMatches.len() && len( trim( data ) ) ) {
				writeLog(
					text: "parseBedrockEventStream - A non-empty STRING stream body matched no `{""bytes"":...}` frames (#len( data )# chars): "
						& "the replay contract is a concatenation of {""bytes"":""<base64>""} objects (ConverseStream frames must also carry ""eventType""). "
						& "Nothing was streamed to the caller. First 200 chars: #left( data, 200 )#",
					type: "warning",
					log : "ai"
				);
			}
			for ( var match in jsonMatches ) {
				var replayEventType = "";
				try {
					replayEventType = jsonDeserialize( match ).eventType ?: "";
				} catch ( any e ) {
					// Not our envelope after all — process it un-named, as before.
				}
				processBedrockEvent(
					match,
					arguments.modelFamily,
					arguments.modelId,
					arguments.callback,
					arguments.streamState,
					replayEventType
				);
			}
			return;
		}

		// Parse binary event-stream
		var bytes      = data;
		var dataLength = arrayLen( bytes );
		var position   = 1; // BoxLang arrays are 1-indexed
		var eventCount = 0;

		if ( arguments.logEnabled ) {
			writeLog(
				text: "parseBedrockEventStream - Parsing binary stream, total bytes: #dataLength#",
				type: "info",
				log : "ai"
			);
		}

		while ( position + 12 <= dataLength ) {
			// Read prelude: total_length (4 bytes) + headers_length (4 bytes)
			var totalLength = readBigEndianInt( bytes, position );
			var headersLength = readBigEndianInt( bytes, position + 4 );

			// Sanity check
			if ( totalLength < 16 || totalLength > 1000000 || headersLength < 0 || headersLength > totalLength ) {
				writeLog(
					text: "parseBedrockEventStream - Invalid event at position #position#: totalLength=#totalLength#, headersLength=#headersLength#",
					type: "warning",
					log : "ai"
				);
				break;
			}

			// Calculate payload position and length
			// Event structure: prelude(8) + preludeCRC(4) + headers(headersLength) + payload + messageCRC(4)
			var payloadStart  = position + 8 + 4 + headersLength; // After prelude + preludeCRC + headers
			var payloadLength = totalLength - 8 - 4 - headersLength - 4; // Subtract prelude, preludeCRC, headers, messageCRC

			// -------------------------------------------------------------------------------------
			// Decode the header block. This was previously skipped entirely, which is why a
			// mid-stream Bedrock exception (throttlingException, modelStreamErrorException,
			// validationException, serviceUnavailableException) — delivered as a frame whose
			// `:message-type` header is `exception`, not `event` — arrived as an untyped payload,
			// transformed to a null chunk, and was logged at DEBUG in processBedrockEvent(). A
			// throttled stream was indistinguishable from a short answer.
			// -------------------------------------------------------------------------------------
			var headerDecode = parseEventStreamHeaders( bytes, position + 12, headersLength, dataLength );
			if ( headerDecode.truncated ) {
				// Half-decoded headers are worse than none: the frame could be an exception frame
				// whose `:message-type` never made it out, which would then be handed to
				// processBedrockEvent() as a normal event and vanish at debug level.
				writeLog(
					text: "parseBedrockEventStream - Malformed/truncated event header block at position #position# (headersLength=#headersLength#, totalBytes=#dataLength#)",
					type: "error",
					log : "ai"
				);
				throw(
					type   : "BedrockStreamError",
					message: "Malformed Bedrock event-stream frame: the header block at byte #position# is truncated (headersLength=#headersLength#, delivered=#dataLength# bytes). The stream ended mid-frame.",
					detail : "malformedFrame"
				);
			}
			var eventHeaders  = headerDecode.headers;
			var messageType   = eventHeaders[ ":message-type" ] ?: "";
			var exceptionType = eventHeaders[ ":exception-type" ] ?: ( eventHeaders[ ":error-code" ] ?: "" );
			// The ConverseStream event vocabulary lives ENTIRELY in this header — messageStart /
			// contentBlockStart / contentBlockDelta / contentBlockStop / messageStop / metadata all
			// arrive as bare payload structs with no discriminating field of their own — so it has
			// to reach transformStreamChunk(). InvokeModel frames all say ":event-type: chunk",
			// which every non-Converse branch ignores.
			var eventType     = eventHeaders[ ":event-type" ] ?: "";

			if ( len( exceptionType ) || listFindNoCase( "exception,error", messageType ) ) {
				// An exception frame whose payload is empty or truncated still carries the message
				// in the `:error-message` header (that is where ConverseStream puts it); dropping
				// to "" produced a bare "Bedrock stream error [throttlingException]" with no detail.
				var errorPayload = ( payloadLength > 0 && payloadStart + payloadLength - 1 <= dataLength )
					? readEventStreamString( bytes, payloadStart, payloadLength )
					: ( eventHeaders[ ":error-message" ] ?: "" );
				throwBedrockStreamError( exceptionType, errorPayload, arguments.aiRequest );
			}

			if ( payloadLength > 0 && payloadStart + payloadLength - 1 <= dataLength ) {
				var payloadStr = readEventStreamString( bytes, payloadStart, payloadLength );

				// Debug first event payload
				if ( eventCount == 0 && arguments.logEnabled ) {
					writeLog(
						text: "parseBedrockEventStream - First event payload (#payloadLength# bytes): #left( payloadStr, 300 )#",
						type: "info",
						log : "ai"
					);
				}

				// Deliberately unguarded. processBedrockEvent() logs an unparseable payload itself,
				// and the caller's stream callback runs inside it — a try around this call turned
				// every exception the caller's own code threw into a warning-level log line and a
				// stream that quietly kept going.
				processBedrockEvent( payloadStr, arguments.modelFamily, arguments.modelId, arguments.callback, arguments.streamState, eventType );
				eventCount++;
			} else if ( payloadLength > 0 ) {
				// The frame declares a payload the delivered bytes do not contain: the stream was
				// cut mid-payload. Silently skipping it let the walk fall out of the loop and
				// report a normal, complete stream — a truncated answer indistinguishable from a
				// short one.
				writeLog(
					text: "parseBedrockEventStream - Malformed/truncated event payload at position #position# (payloadStart=#payloadStart#, payloadLength=#payloadLength#, totalBytes=#dataLength#)",
					type: "error",
					log : "ai"
				);
				throw(
					type   : "BedrockStreamError",
					message: "Malformed Bedrock event-stream frame: the payload at byte #payloadStart# is truncated (payloadLength=#payloadLength#, delivered=#dataLength# bytes). The stream ended mid-frame.",
					detail : "malformedFrame"
				);
			}

			// Move to next event
			position += totalLength;
		}

		if ( arguments.logEnabled ) {
			writeLog(
				text: "parseBedrockEventStream - Processed #eventCount# events",
				type: "info",
				log : "ai"
			);
		}
	}

	/**
	 * Read `length` bytes from an event-stream byte array as a UTF-8 string.
	 *
	 * @bytes    The full event-stream byte array (1-indexed)
	 * @start    First byte to read
	 * @length   Number of bytes to read
	 */
	private string function readEventStreamString( required any bytes, required numeric start, required numeric length ){
		if ( arguments.length <= 0 ) {
			return "";
		}
		// `bytes` is the JVM byte[] behind the BoxLang array, and String(byte[],off,len,charset)
		// reads the range directly — the per-byte copy this replaces allocated a fresh array for
		// every frame of every stream. `start` is 1-indexed (BoxLang), the offset is 0-indexed.
		return createObject( "java", "java.lang.String" ).init(
			arguments.bytes,
			javacast( "int", arguments.start - 1 ),
			javacast( "int", arguments.length ),
			"UTF-8"
		);
	}

	/**
	 * Read one byte of an event-stream frame as an UNSIGNED value (JVM bytes are signed).
	 */
	private numeric function unsignedEventStreamByte( required any bytes, required numeric position ){
		var b = arguments.bytes[ arguments.position ];
		return b < 0 ? b + 256 : b;
	}

	/**
	 * Decode an AWS event-stream header block into a plain struct of header name -> value.
	 *
	 * Wire format per header entry:
	 *   name_length (1 byte) + name (name_length bytes) + value_type (1 byte) + value
	 * Value encoding by type: 0/1 = boolean true/false (no value bytes), 2 = byte, 3 = short,
	 * 4 = integer, 5 = long, 6 = byte buffer (2-byte length prefix), 7 = string (2-byte length
	 * prefix), 8 = timestamp (8 bytes), 9 = UUID (16 bytes).
	 *
	 * Only string headers are surfaced — every header Bedrock's streaming protocol carries that
	 * this module cares about (`:message-type`, `:event-type`, `:exception-type`, `:content-type`)
	 * is a string. Non-string values are skipped by width so the walk stays in sync.
	 * @see https://docs.aws.amazon.com/transcribe/latest/dg/streaming-setting-up.html
	 *
	 * @bytes  The full event-stream byte array (1-indexed)
	 * @start  First byte of the header block
	 * @length Header block length in bytes
	 * @limit  Last readable byte index (defaults to the array length) — the walk never crosses it
	 *
	 * @return { headers: name -> value (string/boolean/numeric), truncated: boolean }. `truncated`
	 *         is true when the block ran out of bytes mid-entry: the decoded headers are then
	 *         incomplete and MUST NOT be trusted (an exception frame would read as a normal event).
	 */
	private struct function parseEventStreamHeaders( required any bytes, required numeric start, required numeric length, numeric limit = 0 ){
		var headers   = {};
		var truncated = false;
		if ( arguments.length <= 0 ) {
			return { "headers": headers, "truncated": false };
		}

		var pos    = arguments.start;
		var endPos = arguments.start + arguments.length; // exclusive
		// Never walk past the end of the delivered bytes, even when the frame prelude claims a
		// header block longer than what actually arrived.
		var hardEnd = ( arguments.limit > 0 ? arguments.limit : arrayLen( arguments.bytes ) ) + 1;
		if ( endPos > hardEnd ) {
			endPos    = hardEnd;
			truncated = true;
		}

		try {
			while ( pos < endPos ) {
				var nameLen = unsignedEventStreamByte( arguments.bytes, pos );
				pos++;
				if ( nameLen <= 0 || pos + nameLen > endPos ) {
					truncated = truncated || nameLen > 0;
					break;
				}

				var headerName = readEventStreamString( arguments.bytes, pos, nameLen );
				pos += nameLen;
				if ( pos >= endPos ) {
					// Name with no value type byte behind it — the frame is cut short.
					truncated = true;
					break;
				}

				var valueType = unsignedEventStreamByte( arguments.bytes, pos );
				pos++;

				switch ( valueType ) {
					case 0:
						headers[ headerName ] = true;
						break;
					case 1:
						headers[ headerName ] = false;
						break;
					case 2:
						// Bounds-check BEFORE the read: on a truncated frame this read past endPos (and
						// past the array), the outer catch swallowed it, and the half-decoded headers made
						// an exception frame look like an ordinary event.
						if ( pos >= endPos ) {
							truncated = true;
							pos       = endPos;
							break;
						}
						headers[ headerName ] = unsignedEventStreamByte( arguments.bytes, pos );
						pos += 1;
						break;
					case 3:
					case 4:
					case 5:
					case 8:
					case 9:
						// Fixed-width values that are skipped, not read: 3=short(2) 4=int(4) 5=long(8)
						// 8=timestamp(8) 9=uuid(16).
						var skipWidth = ( valueType == 3 ? 2 : ( valueType == 4 ? 4 : ( valueType == 9 ? 16 : 8 ) ) );
						if ( pos + skipWidth > endPos ) {
							truncated = true;
							pos       = endPos;
							break;
						}
						pos += skipWidth;
						break;
					case 6:
					case 7:
						if ( pos + 2 > endPos ) {
							truncated = true;
							pos       = endPos;
							break;
						}
						var valueLen = ( unsignedEventStreamByte( arguments.bytes, pos ) * 256 ) + unsignedEventStreamByte( arguments.bytes, pos + 1 );
						pos += 2;
						if ( pos + valueLen > endPos ) {
							truncated = true;
							pos       = endPos;
							break;
						}
						if ( valueType == 7 ) {
							headers[ headerName ] = readEventStreamString( arguments.bytes, pos, valueLen );
						}
						pos += valueLen;
						break;
					default:
						// Unknown value type — the remaining walk can't be trusted, stop here
						// rather than mis-parsing into the payload.
						truncated = true;
						pos       = endPos;
				}
			}
		} catch ( any e ) {
			writeLog(
				text: "parseEventStreamHeaders - Could not decode event headers: #e.message#",
				type: "warning",
				log : "ai"
			);
			local.truncated = true;
		}

		return { "headers": headers, "truncated": truncated };
	}

	/**
	 * Announce and throw for a Bedrock streaming exception frame.
	 *
	 * Surfaced through the same onAIError path sendBedrockStreamRequest()'s HTTP-error branch
	 * uses, with canRetry set for the transient AWS exception types, so a throttled or
	 * temporarily-unavailable stream is retryable rather than silently truncated.
	 *
	 * @exceptionType The `:exception-type` / `:error-code` header value (may be empty)
	 * @payload       The raw exception frame payload (JSON with a `message`, usually)
	 * @aiRequest     The AiChatRequest, when one is in scope (announced with the error)
	 *
	 * @throws BedrockStreamError always
	 */
	private void function throwBedrockStreamError( required string exceptionType, required string payload, any aiRequest = "" ){
		var detail = trim( arguments.payload );
		try {
			var parsed = jsonDeserialize( arguments.payload );
			if ( isStruct( parsed ) ) {
				detail = parsed.message ?: ( parsed.Message ?: ( parsed.errorMessage ?: detail ) );
			}
		} catch ( any e ) {
			// Not JSON — keep the raw payload as the detail
		}

		var kind         = len( arguments.exceptionType ) ? arguments.exceptionType : "unknownException";
		var errorMessage = "Bedrock stream error [#kind#]" & ( len( detail ) ? ": #detail#" : "" );
		var canRetry     = reFindNoCase( "throttl|serviceUnavailable|modelStreamError|internalServer|modelTimeout", kind ) > 0;

		writeLog( text: errorMessage, type: "error", log: "ai" );

		boxAnnounce(
			"onAIError",
			{
				error        : { "message" : detail, "exceptionType" : kind },
				errorMessage : errorMessage,
				provider     : this,
				operation    : "stream",
				aiRequest    : arguments.aiRequest,
				canRetry     : canRetry
			}
		);

		// extendedInfo marks the announce as DONE, so the catch in sendBedrockStreamRequest can tell
		// this frame apart from the other BedrockStreamError throws (malformedFrame, truncated tool
		// arguments, the drain) which announce nothing. Keying that catch on the TYPE alone
		// suppressed the announce for all of them.
		throw(
			type        : "BedrockStreamError",
			message     : errorMessage,
			detail      : kind,
			extendedInfo: static.BEDROCK_ERROR_ANNOUNCED
		);
	}

	/**
	 * Read a 4-byte big-endian integer from a byte array
	 */
	private numeric function readBigEndianInt( required array bytes, required numeric position ){
		// Convert signed bytes to unsigned and combine
		var b1 = arguments.bytes[ arguments.position ] < 0 ? arguments.bytes[ arguments.position ] + 256 : arguments.bytes[ arguments.position ];
		var b2 = arguments.bytes[ arguments.position + 1 ] < 0 ? arguments.bytes[ arguments.position + 1 ] + 256 : arguments.bytes[ arguments.position + 1 ];
		var b3 = arguments.bytes[ arguments.position + 2 ] < 0 ? arguments.bytes[ arguments.position + 2 ] + 256 : arguments.bytes[ arguments.position + 2 ];
		var b4 = arguments.bytes[ arguments.position + 3 ] < 0 ? arguments.bytes[ arguments.position + 3 ] + 256 : arguments.bytes[ arguments.position + 3 ];

		return ( b1 * 16777216 ) + ( b2 * 65536 ) + ( b3 * 256 ) + b4;
	}

	/**
	 * Process a single Bedrock event payload
	 */
	private function processBedrockEvent(
		required string payloadStr,
		required string modelFamily,
		required string modelId,
		required function callback,
		struct streamState = {},
		string eventType   = ""
	){
		// The payload should be JSON. It may contain a "bytes" field with base64 data
		// or be direct JSON from the model.
		var chunkToSend = javacast( "null", "" );
		try {
			var payloadJson = jsonDeserialize( arguments.payloadStr );

			// Check if this is a wrapper with base64 "bytes" field
			if ( payloadJson.keyExists( "bytes" ) ) {
				var decodedPayload = len( payloadJson.bytes ?: "" )
					? toString( binaryDecode( payloadJson.bytes, "base64" ), "UTF-8" )
					: "";
				// An EMPTY payload is a real frame, not a broken one: a ConverseStream
				// contentBlockStop / messageStop carries nothing of its own (the event name lives
				// in the frame header, passed in as `eventType`). jsonDeserialize( "" ) threw, so
				// the terminator was swallowed at debug and the drain then reported the tool
				// arguments as truncated.
				payloadJson = len( trim( decodedPayload ) ) ? jsonDeserialize( decodedPayload ) : {};
			}

			// Capture usage data from various Bedrock model formats before transformation
			var chunkUsage = {};
			// ConverseStream: the `metadata` event carries the whole TokenUsage block, including
			// the cache counters. inputTokens EXCLUDES cached tokens, so prompt_tokens is the sum
			// — same accounting transformResponseFromConverse() does for the sync path.
			if ( arguments.eventType == "metadata" && isStruct( payloadJson.usage ?: "" ) ) {
				var converseUsage = payloadJson.usage;
				chunkUsage        = normalizeConverseUsage( converseUsage );
				// AWS's raw (cache-exclusive) total, kept verbatim beside the normalized one.
				chunkUsage[ "bedrock" ] = {
					"totalTokens" : converseUsage.totalTokens ?: ( ( converseUsage.inputTokens ?: 0 ) + ( converseUsage.outputTokens ?: 0 ) )
				};
			}
			// Claude-on-Bedrock: message_start has input_tokens, message_delta has output_tokens
			if( payloadJson.keyExists( "type" ) && payloadJson.type == "message_start" && !isNull( payloadJson.message?.usage ) ){
				chunkUsage = {
					"prompt_tokens"     : payloadJson.message.usage.input_tokens ?: 0,
					"completion_tokens" : 0,
					"total_tokens"      : payloadJson.message.usage.input_tokens ?: 0
				};
			}
			if( payloadJson.keyExists( "type" ) && payloadJson.type == "message_delta" && !isNull( payloadJson.usage ) ){
				// NO prompt_tokens key: the delta carries output only, and the accumulator in
				// sendBedrockStreamRequest() keys on keyExists — a literal 0 here overwrote the
				// input_tokens message_start had already captured, so onAITokenCount reported
				// promptTokens 0 for every Claude InvokeModel stream that had no trailing
				// amazon-bedrock-invocationMetrics event to repair it.
				chunkUsage = {
					"completion_tokens" : payloadJson.usage.output_tokens ?: 0,
					"total_tokens"      : payloadJson.usage.output_tokens ?: 0
				};
			}
			// OpenAI-shaped families: the final chunk carries the whole usage block
			if( payloadJson.keyExists( "choices" ) && isStruct( payloadJson.usage ?: "" ) && payloadJson.usage.keyExists( "prompt_tokens" ) ){
				chunkUsage = {
					"prompt_tokens"     : payloadJson.usage.prompt_tokens ?: 0,
					"completion_tokens" : payloadJson.usage.completion_tokens ?: 0,
					"total_tokens"      : payloadJson.usage.total_tokens ?: ( ( payloadJson.usage.prompt_tokens ?: 0 ) + ( payloadJson.usage.completion_tokens ?: 0 ) )
				};
			}
			// Cohere: the stream-end event carries meta.billed_units
			if( isStruct( payloadJson.meta ?: "" ) && isStruct( payloadJson.meta.billed_units ?: "" ) ){
				var billed = payloadJson.meta.billed_units;
				chunkUsage = {
					"prompt_tokens"     : billed.input_tokens ?: 0,
					"completion_tokens" : billed.output_tokens ?: 0,
					"total_tokens"      : ( billed.input_tokens ?: 0 ) + ( billed.output_tokens ?: 0 )
				};
			}
			// Amazon invocation metrics (present in final event for all model families)
			if( payloadJson.keyExists( "amazon-bedrock-invocationMetrics" ) ){
				var metrics = payloadJson[ "amazon-bedrock-invocationMetrics" ];
				chunkUsage = {
					"prompt_tokens"     : metrics.inputTokenCount ?: 0,
					"completion_tokens" : metrics.outputTokenCount ?: 0,
					"total_tokens"      : ( metrics.inputTokenCount ?: 0 ) + ( metrics.outputTokenCount ?: 0 )
				};
			}
			// Guardrails: some streamed events carry an in-band intervention marker alongside the
			// chunk payload (in addition to/instead of the response-header form checked once for
			// the whole stream in sendBedrockStreamRequest).
			if(
				payloadJson.keyExists( "amazon-bedrock-guardrailAction" )
				&& payloadJson[ "amazon-bedrock-guardrailAction" ].findNoCase( "INTERVENED" )
			){
				writeLog(
					text: "Bedrock guardrail intervened during streaming (action=#payloadJson[ 'amazon-bedrock-guardrailAction' ]#)",
					type: "warning",
					log : "ai"
				);
			}

			var streamChunk = transformStreamChunk( payloadJson, arguments.modelFamily, arguments.modelId, arguments.streamState, arguments.eventType );
			if ( !isNull( streamChunk ) ) {
				if ( !structIsEmpty( chunkUsage ) ) {
					streamChunk.usage = chunkUsage;
				}
				chunkToSend = streamChunk;
			} else if ( !structIsEmpty( chunkUsage ) ) {
				// A usage-only chunk so the callback can capture it
				chunkToSend = { "usage": chunkUsage, "choices": [], "model": arguments.modelId };
			}
		} catch ( any e ) {
			// A BedrockStreamError raised while transforming the frame is a DELIBERATE stream
			// failure (an exception frame, a malformed frame, truncated tool arguments) and must
			// reach the caller. Swallowed at debug here it was replaced downstream by the drain's
			// far vaguer "no content_block_stop" message, which named neither the cause nor the
			// truncated JSON.
			if ( e.type == "BedrockStreamError" ) {
				rethrow;
			}
			// Not valid JSON or processing error - may be a control message
			writeLog(
				text: "processBedrockEvent - Could not process: #left( arguments.payloadStr, 100 )# - Error: #e.message#",
				type: "debug",
				log : "ai"
			);
			return;
		}

		// The callback runs OUTSIDE the try: it is the caller's code, so an exception it throws is
		// the caller's bug and must propagate. Inside the try it was logged at debug as if the
		// frame were unparseable — live, a callback doing `chunk.choices.first()` on the usage-only
		// `metadata` / `message_start` chunks (choices: []) failed on every stream and nobody saw.
		if ( !isNull( chunkToSend ) ) {
			emitStreamChunk( arguments.callback, chunkToSend );
		}
	}

	/**
	 * Open a streamed Claude tool_use content block.
	 *
	 * The forced structured-output tool is tracked separately and deliberately kept OUT of
	 * streamState.toolCalls: it is a schema carrier, not a tool the agent may execute.
	 *
	 * @streamState The mutable stream accumulation state
	 * @chunk       The content_block_start event
	 */
	private void function startStreamToolCall( required struct streamState, required struct chunk ){
		var blockKey = toString( arguments.chunk.index ?: 0 );

		arguments.streamState.toolInputBuffers[ blockKey ] = "";

		if ( ( arguments.chunk.content_block.name ?: "" ) == static.STRUCTURED_OUTPUT_TOOL ) {
			arguments.streamState[ "structuredOutputIndex" ] = blockKey;
			return;
		}

		arguments.streamState.toolCalls.append( {
			"type" : "tool_use",
			"id"   : arguments.chunk.content_block.id ?: "",
			"name" : arguments.chunk.content_block.name ?: "",
			"input": {}
		} );
		arguments.streamState.toolCallIndexMap[ blockKey ] = arguments.streamState.toolCalls.len();
	}

	/**
	 * Append an input_json_delta fragment to the buffer of the tool block it belongs to.
	 *
	 * @streamState The mutable stream accumulation state
	 * @chunk       The content_block_delta event carrying `delta.partial_json`
	 */
	private void function appendStreamToolInput( required struct streamState, required struct chunk ){
		var blockKey = toString( arguments.chunk.index ?: 0 );
		if ( !arguments.streamState.toolInputBuffers.keyExists( blockKey ) ) {
			arguments.streamState.toolInputBuffers[ blockKey ] = "";
		}
		arguments.streamState.toolInputBuffers[ blockKey ] &= ( arguments.chunk.delta.partial_json ?: "" );
	}

	/**
	 * Parse one streamed tool call's buffered argument JSON, or fail loudly.
	 *
	 * A buffer that will not deserialize means the argument stream was cut off mid-JSON (the model
	 * hit max_tokens, or the event stream ended early). Executing the tool with `{}` in that case
	 * is worse than not executing it at all — the tool runs with entirely different arguments than
	 * the model asked for, silently.
	 *
	 * @toolName   Name of the tool whose arguments these are, for the message
	 * @buffer     The accumulated argument JSON fragments
	 * @stopReason The stream's stop/finish reason, when known
	 *
	 * @throws BedrockStreamError when the buffer is not parseable JSON
	 */
	private any function parseStreamToolArguments( required string toolName, required string buffer, string stopReason = "" ){
		try {
			return jsonDeserialize( arguments.buffer );
		} catch ( any e ) {
			writeLog(
				text: "Streamed tool arguments for [#arguments.toolName#] are not valid JSON (stop_reason=#arguments.stopReason#): #e.message# - Buffer: #left( arguments.buffer, 200 )#",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "BedrockStreamError",
				message: "Tool call arguments truncated for [#arguments.toolName#] (stop_reason=#len( arguments.stopReason ) ? arguments.stopReason : "unknown"#)."
					& ( arguments.stopReason == "max_tokens" ? " The response hit max_tokens mid-arguments — increase max_tokens." : "" )
					& " The tool was NOT executed.",
				detail : "truncatedToolArguments"
			);
		}
	}

	/**
	 * Record that a streamed tool call's argument buffer has been closed and parsed, so the
	 * end-of-stream drain does not re-finalize it (and can spot the ones that were never closed).
	 */
	private void function markStreamToolCallFinalized( required struct streamState, required string blockKey ){
		arguments.streamState.finalizedToolCalls[ arguments.blockKey ] = true;
	}

	/**
	 * Close out any tool-call argument buffers still pending when the stream ended, and decide
	 * whether the accumulated calls may be executed.
	 *
	 * Both families only finalized their buffers on a happy-path terminator — Claude on
	 * `content_block_stop`, OpenAI-shaped models on `finish_reason == "tool_calls"`. A stream that
	 * ends any other way (finish_reason "stop"/"length"/absent for gpt-oss, a max_tokens
	 * truncation mid `input_json_delta` for Claude) left the calls sitting in `toolCalls` with
	 * `input: {}`, and the tool loop — gated only on `toolCalls.len()` — ran every one of them with
	 * empty arguments. Drain here instead:
	 *
	 *   - OpenAI-shaped: there is no per-call close event, so finalize whatever was buffered and
	 *     emit the same normalized tool_calls chunk the finish_reason path emits.
	 *   - Claude: every tool_use block is closed by content_block_stop, so a block still open at
	 *     end-of-stream IS a truncation — never execute it.
	 *
	 * Returns having either finalized every open buffer or thrown, so the tool loop can gate on
	 * `streamState.toolCalls.len()` alone.
	 *
	 * @streamState  The mutable stream accumulation state
	 * @modelFamily  The detected model family
	 * @modelId      The model ID, for the emitted chunk envelope
	 * @callback     The caller's stream callback (receives the drained tool_calls chunk)
	 *
	 * @throws BedrockStreamError when a pending buffer is incomplete/unparseable
	 */
	private void function drainPendingStreamToolCalls(
		required struct streamState,
		required string modelFamily,
		required string modelId,
		required function callback
	){
		var toolCalls = arguments.streamState.toolCalls ?: [];
		if ( !toolCalls.len() ) {
			return;
		}

		var mapping    = arguments.streamState.toolCallIndexMap ?: {};
		var finalized  = arguments.streamState.finalizedToolCalls ?: {};
		var stopReason = arguments.streamState.stopReason ?: "";
		var soIndex    = arguments.streamState.structuredOutputIndex ?: "";
		var pending    = mapping
			.keyArray()
			.filter( ( key ) => !finalized.keyExists( key ) && soIndex != key );

		// Claude and Converse both close every content block with an explicit stop event
		// (content_block_stop / contentBlockStop), so a block still open at end-of-stream IS a
		// truncation — never execute it.
		if ( listFindNoCase( "claude,converse", arguments.modelFamily ) && pending.len() ) {
			var openCall = toolCalls[ mapping[ pending.first() ] ];
			writeLog(
				text: "Bedrock stream ended with an unterminated tool_use block for [#openCall.name ?: ""#] (stop_reason=#stopReason#) — no content_block_stop arrived",
				type: "error",
				log : "ai"
			);
			throw(
				type   : "BedrockStreamError",
				message: "Tool call arguments truncated for [#openCall.name ?: ""#] (stop_reason=#len( stopReason ) ? stopReason : "unknown"#):"
					& " the stream ended mid input_json_delta with no content_block_stop."
					& ( stopReason == "max_tokens" ? " The response hit max_tokens — increase max_tokens." : "" )
					& " The tool was NOT executed.",
				detail : "truncatedToolArguments"
			);
		}

		if ( pending.len() ) {
			// OpenAI-shaped stream that never said "tool_calls": finalize (throws on a truncated
			// buffer) and give the caller the tool_calls chunk it would otherwise never see.
			var drainedChunk = finalizeOpenAIStreamToolCalls( arguments.streamState, arguments.modelId );
			if ( !isNull( drainedChunk ) ) {
				emitStreamChunk( arguments.callback, drainedChunk );
			}
		}

	}

	/**
	 * Close a streamed content block: parse the accumulated JSON arguments into the tool call and
	 * return the normalized tool_calls chunk for it.
	 *
	 * @streamState The mutable stream accumulation state
	 * @chunk       The content_block_stop event
	 * @modelId     The model ID, for the emitted chunk envelope
	 *
	 * @return A normalized tool_calls stream chunk, or null when this block was not a tool block
	 *         (plain text) or was the forced structured-output carrier
	 */
	private function finalizeStreamToolCall( required struct streamState, required struct chunk, required string modelId ){
		var blockKey = toString( arguments.chunk.index ?: 0 );
		var buffer   = arguments.streamState.toolInputBuffers[ blockKey ] ?: "";

		// The forced structured-output block: keep the raw JSON, never emit it as a tool call.
		if ( ( arguments.streamState.structuredOutputIndex ?: "" ) == blockKey ) {
			arguments.streamState[ "structuredOutputJSON" ] = len( trim( buffer ) ) ? buffer : "{}";
			return javacast( "null", "" );
		}

		var mapping = arguments.streamState.toolCallIndexMap ?: {};
		if ( !mapping.keyExists( blockKey ) ) {
			// A text/thinking block closing — nothing to finalize.
			return javacast( "null", "" );
		}

		var toolCall = arguments.streamState.toolCalls[ mapping[ blockKey ] ];
		if ( len( trim( buffer ) ) ) {
			// Unparseable buffered arguments used to be logged and then handed to the tool as `{}`
			// — a truncated call silently ran with no arguments. Fail instead.
			toolCall.input = parseStreamToolArguments( toolCall.name ?: "", buffer, arguments.streamState.stopReason ?: "" );
		}
		markStreamToolCallFinalized( arguments.streamState, blockKey );

		return {
			"model"   : arguments.modelId,
			"object"  : "chat.completion.chunk",
			"choices" : [ {
				"index" : 0,
				"delta" : {
					"role"       : "assistant",
					"tool_calls" : [ {
						"index"    : mapping[ blockKey ] - 1,
						"id"       : toolCall.id,
						"type"     : "function",
						"function" : { "name": toolCall.name, "arguments": len( trim( buffer ) ) ? buffer : "{}" }
					} ]
				},
				"finish_reason" : javacast( "null", "" )
			} ]
		};
	}

	/**
	 * Accumulate an OpenAI-shaped `delta.tool_calls` fragment.
	 *
	 * The OpenAI streaming wire format spreads one tool call over many chunks: the first carries
	 * `index` + `id` + `function.name` (and possibly the first slice of arguments), every later
	 * one carries only `index` + a further slice of `function.arguments`. Fragments are keyed by
	 * `index` and land in the SAME normalized `streamState.toolCalls` shape the Claude
	 * accumulator produces, so the streaming tool loop is family-agnostic.
	 *
	 * @streamState    The mutable stream accumulation state
	 * @deltaToolCalls The `delta.tool_calls` array from one chunk
	 */
	private void function accumulateOpenAIStreamToolCalls( required struct streamState, required array deltaToolCalls ){
		for ( var fragment in arguments.deltaToolCalls ) {
			// `index` is what separates one streamed call from the next. Some OpenAI-shaped models
			// on Bedrock omit it: every fragment then keyed to "0", so N parallel tool calls
			// collapsed into one whose arguments were the concatenation of all of them. Absent an
			// index, a fragment carrying an `id` starts a NEW call and one without continues the
			// most recent (same rule as BaseService.mergeToolCallDeltas).
			var blockKey = "";
			if ( !isNull( fragment.index ) ) {
				blockKey = toString( fragment.index );
			} else if ( len( fragment.id ?: "" ) || !arguments.streamState.toolCalls.len() ) {
				blockKey = toString( arguments.streamState.toolCalls.len() );
			} else {
				blockKey = toString( arguments.streamState.toolCalls.len() - 1 );
			}

			if ( !arguments.streamState.toolCallIndexMap.keyExists( blockKey ) ) {
				arguments.streamState.toolInputBuffers[ blockKey ] = "";
				arguments.streamState.toolCalls.append( {
					"type"  : "tool_use",
					"id"    : fragment.id ?: "",
					"name"  : "",
					"input" : {}
				} );
				arguments.streamState.toolCallIndexMap[ blockKey ] = arguments.streamState.toolCalls.len();
			}

			var toolCall = arguments.streamState.toolCalls[ arguments.streamState.toolCallIndexMap[ blockKey ] ];

			// id and name may arrive on any fragment (and only once) — never overwrite with "".
			if ( len( fragment.id ?: "" ) ) {
				toolCall.id = fragment.id;
			}
			if ( len( fragment.function?.name ?: "" ) ) {
				toolCall.name = fragment.function.name;
			}
			arguments.streamState.toolInputBuffers[ blockKey ] &= ( fragment.function?.arguments ?: "" );
		}
	}

	/**
	 * Close every accumulated OpenAI-shaped tool call: parse its buffered argument JSON into the
	 * normalized call and emit them as one tool_calls chunk with finish_reason "tool_calls".
	 *
	 * @streamState The mutable stream accumulation state
	 * @modelId     The model ID, for the emitted chunk envelope
	 *
	 * @return A normalized tool_calls stream chunk, or null when nothing was accumulated
	 */
	private function finalizeOpenAIStreamToolCalls( required struct streamState, required string modelId ){
		var toolCalls = arguments.streamState.toolCalls ?: [];
		if ( !toolCalls.len() ) {
			return javacast( "null", "" );
		}

		var mapping  = arguments.streamState.toolCallIndexMap ?: {};
		var emitted  = [];

		for ( var blockKey in mapping ) {
			var position = mapping[ blockKey ];
			var buffer   = arguments.streamState.toolInputBuffers[ blockKey ] ?: "";
			var toolCall = toolCalls[ position ];

			if ( len( trim( buffer ) ) ) {
				toolCall.input = parseStreamToolArguments( toolCall.name ?: "", buffer, arguments.streamState.stopReason ?: "" );
			}
			markStreamToolCallFinalized( arguments.streamState, blockKey );

			emitted.append( {
				"index"    : position - 1,
				"id"       : toolCall.id,
				"type"     : "function",
				"function" : { "name": toolCall.name, "arguments": len( trim( buffer ) ) ? buffer : "{}" }
			} );
		}

		emitted.sort( ( a, b ) => a.index - b.index );

		return {
			"model"   : arguments.modelId,
			"object"  : "chat.completion.chunk",
			"choices" : [ {
				"index"         : 0,
				"delta"         : { "role": "assistant", "tool_calls": emitted },
				"finish_reason" : "tool_calls"
			} ]
		};
	}

	/**
	 * Accumulate Cohere Command R's `tool-calls-generation` stream event, which delivers every
	 * tool call complete in one event (unlike Claude/OpenAI, which stream argument fragments).
	 * Ids are synthesized positionally, matching extractResponseToolCalls()'s sync behaviour.
	 *
	 * @streamState The mutable stream accumulation state
	 * @cohereCalls The event's `tool_calls` array: [ { name, parameters } ]
	 * @modelId     The model ID, for the emitted chunk envelope
	 *
	 * @return A normalized tool_calls stream chunk
	 */
	private function accumulateCohereStreamToolCalls( required struct streamState, required array cohereCalls, required string modelId ){
		if ( !arguments.streamState.keyExists( "toolCalls" ) ) {
			arguments.streamState[ "toolCalls" ] = [];
		}

		// Unique per stream, not just per position: a multi-turn tool loop restarts a fresh
		// streamState each turn, so bare positional ids collided across turns (see
		// extractResponseToolCalls()).
		if ( !len( arguments.streamState.cohereCallBatchId ?: "" ) ) {
			arguments.streamState[ "cohereCallBatchId" ] = createUUID().replace( "-", "", "all" ).left( 12 );
		}
		var streamBatchId = arguments.streamState.cohereCallBatchId;

		var emitted = [];
		for ( var call in arguments.cohereCalls ) {
			arguments.streamState.toolCalls.append( {
				"type"  : "tool_use",
				"id"    : "cohere_tool_#arguments.streamState.toolCalls.len() + 1#_#streamBatchId#",
				"name"  : call.name ?: "",
				"input" : call.parameters ?: {}
			} );
			emitted.append( {
				"index"    : arguments.streamState.toolCalls.len() - 1,
				"id"       : arguments.streamState.toolCalls.last().id,
				"type"     : "function",
				"function" : { "name": call.name ?: "", "arguments": jsonSerialize( call.parameters ?: {} ) }
			} );
		}

		if ( !emitted.len() ) {
			return javacast( "null", "" );
		}

		return {
			"model"   : arguments.modelId,
			"object"  : "chat.completion.chunk",
			"choices" : [ {
				"index"         : 0,
				"delta"         : { "role": "assistant", "tool_calls": emitted },
				"finish_reason" : "tool_calls"
			} ]
		};
	}

	/**
	 * Transform a streaming chunk from Bedrock model-specific format to OpenAI-compatible format
	 *
	 * @chunk       The raw chunk from Bedrock
	 * @modelFamily The model family
	 * @modelId     The model ID
	 * @streamState Mutable accumulation state for the current stream (tool_use blocks are
	 *              assembled across content_block_start / input_json_delta / content_block_stop
	 *              events, and the stop reason recorded, so chatStream() can run the tool loop)
	 *
	 * @return OpenAI-compatible streaming chunk or null if no content
	 */
	private function transformStreamChunk(
		required struct chunk,
		required string modelFamily,
		required string modelId,
		struct streamState = {},
		string eventType   = ""
	){
		var content = "";
		var reasoning = "";
		var finishReason = "";

		switch ( arguments.modelFamily ) {
			case "converse":
				// ConverseStream's events are bare payload structs — the event NAME is the
				// `:event-type` frame header, decoded in parseBedrockEventStream() and handed down
				// here. Everything lands in the SAME streamState accumulator the Claude and
				// OpenAI-shaped branches feed, so drainPendingStreamToolCalls(), the streaming
				// tool loop and resumeToolBatchStream() are untouched by this branch existing.
				// @see https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ConverseStreamOutput.html
				switch ( arguments.eventType ) {
					case "contentBlockStart":
						if ( isStruct( arguments.chunk.start?.toolUse ?: "" ) ) {
							// Adapt onto the shape startStreamToolCall() reads (index +
							// content_block.{id,name}) rather than duplicating the accumulator.
							startStreamToolCall( arguments.streamState, {
								"index"         : arguments.chunk.contentBlockIndex ?: 0,
								"content_block" : {
									"type" : "tool_use",
									"id"   : arguments.chunk.start.toolUse.toolUseId ?: "",
									"name" : arguments.chunk.start.toolUse.name ?: ""
								}
							} );
						}
						return javacast( "null", "" );

					case "contentBlockDelta":
						var converseDelta = arguments.chunk.delta ?: {};
						// Streamed tool arguments arrive as partial-JSON fragments; accumulate and
						// emit nothing until the block closes.
						if ( isStruct( converseDelta.toolUse ?: "" ) ) {
							appendStreamToolInput( arguments.streamState, {
								"index" : arguments.chunk.contentBlockIndex ?: 0,
								"delta" : { "partial_json": converseDelta.toolUse.input ?: "" }
							} );
							return javacast( "null", "" );
						}
						if ( isSimpleValue( converseDelta.text ?: "" ) && len( converseDelta.text ?: "" ) ) {
							content = converseDelta.text;
						}
						// Reasoning is mapped onto the standard `delta.reasoning` key, never merged
						// into content. The `signature` arrives as its OWN delta and carries no
						// displayable text — it is kept on the accumulator instead, because the
						// recorded assistant turn has to hand it back unmodified on the next turn
						// (see buildStreamAssistantMessage()).
						if ( isStruct( converseDelta.reasoningContent ?: "" ) ) {
							reasoning = converseDelta.reasoningContent.text ?: "";
							if ( len( converseDelta.reasoningContent.signature ?: "" ) ) {
								arguments.streamState[ "reasoningSignature" ] = ( arguments.streamState.reasoningSignature ?: "" ) & converseDelta.reasoningContent.signature;
							}
						}
						break;

					case "contentBlockStop":
						return finalizeStreamToolCall(
							arguments.streamState,
							{ "index": arguments.chunk.contentBlockIndex ?: 0 },
							arguments.modelId
						);

					case "messageStop":
						var converseStop = arguments.chunk.stopReason ?: "end_turn";
						arguments.streamState[ "stopReason" ] = converseStop;
						finishReason = static.CONVERSE_STOP_REASONS[ converseStop ] ?: "stop";
						if ( converseStop == "guardrail_intervened" ) {
							writeLog(
								text: "Bedrock guardrail intervened during streaming (stopReason=guardrail_intervened, model=#arguments.modelId#)",
								type: "warning",
								log : "ai"
							);
						}
						break;

					case "messageStart":
					case "metadata":
					default:
						// messageStart carries only the role; metadata's usage/metrics are captured
						// in processBedrockEvent() and emitted as a usage-only chunk there.
						return javacast( "null", "" );
				}
				break;

			case "cohere":
				// Cohere's Bedrock stream is its own event vocabulary, keyed on `event_type`:
				//   stream-start | text-generation | tool-calls-chunk | tool-calls-generation |
				//   citation-generation | search-queries-generation | stream-end
				// Legacy Command's generate stream has no event_type at all — just
				// { text, is_finished, finish_reason } — so both are handled here.
				if ( arguments.chunk.keyExists( "event_type" ) ) {
					switch ( arguments.chunk.event_type ) {
						case "text-generation":
							content = arguments.chunk.text ?: "";
							break;
						case "tool-calls-generation":
							// Command R delivers each tool call whole in this single event.
							if ( isArray( arguments.chunk.tool_calls ?: "" ) ) {
								return accumulateCohereStreamToolCalls( arguments.streamState, arguments.chunk.tool_calls, arguments.modelId );
							}
							return javacast( "null", "" );
						case "stream-end":
							// The NORMALIZED value, not Cohere's raw "COMPLETE"/"MAX_TOKENS":
							// streamState.stopReason is read back as the finish_reason afterLLMCall
							// middleware sees (sendBedrockStreamRequest maps it through
							// CONVERSE_STOP_REASONS, which knows nothing of Cohere's vocabulary),
							// so the raw value leaked out as the finish reason on this family only.
							finishReason = mapCohereFinishReason( arguments.chunk.finish_reason ?: "" );
							arguments.streamState[ "stopReason" ] = finishReason;
							break;
						default:
							// stream-start, tool-calls-chunk (partial argument fragments, which
							// tool-calls-generation then supersedes wholesale), citation- and
							// search-queries-generation carry nothing the normalized envelope
							// represents.
							return javacast( "null", "" );
					}
					break;
				}

				// Legacy Command generate stream
				if ( arguments.chunk.keyExists( "text" ) && isSimpleValue( arguments.chunk.text ) ) {
					content = arguments.chunk.text;
				}
				if ( len( arguments.chunk.finish_reason ?: "" ) ) {
					finishReason = mapCohereFinishReason( arguments.chunk.finish_reason );
					arguments.streamState[ "stopReason" ] = finishReason;
				}
				break;

			case "claude":
				if ( arguments.chunk.keyExists( "type" ) ) {
					switch ( arguments.chunk.type ) {
						case "content_block_start":
							// A tool_use block opens here; its `input` then arrives in
							// input_json_delta fragments and is finalized on content_block_stop.
							// Previously this event fell into the default branch and was dropped,
							// so a streamed tool call was invisible to the caller entirely.
							if ( ( arguments.chunk.content_block?.type ?: "" ) == "tool_use" ) {
								startStreamToolCall( arguments.streamState, arguments.chunk );
							}
							return javacast( "null", "" );
						case "content_block_delta":
							// Streamed tool arguments: accumulate, emit nothing until the block closes
							// (a partial JSON fragment is not a usable tool call).
							if ( ( arguments.chunk.delta?.type ?: "" ) == "input_json_delta" ) {
								appendStreamToolInput( arguments.streamState, arguments.chunk );
								return javacast( "null", "" );
							}
							// The opaque signature for the thinking block, delivered as its own
							// delta after the thinking text. Without it the recorded assistant turn
							// cannot carry a thinking block at all (Anthropic rejects unsigned
							// ones on the tool-use round trip) — see buildStreamAssistantMessage().
							if ( ( arguments.chunk.delta?.type ?: "" ) == "signature_delta" ) {
								arguments.streamState[ "reasoningSignature" ] = ( arguments.streamState.reasoningSignature ?: "" )
									& ( arguments.chunk.delta.signature ?: "" );
								return javacast( "null", "" );
							}
							if ( arguments.chunk.keyExists( "delta" ) && arguments.chunk.delta.keyExists( "text" ) ) {
								content = arguments.chunk.delta.text;
							}
							// Claude-on-Bedrock extended thinking arrives as its own delta type,
							// mapped onto the standard `delta.reasoning` key like every other
							// provider — never merged into `content`, which is the answer.
							if ( arguments.chunk.keyExists( "delta" ) && arguments.chunk.delta.keyExists( "thinking" ) ) {
								reasoning = arguments.chunk.delta.thinking ?: "";
							}
							break;
						case "content_block_stop":
							// Finalize the tool call this block was building (if any) and surface it
							// as a normalized tool_calls chunk, so middleware and callers see the
							// same shape every other streaming provider emits.
							return finalizeStreamToolCall( arguments.streamState, arguments.chunk, arguments.modelId );
						case "message_stop":
							finishReason = "stop";
							break;
						case "message_delta":
							if ( arguments.chunk.keyExists( "delta" ) && arguments.chunk.delta.keyExists( "stop_reason" ) ) {
								finishReason = arguments.chunk.delta.stop_reason ?: "stop";
								arguments.streamState[ "stopReason" ] = finishReason;
							}
							break;
						default:
							// Skip other event types like message_start
							return javacast( "null", "" );
					}
				}
				break;

			case "titan":
				// Titan streaming format
				if ( arguments.chunk.keyExists( "outputText" ) ) {
					content = arguments.chunk.outputText;
				}
				if ( arguments.chunk.keyExists( "completionReason" ) && len( arguments.chunk.completionReason ) ) {
					finishReason = arguments.chunk.completionReason == "FINISH" ? "stop" : arguments.chunk.completionReason.lcase();
					// Written for the same reason the Converse and OpenAI branches write it: this is
					// the only record of why the stream ended by the time sendBedrockStreamRequest()
					// builds streamState.finishReason for afterLLMCall, and these three families
					// left it empty.
					arguments.streamState[ "stopReason" ] = finishReason;
				}
				break;

			case "llama":
				// Llama streaming format
				if ( arguments.chunk.keyExists( "generation" ) ) {
					content = arguments.chunk.generation;
				}
				if ( arguments.chunk.keyExists( "stop_reason" ) && len( arguments.chunk.stop_reason ?: "" ) ) {
					finishReason = arguments.chunk.stop_reason;
					arguments.streamState[ "stopReason" ] = finishReason;
				}
				break;

			case "mistral":
				// Mistral streaming format
				if ( arguments.chunk.keyExists( "outputs" ) && isArray( arguments.chunk.outputs ) && arguments.chunk.outputs.len() > 0 ) {
					content = arguments.chunk.outputs[ 1 ].text ?: "";
					if ( arguments.chunk.outputs[ 1 ].keyExists( "stop_reason" ) ) {
						finishReason = arguments.chunk.outputs[ 1 ].stop_reason ?: "";
						if ( len( finishReason ) ) {
							arguments.streamState[ "stopReason" ] = finishReason;
						}
					}
				}
				break;

			case "openai":
			default:
				// OpenAI-compatible streaming format - already in standard format. Also the
				// fallback for any family not explicitly handled above (ai21 and everything
				// else), matching detectModelFamily()'s and transformRequestForModel()'s
				// openai default — family not in this switch ⇒ openai.
				if ( arguments.chunk.keyExists( "choices" ) && isArray( arguments.chunk.choices ) && arguments.chunk.choices.len() > 0 ) {
					var delta = arguments.chunk.choices[ 1 ].delta ?: {};

					// Streamed tool arguments: accumulate, emit nothing until the model says the
					// turn is a tool call (finish_reason "tool_calls") — a partial JSON fragment
					// is not a usable tool call.
					if ( isArray( delta.tool_calls ?: "" ) && delta.tool_calls.len() ) {
						accumulateOpenAIStreamToolCalls( arguments.streamState, delta.tool_calls );
					}

					if ( delta.keyExists( "content" ) && isSimpleValue( delta.content ) ) {
						content = delta.content;
					}
					// OpenAI-shaped models on Bedrock carrying reasoning, in either spelling
					for ( var reasoningKey in [ "reasoning", "reasoning_content" ] ) {
						if ( delta.keyExists( reasoningKey ) && isSimpleValue( delta[ reasoningKey ] ) ) {
							reasoning = delta[ reasoningKey ];
							break;
						}
					}
					if ( arguments.chunk.choices[ 1 ].keyExists( "finish_reason" ) && !isNull( arguments.chunk.choices[ 1 ].finish_reason ) ) {
						finishReason = arguments.chunk.choices[ 1 ].finish_reason;
						if ( len( finishReason ) ) {
							arguments.streamState[ "stopReason" ] = finishReason;
						}
						// The turn was a tool call: close every accumulated call and surface them
						// in the same normalized shape the Claude path emits, so the streaming
						// tool loop below runs identically for both families.
						if ( finishReason == "tool_calls" ) {
							var openAIToolChunk = finalizeOpenAIStreamToolCalls( arguments.streamState, arguments.modelId );
							if ( !isNull( openAIToolChunk ) ) {
								return openAIToolChunk;
							}
						}
					}
				}
		}

		// Only return if we have content, reasoning, or a finish reason. Reasoning must be
		// part of this guard: a thinking-only chunk (which is what every chunk is while the
		// model is still reasoning) carries no content, and would otherwise be dropped here.
		if ( !len( content ) && !len( reasoning ) && !len( finishReason ) ) {
			return javacast( "null", "" );
		}

		// Return OpenAI-compatible streaming format
		var streamDelta = {};
		if ( len( content ) ) {
			streamDelta[ "content" ] = content;
		}
		if ( len( reasoning ) ) {
			streamDelta[ "reasoning" ] = reasoning;
		}

		return {
			"choices" : [
				{
					"delta" : streamDelta,
					"index" : 0,
					"finish_reason" : len( finishReason ) ? finishReason : javacast( "null", "" )
				}
			],
			"model" : arguments.modelId
		};
	}

	/**
	 * Detect the embedding model "shape" from the model ID, so embeddings() can build the
	 * request/parse the response the way that specific model actually expects instead of
	 * assuming Titan v1 for everything.
	 *
	 * @modelId The Bedrock embedding model ID
	 *
	 * @return "cohere" (cohere.embed-*), "titan-v2" (amazon.titan-embed-text-v2*), or "titan-v1" (default)
	 */
	public string function detectEmbeddingModelFamily( required string modelId ){
		var id = arguments.modelId.lcase();

		if ( id.findNoCase( "cohere.embed" ) ) {
			return "cohere";
		}
		if ( id.findNoCase( "titan-embed-text-v2" ) ) {
			return "titan-v2";
		}
		return "titan-v1";
	}

	/**
	 * Build a Titan embeddings request body. v1 is just `{ inputText }`; v2 additionally accepts
	 * optional `dimensions` / `normalize`, read from the request's params.
	 *
	 * @text   A single input text
	 * @params The embedding request's params (embeddingRequest.getParams())
	 * @isV2   Whether to include the v2-only optional fields
	 *
	 * @return The Titan InvokeModel request body for one text
	 */
	public struct function buildTitanEmbeddingRequest( required string text, required struct params, boolean isV2 = false ){
		var dataPacket = { "inputText" : arguments.text };

		if ( arguments.isV2 ) {
			if ( arguments.params.keyExists( "dimensions" ) ) {
				dataPacket[ "dimensions" ] = arguments.params.dimensions;
			}
			if ( arguments.params.keyExists( "normalize" ) ) {
				dataPacket[ "normalize" ] = arguments.params.normalize;
			}
		}

		return dataPacket;
	}

	/**
	 * Build a Cohere embeddings request body: `{ texts: [...], input_type }`.
	 * @see https://docs.aws.amazon.com/bedrock/latest/userguide/model-parameters-cohere-embed.html
	 *
	 * @texts  A batch of input texts (max 96 per Cohere's embed API limit)
	 * @params The embedding request's params (embeddingRequest.getParams())
	 *
	 * @return The Cohere InvokeModel request body for this batch
	 */
	public struct function buildCohereEmbeddingRequest( required array texts, required struct params ){
		return {
			"texts"      : arguments.texts,
			"input_type" : arguments.params.input_type ?: "search_document"
		};
	}

	/**
	 * Send Titan embedding requests, one text per call (Titan has no batch endpoint).
	 *
	 * @modelId          The Titan model ID
	 * @texts            The input texts to embed
	 * @embeddingRequest The embedding request object
	 * @isV2             Whether this is titan-embed-text-v2 (adds optional dimensions/normalize)
	 */
	private array function sendTitanEmbeddings(
		required string modelId,
		required array texts,
		required AiEmbeddingRequest embeddingRequest,
		boolean isV2 = false
	){
		var params  = arguments.embeddingRequest.getParams();
		var results = [];

		for ( var i = 1; i <= arguments.texts.len(); i++ ) {
			var dataPacket = buildTitanEmbeddingRequest( arguments.texts[ i ], params, arguments.isV2 );

			var result = sendBedrockEmbeddingRequest( arguments.modelId, dataPacket, arguments.embeddingRequest );

			if ( result.keyExists( "error" ) ) {
				throw( type: "ProviderError", message: result.error.message ?: "Embedding request failed" );
			}

			// Titan reports the input token count per-call.
			var tokenCount = result.keyExists( "inputTextTokenCount" ) ? result.inputTextTokenCount : 0;

			arrayAppend( results, { "embedding" : result.embedding, "index" : i - 1, "promptTokens" : tokenCount } );
		}

		return results;
	}

	/**
	 * Send Cohere embedding requests, batched up to 96 texts per call (Cohere's embed API limit).
	 *
	 * @modelId          The Cohere model ID
	 * @texts            The input texts to embed
	 * @embeddingRequest The embedding request object
	 */
	private array function sendCohereEmbeddings(
		required string modelId,
		required array texts,
		required AiEmbeddingRequest embeddingRequest
	){
		var params     = arguments.embeddingRequest.getParams();
		var results    = [];
		var batchSize  = static.COHERE_EMBED_BATCH_SIZE;
		var totalTexts = arguments.texts.len();
		var startIndex = 1;

		while ( startIndex <= totalTexts ) {
			var endIndex = min( startIndex + batchSize - 1, totalTexts );
			var batch    = arguments.texts.slice( startIndex, endIndex - startIndex + 1 );

			var dataPacket = buildCohereEmbeddingRequest( batch, params );
			var result      = sendBedrockEmbeddingRequest( arguments.modelId, dataPacket, arguments.embeddingRequest );

			if ( result.keyExists( "error" ) ) {
				throw( type: "ProviderError", message: result.error.message ?: "Embedding request failed" );
			}

			// Cohere batch responses may not carry a token count at all — sendBedrockEmbeddingRequest
			// backfills "inputTextTokenCount" from the X-Amzn-Bedrock-Input-Token-Count response
			// header when the body itself doesn't have it (falls back to 0 if neither is present).
			var tokenCount      = result.keyExists( "inputTextTokenCount" ) ? result.inputTextTokenCount : 0;
			var batchEmbeddings = result.embeddings ?: [];

			for ( var j = 1; j <= batchEmbeddings.len(); j++ ) {
				arrayAppend(
					results,
					{
						"embedding"    : batchEmbeddings[ j ],
						"index"        : startIndex + j - 2,
						// Only attribute the token count to the first item of the batch so it's
						// counted once per HTTP call, not once per text in the batch.
						"promptTokens" : ( j == 1 ) ? tokenCount : 0
					}
				);
			}

			startIndex = endIndex + 1;
		}

		return results;
	}

	/**
	 * Generate embeddings using Bedrock's embedding models. Routes to the model-specific request/
	 * response shape by embedding model ID (see detectEmbeddingModelFamily()):
	 *   - `cohere.embed-*`             — batched `{ texts, input_type }` request, `embeddings[]` response
	 *   - `amazon.titan-embed-text-v2*`— Titan v1 body + optional `dimensions`/`normalize`
	 *   - everything else              — Titan v1, one text per call (original behavior)
	 *
	 * @embeddingRequest The embedding request object
	 */
		@override
	public function embeddings( required AiEmbeddingRequest embeddingRequest ){
		// Get the embedding model - default to Titan Embeddings
		var modelId = arguments.embeddingRequest.getModel();
		if ( !len( modelId ) ) {
			modelId = "amazon.titan-embed-text-v1";
		}

		// Push service-level params into the request, exactly as chat()/chatStream() do, so a
		// module-configured input_type / dimensions / normalize reaches the InvokeModel body.
		arguments.embeddingRequest.mergeServiceParams( configuredServiceParams() );

		var embeddingFamily = detectEmbeddingModelFamily( modelId );
		var input           = arguments.embeddingRequest.getInput();
		var textsToProcess  = isArray( input ) ? input : [ input ];

		var rawResults = [];
		switch ( embeddingFamily ) {
			case "cohere":
				rawResults = sendCohereEmbeddings( modelId, textsToProcess, arguments.embeddingRequest );
				break;
			case "titan-v2":
				rawResults = sendTitanEmbeddings( modelId, textsToProcess, arguments.embeddingRequest, true );
				break;
			default:
				rawResults = sendTitanEmbeddings( modelId, textsToProcess, arguments.embeddingRequest, false );
		}

		var promptTokens = 0;
		var results      = [];
		for ( var item in rawResults ) {
			promptTokens += item.promptTokens ?: 0;
			arrayAppend( results, { "embedding" : item.embedding, "index" : item.index } );
		}

		// Format response like OpenAI
		var response = {
			"data"  : results,
			"model" : modelId,
			"usage" : { "prompt_tokens" : promptTokens, "total_tokens" : promptTokens }
		};

		// Announce token usage, mirroring the chat path's onAITokenCount payload. Chat announces
		// whenever its response carries a "usage" key at all (which every family's transform
		// always builds, even when the counts are zero) rather than gating on promptTokens > 0 —
		// match that here too so an all-zero-usage embedding call still gets its event.
		if ( response.keyExists( "usage" ) ) {
			boxAnnounce(
				"onAITokenCount",
				{
					provider         : this,
					operation        : "embeddings",
					model            : modelId,
					promptTokens     : promptTokens,
					completionTokens : 0,
					totalTokens      : promptTokens,
					aiRequest        : arguments.embeddingRequest,
					usage            : response.usage,
					timestamp        : now()
				}
			);
		}

		// Return based on format
		switch ( arguments.embeddingRequest.getReturnFormat() ) {
			case "embeddings":
				return response.data.map( item => item.embedding );
			case "raw":
				return response;
			case "first":
			default:
				return response.data[ 1 ].embedding;
		}
	}

	/**
	 * Send a signed embedding request to Bedrock
	 */
	private struct function sendBedrockEmbeddingRequest(
		required string modelId,
		required struct dataPacket,
		required AiEmbeddingRequest embeddingRequest
	){
		var host     = getBedrockHost();
		var path     = getBedrockPath( arguments.modelId );
		var endpoint = getBedrockEndpoint( arguments.modelId );
		var payload  = jsonSerialize( arguments.dataPacket );

		// Announce the request
		boxAnnounce(
			"onAIEmbedRequest",
			{
				"dataPacket" : arguments.dataPacket,
				"embeddingRequest" : arguments.embeddingRequest,
				"provider"   : this
			}
		);

		// Log the request if enabled
		if ( arguments.embeddingRequest.getLogRequest() ) {
			writeLog(
				text: buildBedrockEmbeddingRequestLog( arguments.embeddingRequest, arguments.dataPacket, endpoint ),
				type: "info",
				log : "ai"
			);
		}

		if ( arguments.embeddingRequest.getLogRequestToConsole() ) {
			println( buildBedrockEmbeddingRequestLog( arguments.embeddingRequest, arguments.dataPacket, endpoint ) );
		}

		// Same auth rule as chat/stream: a Bedrock long-term API key (explicit `bearerToken`
		// config, or AWS_BEARER_TOKEN_BEDROCK) uses bearer auth and skips SigV4 entirely.
		var extraHeaders = buildProviderOptionHeaders( arguments.embeddingRequest.getProviderOptions() );

		var httpService = http( url = endpoint )
			.method( "POST" )
			.charset( "UTF-8" )
			.timeout( arguments.embeddingRequest.getTimeout() )
			.throwOnError( false )
			.header( "Content-Type", "application/json" )
			.header( "Accept", "application/json" );

		if ( useBearerAuth() ) {
			httpService.header( "Authorization", "Bearer #getBearerToken()#" );
		} else {
			// Sign the request
			var headersToSign = {
				"content-type" : "application/json",
				"accept"       : "application/json"
			};
			headersToSign.append( extraHeaders, true );

			var creds         = resolveAwsCredentials();
			var signer        = new AwsSignatureV4();
			var signedHeaders = signer.signRequest(
				method      = "POST",
				host        = host,
				path        = path,
				queryString = "",
				headers     = headersToSign,
				payload         = payload,
				region          = variables.region,
				service         = static.AWS_SERVICE,
				accessKeyId     = creds.accessKeyId,
				secretAccessKey = creds.secretAccessKey,
				sessionToken    = creds.sessionToken
			);

			httpService.header( "Host", host );
			for ( var headerName in signedHeaders ) {
				httpService.header( headerName, signedHeaders[ headerName ] );
			}
		}

		for ( var headerName in extraHeaders ) {
			httpService.header( headerName, extraHeaders[ headerName ] );
		}

		// Add body and send
		var httpResult = httpService.body( payload ).send();

		// Log response if enabled
		if ( arguments.embeddingRequest.getLogResponse() ) {
			writeLog(
				text: buildBedrockEmbeddingResponseLog( arguments.embeddingRequest, httpResult, arguments.modelId ),
				type: "info",
				log : "ai"
			);
		}

		if ( arguments.embeddingRequest.getLogResponseToConsole() ) {
			println( buildBedrockEmbeddingResponseLog( arguments.embeddingRequest, httpResult, arguments.modelId ) );
		}

		var statusCode = val( listFirst( httpResult.statusCode, " " ) );
		if ( statusCode != 200 ) {
			var errorResponse = {
				"error" : {
					"message"    : "Bedrock embedding request failed: #httpResult.fileContent#",
					"statusCode" : statusCode
				}
			};

			// Rate limiting (429): announce a dedicated event. Uses the "embeddingRequest" key —
			// unlike chat/stream's onAIRateLimitHit (which mirrors BaseService.bx:360-367's
			// "chatRequest" key), BaseService has no embeddings equivalent to match, so this key
			// is Bedrock-embeddings-specific rather than "matching BaseService's contract".
			if ( statusCode == 429 ) {
				var errorData = {};
				try {
					errorData = jsonDeserialize( httpResult.fileContent );
				} catch ( any e ) {
					errorData = { "message" : httpResult.fileContent };
				}

				var responseHeaders = httpResult.responseHeader ?: {};
				boxAnnounce(
					"onAIRateLimitHit",
					{
						provider         : this,
						operation        : "embeddings",
						statusCode       : statusCode,
						errorData        : errorData,
						embeddingRequest : arguments.embeddingRequest,
						retryAfter       : firstHeaderValue( responseHeaders[ "retry-after" ] ?: "" )
					}
				);
			}

			boxAnnounce(
				"onAIError",
				{
					error        : errorResponse.error,
					errorMessage : errorResponse.error.message,
					provider     : this,
					operation    : "embeddings",
					embeddingRequest : arguments.embeddingRequest,
					canRetry     : statusCode >= 500 || statusCode == 429
				}
			);

			return errorResponse;
		}

		var parsedResponse = jsonDeserialize( httpResult.fileContent );

		// Titan v1/v2 report "inputTextTokenCount" in the body; Cohere's embed response has no
		// per-call token count field at all. Backfill it from the X-Amzn-Bedrock-Input-Token-Count
		// response header (same mechanism sendBedrockRequest() uses for chat's legacy-family usage
		// gap) so embeddings()'s usage accounting works uniformly across all three shapes — falls
		// back to 0 (via embeddings()'s `?: 0` reads) when the header is also absent.
		if ( !parsedResponse.keyExists( "inputTextTokenCount" ) && isStruct( httpResult.responseHeader ?: {} ) ) {
			var inputTokenHeader = firstHeaderValue( httpResult.responseHeader[ "X-Amzn-Bedrock-Input-Token-Count" ] ?: "" );
			if ( len( inputTokenHeader ) ) {
				parsedResponse[ "inputTextTokenCount" ] = val( inputTokenHeader );
			}
		}

		boxAnnounce(
			"onAIEmbedResponse",
			{
				"embeddingRequest" : arguments.embeddingRequest,
				"response"  : parsedResponse,
				"provider"  : this
			}
		);

		return parsedResponse;
	}

	/**
	 * Build a detailed Bedrock request log message for debugging
	 *
	 * @aiRequest The AI request object
	 * @dataPacket The data packet being sent
	 * @endpoint The Bedrock endpoint URL
	 * @isStream Whether this is a streaming request
	 *
	 * @return Formatted log message with request details
	 */
	private string function buildBedrockRequestLog(
		required AiBaseRequest aiRequest,
		required struct dataPacket,
		required string endpoint,
		boolean isStream = false
	){
		var logLines = [];

		logLines.append( "========================================" );
		logLines.append( "** Bedrock #arguments.isStream ? 'Stream' : ''# Request (#now()#)**" );
		logLines.append( "Provider: Bedrock / Region: #variables.region#" );
		logLines.append( "Endpoint: #arguments.endpoint#" );
		logLines.append( "Timeout: #arguments.aiRequest.getTimeout()#s" );

		// Show model/family if available
		if( arguments.dataPacket.keyExists( "model" ) ){
			logLines.append( "Model: #arguments.dataPacket.model#" );
		}

		// Show message count for chat requests
		if( arguments.dataPacket.keyExists( "messages" ) && isArray( arguments.dataPacket.messages ) ){
			logLines.append( "Message Count: #arguments.dataPacket.messages.len()#" );
		}

		// Show AWS credentials status (without exposing keys)
		logLines.append( "AWS Auth: AccessKey=#len( variables.awsAccessKeyId ) > 0 ? 'SET' : 'MISSING'# | SecretKey=#len( variables.awsSecretAccessKey ) > 0 ? 'SET' : 'MISSING'# | SessionToken=#len( variables.awsSessionToken ) > 0 ? 'SET' : 'NONE'#" );

		// Show multi-tenant tracking if present
		if( !isNull( arguments.aiRequest.getTenantId() ) && arguments.aiRequest.getTenantId().len() ){
			logLines.append( "Tenant ID: #arguments.aiRequest.getTenantId()#" );
		}

		logLines.append( "Request Body:" );
		logLines.append( jsonSerialize( arguments.dataPacket, true ) );  // Pretty print JSON
		logLines.append( "========================================" );

		return logLines.toList( char(10) );
	}

	/**
	 * Build a detailed Bedrock response log message for debugging
	 *
	 * @aiRequest The AI request object
	 * @httpResult The HTTP response result
	 * @modelId The model ID used
	 *
	 * @return Formatted log message with response details
	 */
	private string function buildBedrockResponseLog(
		required AiBaseRequest aiRequest,
		required struct httpResult,
		required string modelId
	){
		var logLines = [];

		logLines.append( "========================================" );
		logLines.append( "** Bedrock Response (#now()#)**" );
		logLines.append( "Provider: Bedrock / Model: #arguments.modelId#" );
		logLines.append( "Status: #arguments.httpResult.statusCode#" );

		// Show execution time if available
		if( arguments.httpResult.keyExists( "executionTime" ) ){
			logLines.append( "Execution Time: #arguments.httpResult.executionTime#ms" );
		}

		// Try to parse and show token usage
		try {
			var parsedResponse = jsonDeserialize( arguments.httpResult.fileContent );

			// Bedrock response format varies by model family
			if( parsedResponse.keyExists( "usage" ) ){
				var usage = parsedResponse.usage;
				var promptTokens = usage.keyExists( "prompt_tokens" ) ? usage.prompt_tokens : ( usage.keyExists( "input_tokens" ) ? usage.input_tokens : 0 );
				var completionTokens = usage.keyExists( "completion_tokens" ) ? usage.completion_tokens : ( usage.keyExists( "output_tokens" ) ? usage.output_tokens : 0 );
				var totalTokens = usage.keyExists( "total_tokens" ) ? usage.total_tokens : ( promptTokens + completionTokens );
				logLines.append( "Token Usage: Prompt=#promptTokens# | Completion=#completionTokens# | Total=#totalTokens#" );
			}

			logLines.append( "Deserialized Response:" );
			logLines.append( jsonSerialize( parsedResponse, true ) );  // Pretty print
		} catch( any e ){
			// If parsing fails, show raw response
			logLines.append( "Raw Response (JSON parsing failed):" );
			logLines.append( arguments.httpResult.fileContent );
		}

		logLines.append( "========================================" );

		return logLines.toList( char(10) );
	}

	/**
	 * Build a detailed Bedrock embedding request log message for debugging
	 *
	 * @embeddingRequest The embedding request object
	 * @dataPacket The data packet being sent
	 * @endpoint The Bedrock endpoint URL
	 *
	 * @return Formatted log message with request details
	 */
	private string function buildBedrockEmbeddingRequestLog(
		required AiEmbeddingRequest embeddingRequest,
		required struct dataPacket,
		required string endpoint
	){
		var logLines = [];

		logLines.append( "========================================" );
		logLines.append( "** Bedrock Embedding Request (#now()#)**" );
		logLines.append( "Provider: Bedrock / Region: #variables.region#" );
		logLines.append( "Model: #arguments.embeddingRequest.getModel()#" );
		logLines.append( "Endpoint: #arguments.endpoint#" );
		logLines.append( "Timeout: #arguments.embeddingRequest.getTimeout()#s" );

		// Show input details
		var input = arguments.dataPacket.keyExists( "inputText" ) ? arguments.dataPacket.inputText : ( arguments.dataPacket.keyExists( "texts" ) ? arguments.dataPacket.texts : "" );
		if( isArray( input ) ){
			logLines.append( "Input Count: #input.len()# items" );
			if( input.len() > 0 ){
				var preview = isSimpleValue( input[1] ) ? input[1] : input[1].toString();
				if( preview.len() > 100 ){
					preview = preview.left( 100 ) & "...";
				}
				logLines.append( "First Item Preview: #preview#" );
			}
		} else if( isSimpleValue( input ) ){
			var preview = input.len() > 100 ? input.left( 100 ) & "..." : input;
			logLines.append( "Input: #preview#" );
		}

		// Show AWS credentials status
		logLines.append( "AWS Auth: AccessKey=#len( variables.awsAccessKeyId ) > 0 ? 'SET' : 'MISSING'# | SecretKey=#len( variables.awsSecretAccessKey ) > 0 ? 'SET' : 'MISSING'# | SessionToken=#len( variables.awsSessionToken ) > 0 ? 'SET' : 'NONE'#" );

		// Show multi-tenant tracking if present
		if( !isNull( arguments.embeddingRequest.getTenantId() ) && arguments.embeddingRequest.getTenantId().len() ){
			logLines.append( "Tenant ID: #arguments.embeddingRequest.getTenantId()#" );
		}

		logLines.append( "Request Body:" );
		logLines.append( jsonSerialize( arguments.dataPacket, true ) );
		logLines.append( "========================================" );

		return logLines.toList( char(10) );
	}

	/**
	 * Build a detailed Bedrock embedding response log message for debugging
	 *
	 * @embeddingRequest The embedding request object
	 * @httpResult The HTTP response result
	 * @modelId The model ID used
	 *
	 * @return Formatted log message with response details
	 */
	private string function buildBedrockEmbeddingResponseLog(
		required AiEmbeddingRequest embeddingRequest,
		required struct httpResult,
		required string modelId
	){
		var logLines = [];

		logLines.append( "========================================" );
		logLines.append( "** Bedrock Embedding Response (#now()#)**" );
		logLines.append( "Provider: Bedrock / Model: #arguments.modelId#" );
		logLines.append( "Status: #arguments.httpResult.statusCode#" );

		// Show execution time if available
		if( arguments.httpResult.keyExists( "executionTime" ) ){
			logLines.append( "Execution Time: #arguments.httpResult.executionTime#ms" );
		}

		// Try to parse and show embedding details
		try {
			var parsedResponse = jsonDeserialize( arguments.httpResult.fileContent );

			// Bedrock embedding response format varies by model
			if( parsedResponse.keyExists( "embeddings" ) && isArray( parsedResponse.embeddings ) ){
				logLines.append( "Embeddings Count: #parsedResponse.embeddings.len()#" );
				if( parsedResponse.embeddings.len() > 0 && isArray( parsedResponse.embeddings[1] ) ){
					logLines.append( "Vector Dimensions: #parsedResponse.embeddings[1].len()#" );
				}
			} else if( parsedResponse.keyExists( "embedding" ) && isArray( parsedResponse.embedding ) ){
				logLines.append( "Embeddings Count: 1" );
				logLines.append( "Vector Dimensions: #parsedResponse.embedding.len()#" );
			}

			// Show token usage if available
			if( parsedResponse.keyExists( "inputTextTokenCount" ) ){
				logLines.append( "Token Usage: Prompt=#parsedResponse.inputTextTokenCount#" );
			}

			logLines.append( "Deserialized Response:" );
			logLines.append( jsonSerialize( parsedResponse, true ) );
		} catch( any e ){
			// If parsing fails, show raw response
			logLines.append( "Raw Response (JSON parsing failed):" );
			logLines.append( arguments.httpResult.fileContent );
		}

		logLines.append( "========================================" );

		return logLines.toList( char(10) );
	}
}
