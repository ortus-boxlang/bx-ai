 * ----------------------------------------------------------------------------------
 * Summary Memory - Intelligent conversation compression
 * Automatically summarizes older messages when the buffer reaches a trigger threshold,
 * then keeps the most recent summaryThreshold messages verbatim.
 * Result: [System Message?] + [AI Summary] + [Last summaryThreshold Messages]
 *
 * Two mutually exclusive trigger modes (set one, not both):
 *   maxMessages — TRIGGER: compress when non-system message count reaches this (default: 20)
 *   maxTokens   — TRIGGER: compress when estimated token count reaches this (default: 0 = disabled)
 *
 * Parameters:
 *   maxMessages      — message-count trigger (default: 20; set to 0 when using maxTokens)
 *   maxTokens        — token-size trigger (default: 0 = disabled; mutex with maxMessages)
 *   summaryThreshold — KEEP-WINDOW: messages kept verbatim after compression (default: 10)
 *                      Must be less than maxMessages when using message-count mode.
 *
 * The summarization logic lives in BaseMemory.summarize().
 * This class adds the auto-trigger in trim(), which fires on every add().
 */
class extends="WindowMemory" {

	static {
		final DEFAULT_MAX_MESSAGES = 20
		final DEFAULT_SUMMARY_THRESHOLD = 10
		final DEFAULT_SUMMARY_MODEL = "gpt-4o-mini"
		final DEFAULT_SUMMARY_PROVIDER = "openai"
		final DEFAULT_MAX_TOKENS = 0
	}

	/**
	 * Constructor
	 *
	 * @key              The unique key for this memory instance
	 * @userId           The user identifier for multi-tenant isolation
	 * @conversationId   The conversation identifier for multiple conversations
	 * @maxMessages      Message-count trigger: compress when non-system messages reach this (default: 20). Set to 0 when using maxTokens.
	 * @maxTokens        Token-size trigger: compress when estimated token count reaches this (default: 0 = disabled). Mutex with maxMessages.
	 * @summaryThreshold Keep-window: messages kept verbatim after compression (default: 10). Must be < maxMessages in message-count mode.
	 * @summaryModel     Model for summarization (default: gpt-4o-mini)
	 * @summaryProvider  Provider for summarization (default: openai)
	 */
	function init(
		string key = createUUID(),
		string userId = "",
		string conversationId = "",
		numeric maxMessages = static.DEFAULT_MAX_MESSAGES,
		numeric maxTokens = static.DEFAULT_MAX_TOKENS,
		numeric summaryThreshold = static.DEFAULT_SUMMARY_THRESHOLD,
		string summaryModel = static.DEFAULT_SUMMARY_MODEL,
		string summaryProvider = static.DEFAULT_SUMMARY_PROVIDER
	) {
		super.init(
			key: arguments.key,
			userId: arguments.userId,
			conversationId: arguments.conversationId,
			maxMessages: arguments.maxMessages,
			maxTokens: arguments.maxTokens,
			summaryThreshold: arguments.summaryThreshold,
			summaryModel: arguments.summaryModel,
			summaryProvider: arguments.summaryProvider
		)
		// Mutex: cannot have both triggers active
		if ( variables.maxTokens > 0 && variables.maxMessages > 0 ) {
			throw(
				type: "InvalidConfiguration",
				message: "SummaryMemory: set either maxTokens OR maxMessages as the trigger, not both."
			)
		}
		// Message-count mode only: summaryThreshold must be less than maxMessages
		if ( variables.maxTokens == 0 && variables.maxMessages > 0 && variables.summaryThreshold >= variables.maxMessages ) {
			throw(
				type: "InvalidConfiguration",
				message: "SummaryMemory: summaryThreshold (#variables.summaryThreshold#) must be less than maxMessages (#variables.maxMessages#). summaryThreshold is the keep-window after compression; maxMessages is the trigger."
			)
		}
		return this
	}

	/**
	 * Configure the memory instance
	 * Supports maxMessages, maxTokens, summaryThreshold, summaryModel, summaryProvider in config
	 *
	 * @config Configuration struct with options (maxMessages, maxTokens, summaryThreshold, summaryModel, summaryProvider, etc.)
	 *
	 * @return IAiMemory for chaining
	 */
	IAiMemory function configure( required struct config ) {
		// BaseMemory.configure() handles all summary config wiring + model building
		super.configure( arguments.config )
		// Mutex: cannot have both triggers active
		if ( variables.maxTokens > 0 && variables.maxMessages > 0 ) {
			throw(
				type: "InvalidConfiguration",
				message: "SummaryMemory: set either maxTokens OR maxMessages as the trigger, not both."
			)
		}
		// Message-count mode only: summaryThreshold must be less than maxMessages
		if ( variables.maxTokens == 0 && variables.maxMessages > 0 && variables.summaryThreshold >= variables.maxMessages ) {
			throw(
				type: "InvalidConfiguration",
				message: "SummaryMemory: summaryThreshold (#variables.summaryThreshold#) must be less than maxMessages (#variables.maxMessages#). summaryThreshold is the keep-window after compression; maxMessages is the trigger."
			)
		}
		return this
	}

	/**
	 * Auto-trigger summarization when the buffer reaches the configured trigger threshold.
	 *
	 * Two mutually exclusive trigger modes:
	 *   maxTokens   > 0 → token mode:   fires when estimated token count >= maxTokens
	 *   maxMessages > 0 → message mode: fires when non-system message count >= maxMessages
	 *
	 * summaryThreshold — keep-window: how many recent messages survive verbatim after compression
	 *
	 * Result after compression: [system?] + [AI summary] + [last summaryThreshold messages]
	 *
	 * @userId   Optional per-call user identifier (ignored — SummaryMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — SummaryMemory is an on-object store)
	 *
	 * @return IAiMemory for chaining
	 */
	public IAiMemory function trim( string userId = "", string conversationId = "" ) {
		var triggered = false
		if ( variables.maxTokens > 0 ) {
			triggered = this.sizeInTokens() >= variables.maxTokens
		} else if ( variables.maxMessages > 0 ) {
			triggered = getNonSystemMessages().len() >= variables.maxMessages
		}
		if ( !triggered ) { return this }
		this.summarize()
		return this
	}

	/**
	 * Clear all messages and reset summary
	 *
	 * @userId   Optional per-call user identifier (ignored — SummaryMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — SummaryMemory is an on-object store)
	 *
	 * @return IAiMemory for chaining
	 */
	public IAiMemory function clear( string userId = "", string conversationId = "" ) {
		super.clear( userId, conversationId );
		variables.currentSummary = "";
		variables.hasSummary = false;
		return this;
	}

	/**
	 * Get a summary of this memory instance
	 * Overrides base to add SummaryMemory-specific fields
	 *
	 * @return Struct with memory information
	 */
	public struct function getSummary() {
		var summary = super.getSummary();

		// Add SummaryMemory-specific computed fields
		summary.maxMessages = variables.maxMessages;
		summary.maxTokens = variables.maxTokens;
		summary.summaryThreshold = variables.summaryThreshold;
		summary.summaryModel = variables.summaryModel;
		summary.summaryProvider = variables.summaryProvider;
		summary.hasSummary = variables.hasSummary;
		summary.summaryLength = len( variables.currentSummary );
		summary.summarizedMessageCount = variables.hasSummary ? summary.messageCount - variables.summaryThreshold : 0;
		summary.recentMessageCount = variables.summaryThreshold;

		return summary;
	}

	/**
	 * Export messages to a serializable format
	 *
	 * @return Struct containing all memory data
	 */
	public struct function export() {
		var exported = super.export();
		exported.maxMessages = variables.maxMessages;
		exported.maxTokens = variables.maxTokens;
		exported.summaryThreshold = variables.summaryThreshold;
		exported.summaryModel = variables.summaryModel;
		exported.summaryProvider = variables.summaryProvider;
		exported.currentSummary = variables.currentSummary;
		exported.hasSummary = variables.hasSummary;
		return exported;
	}

	/**
	 * Import messages from a previously exported format
	 *
	 * @data The exported memory data
	 *
	 * @return IAiMemory for chaining
	 */
	public IAiMemory function import( required struct data ) {
		// BaseMemory.import() handles all summary field restoration + model rebuild
		super.import( arguments.data )
		return this;
	}

}
