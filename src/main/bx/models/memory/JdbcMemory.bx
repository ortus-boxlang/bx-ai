 * ----------------------------------------------------------------------------------
 * JDBC-based AI conversation storage
 * Stores conversation history in a database table for persistence and scalability
 * Works with any JDBC-compatible database
 */
class extends="BaseMemory" {

	/**
	 * The datasource name to use for database operations
	 */
	property name="datasource" type="string";

	/**
	 * The table name to use for storing memory data
	 */
	property name="table" type="string";

	static{
		final DEFAULT_TABLE = "bx_ai_memories"
	}

	/**
	 * Constructor
	 *
	 * @key The unique key for this memory instance
	 * @userId The user identifier for multi-tenant isolation
	 * @conversationId The conversation identifier for multiple conversations
	 * @datasource The datasource name (optional, can be set via configure)
	 * @table The table name (optional, defaults to bx_ai_memories)
	 * @maxMessages Maximum number of messages to retain (0 = unbounded)
	 */
	function init(
		required string key,
		string userId = "",
		string conversationId = "",
		string datasource = "",
		string table = static.DEFAULT_TABLE,
		numeric maxMessages = 0
	) {
		super.init( argumentCollection: arguments )
		variables.datasource = arguments.datasource
		variables.table = arguments.table
		return this
	}

	/**
	 * Configure the memory instance
	 * Supports datasource and table in config, ensures table exists
	 */
	IAiMemory function configure( required struct config ) {
		// Super Size this
		super.configure( arguments.config )

		if ( arguments.config.keyExists( "datasource" ) ) {
			variables.datasource = arguments.config.datasource
		}

		if ( arguments.config.keyExists( "table" ) ) {
			variables.table = arguments.config.table
		}

		// Ensure we have a datasource
		if ( !len( variables.datasource ) ) {
			throw(
				type = "JdbcMemory.MissingDatasource",
				message = "Datasource is required for JdbcMemory. Provide it via constructor or configure()."
			)
		}

		// Ensure table exists
		ensureTable()

		// Load existing data from database if it exists
		loadFromDatabase( variables.userId, variables.conversationId )

		return this
	}

	/**
	 * Get or set the datasource name
	 *
	 * @datasource Optional datasource name to set
	 *
	 * @return String (getter) or IAiMemory (setter)
	 */
	public any function datasource( string datasource ) {
		if ( !isNull( arguments.datasource ) ) {
			variables.datasource = arguments.datasource
			// Ensure table and reload data
			ensureTable()
			loadFromDatabase()
			return this
		}
		return variables.datasource
	}

	/**
	 * Get or set the table name
	 *
	 * @table Optional table name to set
	 *
	 * @return String (getter) or IAiMemory (setter)
	 */
	public any function table( string table ) {
		if ( !isNull( arguments.table ) ) {
			variables.table = arguments.table
			// Ensure table and reload data
			ensureTable()
			loadFromDatabase()
			return this
		}
		return variables.table
	}

	/**
	 * Clear all messages and remove from database
	 *
	 * @userId   Optional per-call user identifier (another user's row is deleted, not this memory's own)
	 * @conversationId Optional per-call conversation identifier (another conversation's row is deleted, not this memory's own)
	 */
	public IAiMemory function clear( string userId = "", string conversationId = "" ) {
		if ( !isOwnScope( arguments.userId, arguments.conversationId ) ) {
			deleteScope( arguments.userId, arguments.conversationId )
			return this
		}
		super.clear( resolveUserId( userId ), resolveConversationId( conversationId ) )
		deleteFromDatabase( resolveUserId( userId ), resolveConversationId( conversationId ) )
		return this
	}

	/**
	 * Export memory state including database-specific fields
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object
	 *
	 * @return Struct with memory state and database connection info
	 */
	public struct function export( string userId = "", string conversationId = "" ) {
		var exported = super.export( resolveUserId( userId ), resolveConversationId( conversationId ) )
		exported.datasource = variables.datasource
		exported.table = variables.table
		return exported
	}

	/**
	 * Import memory state and persist to database
	 *
	 * @data Struct with memory state to import (as generated by export())
	 *
	 * @return IAiMemory for chaining
	 */
	public IAiMemory function import( required struct data ) {
		super.import( arguments.data )

		// Import database-specific fields
		if ( arguments.data.keyExists( "datasource" ) ) {
			variables.datasource = arguments.data.datasource
		}
		if ( arguments.data.keyExists( "table" ) ) {
			variables.table = arguments.data.table
		}

		saveToDatabase()
		return this
	}

	/**
	 * Get summary including database connection info
	 *
	 * @return Struct with memory summary and database connection info
	 */
	public struct function getSummary() {
		var summary = super.getSummary()
		summary.datasource = variables.datasource
		summary.table = variables.table
		summary.persisted = recordExists()
		return summary
	}

	/**
	 * Trim memory and persist changes to database
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object store)
	 */
	public IAiMemory function trim( string userId = "", string conversationId = "" ) {
		if ( !isOwnScope( arguments.userId, arguments.conversationId ) ) {
			writeScope( arguments.userId, arguments.conversationId, trimmed( readScope( arguments.userId, arguments.conversationId ) ) )
			return this
		}
		super.trim( resolveUserId( userId ), resolveConversationId( conversationId ) )
		// sync DB storage
		saveToDatabase( resolveUserId( userId ), resolveConversationId( conversationId ) );
		return this;
	}

	/**
	 * AI-summarize older messages and persist the result to database.
	 * A call for another user or conversation summarizes the row for it, leaving this memory's own messages alone.
	 *
	 * @config Optional struct with keys: keepRecent, model, provider
	 * @userId   Optional per-call user identifier
	 * @conversationId Optional per-call conversation identifier
	 *
	 * @return IAiMemory for chaining
	 */
	public IAiMemory function summarize( struct config = {}, string userId = "", string conversationId = "" ) {
		if ( !isOwnScope( arguments.userId, arguments.conversationId ) ) {
			return summarizeScope( arguments.config, arguments.userId, arguments.conversationId )
		}
		var targetUserId = resolveUserId( arguments.userId )
		var targetConversationId = resolveConversationId( arguments.conversationId )

		lock name="#buildSummarizeLockName()#" type="exclusive" timeout="10" {
			doSummarize( arguments.config, arguments.userId, arguments.conversationId )
			saveToDatabase( targetUserId, targetConversationId )
		}
		return this
	}

	// ========================================
	// Other users and conversations
	// ========================================
	//
	// The messages of the (userId, conversationId) this memory was built with are held on the object, as they always
	// were. A call that names another user or conversation reads and writes the row for it in the table instead.
	// memory_key is the table's primary key, so that row's key is <key>::<userId>::<conversationId>, with user_id and
	// conversation_id filled in and used in the SQL.

	/**
	 * @return The messages for the user and conversation asked for, from the database for another scope
	 */
	public array function getAll( string userId = "", string conversationId = "" ) {
		return isOwnScope( arguments.userId, arguments.conversationId ) ? super.getAll( arguments.userId, arguments.conversationId ) : readScope( arguments.userId, arguments.conversationId )
	}

	public IAiMemory function add( required any message, string userId = "", string conversationId = "" ) {
		if ( isOwnScope( arguments.userId, arguments.conversationId ) ) {
			return super.add( arguments.message, arguments.userId, arguments.conversationId )
		}
		var messages = readScope( arguments.userId, arguments.conversationId )
		messages.append( processMessage( arguments.message ), true )
		writeScope( arguments.userId, arguments.conversationId, trimmed( messages ) )
		return this
	}

	public IAiMemory function setSystemMessage( required string message, string userId = "", string conversationId = "" ) {
		if ( isOwnScope( arguments.userId, arguments.conversationId ) ) {
			return super.setSystemMessage( arguments.message, arguments.userId, arguments.conversationId )
		}
		var messages = readScope( arguments.userId, arguments.conversationId ).filter( m => m.role != "system" )
		messages.prepend( { role: "system", content: arguments.message, timestamp: now() } )
		writeScope( arguments.userId, arguments.conversationId, trimmed( messages ) )
		return this
	}

	public IAiMemory function removeSystemMessage( string userId = "", string conversationId = "" ) {
		if ( isOwnScope( arguments.userId, arguments.conversationId ) ) {
			return super.removeSystemMessage( arguments.userId, arguments.conversationId )
		}
		writeScope( arguments.userId, arguments.conversationId, readScope( arguments.userId, arguments.conversationId ).filter( m => m.role != "system" ) )
		return this
	}

	/**
	 * @return True when the call names the user and conversation this memory was built with, or neither
	 */
	private boolean function isOwnScope( string userId = "", string conversationId = "" ) {
		return resolveUserId( arguments.userId ) == variables.userId && resolveConversationId( arguments.conversationId ) == variables.conversationId
	}

	/**
	 * @return The messages with the memory's limit applied: the system message, then the last maxMessages of the rest
	 */
	private array function trimmed( required array messages ) {
		if ( variables.maxMessages == 0 ) {
			return arguments.messages
		}
		var system = arguments.messages.filter( m => m.role == "system" )
		var rest = arguments.messages.filter( m => m.role != "system" )
		if ( rest.len() > variables.maxMessages ) {
			rest = rest.slice( rest.len() - variables.maxMessages + 1, variables.maxMessages )
		}
		return system.len() ? [ system[ 1 ] ].append( rest, true ) : rest
	}

	/**
	 * The SQL that picks one row: its key, and the user and conversation when they are named.
	 *
	 * @params The parameters of the statement; filled in
	 *
	 * @return The WHERE clause
	 */
	private string function whereScope( required string userId, required string conversationId, required struct params ) {
		var sql = " WHERE memory_key = :key"
		arguments.params.key = variables.key & "::" & arguments.userId & "::" & arguments.conversationId
		if ( len( arguments.userId ) ) {
			sql &= " AND user_id = :userId"
			arguments.params.userId = arguments.userId
		}
		if ( len( arguments.conversationId ) ) {
			sql &= " AND conversation_id = :conversationId"
			arguments.params.conversationId = arguments.conversationId
		}
		return sql
	}

	private boolean function scopeExists( required string userId, required string conversationId ) {
		var params = {}
		var found = queryExecute(
			"SELECT COUNT(*) AS record_count FROM #variables.table#" & whereScope( arguments.userId, arguments.conversationId, params ),
			params,
			{ datasource: variables.datasource, returntype: "array" }
		)
		return found.len() > 0 && found[ 1 ].record_count > 0
	}

	/**
	 * @return The messages in the row for the user and conversation, or an empty array when there is none
	 */
	private array function readScope( string userId = "", string conversationId = "" ) {
		var uid = resolveUserId( arguments.userId )
		var cid = resolveConversationId( arguments.conversationId )
		// check first, to avoid "CLOB freed after transaction" errors on a row that is not there
		if ( !scopeExists( uid, cid ) ) {
			return []
		}
		var params = {}
		var result = queryExecute(
			getDatabaseSpecificSelectSQL().replace( " WHERE memory_key = :key", "" ) & whereScope( uid, cid, params ),
			params,
			{ datasource: variables.datasource }
		)
		return result.recordCount > 0 ? jsonDeserialize( result.memory_data[ 1 ] ) : []
	}

	private void function writeScope( string userId = "", string conversationId = "", required array messages ) {
		var uid = resolveUserId( arguments.userId )
		var cid = resolveConversationId( arguments.conversationId )
		var params = {}
		var where = whereScope( uid, cid, params )
		params.messages = jsonSerialize( arguments.messages )
		if ( scopeExists( uid, cid ) ) {
			queryExecute(
				"UPDATE #variables.table# SET memory_data = :messages, updated_date = CURRENT_TIMESTAMP" & where,
				params,
				{ datasource: variables.datasource }
			)
		} else {
			queryExecute(
				"INSERT INTO #variables.table# (memory_key, user_id, conversation_id, memory_data, metadata_data, config_data)
				 VALUES (:key, :userId, :conversationId, :messages, '{}', :config)",
				{
					key: params.key,
					userId: uid,
					conversationId: cid,
					messages: params.messages,
					config: jsonSerialize( variables.config )
				},
				{ datasource: variables.datasource }
			)
		}
	}

	private void function deleteScope( string userId = "", string conversationId = "" ) {
		var params = {}
		queryExecute(
			"DELETE FROM #variables.table#" & whereScope( resolveUserId( arguments.userId ), resolveConversationId( arguments.conversationId ), params ),
			params,
			{ datasource: variables.datasource }
		)
	}

	/**
	 * Summarizes the row for another user or conversation. doSummarize() builds its result in variables.messages and
	 * variables.currentSummary, so this memory's own are put back afterwards.
	 */
	private IAiMemory function summarizeScope( struct config, string userId, string conversationId ) {
		var uid = resolveUserId( arguments.userId )
		var cid = resolveConversationId( arguments.conversationId )
		lock name="#buildSummarizeLockName()#" type="exclusive" timeout="10" {
			var ownMessages = variables.messages
			var ownSummary = variables.currentSummary
			var ownHasSummary = variables.hasSummary
			try {
				var earlier = readScope( uid, cid ).filter( m => m.isSummary ?: false )
				variables.currentSummary = earlier.len() ? earlier.last().content.replace( "[Previous conversation summary]: ", "" ) : ""
				variables.hasSummary = earlier.len() > 0
				doSummarize( arguments.config, uid, cid )
				writeScope( uid, cid, variables.messages )
			} finally {
				variables.messages = ownMessages
				variables.currentSummary = ownSummary
				variables.hasSummary = ownHasSummary
			}
		}
		return this
	}

	// ========================================
	// Private Helper Methods
	// ========================================

	/**
	 * Ensure the database table exists, create if necessary
	 */
	private void function ensureTable() {
		// Check if table exists using DBInfo
		bx:dbinfo
			name="tables"
			type="tables"
			datasource="#variables.datasource#" {}

		var tableExists = false
		for ( var tableInfo in tables ) {
			if ( tableInfo.table_name.toLowerCase() == variables.table.toLowerCase() ) {
				tableExists = true
				break
			}
		}

		if ( !tableExists ) {
			createTable()
		}
	}

	/**
	 * Create the memory table with database-agnostic SQL
	 */
	private void function createTable() {
		// Get database type to use appropriate SQL
		bx:dbinfo
			name="dbVersion"
			type="version"
			datasource="#variables.datasource#" {}
		var dbType = dbVersion.database_productname.toLowerCase()

		// Build CREATE TABLE statement
		// Using CLOB/TEXT for large JSON data storage
		var sql = "
			CREATE TABLE #variables.table# (
				memory_key VARCHAR(255) PRIMARY KEY,
				user_id VARCHAR(255),
				conversation_id VARCHAR(255),
				memory_data CLOB,
				metadata_data CLOB,
				config_data CLOB,
				created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
				updated_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
			)
		"

		// Adjust for database-specific types
		if ( dbType.contains( "mysql" ) || dbType.contains( "mariadb" ) ) {
			sql = sql.replace( "CLOB", "LONGTEXT" )
		} else if ( dbType.contains( "postgres" ) ) {
			sql = sql.replace( "CLOB", "TEXT" )
		} else if ( dbType.contains( "sqlserver" ) || dbType.contains( "microsoft" ) ) {
			sql = sql.replace( "CLOB", "NVARCHAR(MAX)" )
		} else if ( dbType.contains( "oracle" ) ) {
			// Oracle uses CLOB
		}

		queryExecute(
			sql,
			{},
			{ datasource: variables.datasource }
		)

		// Create indexes for better query performance
		try {
			queryExecute(
				"CREATE INDEX idx_#variables.table#_user_id ON #variables.table# (user_id)",
				{},
				{ datasource: variables.datasource }
			)
			queryExecute(
				"CREATE INDEX idx_#variables.table#_conversation_id ON #variables.table# (conversation_id)",
				{},
				{ datasource: variables.datasource }
			)
			queryExecute(
				"CREATE INDEX idx_#variables.table#_user_conv ON #variables.table# (user_id, conversation_id)",
				{},
				{ datasource: variables.datasource }
			)
		} catch( any e ) {
			// Indexes might already exist or DB might not support them
			// Silently continue - table creation is what matters
		}
	}

	/**
	 * Load data from database if record exists
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object store)
	 */
	private void function loadFromDatabase( string userId = "", string conversationId = "" ) {
		var targetUserId = resolveUserId( userId )
		var targetConversationId = resolveConversationId( conversationId )

		// Check if record exists before querying to avoid "CLOB freed after transaction" errors
		if ( !recordExists( targetUserId, targetConversationId ) ) {
			return
		}

		// Get database-specific CLOB-to-string conversion SQL
		var selectSQL = getDatabaseSpecificSelectSQL()

		// Append userId and conversationId filters if provided (for multi-tenant scenarios)
		if ( len( targetUserId ) ) {
			selectSQL &= " AND user_id = :userId"
		}
		if ( len( targetConversationId ) ) {
			selectSQL &= " AND conversation_id = :conversationId"
		}

		var result = queryExecute(
			selectSQL,
			{ key: variables.key, userId: targetUserId, conversationId: targetConversationId },
			{ datasource: variables.datasource }
		)

		if ( result.recordCount > 0 ) {
			// Access as string values (conversion handled by database)
			var messagesStr = result.memory_data[1]
			var metadataStr = result.metadata_data[1]
			var configStr = result.config_data[1]

			// Deserialize JSON strings
			variables.messages = jsonDeserialize( messagesStr )
			variables.metadata = jsonDeserialize( metadataStr )
			variables.config = jsonDeserialize( configStr )

			// Load userId and conversationId if present
			if ( result.keyExists( "user_id" ) && !isNull( result.user_id[1] ) ) {
				variables.userId = result.user_id[1]
			}
			if ( result.keyExists( "conversation_id" ) && !isNull( result.conversation_id[1] ) ) {
				variables.conversationId = result.conversation_id[1]
			}
		}
	}

	/**
	 * Get database-specific SELECT SQL with CLOB-to-string conversion
	 * This prevents "CLOB freed after transaction" errors by converting
	 * CLOB data to strings before the ResultSet closes
	 */
	private string function getDatabaseSpecificSelectSQL() {
		// Detect database type
		bx:dbinfo
			name="dbVersion"
			type="version"
			datasource="#variables.datasource#" {}

		var dbType = dbVersion.database_productname.toLowerCase()

		// Build database-specific SELECT with appropriate CLOB conversion
		if ( dbType.findNoCase( "mysql" ) || dbType.findNoCase( "mariadb" ) ) {
			// MySQL/MariaDB: CAST to CHAR (LONGTEXT is already string-compatible)
			return "SELECT
				CAST(memory_data AS CHAR) as memory_data,
				CAST(metadata_data AS CHAR) as metadata_data,
				CAST(config_data AS CHAR) as config_data,
				user_id,
				conversation_id
			FROM #variables.table# WHERE memory_key = :key"
		} else if ( dbType.findNoCase( "postgresql" ) || dbType.findNoCase( "postgres" ) ) {
			// PostgreSQL: TEXT type is already string-compatible, but explicit cast for safety
			return "SELECT
				memory_data::text as memory_data,
				metadata_data::text as metadata_data,
				config_data::text as config_data,
				user_id,
				conversation_id
			FROM #variables.table# WHERE memory_key = :key"
		} else if ( dbType.findNoCase( "microsoft" ) || dbType.findNoCase( "sql server" ) ) {
			// SQL Server: CAST to VARCHAR(MAX) or just select (NVARCHAR(MAX) is string-compatible)
			return "SELECT
				CAST(memory_data AS VARCHAR(MAX)) as memory_data,
				CAST(metadata_data AS VARCHAR(MAX)) as metadata_data,
				CAST(config_data AS VARCHAR(MAX)) as config_data,
				user_id,
				conversation_id
			FROM #variables.table# WHERE memory_key = :key"
		} else if ( dbType.findNoCase( "oracle" ) ) {
			// Oracle: Use TO_CHAR or DBMS_LOB.SUBSTR for CLOB conversion
			// TO_CHAR has 4000 char limit, so use CAST for consistency
			return "SELECT
				TO_CLOB(memory_data) as memory_data,
				TO_CLOB(metadata_data) as metadata_data,
				TO_CLOB(config_data) as config_data,
				user_id,
				conversation_id
			FROM #variables.table# WHERE memory_key = :key"
		} else {
			// Derby and other databases: CAST to VARCHAR with max size
			// Derby's max VARCHAR is 32672
			return "SELECT
				CAST(memory_data AS VARCHAR(32672)) as memory_data,
				CAST(metadata_data AS VARCHAR(32672)) as metadata_data,
				CAST(config_data AS VARCHAR(32672)) as config_data,
				user_id,
				conversation_id
			FROM #variables.table# WHERE memory_key = :key"
		}
	}

	/**
	 * Save current state to database (INSERT or UPDATE)
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object store)
	 */
	private void function saveToDatabase( string userId = "", string conversationId = "" ) {
		var messagesJson = jsonSerialize( variables.messages )
		var metadataJson = jsonSerialize( variables.metadata )
		var configJson = jsonSerialize( variables.config )
		var targetUserId = resolveUserId( userId )
		var targetConversationId = resolveConversationId( conversationId )

		if ( recordExists( targetUserId, targetConversationId ) ) {
			// Update existing record
			queryExecute(
				"UPDATE #variables.table#
				 SET memory_data = :messages,
				     metadata_data = :metadata,
				     config_data = :config,
				     user_id = :userId,
				     conversation_id = :conversationId,
				     updated_date = CURRENT_TIMESTAMP
				 WHERE memory_key = :key",
				{
					key: variables.key,
					messages: messagesJson,
					metadata: metadataJson,
					config: configJson,
					userId: targetUserId,
					conversationId: targetConversationId
				},
				{ datasource: variables.datasource }
			)
		} else {
			// Insert new record
			queryExecute(
				"INSERT INTO #variables.table# (memory_key, user_id, conversation_id, memory_data, metadata_data, config_data)
				 VALUES (:key, :userId, :conversationId, :messages, :metadata, :config)",
				{
					key: variables.key,
					userId: targetUserId,
					conversationId: targetConversationId,
					messages: messagesJson,
					metadata: metadataJson,
					config: configJson
				},
				{ datasource: variables.datasource }
			)
		}
	}

	/**
	 * Delete record from database
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object
	 */
	private void function deleteFromDatabase( string userId = "", string conversationId = "" ) {
		var params = { key: variables.key };
		var sql = "DELETE FROM #variables.table# WHERE memory_key = :key";

		if ( len( arguments.userId ) ) {
			sql &= " AND user_id = :userId";
			params.userId = arguments.userId;
		}

		if ( len( arguments.conversationId ) ) {
			sql &= " AND conversation_id = :conversationId";
			params.conversationId = arguments.conversationId;
		}

		queryExecute(
			sql,
			params,
			{ datasource: variables.datasource }
		)
	}

	/**
	 * Check if a record exists in the database
	 *
	 * @userId   Optional per-call user identifier (ignored — JdbcMemory is an on-object store)
	 * @conversationId Optional per-call conversation identifier (ignored — JdbcMemory is an on-object store)
	 *
	 * @return Boolean
	 */
	private boolean function recordExists( string userId = "", string conversationId = "" ) {
		var params = { key: variables.key };
		var sql = "SELECT COUNT(*) as record_count FROM #variables.table# WHERE memory_key = :key";

		if ( len( arguments.userId ) ) {
			sql &= " AND user_id = :userId";
			params.userId = arguments.userId;
		}

		if ( len( arguments.conversationId ) ) {
			sql &= " AND conversation_id = :conversationId";
			params.conversationId = arguments.conversationId;
		}

		var result = queryExecute(
			sql,
			params,
			{ datasource: variables.datasource, returntype: "array" }
		)

		return result.len() > 0 && result[1].record_count > 0
	}

	// ==================== Checkpoint Methods ====================

	/**
	 * Persist checkpoint state using the memory table with a prefixed key.
	 *
	 * @threadId Unique agent thread identifier
	 * @state    Serialisable struct to store
	 * @ttl      TTL in minutes (stored as expiresAt; 0 = no expiry)
	 *
	 * @return this for chaining
	 */
	public IAiMemory function saveState( required string threadId, required struct state, numeric ttl = 0 ) {
		var checkpointKey = "checkpoint_" & arguments.threadId;
		var expiresAt     = arguments.ttl > 0 ? dateAdd( "n", arguments.ttl, now() ) : "";
		var payload       = jsonSerialize( {
			savedAt  : now(),
			expiresAt: expiresAt,
			state    : arguments.state
		} );

		// Upsert pattern: delete existing, then insert
		try {
			queryExecute(
				"DELETE FROM #variables.table# WHERE memory_key = :key",
				{ key: checkpointKey },
				{ datasource: variables.datasource }
			);
		} catch ( any ignored ) {}

		queryExecute(
			"INSERT INTO #variables.table# (memory_key, memory_data) VALUES (:key, :data)",
			{ key: checkpointKey, data: payload },
			{ datasource: variables.datasource }
		);

		return this;
	}

	/**
	 * Retrieve checkpoint state from the memory table.
	 *
	 * @threadId Unique agent thread identifier
	 *
	 * @return Saved state struct, or empty struct if not found or expired
	 */
	public struct function loadState( required string threadId ) {
		var checkpointKey = "checkpoint_" & arguments.threadId;
		try {
			var rows = queryExecute(
				"SELECT memory_data FROM #variables.table# WHERE memory_key = :key",
				{ key: checkpointKey },
				{ datasource: variables.datasource, returntype: "array" }
			);
			if ( rows.isEmpty() ) {
				return {};
			}
			var payload = jsonDeserialize( rows[1].memory_data );
			// Honour expiry
			if ( len( payload.expiresAt ) && now() > payload.expiresAt ) {
				clearState( arguments.threadId );
				return {};
			}
			return payload.state ?: {};
		} catch ( any e ) {
			return {};
		}
	}

	/**
	 * Delete checkpoint state from the memory table.
	 *
	 * @threadId Unique agent thread identifier
	 *
	 * @return this for chaining
	 */
	public IAiMemory function clearState( required string threadId ) {
		var checkpointKey = "checkpoint_" & arguments.threadId;
		try {
			queryExecute(
				"DELETE FROM #variables.table# WHERE memory_key = :key",
				{ key: checkpointKey },
				{ datasource: variables.datasource }
			);
		} catch ( any ignored ) {}
		return this;
	}

}
