 * governing permissions and limitations under the License.
 * ----------------------------------------------------------------------------------
 * Fluent client for consuming Model Context Protocol (MCP) servers over HTTP.
 *
 * Build it with the MCP() BIF: MCP( "https://host/mcp" )
 */
class extends="BaseMCPClient" {

	/**
	 * The base URL of the MCP server
	 */
	property name="baseURL" type="string";

	/**
	 * Additional headers to include in requests
	 */
	property name="headers" type="struct" default={};

	/**
	 * Basic authentication username
	 */
	property name="authUser" type="string" default="";

	/**
	 * Basic authentication password
	 */
	property name="authPassword" type="string" default="";

	/**
	 * Bearer token for authentication
	 */
	property name="bearerToken" type="string" default="";

	/**
	 * Optional guard called with the target URL before every request.
	 * Return false or throw to refuse the request, nothing is sent. Null means no guard.
	 */
	property name="urlGuard" type="any";

	/**
	 * Whether HTTP redirects (3xx) are followed. Default true.
	 */
	property name="followRedirects" type="boolean" default=true;

	/**
	 * Maximum response body size in characters. 0 means no limit.
	 * The body is read before it is measured, so this protects what you keep and pass on, not the bytes read.
	 */
	property name="maxResponseBytes" type="numeric" default=0;

	/**
	 * When true, the client sends an MCP "initialize" request (and the "notifications/initialized" notice)
	 * once before its first call and sends back the Mcp-Session-Id the server returns.
	 */
	property name="handshake" type="boolean" default=false;

	/**
	 * The HTTP version of the requests: "HTTP/2" (the default, the same as bx:http) or "HTTP/1.1".
	 * On a plain http address HTTP/2 starts with an upgrade request (h2c) that some servers do not handle well.
	 */
	property name="httpVersion" type="string" default="HTTP/2";

	/**
	 * Session id the server returned from the handshake, empty when none.
	 * With OAuth each person has a session of their own, see getSessionId().
	 */
	property name="sessionId" type="string" default="";

	/**
	 * The OAuth flow of this client (MCPOAuthFlow), empty when OAuth is off
	 */
	property name="oauth";

	/**
	 * Who the OAuth tokens belong to: a name, or a function ( context ) that returns it for each call
	 */
	property name="oauthSubject";

	/**
	 * Constructor
	 *
	 * @baseURL The base URL of the MCP server
	 */
	function init( required string baseURL ) {
		super.init()

		variables.baseURL      = arguments.baseURL.trim()
		variables.headers      = {}
		variables.authUser     = ""
		variables.authPassword = ""
		variables.bearerToken  = ""
		variables.followRedirects = true
		variables.maxResponseBytes = 0
		variables.handshake    = false
		variables.sessionId    = ""
		variables.httpVersion  = "HTTP/2"
		variables.sessionIds   = {}
		variables.handshakesDone = {}
		variables.oauth        = ""
		variables.oauthSubject = "default"
		variables.lastChallenge = ""

		return this
	}

	/**
	 * The name of the transport
	 */
	string function getTransportName() {
		return "http"
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * Configuration Methods
	 * ---------------------------------------------------------------------------------------------------------
	 */

	/**
	 * Set custom headers for requests
	 *
	 * @headers Struct of header key-value pairs
	 * @return This client for chaining
	 */
	function withHeaders( required struct headers ) {
		variables.headers.append( arguments.headers, true )
		return this
	}

	/**
	 * Set basic authentication credentials
	 *
	 * @user Username
	 * @pass Password
	 * @return This client for chaining
	 */
	function withAuth( required string user, required string pass ) {
		variables.authUser = arguments.user
		variables.authPassword = arguments.pass
		return this
	}

	/**
	 * Set bearer token authentication
	 *
	 * @token Bearer token
	 * @return This client for chaining
	 */
	function withBearerToken( required string token ) {
		variables.bearerToken = arguments.token
		return this
	}

	/**
	 * Set a guard that is called with the target URL before every request.
	 * Return true to allow it. Return false, or throw, to refuse it: nothing is sent and the call
	 * returns a failed MCPResponse. Use it to block private addresses or to apply an allow list.
	 *
	 * <pre>
	 * MCP( url ).withUrlGuard( ( url ) => !isPrivateAddress( url ) )
	 * </pre>
	 *
	 * @guard Function with the signature ( url ) => boolean
	 * @return This client for chaining
	 */
	function withUrlGuard( required function guard ) {
		variables.urlGuard = arguments.guard
		return this
	}

	/**
	 * Choose whether HTTP redirects are followed. They are by default.
	 * With false, a redirect answer is a failed response and the new address is never called.
	 *
	 * @follow True to follow redirects, false to treat them as an error
	 * @return This client for chaining
	 */
	function withRedirects( required boolean follow ) {
		variables.followRedirects = arguments.follow
		return this
	}

	/**
	 * Refuse responses larger than a number of characters. 0 means no limit.
	 * The response is read before it is measured, so this limits what is parsed and returned,
	 * not what is downloaded.
	 *
	 * @max Maximum body size in characters
	 * @return This client for chaining
	 */
	function withMaxResponseBytes( required numeric max ) {
		variables.maxResponseBytes = arguments.max
		return this
	}

	/**
	 * Choose the HTTP version of the requests. The default is "HTTP/2", the same as bx:http.
	 * Use "HTTP/1.1" for a server on a plain http address that does not handle the HTTP/2 upgrade (h2c).
	 *
	 * @version "HTTP/2" or "HTTP/1.1"
	 * @return This client for chaining
	 */
	function withHttpVersion( required string version ) {
		if ( !listFindNoCase( "HTTP/2,HTTP/1.1", arguments.version ) ) {
			throw( type: "InvalidArgument", message: "The HTTP version must be HTTP/2 or HTTP/1.1, not [#arguments.version#]" )
		}
		variables.httpVersion = arguments.version
		return this
	}

	/**
	 * Turn the MCP "initialize" handshake on or off. When on, the client greets the server once before
	 * its first call, as the MCP specification asks, and sends back the Mcp-Session-Id the server returns.
	 *
	 * @enabled True to do the handshake
	 * @return This client for chaining
	 */
	function withHandshake( boolean enabled = true ) {
		variables.handshake = arguments.enabled
		variables.handshakesDone = {}
		variables.sessionIds = {}
		variables.sessionId = ""
		return this
	}

	/**
	 * Sign in to the server with OAuth, as the MCP authorization specification describes: the client finds the
	 * authorization server from the server's metadata, you send the person to sign in (startAuthorization()),
	 * your callback route finishes it (completeAuthorization()), and from then on every request carries the
	 * person's access token, refreshed when it expires.
	 *
	 * A request without tokens does not reach the server: it fails with "MCPAuthorizationRequired" and the
	 * onMCPAuthorizationRequired event fires, so your code can show a sign-in.
	 *
	 * Options:
	 * - store        Where tokens live: "cache" (default, the BoxLang cache), "file", "jdbc", a class path, or an IMCPTokenStore instance
	 * - storeOptions Options of the store: { cacheName } for cache, { path } for file, { datasource, table } for jdbc, passed to a class path
	 * - subject      Whose tokens a call uses: a name, or a function ( context ) => string. The context of a tool call has { chatRequest }, so
	 *                ( context ) => context.chatRequest.getUserId() signs in each person on their own. Calls without a context (listing the tools) use discoverySubject.
	 * - discoverySubject  Whose tokens a call with no context uses, such as listing the tools when an agent starts: a name, or a function that takes
	 *                no arguments. Default "default". The list of tools is the server's, the same for everyone, so one signed in person is enough to ask for it
	 * - redirectUri  The address of your callback route (required to sign in)
	 * - scopes       Array of scopes to ask for. When left out, the scope the server asks for, else everything it supports
	 * - clientId     A client id you registered with the authorization server (and clientSecret, when it has one)
	 * - clientMetadataUrl  The HTTPS address of a Client ID Metadata Document, used when the authorization server supports them
	 * - clientName   The name shown at sign in, when the client registers itself. Default "bx-ai"
	 *
	 * <pre>
	 * mcpClient = MCP( "https://mail.example.com/mcp" ).withOAuth( {
	 *     redirectUri : "https://app.example.com/oauth/callback",
	 *     subject     : ( context ) => context.chatRequest.getUserId()
	 * } )
	 * link = mcpClient.startAuthorization( "alice" ).authorizationUrl
	 * </pre>
	 *
	 * @options The options above
	 *
	 * @return This client for chaining
	 */
	function withOAuth( struct options = {} ) {
		var oauthOptions = arguments.options.copy()
		oauthOptions[ "timeout" ] = oauthOptions.timeout ?: variables.timeout
		variables.oauthSubject = oauthOptions.subject ?: "default"
		variables.oauthDiscoverySubject = oauthOptions.discoverySubject ?: "default"
		variables.oauth = new bxModules.bxai.models.mcp.oauth.MCPOAuthFlow(
			variables.baseURL,
			resolveTokenStore( oauthOptions.store ?: "cache", oauthOptions.storeOptions ?: {} ),
			oauthOptions
		)
		variables.handshakesDone = {}
		variables.sessionIds = {}
		return this
	}

	/**
	 * Begin signing a person in. Finds the authorization server, gets a client id and returns the address to send
	 * the person to. Needs withOAuth().
	 *
	 * @subject Who is signing in (the same name the subject option gives for their calls)
	 *
	 * @return { authorizationUrl, state }
	 */
	struct function startAuthorization( string subject = "default" ) {
		assertOAuth()
		return variables.oauth.start( arguments.subject, variables.lastChallenge )
	}

	/**
	 * Finish signing a person in, from the callback route. Trades the code for tokens and saves them in the store.
	 *
	 * @code   The "code" the authorization server sent to your callback
	 * @state  The "state" it sent
	 * @issuer The "iss" it sent, when it sent one
	 *
	 * @return { subject, scope, expiresAt }: who signed in, never the tokens
	 */
	struct function completeAuthorization( required string code, required string state, string issuer = "" ) {
		assertOAuth()
		return variables.oauth.complete( arguments.code, arguments.state, arguments.issuer )
	}

	/**
	 * Whether a person has tokens that work or can be refreshed.
	 *
	 * @subject Whose tokens
	 */
	boolean function isAuthorized( string subject = "default" ) {
		assertOAuth()
		return variables.oauth.isAuthorized( arguments.subject )
	}

	/**
	 * Delete a person's tokens, so they have to sign in again.
	 *
	 * @subject Whose tokens
	 *
	 * @return This client for chaining
	 */
	function revokeAuthorization( string subject = "default" ) {
		assertOAuth()
		variables.oauth.forget( arguments.subject )
		return this
	}

	/**
	 * The session id the server gave a person at the handshake. Without OAuth there is one session.
	 *
	 * @subject Whose session, with OAuth
	 */
	string function getSessionId( string subject = "" ) {
		return variables.sessionIds[ arguments.subject ] ?: ""
	}

	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * Private Methods
	 * ---------------------------------------------------------------------------------------------------------
	 */

	/**
	 * Runs before every request: the URL guard first, so a refused URL never reaches the network,
	 * then the MCP handshake once, before the first real call.
	 */
	private void function prepare(
		required struct body,
		required string operationType,
		required string operationName,
		struct context = {}
	) {
		if( !isNull( variables.urlGuard ) ){
			if( variables.urlGuard( variables.baseURL ) === false ){
				throw( type: "MCPUrlRefused", message: "URL refused by the URL guard: " & variables.baseURL )
			}
		}

		// With OAuth each person has a session of their own, so the handshake is done once per person
		if( variables.handshake && !variables.handshakesDone.keyExists( sessionKeyFor( arguments.context ) ) && arguments.operationName != "initialize" ){
			doHandshake( arguments.context )
		}
	}

	/**
	 * Send "initialize" and "notifications/initialized" once and keep the session id the server returns.
	 * A server that does not answer the handshake is not an error, the client carries on without a session.
	 */
	private void function doHandshake( struct context = {} ) {
		var sessionKey = sessionKeyFor( arguments.context )
		variables.handshakesDone[ sessionKey ] = true
		var initResponse = makeRequest(
			{
				"jsonrpc": "2.0",
				"method": "initialize",
				"id": createUUID(),
				"params": {
					"protocolVersion": "2025-03-26",
					"capabilities": {},
					"clientInfo": { "name": "bx-ai", "version": "1.0.0" }
				}
			},
			"discovery",
			"initialize",
			arguments.context
		)
		if( initResponse.isSuccess() ){
			var responseHeaders = initResponse.getHeaders()
			for( var headerName in responseHeaders ){
				if( headerName.lCase() == "mcp-session-id" ){
					var headerValue = responseHeaders[ headerName ]
					variables.sessionIds[ sessionKey ] = isArray( headerValue ) ? ( headerValue.len() ? headerValue.first() : "" ) : headerValue
					if( !len( sessionKey ) ){
						variables.sessionId = variables.sessionIds[ sessionKey ]
					}
				}
			}
			makeRequest( { "jsonrpc": "2.0", "method": "notifications/initialized" }, "discovery", "initialized", arguments.context )
		}
	}

	/**
	 * Make an HTTP POST request to the MCP server
	 *
	 * @body          The JSON-RPC message
	 * @operationType The type of operation: tool, resource, prompt, or discovery
	 * @operationName The specific name being invoked (tool name, URI, prompt name, or label)
	 * @return MCPResponse with normalized response data
	 */
	private MCPResponse function transportSend(
		required struct body,
		required string operationType,
		required string operationName,
		struct context = {},
		boolean retried = false
	) {
		var targetUrl  = variables.baseURL
		var subject    = isObject( variables.oauth ) ? subjectFor( arguments.context ) : ""
		var sessionId  = variables.sessionIds[ sessionKeyFor( arguments.context ) ] ?: ""

		// Build authentication credentials
		var authHeader = ""
		if( isObject( variables.oauth ) ){
			// The person's access token, refreshed when it has expired. Throws when they have to sign in.
			authHeader = "Bearer " & tokenFor( subject )
		} else if( len( variables.bearerToken ) ){
			authHeader = "Bearer #variables.bearerToken#"
		} else if( len( variables.authUser ) ){
			// Create Basic Auth header with Base64 encoding
			var credentials        = variables.authUser & ":" & variables.authPassword
			var encodedCredentials = toBase64( credentials )
			authHeader             = "Basic #encodedCredentials#"
		}

		// Our timeout is in milliseconds but the bx:http timeout is in seconds
		var timeoutSeconds = max( 1, ceiling( variables.timeout / 1000 ) )

		// Make HTTP request using bx:http component
		bx: http
			url     = targetUrl
			method  = "POST"
			result  = "httpResult"
			charset = "utf-8"
			timeout = timeoutSeconds
			redirect = variables.followRedirects
			httpVersion = variables.httpVersion
		{
			bx:httpParam type="header" name="content-type" value="application/json";
			bx:httpParam type="header" name="accept" value="application/json, text/event-stream";

			// MCP session from the handshake
			if( len( sessionId ) ){
				bx:httpParam type="header" name="Mcp-Session-Id" value="#sessionId#";
			}

			// Authentication header
			if( len( authHeader ) ){
				bx:httpParam type="header" name="Authorization" value="#authHeader#";
			}

			// Custom headers
			for( var thisHeader in variables.headers ){
				bx:httpParam
					type="header"
					name="#thisHeader#"
					value="#variables.headers[ thisHeader ]#";
			}

			// Body of the POST request
			bx:httpParam type="body" value=jsonSerialize( arguments.body );
		}

		// Parse response
		var statusCode = httpResult.status_code ?: 0
		var responseHeaders = {}

		// Convert headers to struct
		if( !isNull( httpResult.responseheader ) ) {
			for( var headerName in httpResult.responseheader ) {
				responseHeaders[ headerName ] = httpResult.responseheader[ headerName ]
			}
		}

		// OAuth: a 401 means the token is not accepted. Refresh it and try once more, then ask for a sign in.
		if( isObject( variables.oauth ) && ( statusCode == 401 || statusCode == 403 ) ){
			var challenge = headerValueOf( responseHeaders, "www-authenticate" )
			if( statusCode == 401 ){
				variables.lastChallenge = challenge
				if( !arguments.retried ){
					variables.oauth.expire( subject )
					return transportSend( arguments.body, arguments.operationType, arguments.operationName, arguments.context, true )
				}
				announceAuthorizationRequired( subject, "unauthorized", challenge )
				return new bxModules.bxai.models.mcp.MCPResponse(
					success: false,
					data: {},
					error: "The MCP server did not accept the access token of [#subject#] (HTTP 401). They need to sign in again.",
					statusCode: statusCode,
					headers: responseHeaders
				)
			}
			if( challenge.findNoCase( "insufficient_scope" ) ){
				announceAuthorizationRequired( subject, "insufficient_scope", challenge )
			}
		}

		// Determine success based on status code
		var isSuccess = statusCode >= 200 && statusCode < 300
		var responseData = {}
		var errorMessage = ""

		// Refuse an oversized body before parsing it
		if( variables.maxResponseBytes > 0 && len( httpResult.filecontent ?: "" ) > variables.maxResponseBytes ){
			throw( type: "MCPResponseTooLarge", message: "Response larger than #variables.maxResponseBytes# characters" )
		}

		// Parse response body (handles both SSE and plain JSON)
		if( len( httpResult.filecontent ?: "" ) ) {
			try {
				var content = httpResult.filecontent

				// Check if this is an SSE response
				if( content.startsWith( "event:" ) || content.contains( char(10) & "data:" ) ) {
					// Parse SSE format: extract JSON from "data:" line
					var lines = content.listToArray( char(10) )
					for( var line in lines ) {
						if( line.trim().startsWith( "data:" ) ) {
							var jsonData = line.trim().replaceNoCase( "data:", "" ).trim()
							responseData = jsonDeserialize( jsonData )

							// A stream can carry server notifications before the answer: skip a message that is not a JSON-RPC response
							if( isStruct( responseData ) && !structKeyExists( responseData, "result" ) && !structKeyExists( responseData, "error" ) ){
								continue;
							}

							// Check for JSON-RPC error
							if( isStruct( responseData ) && structKeyExists( responseData, "error" ) ) {
								isSuccess = false
								errorMessage = isStruct( responseData.error )
									? ( responseData.error.message ?: "Unknown error" )
									: responseData.error
							}
							// Extract result from JSON-RPC response
							else if( isStruct( responseData ) && structKeyExists( responseData, "result" ) ) {
								responseData = responseData.result
							}
							break;
						}
					}
				} else {
					// Plain JSON response
					responseData = jsonDeserialize( content )

					// Check for JSON-RPC error
					if( isStruct( responseData ) && structKeyExists( responseData, "error" ) ) {
						isSuccess = false
						errorMessage = isStruct( responseData.error )
							? ( responseData.error.message ?: "Unknown error" )
							: responseData.error
					}
					// Extract result from JSON-RPC response
					else if( isStruct( responseData ) && structKeyExists( responseData, "result" ) ) {
						responseData = responseData.result
					}
				}
			} catch( any e ) {
				responseData = httpResult.filecontent
			}
		}

		// Set error message for failed requests
		if( !isSuccess && !len( errorMessage ) ) {
			errorMessage = "HTTP #statusCode#"
			if( isStruct( responseData ) && structKeyExists( responseData, "error" ) ) {
				errorMessage = responseData.error
			} else if( isSimpleValue( responseData ) ) {
				errorMessage = responseData
			}
		}

		// Create normalized response
		return new bxModules.bxai.models.mcp.MCPResponse(
			success: isSuccess,
			data: responseData,
			error: errorMessage,
			statusCode: statusCode,
			headers: responseHeaders
		)
	}


	/**
	 * ---------------------------------------------------------------------------------------------------------
	 * OAuth helpers
	 * ---------------------------------------------------------------------------------------------------------
	 */

	/**
	 * Whose tokens a call uses. The subject option is a name, or a function that gets the context of the call.
	 * A call with no context (listing the tools at start up) uses the discoverySubject option, "default" when there is none.
	 */
	private string function subjectFor( struct context = {} ) {
		var subject = variables.oauthSubject
		if( !isSimpleValue( subject ) ){
			subject = arguments.context.isEmpty() ? discoverySubject() : subject( arguments.context )
		}
		return len( subject ?: "" ) ? subject : "default"
	}

	/**
	 * Whose tokens a call with no context uses: the discoverySubject option, a name or a function with no arguments.
	 */
	private string function discoverySubject() {
		var discovery = variables.oauthDiscoverySubject ?: "default"
		if( !isSimpleValue( discovery ) ){
			discovery = discovery()
		}
		return len( discovery ?: "" ) ? discovery : "default"
	}

	/**
	 * The key of a person's session: their name with OAuth, empty without
	 */
	private string function sessionKeyFor( struct context = {} ) {
		return isObject( variables.oauth ) ? subjectFor( arguments.context ) : ""
	}

	/**
	 * The access token of a person. Tells listeners when there is none, then lets the error through.
	 */
	private string function tokenFor( required string subject ) {
		try {
			return variables.oauth.accessToken( arguments.subject )
		} catch( "MCPAuthorizationRequired" e ) {
			announceAuthorizationRequired( arguments.subject, "no_token", "" )
			rethrow
		}
	}

	/**
	 * Fire onMCPAuthorizationRequired: a person has to sign in (or grant more scope). Interceptors use it to show a sign in.
	 *
	 * @reason    no_token, unauthorized or insufficient_scope
	 * @challenge The WWW-Authenticate header of the answer, when there was one
	 */
	private void function announceAuthorizationRequired( required string subject, required string reason, string challenge = "" ) {
		BoxAnnounce( "onMCPAuthorizationRequired", {
			"client"   : this,
			"baseURL"  : variables.baseURL,
			"subject"  : arguments.subject,
			"reason"   : arguments.reason,
			"challenge": arguments.challenge,
			"scope"    : variables.oauth.parseChallenge( arguments.challenge ).scope
		} )
	}

	/**
	 * A response header by name, whatever its case. Several values come back joined by a comma.
	 */
	private string function headerValueOf( required struct headers, required string name ) {
		for( var headerName in arguments.headers ){
			if( headerName.lCase() == arguments.name ){
				var value = arguments.headers[ headerName ]
				return isArray( value ) ? value.toList( ", " ) : toString( value )
			}
		}
		return ""
	}

	/**
	 * Stop with a clear error when withOAuth() has not been called.
	 *
	 * @throws MCPOAuthNotEnabled when OAuth is off for this client
	 */
	private void function assertOAuth() {
		if( !isObject( variables.oauth ) ){
			throw( type: "MCPOAuthNotEnabled", message: "OAuth is not turned on for this client. Call withOAuth() first." )
		}
	}

	/**
	 * Build the token store of the oauth options
	 *
	 * @store   "cache", "file", "jdbc", a class path or a store instance
	 * @options Options of the store
	 */
	private any function resolveTokenStore( required any store, struct options = {} ) {
		if( isObject( arguments.store ) ){
			return arguments.store
		}
		switch( lCase( arguments.store ) ){
			case "cache":
				return new bxModules.bxai.models.mcp.oauth.CacheMCPTokenStore( arguments.options.cacheName ?: "default" )
			case "file":
				return new bxModules.bxai.models.mcp.oauth.FileMCPTokenStore( arguments.options.path ?: arguments.options.directoryPath ?: "" )
			case "jdbc":
				return new bxModules.bxai.models.mcp.oauth.JdbcMCPTokenStore(
					arguments.options.datasource ?: "",
					arguments.options.table ?: "bx_ai_mcp_oauth"
				)
		}
		if( arguments.store.find( "." ) ){
			return new "#arguments.store#"( argumentCollection: arguments.options )
		}
		throw( type: "InvalidArgument", message: "Unknown OAuth token store [#arguments.store#]. Use cache, file, jdbc, a class path or a store instance" )
	}

}
