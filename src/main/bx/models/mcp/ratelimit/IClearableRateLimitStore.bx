 * Optional capability of a rate limit store: delete every counter that starts with a prefix. MCPServer.resetRateLimit()
 * uses it. A store that does not implement it keeps its counters until they expire, which is at most two windows.
 */
interface {

	/**
	 * Delete every counter whose key starts with the prefix
	 *
	 * @prefix The start of the counter keys
	 */
	void function clear( required string prefix );

}
