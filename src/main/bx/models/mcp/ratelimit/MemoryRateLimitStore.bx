 * ----------------------------------------------------------------------------------
 * In-memory IRateLimitStore. Counters live in this JVM only and are lost on restart. Good for a single
 * node, for tests, and for when no cache should be involved. Expired counters are swept now and then, so
 * memory stays bounded by the number of active clients.
 */
class implements="IRateLimitStore" {

	static {
		// Sweep the expired counters every this many writes
		final SWEEP_EVERY = 1000
	}

	function init() {
		// key => { count, expiresAt in milliseconds }
		variables.counters = {}
		variables.writes   = 0
		variables.storeId  = createUUID()
		return this
	}

	numeric function increment( required string key, required numeric ttlSeconds, numeric amount = 1 ) {
		var nowMillis = createObject( "java", "java.lang.System" ).currentTimeMillis()
		lock name="bxai-ratelimit-memory-#hash( arguments.key )#-#getStoreId()#" type="exclusive" timeout="5" throwontimeout="true" {
			var existing = variables.counters[ arguments.key ] ?: { count: 0, expiresAt: 0 }
			var current  = ( existing.expiresAt > nowMillis ? existing.count : 0 ) + arguments.amount
			variables.counters[ arguments.key ] = {
				count    : max( 0, current ),
				expiresAt: nowMillis + ( arguments.ttlSeconds * 1000 )
			}
		}
		variables.writes++
		if ( variables.writes % static.SWEEP_EVERY == 0 ) {
			sweep( nowMillis )
		}
		return max( 0, current )
	}

	numeric function get( required string key ) {
		var existing = variables.counters[ arguments.key ] ?: { count: 0, expiresAt: 0 }
		return existing.expiresAt > createObject( "java", "java.lang.System" ).currentTimeMillis() ? existing.count : 0
	}

	void function remove( required string key ) {
		variables.counters.delete( arguments.key )
	}

	/**
	 * Drop the counters that have expired
	 */
	private void function sweep( required numeric nowMillis ) {
		lock name="bxai-ratelimit-memory-sweep-#getStoreId()#" type="exclusive" timeout="5" throwontimeout="true" {
			variables.counters.keyArray().each( key => {
				if ( ( variables.counters[ key ]?.expiresAt ?: 0 ) <= nowMillis ) {
					variables.counters.delete( key )
				}
			} )
		}
	}

	private string function getStoreId() {
		return variables.storeId
	}

}
