import bxModules.bxaiSlack.models.SlackSignature;

class extends="testbox.system.BaseSpec" {

	function run( testResults, testBox ) {
		describe( "SlackSignature", () => {

			it( "signs with the v0= prefix", () => {
				var sig = SlackSignature::sign( "secret", "1700000000", "body" )
				expect( sig.left( 3 ) ).toBe( "v0=" )
			} )

			it( "verifies a correctly signed request", () => {
				var secret    = "test-signing-secret"
				var timestamp = toString( int( now().getTime() / 1000 ) )
				var rawBody   = "token=abc&team_id=T123"
				var sig       = SlackSignature::sign( secret, timestamp, rawBody )

				var result = SlackSignature::verify( secret, timestamp, rawBody, sig )
				expect( result.valid ).toBeTrue()
			} )

			it( "rejects a tampered body", () => {
				var secret    = "test-signing-secret"
				var timestamp = toString( int( now().getTime() / 1000 ) )
				var rawBody   = "token=abc&team_id=T123"
				var sig       = SlackSignature::sign( secret, timestamp, rawBody )

				var result = SlackSignature::verify( secret, timestamp, rawBody & "TAMPERED", sig )
				expect( result.valid ).toBeFalse()
			} )

			it( "rejects a mismatched signature", () => {
				var secret    = "test-signing-secret"
				var timestamp = toString( int( now().getTime() / 1000 ) )
				var rawBody   = "token=abc&team_id=T123"

				var result = SlackSignature::verify( secret, timestamp, rawBody, "v0=deadbeef" )
				expect( result.valid ).toBeFalse()
			} )

			it( "rejects a request outside the timestamp tolerance", () => {
				var secret       = "test-signing-secret"
				var rawBody      = "token=abc&team_id=T123"
				var oldTimestamp = toString( int( now().getTime() / 1000 ) - 10000 )
				var oldSig       = SlackSignature::sign( secret, oldTimestamp, rawBody )

				var result = SlackSignature::verify( secret, oldTimestamp, rawBody, oldSig )
				expect( result.valid ).toBeFalse()
			} )

			it( "rejects a missing/non-numeric timestamp", () => {
				var result = SlackSignature::verify( "secret", "not-a-number", "body", "v0=whatever" )
				expect( result.valid ).toBeFalse()
			} )

		} )
	}

}
