 * ----------------------------------------------------------------------------------
 * Most specs here instantiate SlackGateway directly (`new SlackGateway().configure({...})`)
 * rather than going through `aiGateway( "slack" )` — the module registers ONE shared
 * instance in gatewayRegistry() at load time (see ModuleConfig.bx), and `aiGateway()`
 * reconfigures/returns that SAME instance on every call. Sharing it across these specs
 * would leak state (e.g. `requestTTLSeconds: -1` from the expiry spec would poison every
 * later interaction). Direct instantiation keeps each spec isolated; the one spec that
 * exercises `aiGateway( "slack" )` itself only reads capabilities, so it's safe to run
 * against the shared instance.
 */
import bxModules.bxaiSlack.models.SlackGateway;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.HumanInteractionRequest;
import bxModules.bxai.models.gateway.contracts.HumanInteractionDecision;

class extends="testbox.system.BaseSpec" {

	private SlackGateway function newGateway( struct options = { botToken: "xoxb-test", signingSecret: "shhh" } ) {
		return new SlackGateway().configure( arguments.options );
	}

	function run( testResults, testBox ) {
		describe( "SlackGateway", () => {

			it( "resolves via aiGateway( 'slack' ) with the expected capabilities", () => {
				// ModuleConfig's onRuntimeStart registration is best-effort (module startup
				// order isn't guaranteed) — ensure it's registered here too, so this spec
				// doesn't flake if it lost that race during this test run's boot.
				if ( !gatewayRegistry().has( "slack" ) ) {
					gatewayRegistry().register( new SlackGateway() )
				}
				var gw = aiGateway( "slack", { botToken: "xoxb-test", signingSecret: "shhh" } )

				expect( gw.getName() ).toBe( "slack" )
				expect( isInstanceOf( gw, "IGateway" ) ).toBeTrue()
				expect( gw.supports( "inboundMessages" ) ).toBeTrue()
				expect( gw.supports( "outboundMessages" ) ).toBeTrue()
				expect( gw.supports( "interactiveActions" ) ).toBeTrue()
				expect( gw.supports( "humanApproval" ) ).toBeTrue()
				expect( gw.supports( "streaming" ) ).toBeFalse()
			} )

			it( "configure() merges options instead of replacing them wholesale", () => {
				var gw = newGateway( { botToken: "xoxb-first", signingSecret: "secret-1" } )
				gw.configure( { apiBaseUrl: "https://slack.test/api" } )

				expect( gw.getOptions().botToken ).toBe( "xoxb-first" )
				expect( gw.getOptions().signingSecret ).toBe( "secret-1" )
				expect( gw.getOptions().apiBaseUrl ).toBe( "https://slack.test/api" )
			} )

			it( "verifyInbound() is false without a configured signingSecret", () => {
				var gw = newGateway( { botToken: "xoxb-test" } )
				expect( gw.verifyInbound( {}, { headers: {}, rawBody: "" } ) ).toBeFalse()
			} )

			it( "parseInbound() normalizes a Slack event_callback payload", () => {
				var gw      = newGateway()
				var payload = {
					type   : "event_callback",
					team_id: "T789",
					event  : { type: "message", channel: "C123", user: "U456", text: "hello", ts: "1700000000.000001" }
				}

				var messages = gw.parseInbound( payload, {} )
				expect( messages ).toHaveLength( 1 )
				expect( messages[ 1 ].getText() ).toBe( "hello" )
				expect( messages[ 1 ].getContext().getConversationID() ).toBe( "C123" )
				expect( messages[ 1 ].getContext().getUserID() ).toBe( "U456" )
				expect( messages[ 1 ].getContext().getMetadata().slackTeamId ).toBe( "T789" )
			} )

			it( "parseInbound() returns empty array for non-event_callback payloads", () => {
				var gw = newGateway()
				expect( gw.parseInbound( { type: "url_verification", challenge: "xyz" }, {} ) ).toHaveLength( 0 )
				expect( gw.parseInbound( {}, {} ) ).toHaveLength( 0 )
			} )

			it( "parseInbound() filters out bot messages to prevent self-echo", () => {
				var gw      = newGateway()
				var payload = {
					type : "event_callback",
					event: { type: "message", channel: "C123", bot_id: "B123", text: "I am a bot", ts: "1700000000.000002" }
				}
				expect( gw.parseInbound( payload, {} ) ).toHaveLength( 0 )
			} )

			it( "parseInbound() filters out system message subtypes except file_share", () => {
				var gw = newGateway()

				var editPayload = {
					type : "event_callback",
					event: { type: "message", subtype: "message_changed", channel: "C123", user: "U456", ts: "1700000000.000003" }
				}
				expect( gw.parseInbound( editPayload, {} ) ).toHaveLength( 0 )

				var filePayload = {
					type : "event_callback",
					event: { type: "message", subtype: "file_share", channel: "C123", user: "U456", text: "here is a file", ts: "1700000000.000004" }
				}
				expect( gw.parseInbound( filePayload, {} ) ).toHaveLength( 1 )
			} )

			it( "parseInbound() sets slackThreadTs to ts when thread_ts is absent", () => {
				var gw      = newGateway()
				var payload = {
					type : "event_callback",
					event: { type: "message", channel: "C123", user: "U456", text: "hi", ts: "1700000001.000000" }
				}
				var messages = gw.parseInbound( payload, {} )
				expect( messages[ 1 ].getContext().getMetadata().slackThreadTs ).toBe( "1700000001.000000" )
			} )

			it( "requestHumanInteraction() posts Block Kit approve/reject buttons with unique action_ids and tracks a pending interaction", () => {
				var gw = newGateway()

				var captured = { method: "", body: {} }
				gw.callSlackApi = ( method, body ) => {
					captured.method = method
					captured.body   = body
					return { ok: true, channel: body.channel ?: "", ts: "1700000000.000100" }
				}

				var gwContext = new GatewayContext( gateway: "slack", conversationID: "C123", threadID: "thread-1" )
				var humanRequest   = new HumanInteractionRequest(
					title        : "Approve tool call?",
					message      : "The agent wants to call deleteFile(path=/tmp/x)",
					pendingAction: { toolName: "deleteFile", toolArgs: { path: "/tmp/x" } }
				)

				var result = gw.requestHumanInteraction( humanRequest, gwContext )

				expect( result.getSuccess() ).toBeTrue()
				expect( captured.method ).toBe( "chat.postMessage" )
				var elements = captured.body.blocks[ 2 ].elements
				expect( elements ).toHaveLength( 2 )
				// Every button in the block must carry a unique action_id (Slack requirement)
				expect( elements[ 1 ].action_id ).notToBe( elements[ 2 ].action_id )
				expect( elements[ 1 ].action_id ).toMatch( "button:1" )
				expect( elements[ 2 ].action_id ).toMatch( "button:2" )

				// promptBlocks are stored for the answered-card update
				var record = gw.getInteraction( humanRequest.getId() )
				expect( isNull( record.decision ) ).toBeTrue()
				expect( record.promptBlocks ).toHaveLength( 1 )
			} )

			it( "resolveInteraction() atomically resolves and rejects a duplicate", () => {
				var gw = newGateway()
				gw.callSlackApi = ( method, body ) => {
					return { ok: true, channel: body.channel ?: "", ts: "1700000000.000200" }
				}

				var gwContext = new GatewayContext( gateway: "slack", conversationID: "C123" )
				var humanRequest   = new HumanInteractionRequest( title: "Approve?", message: "msg" )
				gw.requestHumanInteraction( humanRequest, gwContext )

				var decision = new HumanInteractionDecision( requestID: humanRequest.getId(), decision: "approve", decidedBy: "U999" )
				var resolved = gw.resolveInteraction( humanRequest.getId(), decision )
				expect( resolved.getDecision() ).toBe( "approve" )

				expect( function() {
					gw.resolveInteraction( humanRequest.getId(), decision )
				} ).toThrow( "InteractionAlreadyResolved" )
			} )

			it( "resolveInteraction() rejects an unknown requestID", () => {
				var gw = newGateway()
				var decision = new HumanInteractionDecision( requestID: "unknown-id", decision: "approve" )

				expect( function() {
					gw.resolveInteraction( "unknown-id", decision )
				} ).toThrow( "InteractionNotFound" )
			} )

			it( "resolveInteraction() rejects an expired interaction", () => {
				var gw = newGateway( { botToken: "xoxb-test", signingSecret: "shhh", requestTTLSeconds: -1 } )
				gw.callSlackApi = ( method, body ) => {
					return { ok: true, channel: body.channel ?: "", ts: "1700000000.000300" }
				}

				var gwContext = new GatewayContext( gateway: "slack", conversationID: "C123" )
				var humanRequest   = new HumanInteractionRequest( title: "Approve?", message: "msg" )
				gw.requestHumanInteraction( humanRequest, gwContext )

				var decision = new HumanInteractionDecision( requestID: humanRequest.getId(), decision: "approve" )
				expect( function() {
					gw.resolveInteraction( humanRequest.getId(), decision )
				} ).toThrow( "InteractionExpired" )
			} )

			it( "parseHumanDecision() builds a HumanInteractionDecision from an interaction.decision event", () => {
				var gw    = newGateway()
				var event = new GatewayEvent(
					type: "interaction.decision",
					data: { requestID: "req-1", decision: "reject", decidedBy: "U123" }
				)

				var decision = gw.parseHumanDecision( event )
				expect( decision.getRequestID() ).toBe( "req-1" )
				expect( decision.getDecision() ).toBe( "reject" )
				expect( decision.getDecidedBy() ).toBe( "U123" )
			} )

		} )
	}

}
