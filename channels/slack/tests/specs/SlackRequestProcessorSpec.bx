 * ----------------------------------------------------------------------------------
 * route( requestData, path ) is the testable seam: `path` is passed explicitly instead
 * of being read from CGI.PATH_INFO, so these specs can drive the full processor without
 * a running web server or CGI mocking.
 *
 * `aiGateway( "slack", {...} )` here resolves and reconfigures the SAME instance the
 * module registered in gatewayRegistry() at load time (see ModuleConfig.bx) — there is
 * no separate register()/unregister() dance per spec. That's safe across these specs
 * because every interaction is keyed by a fresh UUID (HumanInteractionRequest's default
 * id), so there's no state collision between them.
 */
import bxModules.bxaiSlack.models.SlackRequestProcessor;
import bxModules.bxaiSlack.models.SlackSignature;
import bxModules.bxaiSlack.models.SlackGateway;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.HumanInteractionRequest;

class extends="testbox.system.BaseSpec" {

	property name="secret" type="string" default="shared-secret";

	private string function signature( required string timestamp, required string rawBody ) {
		return SlackSignature::sign( variables.secret, arguments.timestamp, arguments.rawBody );
	}

	private struct function signedHeaders( required string rawBody ) {
		var timestamp = toString( int( now().getTime() / 1000 ) );
		return {
			"X-Slack-Signature"        : signature( timestamp, arguments.rawBody ),
			"X-Slack-Request-Timestamp": timestamp,
			"Content-Type"             : "application/json"
		};
	}

	function run( testResults, testBox ) {
		describe( "SlackRequestProcessor", () => {

			var gw = "";

			beforeEach( ( currentSpec, data ) => {
				// ModuleConfig's onRuntimeStart registration is best-effort (module startup
				// order isn't guaranteed) — ensure it's registered here too, so this spec
				// doesn't flake if it lost that race during this test run's boot.
				if ( !gatewayRegistry().has( "slack" ) ) {
					gatewayRegistry().register( new SlackGateway() )
				}
				gw = aiGateway( "slack", { botToken: "xoxb-test", signingSecret: variables.secret } )
				gw.callSlackApi = ( method, body ) => {
					return { ok: true, channel: body.channel ?: "", ts: "1700000000.000900" }
				}
			} )

			it( "echoes the challenge for a signed url_verification handshake", () => {
				var body     = '{"type":"url_verification","challenge":"abc123"}'
				var response = SlackRequestProcessor::route(
					{ method: "POST", body: body, headers: signedHeaders( body ), requestId: "req-1" },
					"/events"
				)

				expect( response.statusCode ).toBe( 200 )
				expect( response.content ).toBe( "abc123" )
			} )

			it( "rejects an events POST with a bad signature", () => {
				var body     = '{"type":"url_verification","challenge":"abc123"}'
				var response = SlackRequestProcessor::route(
					{
						method   : "POST",
						body     : body,
						headers  : { "X-Slack-Signature": "v0=deadbeef", "X-Slack-Request-Timestamp": toString( int( now().getTime() / 1000 ) ) },
						requestId: "req-2"
					},
					"/events"
				)

				expect( response.statusCode ).toBe( 401 )
			} )

			it( "acks a signed event_callback and fires onSlackInboundMessage", () => {
				var received = { fired: false, text: "" }
				boxRegisterInterceptor(
					( data ) => {
						received.fired = true
						received.text  = data.messages[ 1 ].getText()
					},
					"onSlackInboundMessage"
				)

				var body = jsonSerialize( {
					type : "event_callback",
					event: { type: "message", channel: "C1", user: "U1", text: "hi there", ts: "1700000000.000001" }
				} )
				var response = SlackRequestProcessor::route(
					{ method: "POST", body: body, headers: signedHeaders( body ), requestId: "req-3" },
					"/events"
				)

				expect( response.statusCode ).toBe( 200 )
				expect( received.fired ).toBeTrue()
				expect( received.text ).toBe( "hi there" )
			} )

			it( "resolves a signed interactive button click end-to-end", () => {
				var gwContext = new GatewayContext( gateway: "slack", conversationID: "C123" )
				var humanRequest   = new HumanInteractionRequest( title: "Approve?", message: "msg" )
				gw.requestHumanInteraction( humanRequest, gwContext )

				var actionValue = jsonSerialize( { requestID: humanRequest.getId(), decision: "approve" } )
				var payloadJson = jsonSerialize( {
					type   : "block_actions",
					user   : { id: "U999" },
					actions: [ { value: actionValue } ]
				} )
				var formBody = "payload=" & urlEncodedFormat( payloadJson )

				var response = SlackRequestProcessor::route(
					{ method: "POST", body: formBody, headers: signedHeaders( formBody ), requestId: "req-4" },
					"/interactions"
				)

				expect( response.statusCode ).toBe( 200 )

				var record = gw.getInteraction( humanRequest.getId() )
				expect( isNull( record.decision ) ).toBeFalse()
				expect( record.decision.getDecision() ).toBe( "approve" )
				expect( record.decision.getDecidedBy() ).toBe( "U999" )
			} )

			it( "rejects a duplicate decision for an already-resolved interaction", () => {
				var gwContext = new GatewayContext( gateway: "slack", conversationID: "C123" )
				var humanRequest   = new HumanInteractionRequest( title: "Approve?", message: "msg" )
				gw.requestHumanInteraction( humanRequest, gwContext )

				var actionValue = jsonSerialize( { requestID: humanRequest.getId(), decision: "approve" } )
				var payloadJson = jsonSerialize( { type: "block_actions", user: { id: "U999" }, actions: [ { value: actionValue } ] } )
				var formBody    = "payload=" & urlEncodedFormat( payloadJson )
				var reqData     = { method: "POST", body: formBody, headers: signedHeaders( formBody ), requestId: "req-5" }

				var first  = SlackRequestProcessor::route( reqData, "/interactions" )
				var second = SlackRequestProcessor::route( reqData, "/interactions" )

				expect( first.statusCode ).toBe( 200 )
				expect( second.statusCode ).toBe( 409 )
			} )

			it( "returns 404 for an interaction decision on an unknown requestID", () => {
				var actionValue = jsonSerialize( { requestID: "totally-unknown", decision: "approve" } )
				var payloadJson = jsonSerialize( { type: "block_actions", user: { id: "U999" }, actions: [ { value: actionValue } ] } )
				var formBody    = "payload=" & urlEncodedFormat( payloadJson )

				var response = SlackRequestProcessor::route(
					{ method: "POST", body: formBody, headers: signedHeaders( formBody ), requestId: "req-6" },
					"/interactions"
				)

				expect( response.statusCode ).toBe( 404 )
			} )

			it( "returns 400 for an interactions POST with an empty actions array", () => {
				var payloadJson = jsonSerialize( { type: "block_actions", user: { id: "U999" }, actions: [] } )
				var formBody    = "payload=" & urlEncodedFormat( payloadJson )

				var response = SlackRequestProcessor::route(
					{ method: "POST", body: formBody, headers: signedHeaders( formBody ), requestId: "req-8" },
					"/interactions"
				)

				expect( response.statusCode ).toBe( 400 )
			} )

			it( "does not fire onSlackInboundMessage for bot messages", () => {
				var fired = false
				boxRegisterInterceptor(
					( data ) => { fired = true },
					"onSlackInboundMessage"
				)

				var body = jsonSerialize( {
					type : "event_callback",
					event: { type: "message", channel: "C1", bot_id: "B123", text: "bot message", ts: "1700000000.000010" }
				} )
				var response = SlackRequestProcessor::route(
					{ method: "POST", body: body, headers: signedHeaders( body ), requestId: "req-9" },
					"/events"
				)

				expect( response.statusCode ).toBe( 200 )
				expect( fired ).toBeFalse()
			} )

			it( "returns 404 for an unrecognized route", () => {
				var response = SlackRequestProcessor::route(
					{ method: "POST", body: "", headers: {}, requestId: "req-7" },
					"/not-a-real-route"
				)

				expect( response.statusCode ).toBe( 404 )
			} )

		} )
	}

}
