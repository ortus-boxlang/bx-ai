 * governing permissions and limitations under the License.
 * ----------------------------------------------------------------------------------
 * A bx-ai IGateway backed by Slack: inbound Events API callbacks become normalized
 * GatewayMessage(s), and human-in-the-loop approvals are presented as Block Kit
 * messages with Approve/Reject buttons whose clicks arrive via Slack's Interactivity
 * endpoint. See SlackRequestProcessor for the HTTP endpoints that drive this class,
 * and public/slack.bxm for the front controller that exposes them.
 *
 * Like bx-ai's own HttpGateway, this is a network-reachable gateway: every inbound
 * request (event callback or interactive payload) is verified via Slack's own
 * request-signing scheme (SlackSignature, HMAC-SHA256 "v0" scheme) before it is
 * trusted, and resolving a pending interaction is an atomic claim
 * (java.util.concurrent.ConcurrentHashMap.replace()) so a duplicate button click
 * (Slack retries delivery on slow acks) can't double-resolve the same request.
 *
 * Scope note: Slack buttons don't have a natural way to submit *edited* arguments
 * inline (that needs a modal/view), so "edit" is not offered as a button — nor is
 * "cancel", which has no natural single-click Slack affordance either.
 * requestHumanInteraction() renders buttons for "approve"/"approve_always"/
 * "approve_session"/"reject" out of whatever HumanInteractionRequest.
 * getAllowedDecisions() allows, reusing IGateway.presentInteraction()'s shared
 * label/style-per-decision vocabulary (see InteractionPresentation) so the same
 * "Approve Always"/"Approve for Session" wording appears consistently across every
 * chat-native gateway, not just Slack. This is a documented scope limit, not a
 * silent gap.
 *
 * Integration note: mirroring HttpGateway, this gateway does not itself call
 * AiAgent.resume() — the calling application sets GatewayContext.threadID (and,
 * if useful, agentID) when presenting a request, and correlates the resolved
 * decision back to agent.resume() itself, e.g. from an onSlackInteractionResolved
 * interceptor.
 */
import bxModules.bxai.models.gateway.BaseGateway;
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayDeliveryResult;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.GatewayMessage;
import bxModules.bxai.models.gateway.contracts.HumanInteractionDecision;
import bxModules.bxai.models.gateway.contracts.HumanInteractionRequest;
import bxModules.bxaiSlack.models.SlackSignature;

class extends="BaseGateway" {

	/**
	 * The Slack bot token (xoxb-...) used to authenticate Web API calls
	 */
	property name="botToken" type="string" default="";

	/**
	 * The Slack app's signing secret, used to verify inbound requests
	 */
	property name="signingSecret" type="string" default="";

	/**
	 * Base URL for the Slack Web API — overridable for testing
	 */
	property name="apiBaseUrl" type="string" default="https://slack.com/api";

	/**
	 * Maximum allowed clock skew / request age for signed requests, in seconds
	 */
	property name="toleranceSeconds" type="numeric" default=300;

	/**
	 * How long a presented interaction stays open before it's treated as expired, in seconds
	 */
	property name="requestTTLSeconds" type="numeric" default=900;

	/**
	 * Every event delivered via deliver(), in order — mirrors MockGateway/HttpGateway for
	 * observability/testing
	 */
	property name="deliveredEvents" type="array" default=[];

	/**
	 * Pending/resolved interactions, keyed by HumanInteractionRequest.id
	 */
	property name="interactions" type="struct" default={};

	/**
	 * java.util.concurrent.ConcurrentHashMap<String,String> of requestID -> status,
	 * the atomic compare-and-set primitive resolveInteraction() claims against
	 */
	property name="statusLocks";

	/**
	 * Decisions Slack can represent as a single-click button — see the class docs' scope note
	 * on why "edit" and "cancel" are excluded.
	 */
	static {
		SUPPORTED_DECISIONS = "approve,approve_always,approve_session,reject"
	}

	/**
	 * Constructor
	 */
	function init() {
		variables.name                      = "slack"
		variables.description               = "Presents inbound Slack messages and human-in-the-loop approvals over the Slack Events/Interactivity APIs."
		variables.apiBaseUrl                = "https://slack.com/api"
		variables.options                   = {}
		variables.deliveredEvents           = []
		variables.interactions              = {}
		variables.statusLocks               = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		// Slack's hard limit on mrkdwn section block text — truncate before posting to avoid 400s
		variables.SLACK_SECTION_TEXT_MAX_LENGTH = 3000
		return this;
	}

	/**
	 * Merges the given options onto whatever this gateway was previously configured
	 * with, instead of replacing them wholesale — this instance is registered once in
	 * gatewayRegistry() at module load and reconfigured on every aiGateway( "slack", {...} )
	 * call afterward, so a partial-options call (or none at all) must not wipe out
	 * previously-set values like botToken/signingSecret.
	 *
	 * @options { botToken, signingSecret, apiBaseUrl, toleranceSeconds, requestTTLSeconds }
	 */
	IGateway function configure( required any options ) {
		var incoming = isStruct( arguments.options ) ? arguments.options : {}
		structAppend( variables.options, incoming, true )
		variables.botToken          = variables.options.botToken ?: variables.botToken
		variables.signingSecret     = variables.options.signingSecret ?: variables.signingSecret
		variables.apiBaseUrl        = variables.options.apiBaseUrl ?: variables.apiBaseUrl
		variables.toleranceSeconds  = variables.options.toleranceSeconds ?: variables.toleranceSeconds
		variables.requestTTLSeconds = variables.options.requestTTLSeconds ?: variables.requestTTLSeconds
		return this;
	}

	array function getDeclaredCapabilities() {
		return [ "inboundMessages", "outboundMessages", "interactiveActions", "humanApproval" ]
	}

	// -------------------------------------------------------------------------
	// Inbound
	// -------------------------------------------------------------------------

	/**
	 * Verify a Slack request's signature. Expects requestContext.headers to carry
	 * X-Slack-Signature / X-Slack-Request-Timestamp, and requestContext.rawBody the
	 * exact raw body string the signature was computed over.
	 */
	boolean function verifyInbound( required any payload, struct requestContext = {} ) {
		var headers   = arguments.requestContext.headers ?: {}
		var rawBody   = arguments.requestContext.rawBody ?: ""
		var signature = headers[ "X-Slack-Signature" ] ?: ""
		var timestamp = headers[ "X-Slack-Request-Timestamp" ] ?: ""

		if ( !variables.signingSecret.len() ) {
			return false
		}
		if ( !signature.len() || !timestamp.len() ) {
			return false
		}

		return SlackSignature::verify(
			signingSecret   : variables.signingSecret,
			timestamp       : timestamp,
			rawBody         : rawBody,
			signature       : signature,
			toleranceSeconds: variables.toleranceSeconds
		).valid
	}

	/**
	 * Parse a verified Slack Events API `event_callback` payload into a normalized
	 * GatewayMessage.
	 *
	 * Returns an empty array (silently ignoring the event) when:
	 * - The payload is not an `event_callback` envelope
	 * - The inner event was posted by a bot (`bot_id` set) — prevents the bot's own
	 *   outbound messages from re-triggering inbound handlers (self-echo)
	 * - The inner event carries a system `subtype` other than `file_share` — edits,
	 *   deletes, channel-join notifications, etc. are not user messages
	 *
	 * @payload The top-level Slack Events API payload (with a nested `.event` struct)
	 */
	array function parseInbound( required any payload, struct requestContext = {} ) {
		if ( !isStruct( arguments.payload ) || ( arguments.payload.type ?: "" ) != "event_callback" ) {
			return []
		}

		var slackEvent = arguments.payload.event ?: {}

		// Ignore messages posted by bots (including this bot's own replies)
		if ( len( slackEvent.bot_id ?: "" ) ) {
			return []
		}

		// Ignore system message subtypes (edits, deletes, channel joins, etc.)
		// but allow file_share since those are real user-initiated uploads
		var subtype = slackEvent.subtype ?: ""
		if ( len( subtype ) && subtype != "file_share" ) {
			return []
		}

		var gwContext = new GatewayContext(
			gateway       : variables.name,
			conversationID: slackEvent.channel ?: "",
			userID        : slackEvent.user ?: "",
			metadata      : {
				"slackThreadTs" : slackEvent.thread_ts ?: ( slackEvent.ts ?: "" ),
				"slackEventType": slackEvent.type ?: "",
				"slackTeamId"   : arguments.payload.team_id ?: ""
			},
			raw: arguments.payload
		)
		return [
			new GatewayMessage(
				id     : slackEvent.client_msg_id ?: slackEvent.ts ?: createUUID(),
				text   : slackEvent.text ?: "",
				context: gwContext,
				raw    : arguments.payload
			)
		]
	}

	// -------------------------------------------------------------------------
	// Outbound
	// -------------------------------------------------------------------------

	/**
	 * Deliver an event as a plain Slack message via chat.postMessage.
	 */
	GatewayDeliveryResult function deliver( required GatewayEvent event, required GatewayContext context ) {
		variables.deliveredEvents.append( arguments.event )

		try {
			var body = {
				"channel": arguments.context.getConversationID(),
				"text"   : renderEventText( arguments.event )
			}
			var threadTs = arguments.context.getMetadata().slackThreadTs ?: ""
			if ( threadTs.len() ) {
				body[ "thread_ts" ] = threadTs
			}

			var apiResult = this.callSlackApi( "chat.postMessage", body )
			return new GatewayDeliveryResult(
				deliveryID: apiResult.ts ?: "",
				success   : apiResult.ok ?: false,
				error     : ( apiResult.ok ?: false ) ? "" : ( apiResult.error ?: "Unknown Slack API error" ),
				raw       : apiResult
			)
		} catch ( any e ) {
			return GatewayDeliveryResult.failure( "Failed to deliver to Slack: #e.message#" )
		}
	}

	// -------------------------------------------------------------------------
	// Interactive actions
	// -------------------------------------------------------------------------

	/**
	 * Post a Block Kit message with interactive buttons.
	 *
	 * @actions Array of { label, value, style } — value is opaque and echoed back verbatim
	 *          in the button-click payload
	 */
	GatewayDeliveryResult function deliverInteractive(
		required GatewayEvent event,
		required GatewayContext context,
		required array actions
	) {
		try {
			var blocks = [
				{
					"type": "section",
					"text": { "type": "mrkdwn", "text": renderEventText( arguments.event ) }
				},
				{
					"type"    : "actions",
					"elements": arguments.actions.map( ( a ) => buildButton( a ) )
				}
			]

			var body = {
				"channel": arguments.context.getConversationID(),
				"text"   : renderEventText( arguments.event ),
				"blocks" : blocks
			}
			var threadTs = arguments.context.getMetadata().slackThreadTs ?: ""
			if ( threadTs.len() ) {
				body[ "thread_ts" ] = threadTs
			}

			var apiResult = this.callSlackApi( "chat.postMessage", body )
			return new GatewayDeliveryResult(
				deliveryID: apiResult.ts ?: "",
				success   : apiResult.ok ?: false,
				error     : ( apiResult.ok ?: false ) ? "" : ( apiResult.error ?: "Unknown Slack API error" ),
				raw       : apiResult
			)
		} catch ( any e ) {
			return GatewayDeliveryResult.failure( "Failed to deliver interactive message to Slack: #e.message#" )
		}
	}

	// -------------------------------------------------------------------------
	// Human-in-the-loop
	// -------------------------------------------------------------------------

	/**
	 * Present an interaction request as a Block Kit message with Approve/Reject buttons.
	 * Always resolves asynchronously — the decision arrives later via resolveInteraction()
	 * when the button click is POSTed to the Interactivity endpoint.
	 *
	 * @humanRequest HumanInteractionRequest — typed `any` (not the strict class name) and
	 *          named "humanRequest" rather than "request": "request" is BoxLang's own
	 *          built-in scope name, and even `arguments.request` resolves to that ambient
	 *          scope instead of this parameter once it isn't strictly typed as a specific
	 *          class — confirmed via a "getId() not found on RequestScope" runtime error.
	 *          Separately, a strict class type here doesn't survive cross-module identity:
	 *          a BoxLang instance built via a `bxModules.bxai.*` import from a loose
	 *          top-level script (e.g. a TestBox spec) fails strict-type binding against the
	 *          same import used inside this module's own compiled code — confirmed via CI
	 *          ("argument type Struct does not match declared type HumanInteractionRequest").
	 *          So this stays duck-typed (`.getId()`, `.getAllowedDecisions()`, etc.).
	 * @context GatewayContext — same cross-module-identity reasoning as @humanRequest.
	 */
	GatewayDeliveryResult function requestHumanInteraction( required any humanRequest, required any context ) {
		var id = arguments.humanRequest.getId()

		// Reuse IGateway's shared label/style-per-decision vocabulary for buttons — filtered
		// down to the decisions Slack can represent as a single-click button (see class docs).
		var presentation     = this.presentInteraction( arguments.humanRequest, variables.SLACK_SECTION_TEXT_MAX_LENGTH )
		var supportedButtons = presentation.getButtons().filter( ( b ) => static.SUPPORTED_DECISIONS.listFindNoCase( b.value ) > 0 )

		// Build button elements with per-index action_id (Eve pattern) so every button
		// in the same actions block gets a unique action_id, which Slack requires.
		var buttonElements = []
		for ( var i = 1; i <= supportedButtons.len(); i++ ) {
			var b = supportedButtons[ i ]
			buttonElements.append( buildButton(
				{
					"label": b.label,
					"value": jsonSerialize( { "requestID": id, "decision": b.value } ),
					"style": b.style == "default" ? "" : b.style
				},
				i
			) )
		}

		var promptText  = buildRequestText( arguments.humanRequest )
		var promptBlock = { "type": "section", "text": { "type": "mrkdwn", "text": promptText } }
		var blocks = [
			promptBlock,
			{
				"type"    : "actions",
				"block_id": "bxai_hitl_#id#",
				"elements": buttonElements
			}
		]

		var body = {
			"channel": arguments.context.getConversationID(),
			// Prefer the actual message over presentInteraction()'s generic "Approval needed"
			// fallback title — Slack shows this "text" field as the notification/plain-text
			// preview, where the real content is more useful than a generic header.
			"text"   : arguments.humanRequest.getTitle().len() ? arguments.humanRequest.getTitle() : arguments.humanRequest.getMessage(),
			"blocks" : blocks
		}
		var threadTs = arguments.context.getMetadata().slackThreadTs ?: ""
		if ( threadTs.len() ) {
			body[ "thread_ts" ] = threadTs
		}

		var apiResult = this.callSlackApi( "chat.postMessage", body )

		// Only track the interaction as pending if it was actually delivered — a failed
		// Slack API call means no human ever saw the buttons, so there's nothing to
		// later resolve (and no orphaned "pending" entry that could be resolved regardless).
		if ( apiResult.ok ?: false ) {
			variables.statusLocks.put( id, "pending" )
			variables.interactions[ id ] = {
				"humanRequest" : arguments.humanRequest,
				"context"      : arguments.context,
				"decision"     : javacast( "null", "" ),
				"createdAt"    : now(),
				"slackChannel" : apiResult.channel ?: arguments.context.getConversationID(),
				"slackTs"      : apiResult.ts ?: "",
				// Preserve prompt blocks so resolveInteraction() can update the message
				// with the original content intact (Eve "answered-card" pattern)
				"promptBlocks" : [ promptBlock ]
			}
		}

		return new GatewayDeliveryResult(
			deliveryID: apiResult.ts ?: "",
			success   : apiResult.ok ?: false,
			error     : ( apiResult.ok ?: false ) ? "" : ( apiResult.error ?: "Unknown Slack API error" ),
			raw       : apiResult
		)
	}

	/**
	 * Build a HumanInteractionDecision from an inbound `block_actions` interactive payload's
	 * parsed GatewayEvent (see SlackRequestProcessor.handleInteraction()).
	 */
	HumanInteractionDecision function parseHumanDecision( required GatewayEvent event ) {
		var data = arguments.event.getData()
		return new HumanInteractionDecision(
			requestID: data.requestID ?: "",
			decision : data.decision ?: "",
			reason   : data.reason ?: "",
			decidedBy: data.decidedBy ?: ""
		)
	}

	/**
	 * Look up a tracked interaction record by requestID, pending or resolved.
	 *
	 * @return struct { humanRequest, context, decision, createdAt, slackChannel, slackTs } or null if unknown
	 */
	any function getInteraction( required string requestID ) {
		return variables.interactions[ arguments.requestID ] ?: javacast( "null", "" )
	}

	/**
	 * Whether a requestID's presented interaction has aged past requestTTLSeconds.
	 */
	boolean function isInteractionExpired( required string requestID ) {
		var record = getInteraction( arguments.requestID )
		if ( isNull( record ) ) {
			return true
		}
		return dateDiff( "s", record.createdAt, now() ) > variables.requestTTLSeconds
	}

	/**
	 * Atomically resolve a pending interaction with a decision. Only the first call for a
	 * given requestID succeeds — Slack retries slow-acking interactions, so a duplicate
	 * button click POST must not double-resolve. On success, best-effort updates the
	 * original Slack message to remove the buttons and show the outcome.
	 *
	 * @throws InteractionNotFound        if no interaction is tracked with that id
	 * @throws InteractionExpired         if the interaction aged past requestTTLSeconds
	 * @throws InteractionAlreadyResolved if another resolveInteraction() call already claimed it
	 */
	HumanInteractionDecision function resolveInteraction( required string requestID, required HumanInteractionDecision decision ) {
		var record = getInteraction( arguments.requestID )
		if ( isNull( record ) ) {
			throw( type: "InteractionNotFound", message: "No interaction with id [#arguments.requestID#]." )
		}
		if ( isInteractionExpired( arguments.requestID ) ) {
			throw( type: "InteractionExpired", message: "Interaction [#arguments.requestID#] has expired." )
		}

		var claimed = variables.statusLocks.replace( arguments.requestID, "pending", "resolved" )
		if ( !claimed ) {
			throw(
				type   : "InteractionAlreadyResolved",
				message: "Interaction [#arguments.requestID#] was already resolved with status [#variables.statusLocks.get( arguments.requestID )#]."
			)
		}

		record.decision = arguments.decision

		try {
			// Eve "answered-card" pattern: preserve the original prompt blocks so context
			// stays visible, strip the interactive action buttons, then append a
			// confirmation section and an attribution context block.
			//
			// presentResolution() already knows how to phrase every decision variant
			// (approve/approve_always/approve_session/reject-with-reason/edit/cancel) — reused
			// here for the summary line, but with decidedBy stripped, since Slack renders
			// attribution as its own clickable <@user> mention in a separate context block
			// below rather than presentResolution()'s plain-text "by X" suffix.
			var summaryDecision = new HumanInteractionDecision(
				requestID: arguments.decision.getRequestID(),
				decision : arguments.decision.getDecision(),
				reason   : arguments.decision.getReason()
			)
			var answeredBlocks = []
			for ( var block in ( record.promptBlocks ?: [] ) ) {
				answeredBlocks.append( block )
			}
			answeredBlocks.append( {
				"type": "section",
				"text": { "type": "mrkdwn", "text": ":white_check_mark: #this.presentResolution( summaryDecision )#" }
			} )
			var who = arguments.decision.getDecidedBy().len() ? arguments.decision.getDecidedBy() : ""
			if ( who.len() ) {
				answeredBlocks.append( {
					"type"    : "context",
					"elements": [ { "type": "mrkdwn", "text": "Answered by <@#who#>" } ]
				} )
			}

			this.callSlackApi( "chat.update", {
				"channel": record.slackChannel,
				"ts"     : record.slackTs,
				"text"   : "#buildRequestText( record.humanRequest )# — #this.presentResolution( summaryDecision )#",
				"blocks" : answeredBlocks
			} )
		} catch ( any e ) {
			// Best-effort — the decision is already atomically claimed and recorded above;
			// failing to cosmetically update the Slack message is not a resolution failure.
		}

		return arguments.decision
	}

	// -------------------------------------------------------------------------
	// Private helpers
	// -------------------------------------------------------------------------

	/**
	 * Call a Slack Web API method with the bot token. Public (not private) so tests can
	 * substitute it with a closure instead of hitting the real Slack API — mirrors how
	 * bx-ai's own MCP/gateway tests monkey-patch a transport's public methods.
	 *
	 * @method Slack Web API method name, e.g. "chat.postMessage"
	 * @body   The JSON body to send
	 *
	 * @return The deserialized Slack API JSON response (at least { ok, error })
	 */
	public struct function callSlackApi( required string method, required struct body ) {
		bx: http
			url    = variables.apiBaseUrl & "/" & arguments.method
			method = "post"
			result = "apiResult"
			charset = "utf-8"
		{
			bx:httpParam type="header" name="authorization" value="Bearer #variables.botToken#";
			bx:httpParam type="header" name="content-type" value="application/json; charset=utf-8";
			bx:httpParam type="body" value=jsonSerialize( arguments.body );
		}
		return jsonDeserialize( apiResult.fileContent ?: "{}" )
	}

	/**
	 * Build a single Slack Block Kit "button" element.
	 *
	 * @action { label, value, style }
	 * @index  1-based position within the actions block — appended to the action_id
	 *         so every button in a block gets a unique id, which Slack requires.
	 */
	private struct function buildButton( required struct action, numeric index = 0 ) {
		var suffix = arguments.index > 0 ? ":button:#arguments.index#" : ":button:#hash( arguments.action.value )#"
		var button = {
			"type"     : "button",
			"text"     : { "type": "plain_text", "text": arguments.action.label, "emoji": true },
			"value"    : arguments.action.value,
			"action_id": "bxai_hitl#suffix#"
		}
		if ( len( arguments.action.style ?: "" ) ) {
			button[ "style" ] = arguments.action.style
		}
		return button
	}

	/**
	 * Truncate text to Slack's hard mrkdwn section limit, adding "…" when trimmed.
	 *
	 * @text      Text to truncate
	 * @maxLength Maximum characters (default SLACK_SECTION_TEXT_MAX_LENGTH)
	 */
	private string function truncateMrkdwn( required string text, numeric maxLength = variables.SLACK_SECTION_TEXT_MAX_LENGTH ) {
		if ( len( arguments.text ) <= arguments.maxLength ) {
			return arguments.text
		}
		return left( arguments.text, max( 0, arguments.maxLength - 1 ) ).trimRight() & "…"
	}

	/**
	 * Render a HumanInteractionRequest as Slack mrkdwn text.
	 * Truncates to SLACK_SECTION_TEXT_MAX_LENGTH to prevent API 400s on large tool inputs.
	 *
	 * @humanRequest typed/named the same way as requestHumanInteraction()'s param — see
	 *          that method's doc comment for why ("request" collides with BoxLang's own
	 *          ambient scope, and strict cross-module class types don't survive a caller
	 *          outside this module).
	 */
	private string function buildRequestText( required any humanRequest ) {
		var lines = []
		if ( arguments.humanRequest.getTitle().len() ) {
			lines.append( "*#arguments.humanRequest.getTitle()#*" )
		}
		if ( arguments.humanRequest.getMessage().len() ) {
			lines.append( arguments.humanRequest.getMessage() )
		}
		var pending = arguments.humanRequest.getPendingAction()
		if ( !structIsEmpty( pending ) ) {
			var json = jsonSerialize( pending )
			lines.append( "*Tool input*" & char( 10 ) & "```" & char( 10 ) & json & char( 10 ) & "```" )
		}
		return truncateMrkdwn( lines.toList( char( 10 ) & char( 10 ) ) )
	}

	/**
	 * Render a normalized GatewayEvent as Slack mrkdwn text for plain/interactive delivery.
	 * Truncates to SLACK_SECTION_TEXT_MAX_LENGTH to prevent API 400s.
	 */
	private string function renderEventText( required GatewayEvent event ) {
		var data = arguments.event.getData()
		if ( len( data.text ?: "" ) ) {
			return truncateMrkdwn( data.text )
		}
		return truncateMrkdwn( "*#arguments.event.getType()#*" & ( structIsEmpty( data ) ? "" : char( 10 ) & "```#jsonSerialize( data )#```" ) )
	}

}
